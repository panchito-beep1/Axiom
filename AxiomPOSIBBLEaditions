-- BULLETPROOF: neither argument can ever be a non-table and cause pairs() to blow up.
function Theme.merge(base, override)
    local out = {}
    if type(base) == "table" then
        for k, v in pairs(base) do out[k] = v end
    end
    if type(override) == "table" then
        for k, v in pairs(override) do out[k] = v end
    end
    return out
end

