Axiom.Validators = {}

function Axiom.Validators.GamePass(passId, options)
    options = options or {}
    return {
        Tier            = options.Tier            or "VIP",
        Premium         = options.Premium         ~= false,
        IsAsync         = true,
        PromptIfMissing = options.PromptIfMissing or false,
        Validate = function(_key)
            local MPS    = game:GetService("MarketplaceService")
            local player = game:GetService("Players").LocalPlayer
            local ok, owns = pcall(MPS.UserOwnsGamePassAsync, MPS, player.UserId, passId)
            if ok and owns then return true end
            if options.PromptIfMissing then
                pcall(MPS.PromptGamePassPurchase, MPS, player, passId)
            end
            return false
        end,
    }
end

function Axiom.Validators.DevProduct(productId, options)
    options = options or {}
    return {
        Tier    = options.Tier    or "VIP",
        Premium = options.Premium ~= false,
        IsAsync = false,
        Validate = function(_key)
            local MPS    = game:GetService("MarketplaceService")
            local player = game:GetService("Players").LocalPlayer
            pcall(MPS.PromptProductPurchase, MPS, player, productId)
            if options.OnPrompt then pcall(options.OnPrompt) end
            return false
        end,
    }
end

function Axiom.Validators.UserId(ids, options)
    options = options or {}
    local set = {}
    if type(ids) == "table" then
        for _, id in ipairs(ids) do set[id] = true end
    else
        set[ids] = true
    end
    return {
        Tier    = options.Tier    or "Developer",
        Premium = options.Premium or false,
        IsAsync = false,
        Validate = function(_key)
            return set[game:GetService("Players").LocalPlayer.UserId] == true
        end,
    }
end

function Axiom.Validators.Username(names, options)
    options = options or {}
    local set = {}
    if type(names) == "table" then
        for _, n in ipairs(names) do set[tostring(n):lower()] = true end
    else
        set[tostring(names):lower()] = true
    end
    return {
        Tier    = options.Tier    or "Developer",
        Premium = options.Premium or false,
        IsAsync = false,
        Validate = function(_key)
            return set[game:GetService("Players").LocalPlayer.Name:lower()] == true
        end,
    }
end

function Axiom.Validators.Currency(attr, amount, options)
    options = options or {}
    return {
        Tier    = options.Tier    or "VIP",
        Premium = options.Premium ~= false,
        IsAsync = false,
        Validate = function(_key)
            local player = game:GetService("Players").LocalPlayer
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
                local stat = leaderstats:FindFirstChild(attr)
                if stat and typeof(stat.Value) == "number" and stat.Value >= amount then
                    return true
                end
            end
            local val = player:GetAttribute(attr)
            if typeof(val) == "number" and val >= amount then
                return true
            end
            return false
        end,
    }
end

