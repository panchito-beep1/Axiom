--  Dear ImGui Runtime Style Editor (ImGui::ShowStyleEditor)
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:ShowStyleEditor()
    local win = Axiom._Internal.CreateWindowChrome({
        Title = "Dear ImGui Style Editor",
        Size  = UDim2.new(0, 440, 0, 480),
        Theme = self._theme or Axiom.DefaultTheme,
        Icon  = "rbxassetid://6031280882",
    })

    local body = win:GetBody()
    local tab = setmetatable({ _page = body, _window = self, _layoutOrder = 0, _disabledStack = {} }, TabComponent)

    tab:AddSection({ Text = "Theme Colors (Live Tweak)" })

    local keysToEdit = {
        "WindowBg", "TitleBg", "TitleBgActive", "FrameBg", "FrameBgHover", "FrameBgActive",
        "Accent", "Button", "ButtonHover", "ButtonActive", "CheckOn", "SliderFill",
        "TabActive", "Text", "SubText", "Border"
    }

    for _, key in ipairs(keysToEdit) do
        local curColor = self._theme[key] or Color3.fromRGB(100, 100, 100)
        tab:AddColorPicker({
            Text    = key,
            Default = curColor,
            Callback = function(newClr)
                local patch = {}
                patch[key] = newClr
                self:SetTheme(patch)
            end
        })
    end

    tab:AddSeparator()
    tab:AddButton({
        Text = "Export Theme as Lua Table to Console",
        Callback = function()
            local out = "local MyTheme = {\n"
            for k, v in pairs(self._theme) do
                if typeof(v) == "Color3" then
                    out = out .. string.format("    %-18s = Color3.fromRGB(%d, %d, %d),\n", k, math.floor(v.R*255), math.floor(v.G*255), math.floor(v.B*255))
                end
            end
            out = out .. "}\n"
            print("\n[Axiom Style Export]\n" .. out)
            if setclipboard then setclipboard(out) end
            self:Notify({ Title = "Style Exported", Description = "Theme table printed to console and clipboard!", Duration = 3 })
        end,
    })

    return win
end

