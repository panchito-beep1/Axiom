        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Parent = holder,
    })

    local display = Util.create("TextButton", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 21),
        BackgroundColor3 = theme.main, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Parent = holder,
    })
    Util.corner(theme.cornerSmall).Parent = display
    Util.stroke(theme.outline, 1).Parent = display
    Util.padding({ left = 8, right = 4 }).Parent = display

    local valueLabel = Util.create("TextLabel", {
        Text = "", Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, -20, 1, 0), Parent = display,
    })

    Util.create("TextLabel", {
        Text = icon("chevron"), Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextTransparency = theme.textTransparency,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Parent = display,
    })

    local function list()
        local out = {}
        for _, v in ipairs(options) do if selected[v] then table.insert(out, v) end end
        return out
    end
    local function renderLabel()
        local s = list()
        valueLabel.Text = (#s == 0) and "---" or table.concat(s, ", ")
    end
    renderLabel()

    display.MouseEnter:Connect(function()
        Util.tween(display, { BackgroundColor3 = theme.surfaceHover }, 0.1)
    end)
    display.MouseLeave:Connect(function()
        Util.tween(display, { BackgroundColor3 = theme.main }, 0.1)
    end)

    local obj = { _root = holder }
    function obj:get() return list() end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    function obj:set(values, silent)
        if not enabled then return end
        selected = {}
        for _, v in ipairs(values) do selected[v] = true end
        renderLabel()
        local s = list()
        if not silent then
            if config.callback then config.callback(s) end
            for _, cb in ipairs(listeners) do cb(s) end
        end
    end

    local function closePopup()
        if popup then popup:Destroy(); popup = nil end
        if backdrop then backdrop:Destroy(); backdrop = nil end
    end
    local function toggleOption(opt)
        selected[opt] = (not selected[opt]) or nil
        renderLabel()
        local s = list()
        if config.callback then config.callback(s) end
        for _, cb in ipairs(listeners) do cb(s) end
    end

    local function openPopup()
        if popup then return end
        local win = section._tab._window
        backdrop = Util.create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 998, Parent = win._root,
        })
        backdrop.MouseButton1Click:Connect(closePopup)

        local btnAbs, winAbs = display.AbsolutePosition, win._root.AbsolutePosition
        local rowH = math.min(#options * 21 + 8, 200)
        popup = Util.create("ScrollingFrame", {
            Size = UDim2.fromOffset(display.AbsoluteSize.X, rowH),
            Position = UDim2.fromOffset(btnAbs.X - winAbs.X, btnAbs.Y - winAbs.Y + 24),
            BackgroundColor3 = theme.main, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = theme.outline,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 999, Parent = win._root,
        })
        Util.corner(theme.cornerSmall).Parent = popup
        Util.outline(popup, theme.outline, theme.dark)
        Util.padding({ top = 2, bottom = 2 }).Parent = popup
        Util.listLayout({ gap = 0 }).Parent = popup

        for _, opt in ipairs(options) do
            local isSel = selected[opt]
            local item = Util.create("TextButton", {
                Text = (isSel and "✓ " or "  ") .. tostring(opt),
                Font = theme.font, TextSize = theme.fontSize,
                TextColor3 = isSel and theme.accent or theme.text,
                TextTransparency = isSel and 0 or theme.textTransparency,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundColor3 = theme.main, BackgroundTransparency = 1,
                BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 21),
                AutoButtonColor = false, ZIndex = 1000, Parent = popup,
            })
            Util.padding({ left = 6 }).Parent = item
            item.MouseEnter:Connect(function()
                if not isSel then item.BackgroundTransparency = 0; item.TextTransparency = 0 end
            end)
            item.MouseLeave:Connect(function()
                if not isSel then item.BackgroundTransparency = 1; item.TextTransparency = theme.textTransparency end
            end)
            item.MouseButton1Click:Connect(function()
                toggleOption(opt); closePopup(); openPopup()
            end)
        end
    end

    local conn = display.MouseButton1Click:Connect(function()
        if not enabled then return end
        if popup then closePopup() else openPopup() end
    end)
    function obj:destroy() conn:Disconnect(); closePopup(); holder:Destroy() end
    return obj
end

-- ---- Keybind ----
function Components.keybind(section, config)
    local theme = section._theme
    local value = config.default
    local listeners, enabled = {}, not config.disabled
    local capturing, captureConn = false, nil

    local holder = Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundTransparency = 1, Parent = section._content,
    })

    Util.create("TextLabel", {
        Text = tostring(config.name or "Keybind"),
        Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), Parent = holder,
    })

    local btn = Util.create("TextButton", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 21),
        BackgroundColor3 = theme.main, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Parent = holder,
    })
    Util.corner(theme.cornerSmall).Parent = btn
    Util.stroke(theme.outline, 1).Parent = btn
    Util.padding({ left = 8, right = 8 }).Parent = btn

    local valueLabel = Util.create("TextLabel", {
        Text = (typeof(value) == "EnumItem") and value.Name or "None",
        Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = btn,
    })

    btn.MouseEnter:Connect(function() Util.tween(btn, { BackgroundColor3 = theme.surfaceHover }, 0.1) end)
    btn.MouseLeave:Connect(function() Util.tween(btn, { BackgroundColor3 = theme.main }, 0.1) end)

    local function stopCapture()
        capturing = false
        if captureConn then captureConn:Disconnect(); captureConn = nil end
        valueLabel.Text = (typeof(value) == "EnumItem") and value.Name or "None"
        valueLabel.TextColor3 = theme.text
    end
    local function startCapture()
        capturing = true
        valueLabel.Text = "[...]"
        valueLabel.TextColor3 = theme.accent
        captureConn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local key = input.KeyCode
            if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                value = nil
            else
                value = key
            end
            stopCapture()
            if config.callback then config.callback(value) end
            for _, cb in ipairs(listeners) do cb(value) end
        end)
    end

    local obj = { _root = holder }
    function obj:get() return value end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    function obj:set(v, silent)
        if not enabled then return end
        value = v
        valueLabel.Text = (typeof(v) == "EnumItem") and v.Name or "None"
        if not silent then
            if config.callback then config.callback(v) end
            for _, cb in ipairs(listeners) do cb(v) end
        end
    end
    local conn = btn.MouseButton1Click:Connect(function()
        if not enabled then return end
        if capturing then stopCapture() else startCapture() end
    end)
    function obj:destroy() conn:Disconnect(); stopCapture(); holder:Destroy() end
    return obj
end

