-- ── Theme Binding & Dynamic Update ────────────────────────────────────────────
function Axiom:_bindTheme(instance, propMap)
    table.insert(self._themeBindings, { Instance = instance, Map = propMap })
end

function Axiom:SetTheme(newTheme)
    for k, v in pairs(newTheme) do self._theme[k] = v end
    for _, binding in ipairs(self._themeBindings) do
        if binding.Instance and binding.Instance.Parent then
            for prop, themeKey in pairs(binding.Map) do
                if self._theme[themeKey] then
                    pcall(function() binding.Instance[prop] = self._theme[themeKey] end)
                end
            end
        end
    end
    -- Update main window titlebar and body
    if self._titleBar then
        local isActive = (Axiom._WindowManager.ActiveWindow == self)
        self._titleBar.BackgroundColor3 = isActive and (self._theme.TitleBgActive or self._theme.TitleBg) or self._theme.TitleBg
    end
    if self._body then self._body.BackgroundColor3 = self._theme.WindowBg end
    if self._tabContainer then self._tabContainer.BackgroundColor3 = self._theme.TabBarBg end
end

function Axiom:GetTheme()
    return self._theme
end

-- ── Scoped Disabled propagation on Window ─────────────────────────────────────
function Axiom:BeginDisabled(cond)
    if cond == nil then cond = true end
    if cond then self._disabledScopeCount = self._disabledScopeCount + 1 end
end

function Axiom:EndDisabled()
    if self._disabledScopeCount > 0 then
        self._disabledScopeCount = self._disabledScopeCount - 1
    end
end

function Axiom:IsDisabled()
    return self._disabledScopeCount > 0
end

-- ════════════════════════════════════════════════════════════════════════════
--  Tab Bar Layout
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:_applyTabLayout(layout)
    layout = layout or "top"
    if not VALID_TAB_LAYOUTS[layout] then
        warn("[Axiom] Unknown tab Layout '" .. tostring(layout) .. "', falling back to 'top'.")
        layout = "top"
    end
    self._tabLayoutMode = layout

    local tabContainer  = self._tabContainer
    local pageContainer = self._pageContainer
    local tabLayout     = self._tabListLayout
    local tabBarWidth   = self._tabBarWidth or 120

    if layout == "top" then
        tabContainer.Position  = UDim2.new(0, 0, 0, 0)
        tabContainer.Size      = UDim2.new(1, 0, 0, 26)
        pageContainer.Position = UDim2.new(0, 0, 0, 26)
        pageContainer.Size     = UDim2.new(1, 0, 1, -26)
        tabLayout.FillDirection     = Enum.FillDirection.Horizontal
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        if self._resizer then self._resizer.Position = UDim2.new(1, -12, 1, -12) end
    elseif layout == "bottom" then
        tabContainer.Position  = UDim2.new(0, 0, 1, -26)
        tabContainer.Size      = UDim2.new(1, 0, 0, 26)
        pageContainer.Position = UDim2.new(0, 0, 0, 0)
        pageContainer.Size     = UDim2.new(1, 0, 1, -26)
        tabLayout.FillDirection     = Enum.FillDirection.Horizontal
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        if self._resizer then self._resizer.Position = UDim2.new(1, -12, 1, -38) end
    elseif layout == "left" then
        tabContainer.Position  = UDim2.new(0, 0, 0, 0)
        tabContainer.Size      = UDim2.new(0, tabBarWidth, 1, 0)
        pageContainer.Position = UDim2.new(0, tabBarWidth, 0, 0)
        pageContainer.Size     = UDim2.new(1, -tabBarWidth, 1, 0)
        tabLayout.FillDirection     = Enum.FillDirection.Vertical
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Top
        if self._resizer then self._resizer.Position = UDim2.new(1, -12, 1, -12) end
    elseif layout == "right" then
        tabContainer.Position  = UDim2.new(1, -tabBarWidth, 0, 0)
        tabContainer.Size      = UDim2.new(0, tabBarWidth, 1, 0)
        pageContainer.Position = UDim2.new(0, 0, 0, 0)
        pageContainer.Size     = UDim2.new(1, -tabBarWidth, 1, 0)
        tabLayout.FillDirection     = Enum.FillDirection.Vertical
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Top
        if self._resizer then self._resizer.Position = UDim2.new(1, -(tabBarWidth + 12), 1, -12) end
    end

    for _, t in ipairs(self._tabs) do
        self:_sizeTab(t)
    end
end

function Axiom:_sizeTab(tab)
    local mode = self._tabLayoutMode or "top"

    tab.TextLabel.TextXAlignment = Enum.TextXAlignment.Center
    tab.TextLabel.TextTruncate   = Enum.TextTruncate.AtEnd
    tab.TextLabel.Position       = UDim2.new(0, 0, 0, 0)
    tab.TextLabel.Size           = UDim2.new(1, 0, 1, 0)

    if mode == "top" or mode == "bottom" then
        local txtSize = TextService:GetTextSize(
            tab.TextLabel.Text, 13, Enum.Font.RobotoMono, Vector2.new(999, 26)
        )
        local extra = tab.Icon and 56 or 24
        tab.Button.Size = UDim2.new(0, txtSize.X + extra, 1, 0)
    else
        tab.Button.Size = UDim2.new(1, 0, 0, 28)
    end
end

function Axiom:SetTabLayout(layout)
    self:_applyTabLayout(layout)
end

-- ════════════════════════════════════════════════════════════════════════════
--  Global Search
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:_registerSearch(frame, text)
    if not frame or not text then return end
    table.insert(self._searchRegistry, { Frame = frame, Text = tostring(text):lower() })
end

function Axiom:_applySearch(query)
    self._searchQuery = (query or ""):lower()
    local q = self._searchQuery
    for _, entry in ipairs(self._searchRegistry) do
        if entry.Frame and entry.Frame.Parent then
            if q == "" then
                entry.Frame.Visible = true
            else
                entry.Frame.Visible = entry.Text:find(q, 1, true) ~= nil
            end
        end
    end
end

function Axiom:EnableSearch(options)
    options = options or {}
    if self._searchBox then return self._searchBox end
    local theme = self._theme
    local titleBar = self._titleBar
    if not titleBar then return end
    local width = options.Width or 120

    local searchBox = Instance.new("TextBox")
    searchBox.Name               = "GlobalSearch"
    searchBox.BackgroundColor3   = theme.FrameBg
    searchBox.BorderSizePixel    = 0
    searchBox.Size               = UDim2.new(0, width, 0, 18)
    searchBox.Position           = UDim2.new(1, -(66 + 4 + width), 0.5, -9)
    searchBox.Font               = Enum.Font.RobotoMono
    searchBox.PlaceholderText    = options.Placeholder or "Search..."
    searchBox.PlaceholderColor3  = theme.SubText
    searchBox.Text               = ""
    searchBox.TextColor3         = theme.Text
    searchBox.TextSize           = 12
    searchBox.TextXAlignment     = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus   = false
    searchBox.Parent             = titleBar
    applyCorner(searchBox, 2)
    applyBorder(searchBox, theme.Border)

    if self._titleLbl then
        local reserve = width + 4 + 66 + 8
        self._titleLbl.Size = UDim2.new(1, -reserve, 1, 0)
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        self:_applySearch(searchBox.Text)
    end)

    self._searchBox = searchBox
    return searchBox
end

function Axiom:DisableSearch()
    if self._searchBox then
        self._searchBox:Destroy()
        self._searchBox = nil
    end
    self:_applySearch("")
end

-- ════════════════════════════════════════════════════════════════════════════
--  State Saving & Loading
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:_registerState(key, getFn, setFn)
    if not key then return end
    self._stateRegistry[key] = { get = getFn, set = setFn }
end

function Axiom:_autoStateKey(tabLabel, componentLabel)
    self._stateAutoCounter = self._stateAutoCounter + 1
    return string.format("%s::%s::%d", tostring(tabLabel), tostring(componentLabel), self._stateAutoCounter)
end

function Axiom:EnableStateSaving(options)
    options = options or {}
    if not writefile or not readfile then
        return
    end
    local folder   = options.Folder   or "Axiom"
    local filename = options.Filename or "state.json"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    self._stateFilePath = folder .. "/" .. filename
end

function Axiom:SaveState()
    if not self._stateFilePath or not writefile then return end
    local snapshot = {
        Position = {
            self._mainFrame.Position.X.Scale, self._mainFrame.Position.X.Offset,
            self._mainFrame.Position.Y.Scale, self._mainFrame.Position.Y.Offset,
        },
        Size = {
            self._mainFrame.Size.X.Scale, self._mainFrame.Size.X.Offset,
            self._mainFrame.Size.Y.Scale, self._mainFrame.Size.Y.Offset,
        },
        ActiveTab  = self._activeTabIndex,
        Components = {},
    }
    for key, entry in pairs(self._stateRegistry) do
        local ok, value = pcall(entry.get)
        if ok then snapshot.Components[key] = value end
    end
    local ok, json = pcall(function() return HttpService:JSONEncode(snapshot) end)
    if ok then pcall(writefile, self._stateFilePath, json) end
end

function Axiom:LoadState()
    if not self._stateFilePath or not readfile or not isfile then return end
    local exists = false
    pcall(function() exists = isfile(self._stateFilePath) end)
    if not exists then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(self._stateFilePath))
    end)
    if not ok or type(data) ~= "table" then return end

    if data.Position then self._mainFrame.Position = UDim2.new(unpack(data.Position)) end
    if data.Size     then self._mainFrame.Size     = UDim2.new(unpack(data.Size))     end

    for key, value in pairs(data.Components or {}) do
        local entry = self._stateRegistry[key]
        if entry then pcall(entry.set, value) end
    end

    if data.ActiveTab and self._tabs[data.ActiveTab] then
        self._tabs[data.ActiveTab].Button.MouseButton1Click:Fire()
    end
end

-- ════════════════════════════════════════════════════════════════════════════
--  Axiom:AddTab
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:AddTab(options)
    options = options or {}
    local name   = options.Name or "Tab"
    local iconId = options.Icon
    local theme  = self._theme

    if #self._tabs == 0 then
        if options.Layout and options.Layout ~= self._tabLayoutMode then
            self:_applyTabLayout(options.Layout)
        end
    end

    local tabBtn = Instance.new("TextButton")
    tabBtn.BackgroundColor3 = theme.TabNormal
    tabBtn.Size             = UDim2.new(0, 0, 1, 0)
    tabBtn.Font             = Enum.Font.RobotoMono
    tabBtn.Text             = ""
    tabBtn.TextColor3       = theme.TabNormalText
    tabBtn.TextSize         = 13
    tabBtn.LayoutOrder      = #self._tabs + 1
    tabBtn.Parent           = self._tabContainer
    applyBorder(tabBtn, theme.Border)

    local tabText = Instance.new("TextLabel")
    tabText.BackgroundTransparency = 1
    tabText.Font         = Enum.Font.RobotoMono
    tabText.Text         = name
    tabText.TextColor3   = theme.TabNormalText
    tabText.TextSize     = 13
    tabText.TextTruncate = Enum.TextTruncate.AtEnd
    tabText.TextXAlignment = Enum.TextXAlignment.Center
    tabText.Parent       = tabBtn

    local icon
    if iconId then
        icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Size     = UDim2.new(0, 18, 0, 18)
        icon.Position = UDim2.new(0, 4, 0.5, -9)
        icon.Image    = Axiom.ResolveIcon(iconId)
        icon.Parent   = tabBtn
    end

    local page = Instance.new("ScrollingFrame")
    page.BackgroundTransparency = 1
    page.Size                   = UDim2.new(1, 0, 1, 0)
    page.ScrollBarThickness     = 4
    page.ScrollBarImageColor3   = theme.Accent
    page.Visible                = false
    page.Parent                 = self._pageContainer
    applyPadding(page, 8)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding   = UDim.new(0, 6)
    layout.Parent    = page

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)

    local tabRecord = {Button = tabBtn, Page = page, TextLabel = tabText, Icon = icon}
    table.insert(self._tabs, tabRecord)
    self:_sizeTab(tabRecord)

    tabBtn.MouseButton1Click:Connect(function()
        for i, t in ipairs(self._tabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = theme.TabNormal
            t.TextLabel.TextColor3 = theme.TabNormalText
            if t.Button == tabBtn then self._activeTabIndex = i end
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = theme.TabActive
        tabText.TextColor3 = theme.TabActiveText
    end)

    if #self._tabs == 1 then
        page.Visible = true
        tabBtn.BackgroundColor3 = theme.TabActive
        tabText.TextColor3 = theme.TabActiveText
        self._activeTabIndex = 1
    end

    local tabObj = setmetatable({}, TabComponent)
    tabObj._page          = page
    tabObj._layoutOrder   = 0
    tabObj._window        = self
    tabObj._disabledStack = {}
    return tabObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  TabComponent Internals & Scoped Disabled Propagation
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:_nextOrder(isDivision)
    if not isDivision then
        self._divisionContainer = nil
    end
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

local function getTheme(tab)
    return tab._window and tab._window._theme or Axiom.DefaultTheme
end

function TabComponent:BeginDisabled(cond)
    if cond == nil then cond = true end
    table.insert(self._disabledStack, cond == true)
end

function TabComponent:EndDisabled()
    if #self._disabledStack > 0 then
        table.remove(self._disabledStack)
    end
end

function TabComponent:IsDisabled()
    if self._window and self._window:IsDisabled() then return true end
    for _, d in ipairs(self._disabledStack) do
        if d then return true end
    end
    return false
end

function TabComponent:_registerFocusable(widget)
    if self._window and self._window._focusableWidgets then
        table.insert(self._window._focusableWidgets, widget)
    end
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddSubTab
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddSubTab(options)
    options = options or {}
    local name   = options.Name or "SubTab"
    local iconId = options.Icon
    local theme  = getTheme(self)

    if not self._subTabContainer then
        local container = Instance.new("Frame")
        container.BackgroundTransparency = 1
        container.Size = UDim2.new(1, 0, 0, 26)
        container.LayoutOrder = self:_nextOrder()
        container.Parent = self._page
        self._subTabContainer = container

        local bar = Instance.new("Frame")
        bar.BackgroundColor3 = theme.TabBarBg
        bar.Size = UDim2.new(1, 0, 0, 24)
        bar.Parent = container
        applyBorder(bar, theme.Border)

        local barLayout = Instance.new("UIListLayout")
        barLayout.FillDirection = Enum.FillDirection.Horizontal
        barLayout.SortOrder = Enum.SortOrder.LayoutOrder
        barLayout.Parent = bar

        self._subTabBar       = bar
        self._subTabBarLayout = barLayout
        self._subTabs         = {}
    end

    local container = self._subTabContainer
    local bar       = self._subTabBar

    local subBtn = Instance.new("TextButton")
    subBtn.BackgroundColor3 = theme.TabNormal
    subBtn.Size = UDim2.new(0, 0, 1, 0)
    subBtn.Font = Enum.Font.RobotoMono
    subBtn.Text = ""
    subBtn.TextSize = 12
    subBtn.LayoutOrder = #self._subTabs + 1
    subBtn.Parent = bar
    applyBorder(subBtn, theme.Border)

    local subText = Instance.new("TextLabel")
    subText.BackgroundTransparency = 1
    subText.Font = Enum.Font.RobotoMono
    subText.Text = name
    subText.TextColor3 = theme.TabNormalText
    subText.TextSize = 12
    subText.TextXAlignment = Enum.TextXAlignment.Center
    subText.TextTruncate   = Enum.TextTruncate.AtEnd
    subText.Position       = UDim2.new(0, 0, 0, 0)
    subText.Size           = UDim2.new(1, 0, 1, 0)
    subText.Parent = subBtn

    local subIcon
    if iconId then
        subIcon = Instance.new("ImageLabel")
        subIcon.BackgroundTransparency = 1
        subIcon.Size = UDim2.new(0, 16, 0, 16)
        subIcon.Position = UDim2.new(0, 4, 0.5, -8)
        subIcon.Image = Axiom.ResolveIcon(iconId)
        subIcon.Parent = subBtn
    end

    local txtSize = TextService:GetTextSize(name, 12, Enum.Font.RobotoMono, Vector2.new(999, 24))
    local extra = subIcon and 56 or 24
    subBtn.Size = UDim2.new(0, txtSize.X + extra, 1, 0)

    local page = Instance.new("Frame")
    page.BackgroundTransparency = 1
    page.Position = UDim2.new(0, 0, 0, 26)
    page.Size = UDim2.new(1, 0, 0, 0)
    page.Visible = false
    page.Parent = container
    applyPadding(page, 6)

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout.Parent = page

    local function updateSizes()
        local h = pageLayout.AbsoluteContentSize.Y + 12
        page.Size = UDim2.new(1, 0, 0, h)
        if page.Visible then
            container.Size = UDim2.new(1, 0, 0, 26 + h)
        end
    end
    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSizes)

    table.insert(self._subTabs, {
        Button = subBtn, Page = page, TextLabel = subText, UpdateSize = updateSizes,
    })

    subBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(self._subTabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = theme.TabNormal
            t.TextLabel.TextColor3 = theme.TabNormalText
        end
        page.Visible = true
        subBtn.BackgroundColor3 = theme.TabActive
        subText.TextColor3 = theme.TabActiveText
        updateSizes()
    end)

    if #self._subTabs == 1 then
        page.Visible = true
        subBtn.BackgroundColor3 = theme.TabActive
        subText.TextColor3 = theme.TabActiveText
        task.defer(updateSizes)
    end

    local subTabObj = setmetatable({}, TabComponent)
    subTabObj._page          = page
    subTabObj._layoutOrder   = 0
    subTabObj._window        = self._window
    subTabObj._disabledStack = {}
    return subTabObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddDivision (Masonry Layout with Synchronous Height Tracking Fix)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddDivision(options)
    options = options or {}
    local theme = getTheme(self)
    local title = options.Title or "Division"

    local preset = options.Preset or self._divisionPreset or "Split"
    local columns = math.max(1, options.Columns or ({
        Split  = 2,
        Stack  = 1,
        Triple = 3,
        Quad   = 4,
    })[preset] or 2)

    local explicitColumns = options.Preset ~= nil or options.Columns ~= nil
    if not explicitColumns and self._divisionContainerColumns then
        columns = self._divisionContainerColumns
    end

    local COL_GAP = options.ColumnGap or 6

    if not self._divisionContainer or self._divisionContainerColumns ~= columns then
        local container = Instance.new("Frame")
        container.Name = "DivisionContainer"
        container.BackgroundTransparency = 1
        container.Size = UDim2.new(1, 0, 0, 0)
        container.LayoutOrder = self:_nextOrder(true)
        container.Parent = self._page

        local hLayout = Instance.new("UIListLayout")
        hLayout.FillDirection = Enum.FillDirection.Horizontal
        hLayout.SortOrder = Enum.SortOrder.LayoutOrder
        hLayout.Padding = UDim.new(0, COL_GAP)
        hLayout.Parent = container

        hLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.Size = UDim2.new(1, 0, 0, hLayout.AbsoluteContentSize.Y)
        end)

        local colOffset = -((columns - 1) * COL_GAP) / columns
        local colData = {}

        for i = 1, columns do
            local col = Instance.new("Frame")
            col.Name = "DivisionColumn" .. i
            col.BackgroundTransparency = 1
            col.Size = UDim2.new(1 / columns, colOffset, 0, 0)
            col.LayoutOrder = i
            col.Parent = container

            local vLayout = Instance.new("UIListLayout")
            vLayout.SortOrder = Enum.SortOrder.LayoutOrder
            vLayout.Padding = UDim.new(0, 6)
            vLayout.Parent = col

            vLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                col.Size = UDim2.new(1 / columns, colOffset, 0, vLayout.AbsoluteContentSize.Y)
            end)

            colData[i] = {
                Frame  = col,
                Layout = vLayout,
                Height = 0,
            }
        end

        self._divisionContainer        = container
        self._divisionContainerColumns = columns
        self._divisionColumns          = colData
    end

    -- Synchronous shortest-column selection:
    local shortestCol    = self._divisionColumns[1]
    local shortestHeight = shortestCol.Height

    for i = 2, #self._divisionColumns do
        local column = self._divisionColumns[i]
        if column.Height < shortestHeight then
            shortestCol    = column
            shortestHeight = column.Height
        end
    end

    local divisionFrame = Instance.new("Frame")
    divisionFrame.Name = "DivisionFrame"
    divisionFrame.BackgroundColor3 = theme.FrameBg
    divisionFrame.Size = UDim2.new(1, 0, 0, 24)
    divisionFrame.ClipsDescendants = true
    divisionFrame.Parent = shortestCol.Frame

    applyCorner(divisionFrame, 2)
    applyBorder(divisionFrame, theme.Border)

    local colGap = (shortestCol.Height > 0) and 6 or 0
    shortestCol.Height = shortestCol.Height + 24 + colGap

    local titleBar = Instance.new("Frame")
    titleBar.BackgroundColor3 = theme.TitleBg
    titleBar.Size = UDim2.new(1, 0, 0, 22)
    titleBar.Parent = divisionFrame
    applyCorner(titleBar, 2)

    local iconW = 0
    if options.Icon and options.Icon ~= "" then
        local id = Axiom.ResolveIcon(options.Icon)
        if id and id ~= "" then
            local icn = Instance.new("ImageLabel")
            icn.BackgroundTransparency = 1
            icn.AnchorPoint = Vector2.new(0, 0.5)
            icn.Position = UDim2.new(0, 6, 0.5, 0)
            icn.Size = UDim2.new(0, 14, 0, 14)
            icn.Image = id
            icn.Parent = titleBar
            iconW = 20
        end
    end

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.new(0, 6 + iconW, 0, 0)
    titleLabel.Size = UDim2.new(1, -(12 + iconW), 1, 0)
    titleLabel.Font = Enum.Font.RobotoMono
    titleLabel.Text = title
    titleLabel.TextColor3 = theme.Text
    titleLabel.TextSize = 12
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.RichText = true
    titleLabel.Parent = titleBar

    local content = Instance.new("ScrollingFrame")
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 0, 0, 22)
    content.Size = UDim2.new(1, 0, 0, 0)
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = theme.Accent
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.Parent = divisionFrame
    applyPadding(content, 4)

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.Parent = content

    local trackedFrameHeight = 24
    local function updateSize()
        local contentH = contentLayout.AbsoluteContentSize.Y + 8
        local newFH    = 24 + contentH
        local delta    = newFH - trackedFrameHeight
        trackedFrameHeight = newFH

        shortestCol.Height = shortestCol.Height + delta
        content.CanvasSize = UDim2.new(0, 0, 0, contentH)
        content.Size       = UDim2.new(1, 0, 0, contentH)
        divisionFrame.Size = UDim2.new(1, 0, 0, newFH)
    end

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSize)
    task.defer(updateSize)

    local dummyTab = {
        _page          = content,
        _window        = self._window,
        _layoutOrder   = 0,
        _disabledStack = {},
    }
    setmetatable(dummyTab, TabComponent)

    local division = {}
    setmetatable(division, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) == "function" then
                return function(_, ...)
                    local result = method(dummyTab, ...)
                    updateSize()
                    return result
                end
            end
            return method
        end
    })

    function division:GetContainer() return divisionFrame end
    function division:GetContent()   return content end
    function division:GetTitle()     return titleLabel.Text end
    function division:SetTitle(v)    titleLabel.Text = tostring(v) end
    function division:SetVisible(v)  divisionFrame.Visible = v end
    function division:IsVisible()    return divisionFrame.Visible end
    function division:Destroy()      divisionFrame:Destroy() end

    if self._window then self._window:_registerSearch(divisionFrame, title) end
    return division
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddChildWindow (ImGui::BeginChild / EndChild)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddChildWindow(options)
    options = options or {}
    local theme = getTheme(self)

    local title      = options.Title
    local size       = options.Size or UDim2.new(1, 0, 0, 160)
    local border     = options.Border ~= false
    local scrollable = options.Scrollable ~= false

    local container = Instance.new("Frame")
    container.Name = "ChildWindow_" .. (title or "Container")
    container.BackgroundColor3 = options.BackgroundColor or theme.ChildBg
    container.Size = size
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page
    applyCorner(container, 2)
    if border then applyBorder(container, theme.Border) end

    local headerH = 0
    if title and title ~= "" then
        headerH = 20
        local header = Instance.new("Frame")
        header.BackgroundColor3 = theme.Header or theme.TitleBg
        header.Size = UDim2.new(1, 0, 0, headerH)
        header.Parent = container

        local titleLbl = Instance.new("TextLabel")
        titleLbl.BackgroundTransparency = 1
        titleLbl.Position = UDim2.new(0, 6, 0, 0)
        titleLbl.Size = UDim2.new(1, -12, 1, 0)
        titleLbl.Font = Enum.Font.RobotoMono
        titleLbl.Text = title
        titleLbl.TextColor3 = theme.Text
        titleLbl.TextSize = 12
        titleLbl.TextXAlignment = Enum.TextXAlignment.Left
        titleLbl.Parent = header
    end

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.Position = UDim2.new(0, 0, 0, headerH)
    scroll.Size = UDim2.new(1, 0, 1, -headerH)
    scroll.ScrollBarThickness = scrollable and 4 or 0
    scroll.ScrollBarImageColor3 = theme.ScrollbarGrab
    scroll.ScrollingEnabled = scrollable
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Parent = container
    applyPadding(scroll, 6)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = scroll

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
    end)

    local childTab = {
        _page          = scroll,
        _window        = self._window,
        _layoutOrder   = 0,
        _disabledStack = {},
    }
    setmetatable(childTab, TabComponent)

    local childObj = {}
    setmetatable(childObj, {
        __index = function(_, methodName)
            local method = childTab[methodName]
            if type(method) == "function" then
                return function(_, ...) return method(childTab, ...) end
            end
            return method
        end
    })

    function childObj:GetContainer() return container end
    function childObj:SetSize(s) container.Size = s end
    function childObj:SetVisible(v) container.Visible = v end
    function childObj:Destroy() container:Destroy() end

    return childObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddSplitter (Draggable Resizable Divider between Dual Panes)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddSplitter(options)
    options = options or {}
    local theme = getTheme(self)

    local direction  = options.Direction or "Horizontal" -- Horizontal splits Left/Right, Vertical splits Top/Bottom
    local totalH     = options.Height or 200
    local splitRatio = math.clamp(options.Ratio or 0.5, options.MinRatio or 0.15, options.MaxRatio or 0.85)
    local minRatio   = options.MinRatio or 0.15
    local maxRatio   = options.MaxRatio or 0.85

    local container = Instance.new("Frame")
    container.Name = "SplitterContainer"
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, totalH)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page
    applyBorder(container, theme.Border)

    local pane1 = Instance.new("ScrollingFrame")
    pane1.Name = "Pane1"
    pane1.BackgroundColor3 = theme.ChildBg
    pane1.BorderSizePixel = 0
    pane1.ScrollBarThickness = 3
    pane1.ScrollBarImageColor3 = theme.ScrollbarGrab
    pane1.Parent = container
    applyPadding(pane1, 6)

    local pane1Layout = Instance.new("UIListLayout")
    pane1Layout.SortOrder = Enum.SortOrder.LayoutOrder
    pane1Layout.Padding = UDim.new(0, 4)
    pane1Layout.Parent = pane1
    pane1Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        pane1.CanvasSize = UDim2.new(0, 0, 0, pane1Layout.AbsoluteContentSize.Y + 12)
    end)

    local splitterBar = Instance.new("TextButton")
    splitterBar.Name = "SplitterBar"
    splitterBar.BackgroundColor3 = theme.Separator
    splitterBar.BorderSizePixel = 0
    splitterBar.Text = ""
    splitterBar.Parent = container

    local pane2 = Instance.new("ScrollingFrame")
    pane2.Name = "Pane2"
    pane2.BackgroundColor3 = theme.ChildBg
    pane2.BorderSizePixel = 0
    pane2.ScrollBarThickness = 3
    pane2.ScrollBarImageColor3 = theme.ScrollbarGrab
    pane2.Parent = container
    applyPadding(pane2, 6)

    local pane2Layout = Instance.new("UIListLayout")
    pane2Layout.SortOrder = Enum.SortOrder.LayoutOrder
    pane2Layout.Padding = UDim.new(0, 4)
    pane2Layout.Parent = pane2
    pane2Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        pane2.CanvasSize = UDim2.new(0, 0, 0, pane2Layout.AbsoluteContentSize.Y + 12)
    end)

    local BAR_THICKNESS = 6
    local function applySplit()
        if direction == "Horizontal" then
            pane1.Position = UDim2.new(0, 0, 0, 0)
            pane1.Size     = UDim2.new(splitRatio, -BAR_THICKNESS / 2, 1, 0)

            splitterBar.Position = UDim2.new(splitRatio, -BAR_THICKNESS / 2, 0, 0)
            splitterBar.Size     = UDim2.new(0, BAR_THICKNESS, 1, 0)

            pane2.Position = UDim2.new(splitRatio, BAR_THICKNESS / 2, 0, 0)
            pane2.Size     = UDim2.new(1 - splitRatio, -BAR_THICKNESS / 2, 1, 0)
        else
            pane1.Position = UDim2.new(0, 0, 0, 0)
            pane1.Size     = UDim2.new(1, 0, splitRatio, -BAR_THICKNESS / 2)

            splitterBar.Position = UDim2.new(0, 0, splitRatio, -BAR_THICKNESS / 2)
            splitterBar.Size     = UDim2.new(1, 0, 0, BAR_THICKNESS)

            pane2.Position = UDim2.new(0, 0, splitRatio, BAR_THICKNESS / 2)
            pane2.Size     = UDim2.new(1, 0, 1 - splitRatio, -BAR_THICKNESS / 2)
        end
    end
    applySplit()

    splitterBar.MouseEnter:Connect(function()
        splitterBar.BackgroundColor3 = theme.SeparatorHover or theme.Accent
    end)
    splitterBar.MouseLeave:Connect(function()
        splitterBar.BackgroundColor3 = theme.Separator
    end)

    local dragging = false
    splitterBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            splitterBar.BackgroundColor3 = theme.SeparatorActive or theme.AccentActive
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            splitterBar.BackgroundColor3 = theme.Separator
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local rel
            if direction == "Horizontal" then
                rel = (input.Position.X - container.AbsolutePosition.X) / container.AbsoluteSize.X
            else
                rel = (input.Position.Y - container.AbsolutePosition.Y) / container.AbsoluteSize.Y
            end
            splitRatio = math.clamp(rel, minRatio, maxRatio)
            applySplit()
        end
    end)

    local tab1 = setmetatable({ _page = pane1, _window = self._window, _layoutOrder = 0, _disabledStack = {} }, TabComponent)
    local tab2 = setmetatable({ _page = pane2, _window = self._window, _layoutOrder = 0, _disabledStack = {} }, TabComponent)

    local splitObj = {
        Container = container,
        LeftPane  = tab1,
        RightPane = tab2,
        TopPane   = tab1,
        BottomPane= tab2,
    }
    function splitObj:SetRatio(r)
        splitRatio = math.clamp(r, minRatio, maxRatio)
        applySplit()
    end
    function splitObj:GetRatio() return splitRatio end
    function splitObj:Destroy() container:Destroy() end

    return splitObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddTreeNode (Hierarchical Trees with Leaf support)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddTreeNode(options)
    options = options or {}
    local theme = getTheme(self)

    local text        = options.Text or "Node"
    local isLeaf      = options.IsLeaf or false
    local defaultOpen = options.DefaultOpen or false
    local callback    = options.Callback
    local isOpen      = defaultOpen and not isLeaf

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 22)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local headerBtn = Instance.new("TextButton")
    headerBtn.BackgroundColor3 = theme.Header or theme.FrameBg
    headerBtn.BackgroundTransparency = 0.5
    headerBtn.Size = UDim2.new(1, 0, 0, 22)
    headerBtn.Font = Enum.Font.RobotoMono
    headerBtn.Text = ""
    headerBtn.Parent = container
    applyCorner(headerBtn, 2)

    local glyph = Instance.new("TextLabel")
    glyph.BackgroundTransparency = 1
    glyph.Size = UDim2.new(0, 16, 1, 0)
    glyph.Position = UDim2.new(0, 4, 0, 0)
    glyph.Font = Enum.Font.RobotoMono
    glyph.Text = isLeaf and "•" or (isOpen and "▼" or "▶")
    glyph.TextColor3 = isLeaf and theme.SubText or theme.Accent
    glyph.TextSize = 12
    glyph.Parent = headerBtn

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -24, 1, 0)
    lbl.Position = UDim2.new(0, 22, 0, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = headerBtn

    local content
    local contentLayout
    if not isLeaf then
        content = Instance.new("Frame")
        content.BackgroundTransparency = 1
        content.Position = UDim2.new(0, 12, 0, 22)
        content.Size = UDim2.new(1, -12, 0, 0)
        content.ClipsDescendants = true
        content.Visible = isOpen
        content.Parent = container

        contentLayout = Instance.new("UIListLayout")
        contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        contentLayout.Padding = UDim.new(0, 2)
        contentLayout.Parent = content

        local function syncHeight()
            if isOpen then
                local h = contentLayout.AbsoluteContentSize.Y + 2
                content.Size = UDim2.new(1, -12, 0, h)
                container.Size = UDim2.new(1, 0, 0, 22 + h)
            else
                content.Size = UDim2.new(1, -12, 0, 0)
                container.Size = UDim2.new(1, 0, 0, 22)
            end
        end
        contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(syncHeight)
        if isOpen then task.defer(syncHeight) end
    end

    headerBtn.MouseEnter:Connect(function()
        headerBtn.BackgroundTransparency = 0.2
    end)
    headerBtn.MouseLeave:Connect(function()
        headerBtn.BackgroundTransparency = 0.5
    end)

    headerBtn.MouseButton1Click:Connect(function()
        if isLeaf then
            safeCall(callback, text)
        else
            isOpen = not isOpen
            glyph.Text = isOpen and "▼" or "▶"
            content.Visible = isOpen
            if isOpen then
                local h = contentLayout.AbsoluteContentSize.Y + 2
                content.Size = UDim2.new(1, -12, 0, h)
                container.Size = UDim2.new(1, 0, 0, 22 + h)
            else
                content.Size = UDim2.new(1, -12, 0, 0)
                container.Size = UDim2.new(1, 0, 0, 22)
            end
            safeCall(callback, isOpen)
        end
    end)

    local dummyTab = {
        _page          = content or container,
        _window        = self._window,
        _layoutOrder   = 0,
        _disabledStack = {},
    }
    setmetatable(dummyTab, TabComponent)

    local nodeObj = {}
    setmetatable(nodeObj, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) == "function" then
                return function(_, ...) return method(dummyTab, ...) end
            end
            return method
        end
    })

    function nodeObj:SetText(t) lbl.Text = tostring(t) end
    function nodeObj:GetText() return lbl.Text end
    function nodeObj:IsOpen() return isOpen end
    function nodeObj:Destroy() container:Destroy() end

    return nodeObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddCollapsible (Collapsing Header)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddCollapsible(options)
    options = options or {}
    local theme = getTheme(self)

    local title = options.Title or "Section"
    local isOpen = options.DefaultOpen ~= false
    local currentEnabled = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 26)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local headerBtn = Instance.new("TextButton")
    headerBtn.BackgroundColor3 = theme.Header or theme.FrameBg
    headerBtn.Size = UDim2.new(1, 0, 0, 24)
    headerBtn.Font = Enum.Font.RobotoMono
    headerBtn.Text = (isOpen and " ▼ " or " ▶ ") .. title
    headerBtn.TextColor3 = theme.Text
    headerBtn.TextSize = 13
    headerBtn.TextXAlignment = Enum.TextXAlignment.Left
    headerBtn.Parent = container
    applyCorner(headerBtn, 2)
    applyBorder(headerBtn, theme.Border)

    headerBtn.MouseEnter:Connect(function()
        if currentEnabled then headerBtn.BackgroundColor3 = theme.HeaderHover or theme.FrameBgHover end
    end)
    headerBtn.MouseLeave:Connect(function()
        headerBtn.BackgroundColor3 = theme.Header or theme.FrameBg
    end)

    local content = Instance.new("Frame")
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 0, 0, 26)
    content.Size = UDim2.new(1, 0, 0, 0)
    content.ClipsDescendants = true
    content.Visible = isOpen
    content.Parent = container
    applyPadding(content, 4)

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.Parent = content

    local function updateSize(instant)
        local contentHeight = contentLayout.AbsoluteContentSize.Y + 8
        local targetContainerSize = isOpen and UDim2.new(1, 0, 0, 26 + contentHeight) or UDim2.new(1, 0, 0, 26)
        local targetContentSize   = isOpen and UDim2.new(1, 0, 0, contentHeight) or UDim2.new(1, 0, 0, 0)
        content.Visible = isOpen
        if instant then
            container.Size = targetContainerSize
            content.Size   = targetContentSize
        else
            TweenService:Create(container, TWEEN_MID, {Size = targetContainerSize}):Play()
            TweenService:Create(content, TWEEN_MID, {Size = targetContentSize}):Play()
        end
    end

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() updateSize(false) end)
    updateSize(true)

    headerBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        headerBtn.Text = (isOpen and " ▼ " or " ▶ ") .. title
        updateSize(false)
    end)

    local dummyTab = {
        _page          = content,
        _window        = self._window,
        _layoutOrder   = 0,
        _disabledStack = {},
    }
    setmetatable(dummyTab, TabComponent)

    local collapsible = {}
    setmetatable(collapsible, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) == "function" then
                return function(_, ...) return method(dummyTab, ...) end
            end
            return method
        end
    })

    function collapsible:Expand()
        if not isOpen and currentEnabled then headerBtn.MouseButton1Click:Fire() end
    end
    function collapsible:Collapse()
        if isOpen and currentEnabled then headerBtn.MouseButton1Click:Fire() end
    end
    function collapsible:Toggle()
        if currentEnabled then headerBtn.MouseButton1Click:Fire() end
    end
    function collapsible:SetEnabled(state)
        currentEnabled = state
        headerBtn.Active = state
        headerBtn.BackgroundColor3 = state and (theme.Header or theme.FrameBg) or disabledColor(theme.Header or theme.FrameBg)
        headerBtn.TextColor3 = state and theme.Text or disabledColor(theme.Text)
    end
    function collapsible:IsEnabled() return currentEnabled end
    function collapsible:Destroy() container:Destroy() end

    if self._window then self._window:_registerSearch(headerBtn, title) end
    return collapsible
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddLayout (Horizontal, Vertical, Grid, Absolute)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddLayout(options)
    options = options or {}
    local theme = getTheme(self)

    local style   = options.Style or "Vertical"
    local padding = options.Padding or 4

    local container = Instance.new("Frame")
    container.Name = "Layout_" .. style
    container.BackgroundColor3 = options.BackgroundColor or theme.FrameBg
    container.BackgroundTransparency = options.BackgroundTransparency or 1
    container.BorderSizePixel = 0
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = false
    container.Parent = self._page

    if style == "Horizontal" then
        container.Size = options.Size or UDim2.new(1, 0, 0, 26)
    elseif style == "Grid" then
        container.Size = options.Size or UDim2.new(1, 0, 0, 100)
    elseif style == "Absolute" then
        container.Size = options.Size or UDim2.new(1, 0, 0, 200)
    else
        container.Size = options.Size or UDim2.new(1, 0, 0, 0)
    end
    container.Position = options.Position or UDim2.new(0, 0, 0, 0)

    applyCorner(container, 2)
    applyBorder(container, theme.Border)

    local layout
    if style == "Vertical" then
        layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, padding)
        layout.Parent = container
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, 0, layout.AbsoluteContentSize.Y + padding * 2)
        end)
    elseif style == "Horizontal" then
        layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, padding)
        layout.Parent = container
    elseif style == "Grid" then
        layout = Instance.new("UIGridLayout")
        layout.CellSize = options.CellSize or UDim2.new(0, 100, 0, 30)
        layout.CellPadding = options.CellPadding or UDim2.new(0, 5, 0, 5)
        layout.FillDirectionMaxCells = options.Columns or 2
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = container
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, 0, layout.AbsoluteContentSize.Y + padding * 2)
        end)
    end

    local dummyTab = {
        _page          = container,
        _window        = self._window,
        _layoutOrder   = 0,
        _disabledStack = {},
    }
    setmetatable(dummyTab, TabComponent)

    local layoutObj = {}
    setmetatable(layoutObj, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) ~= "function" then return method end

            return function(_, ...)
                local args = { ... }

                if style == "Horizontal" then
                    local opts = args[#args]
                    if type(opts) ~= "table" then
                        opts = {}
                        args[#args + 1] = opts
                    end
                    local size     = opts.Size or UDim2.new(0, 100, 1, 0)
                    local position = opts.Position
                    local anchor   = opts.AnchorPoint
                    opts.Size, opts.Position, opts.AnchorPoint = nil, nil, nil

                    local wrapper = Instance.new("Frame")
                    wrapper.BackgroundTransparency = 1
                    wrapper.Size = size
                    wrapper.Position = position or UDim2.new(0, 0, 0, 0)
                    wrapper.AnchorPoint = anchor or Vector2.new(0, 0)
                    wrapper.Parent = container

                    local originalPage = dummyTab._page
                    dummyTab._page = wrapper
                    local comp = method(dummyTab, table.unpack(args))
                    dummyTab._page = originalPage

                    if comp and comp.GetInstance then
                        local inst = comp:GetInstance()
                        if inst then
                            inst.AnchorPoint = Vector2.new(0, 0)
                            inst.Position = UDim2.new(0, 0, 0, 0)
                            inst.Size = UDim2.new(1, 0, 1, 0)
                        end
                    end

                    wrapper.LayoutOrder = dummyTab._layoutOrder
                    dummyTab._layoutOrder = dummyTab._layoutOrder + 1
                    return comp
                end

                return method(dummyTab, table.unpack(args))
            end
        end
    })

    function layoutObj:GetContainer() return container end
    function layoutObj:SetSize(size) container.Size = size end
    function layoutObj:SetPosition(pos) container.Position = pos end
    function layoutObj:Destroy() container:Destroy() end

    return layoutObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddButton (with Active/Pressed State, Focus Ring, Drag&Drop)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddButton(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Button"
    local callback = options.Callback
    local iconId   = options.Icon
    local tooltip  = options.Tooltip
    local tooltipDelay = options.TooltipDelay or 0.4

    local baseColor   = options.Color or theme.Button or theme.FrameBg
    local hoverColor  = options.Color and lightenColor(options.Color, 0.12) or (theme.ButtonHover or theme.FrameBgHover)
    local activeColor = options.Color and lightenColor(options.Color, 0.25) or (theme.ButtonActive or theme.AccentActive)

    if options.Color then warnCustomColor(self, "Button") end

    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()
    if options.Enabled ~= nil then currentEnabled = options.Enabled and not self:IsDisabled() end

    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = currentEnabled and baseColor or disabledColor(baseColor)
    btn.Size = options.Size or UDim2.new(1, 0, 0, 24)
    btn.LayoutOrder = self:_nextOrder()
    btn.Font = Enum.Font.RobotoMono
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Active = currentEnabled
    btn.Parent = self._page
    applyCorner(btn, 2)
    applyBorder(btn, theme.Border)

    local icon
    if iconId then
        icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Size = UDim2.new(0, 18, 0, 18)
        icon.Position = UDim2.new(0, 4, 0.5, -9)
        icon.Image = Axiom.ResolveIcon(iconId)
        icon.Parent = btn
    end

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = icon and UDim2.new(0, 26, 0, 0) or UDim2.new(0, 4, 0, 0)
    lbl.Size = UDim2.new(1, (icon and -30 or -8), 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = currentEnabled and theme.Text or disabledColor(theme.Text)
    lbl.TextSize = 13
    lbl.TextXAlignment = options.TextAlignment or Enum.TextXAlignment.Left
    lbl.RichText = true
    lbl.Parent = btn

    local isHovered = false
    local isPressed = false

    btn.MouseEnter:Connect(function()
        if not currentEnabled then return end
        isHovered = true
        if not isPressed then
            btn.BackgroundColor3 = hoverColor
        end
    end)
    btn.MouseLeave:Connect(function()
        isHovered = false
        if not isPressed then
            btn.BackgroundColor3 = baseColor
        end
    end)

    -- ImGuiCol_ButtonActive: distinct pressed state
    btn.InputBegan:Connect(function(input)
        if not currentEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isPressed = true
            btn.BackgroundColor3 = activeColor
            Axiom._FocusManager:SetFocus(btn)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isPressed then
                isPressed = false
                if currentEnabled then
                    btn.BackgroundColor3 = isHovered and hoverColor or baseColor
                end
            end
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        safeCall(currentCallback)
    end)

    if tooltip then attachTooltip(btn, tooltip, self._window, tooltipDelay) end
    if self._window then self._window:_registerSearch(btn, text) end

    local obj = { _instance = btn, _window = self._window }
    function obj:GetText() return lbl.Text end
    function obj:SetText(t) lbl.Text = tostring(t) end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetIcon(id)
        if not icon then
            icon = Instance.new("ImageLabel")
            icon.BackgroundTransparency = 1
            icon.Size = UDim2.new(0, 18, 0, 18)
            icon.Position = UDim2.new(0, 4, 0.5, -9)
            icon.Parent = btn
            lbl.Position = UDim2.new(0, 26, 0, 0)
            lbl.Size = UDim2.new(1, -30, 1, 0)
        end
        icon.Image = Axiom.ResolveIcon(id)
    end
    function obj:SetEnabled(state)
        currentEnabled = state and not self._window:IsDisabled()
        btn.Active = currentEnabled
        btn.BackgroundColor3 = currentEnabled and baseColor or disabledColor(baseColor)
        lbl.TextColor3 = currentEnabled and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:IsHovered() return isHovered end
    function obj:IsActive() return isPressed end
    function obj:Destroy() btn:Destroy() end
    function obj:GetInstance() return btn end

    -- Keyboard activation:
    function obj:_onKeyboardActivate()
        if not currentEnabled then return end
        TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = activeColor }):Play()
        task.delay(0.12, function()
            TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = baseColor }):Play()
        end)
        safeCall(currentCallback)
    end

    -- Drag & Drop integration:
    function obj:SetDragSource(dragOpts)
        dragOpts = dragOpts or {}
        local payload  = dragOpts.Payload or text
        local dragType = dragOpts.Type or "Default"
        local tipText  = dragOpts.Tooltip or ("Dragging: " .. text)

        ensureDragGhost()
        local pressing = false
        local startPos = Vector2.zero

        btn.InputBegan:Connect(function(input)
            if not currentEnabled then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                pressing = true
                startPos = input.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if pressing and input.UserInputType == Enum.UserInputType.MouseMovement then
                local dist = (Vector2.new(input.Position.X, input.Position.Y) - Vector2.new(startPos.X, startPos.Y)).Magnitude
                if dist > 6 and not Axiom._DragDrop.Dragging then
                    Axiom._DragDrop.Dragging = true
                    Axiom._DragDrop.Payload = payload
                    Axiom._DragDrop.DragType = dragType
                    Axiom._DragDrop.ActiveSource = obj
                    Axiom._DragDrop.GhostLabel.Text = tipText
                    Axiom._DragDrop.GhostFrame.Visible = true
                end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                pressing = false
                if Axiom._DragDrop.Dragging and Axiom._DragDrop.ActiveSource == obj then
                    if Axiom._DragDrop.CurrentTarget and Axiom._DragDrop.CurrentTarget._onDrop then
                        Axiom._DragDrop.CurrentTarget._onDrop(Axiom._DragDrop.Payload, obj)
                    end
                    Axiom._DragDrop.Dragging = false
                    Axiom._DragDrop.ActiveSource = nil
                    Axiom._DragDrop.Payload = nil
                    Axiom._DragDrop.DragType = nil
                    Axiom._DragDrop.GhostFrame.Visible = false
                end
            end
        end)
    end

    function obj:SetDragTarget(targetOpts)
        targetOpts = targetOpts or {}
        local accepts  = targetOpts.Accepts or {}
        local onDrop   = targetOpts.OnDrop
        local acceptSet = {}
        for _, t in ipairs(accepts) do acceptSet[t] = true end

        btn.MouseEnter:Connect(function()
            if Axiom._DragDrop.Dragging and (acceptSet[Axiom._DragDrop.DragType] or #accepts == 0) then
                Axiom._DragDrop.CurrentTarget = { _onDrop = onDrop }
                btn.BackgroundColor3 = theme.Accent
            end
        end)
        btn.MouseLeave:Connect(function()
            if Axiom._DragDrop.CurrentTarget and Axiom._DragDrop.CurrentTarget._onDrop == onDrop then
                Axiom._DragDrop.CurrentTarget = nil
            end
            if not isPressed then btn.BackgroundColor3 = isHovered and hoverColor or baseColor end
        end)
    end

    self:_registerFocusable(obj)
    return obj
end

