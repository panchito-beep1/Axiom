--  AddKeybindPicker
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddKeybindPicker(options)
    options = options or {}
    local theme = getTheme(self)

    local text          = options.Text or "Keybind"
    local defaultKey    = options.Default or "Unbound"
    local callback      = options.Callback
    local toggleMode    = options.Toggle or false
    local allowCombos   = options.AllowCombos ~= false
    local currentState  = options.DefaultState or false
    local tooltip       = options.Tooltip

    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()

    local modifierShort = {
        LeftShift = "Shift", RightShift = "Shift",
        LeftControl = "Ctrl", RightControl = "Ctrl",
        LeftAlt = "Alt", RightAlt = "Alt",
    }

    local function parseKeySpec(spec)
        if not spec then return {"Unbound"} end
        if typeof(spec) == "EnumItem" then return { spec.Name } end
        if type(spec) == "table" then
            local t = {}
            for _, v in ipairs(spec) do
                if typeof(v) == "EnumItem" then table.insert(t, v.Name) else table.insert(t, tostring(v)) end
            end
            return #t > 0 and t or {"Unbound"}
        end
        if type(spec) == "string" then
            local t = {}
            for part in spec:gmatch("[^+]+") do
                table.insert(t, (part:gsub("^%s+", ""):gsub("%s+$", "")))
            end
            return #t > 0 and t or {"Unbound"}
        end
        return {"Unbound"}
    end

    local currentCombo = parseKeySpec(defaultKey)
    local isWaiting    = false
    local pressConnection, bindConnection

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0, TextService:GetTextSize(text, 13, Enum.Font.RobotoMono, Vector2.new(999, 24)).X + 6, 1, 0)
    label.Font = Enum.Font.RobotoMono
    label.Text = text
    label.TextColor3 = theme.Text
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local keyDisplay = Instance.new("TextLabel")
    keyDisplay.BackgroundColor3 = theme.FrameBg
    keyDisplay.Position = UDim2.new(0, label.Size.X.Offset + 6, 0, 0)
    keyDisplay.Size = UDim2.new(1, -(label.Size.X.Offset + 6 + 48), 1, 0)
    keyDisplay.Font = Enum.Font.RobotoMono
    keyDisplay.TextSize = 12
    keyDisplay.TextXAlignment = Enum.TextXAlignment.Center
    keyDisplay.Parent = container
    applyCorner(keyDisplay, 2)
    applyBorder(keyDisplay, theme.Border)

    local bindBtn = Instance.new("TextButton")
    bindBtn.BackgroundColor3 = theme.Accent
    bindBtn.Position = UDim2.new(1, -44, 0, 0)
    bindBtn.Size = UDim2.new(0, 44, 1, 0)
    bindBtn.Font = Enum.Font.RobotoMono
    bindBtn.Text = "Bind"
    bindBtn.TextColor3 = theme.Text
    bindBtn.TextSize = 12
    bindBtn.Parent = container
    applyCorner(bindBtn, 2)
    applyBorder(bindBtn, theme.Border)

    local function updateDisplay()
        local display = table.concat(currentCombo, "+")
        if display == "Unbound" or display == "" then
            keyDisplay.Text = "Unbound"
            keyDisplay.TextColor3 = theme.SubText
        else
            if toggleMode then
                keyDisplay.Text = string.format("%s [%s]", display, currentState and "ON" or "OFF")
                keyDisplay.TextColor3 = currentState and theme.Accent or theme.Text
            else
                keyDisplay.Text = display
                keyDisplay.TextColor3 = theme.Text
            end
        end
    end
    updateDisplay()

    local function reconnectPressListener()
        if pressConnection then pressConnection:Disconnect(); pressConnection = nil end
        if currentCombo[1] == "Unbound" then return end
        pressConnection = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe or not currentEnabled then return end
            local mainKey = currentCombo[#currentCombo]
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == mainKey then
                if toggleMode then
                    currentState = not currentState
                    updateDisplay()
                    safeCall(currentCallback, table.concat(currentCombo, "+"), currentState)
                else
                    safeCall(currentCallback, table.concat(currentCombo, "+"))
                end
            end
        end)
    end
    reconnectPressListener()

    bindBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        if isWaiting then
            isWaiting = false
            bindBtn.Text = "Bind"
            updateDisplay()
            if bindConnection then bindConnection:Disconnect(); bindConnection = nil end
            return
        end
        isWaiting = true
        bindBtn.Text = "..."
        keyDisplay.Text = "Press a key..."
        keyDisplay.TextColor3 = theme.Accent

        bindConnection = UserInputService.InputBegan:Connect(function(input)
            if not isWaiting then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                isWaiting = false
                bindBtn.Text = "Bind"
                updateDisplay()
                if bindConnection then bindConnection:Disconnect(); bindConnection = nil end
                return
            end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentCombo = { input.KeyCode.Name }
                isWaiting = false
                bindBtn.Text = "Bind"
                updateDisplay()
                reconnectPressListener()
                if bindConnection then bindConnection:Disconnect(); bindConnection = nil end
                safeCall(currentCallback, table.concat(currentCombo, "+"))
            end
        end)
    end)

    if tooltip then attachTooltip(bindBtn, tooltip, self._window) end

    local obj = { _instance = container }
    function obj:GetKey() return table.concat(currentCombo, "+") end
    function obj:SetKey(k)
        currentCombo = parseKeySpec(k)
        updateDisplay()
        reconnectPressListener()
    end
    function obj:Destroy()
        if pressConnection then pressConnection:Disconnect() end
        if bindConnection then bindConnection:Disconnect() end
        container:Destroy()
    end
    return obj
end

