-- ── AddDivision (masonry multi-column) ────────────────────────────────────────
local COL_GAP = 6

function TabComponent:AddDivision(opts)
    opts = opts or {}
    local theme = self._theme
    local preset = opts.Preset or "Split"
    local numCols = opts.Columns or (
        preset == "Stack"  and 1 or
        preset == "Triple" and 3 or
        preset == "Quad"   and 4 or 2
    )

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 0)
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._frame
    self._divisionContainer = container

    local colWidthScale = 1 / numCols
    local cols = {}
    local colHeights = {}
    for c = 1, numCols do
        colHeights[c] = 0
        local col = Instance.new("Frame")
        col.BackgroundTransparency = 1
        col.Position = UDim2.new((c-1) * colWidthScale, (c-1) * COL_GAP, 0, 0)
        col.Size = UDim2.new(colWidthScale, -COL_GAP * (numCols-1) / numCols, 0, 0)
        col.AutomaticSize = Enum.AutomaticSize.Y
        col.Parent = container
        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 4)
        layout.Parent = col
        cols[c] = { frame = col, layout = layout, height = 0, order = 0 }
    end

    local function shortestCol()
        local best, bestH = 1, math.huge
        for i, cd in ipairs(cols) do
            if cd.height < bestH then best = i; bestH = cd.height end
        end
        return best
    end

    local divObj = {}

    function divObj:AddColumn(colIndex)
        colIndex = colIndex or shortestCol()
        local cd = cols[colIndex]
        cd.order += 1
        local colTab = setmetatable({}, TabComponent)
        colTab._window = self._window or (divObj._window)
        colTab._frame  = cd.frame
        colTab._theme  = theme
        colTab._order  = cd.order * 100
        colTab._disabledStack = {}
        colTab._focusableWidgets = {}
        colTab._divisionContainer = nil
        function colTab:_nextOrder()
            self._order = self._order + 1
            self._divisionContainer = nil
            return self._order
        end
        colTab._filterContent = TabComponent._filterContent
        -- Track height
        cd.frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            cd.height = cd.frame.AbsoluteSize.Y
        end)
        return colTab
    end

    divObj._window = self._window

    -- Convenience: get next column tab (round-robin shortest)
    function divObj:Next()
        return self:AddColumn(shortestCol())
    end

    function divObj:GetContainer() return container end
    function divObj:Destroy() container:Destroy() end

    return divObj
end

