--  AddDropdown
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddDropdown(options, maybeItems, maybeDefault, maybeCallback)
    if type(options) == "string" then
        options = { Text = options, Items = maybeItems, Default = maybeDefault, Callback = maybeCallback }
    end
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Dropdown"
    local items    = options.Items or {}
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local selected = default or items[1]
    local isOpen   = false
    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("TextButton")
    header.BackgroundColor3 = options.Color or theme.FrameBg
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Text = ""
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local iconW = 0
    if options.Icon and options.Icon ~= "" then
        local id = Axiom.ResolveIcon(options.Icon)
        if id and id ~= "" then
            local icn = Instance.new("ImageLabel")
            icn.BackgroundTransparency = 1
            icn.AnchorPoint = Vector2.new(0, 0.5)
            icn.Position = UDim2.new(0, 6, 0.5, 0)
            icn.Size = UDim2.new(0, 14, 0, 14)
            icn.Image = id
            icn.Parent = header
            iconW = 22
        end
    end

    local headerLabel = Instance.new("TextLabel")
    headerLabel.BackgroundTransparency = 1
    headerLabel.Position = UDim2.new(0, 6 + iconW, 0, 0)
    headerLabel.Size = UDim2.new(1, -(24 + iconW), 1, 0)
    headerLabel.Font = Enum.Font.RobotoMono
    headerLabel.Text = string.format("%s: %s", text, tostring(selected or ""))
    headerLabel.TextColor3 = theme.Text
    headerLabel.TextSize = 13
    headerLabel.TextXAlignment = Enum.TextXAlignment.Left
    headerLabel.Parent = header

    local arrowLbl = Instance.new("TextLabel")
    arrowLbl.BackgroundTransparency = 1
    arrowLbl.Position = UDim2.new(1, -20, 0, 0)
    arrowLbl.Size = UDim2.new(0, 18, 1, 0)
    arrowLbl.Font = Enum.Font.RobotoMono
    arrowLbl.Text = "▼"
    arrowLbl.TextColor3 = theme.SubText
    arrowLbl.TextSize = 10
    arrowLbl.Parent = header

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.BackgroundColor3 = theme.TabNormal
    listFrame.Position = UDim2.new(0, 0, 0, 26)
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.ScrollBarThickness = 3
    listFrame.ScrollBarImageColor3 = theme.Accent
    listFrame.ClipsDescendants = true
    listFrame.Parent = container
    applyBorder(listFrame, theme.Border)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = listFrame

    local optionButtons = {}
    local function rebuildOptions()
        for _, b in ipairs(optionButtons) do b:Destroy() end
        table.clear(optionButtons)
        for i, optItem in ipairs(items) do
            local optBtn = Instance.new("TextButton")
            optBtn.BackgroundTransparency = 1
            optBtn.Size = UDim2.new(1, 0, 0, 22)
            optBtn.Font = Enum.Font.RobotoMono
            optBtn.Text = " " .. tostring(optItem)
            optBtn.TextColor3 = (optItem == selected) and theme.Accent or theme.TabNormalText
            optBtn.TextSize = 12
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.LayoutOrder = i
            optBtn.Parent = listFrame

            optBtn.MouseEnter:Connect(function() optBtn.TextColor3 = theme.Accent end)
            optBtn.MouseLeave:Connect(function() optBtn.TextColor3 = (optItem == selected) and theme.Accent or theme.TabNormalText end)
            optBtn.MouseButton1Click:Connect(function()
                if not currentEnabled then return end
                selected = optItem
                headerLabel.Text = string.format("%s: %s", text, tostring(selected))
                isOpen = false
                arrowLbl.Text = "▼"
                TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 24)}):Play()
                TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                safeCall(currentCallback, selected)
            end)
            table.insert(optionButtons, optBtn)
        end
        listFrame.CanvasSize = UDim2.new(0, 0, 0, #items * 22)
    end
    rebuildOptions()

    header.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        arrowLbl.Text = isOpen and "▲" or "▼"
        local itemH = math.min(#items * 22, 140)
        local targetHeight = isOpen and (26 + itemH) or 24
        listFrame.Size = isOpen and UDim2.new(1, 0, 0, itemH) or UDim2.new(1, 0, 0, 0)
        TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
    end)

    if tooltip then attachTooltip(header, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = { _instance = container }
    function obj:GetValue() return selected end
    function obj:SetValue(val)
        selected = val
        headerLabel.Text = string.format("%s: %s", text, tostring(selected))
        rebuildOptions()
        safeCall(currentCallback, selected)
    end
    function obj:AddItem(item) table.insert(items, item); rebuildOptions() end
    function obj:SetItems(newItems)
        items = newItems
        rebuildOptions()
    end
    function obj:Clear()
        items = {}
        selected = nil
        headerLabel.Text = string.format("%s: ", text)
        rebuildOptions()
        safeCall(currentCallback, nil)
    end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state and not self._window:IsDisabled()
        header.Active = currentEnabled
        header.BackgroundColor3 = currentEnabled and (options.Color or theme.FrameBg) or disabledColor(options.Color or theme.FrameBg)
        headerLabel.TextColor3 = currentEnabled and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    return obj
end

