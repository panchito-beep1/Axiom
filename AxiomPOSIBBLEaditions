--  Watermark
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:CreateWatermark(options)
    options = options or {}
    local theme = self._theme or Axiom.DefaultTheme
    local text = options.Text or "Axiom " .. V

    local wmGui = Instance.new("ScreenGui")
    wmGui.Name = "Axiom_Watermark"
    wmGui.ResetOnSpawn = false
    wmGui.DisplayOrder = 999
    wmGui.Parent = CoreGui

    local wmFrame = Instance.new("Frame")
    wmFrame.BackgroundColor3 = options.BackgroundColor or theme.TitleBg
    wmFrame.BackgroundTransparency = 0.3
    wmFrame.Position = options.Position or UDim2.new(0, 12, 0, 12)
    wmFrame.Size = UDim2.new(0, 0, 0, 24)
    wmFrame.Parent = wmGui
    applyCorner(wmFrame, 2)
    applyBorder(wmFrame, theme.Border)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 12
    lbl.RichText = true
    lbl.Parent = wmFrame

    local function sync()
        local ts = TextService:GetTextSize(lbl.Text, 12, Enum.Font.RobotoMono, Vector2.new(999, 24))
        wmFrame.Size = UDim2.new(0, ts.X + 16, 0, 24)
        lbl.Size = UDim2.new(1, 0, 1, 0)
    end
    sync()
    makeDraggable(wmFrame, wmFrame)

    local wmObj = {}
    function wmObj:SetText(t) lbl.Text = tostring(t); sync() end
    function wmObj:Destroy() wmGui:Destroy() end
    return wmObj
end

