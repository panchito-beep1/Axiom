--  AddProgressBar
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddProgressBar(options)
    options = options or {}
    local theme = getTheme(self)

    local text      = options.Text or ""
    local default   = options.Default or 0
    local min       = options.Min or 0
    local max       = options.Max or 100
    local barHeight = options.Height or 20
    local fillColor = options.FillColor or theme.SliderFill
    local bgColor   = options.BackgroundColor or theme.SliderTrack
    local txtColor  = options.TextColor or theme.Text

    local value = math.clamp(default, min, max)

    local container = Instance.new("Frame")
    container.BackgroundColor3 = bgColor
    container.Size = UDim2.new(1, 0, 0, barHeight)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page
    applyCorner(container, 2)
    applyBorder(container, theme.Border)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = fillColor
    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.Parent = container
    applyCorner(fill, 2)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.TextColor3 = txtColor
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.RichText = true
    lbl.ZIndex = 2
    lbl.Parent = container

    local function refresh()
        local pct = (value - min) / (max - min) * 100
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        local prefix = (text ~= "") and (text .. ": ") or ""
        lbl.Text = string.format("%s%.1f%%", prefix, pct)
    end
    refresh()

    local obj = { _instance = container }
    function obj:GetValue() return value end
    function obj:SetValue(val)
        value = math.clamp(val, min, max)
        refresh()
    end
    function obj:SetPercent(pct) obj:SetValue(min + (max - min) * (pct / 100)) end
    function obj:Destroy() container:Destroy() end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddImage (Atlas & Sprite Sheet Cropping Support)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddImage(options)
    options = options or {}
    local theme = getTheme(self)

    local imageId   = Axiom.ResolveIcon(options.Image) or ""
    local rectOff   = options.ImageRectOffset or Vector2.zero
    local rectSz    = options.ImageRectSize   or Vector2.zero
    local scaleType = options.ScaleType or Enum.ScaleType.Fit

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = options.Size or UDim2.new(0, 100, 0, 100)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page
    applyCorner(container, options.CornerRadius or 2)
    if options.Border ~= false then applyBorder(container, theme.Border) end

    local imgLabel = Instance.new("ImageLabel")
    imgLabel.BackgroundTransparency = options.BackgroundTransparency or 1
    imgLabel.Size = UDim2.new(1, 0, 1, 0)
    imgLabel.Image = imageId
    imgLabel.ScaleType = scaleType
    if rectSz ~= Vector2.zero then
        imgLabel.ImageRectOffset = rectOff
        imgLabel.ImageRectSize   = rectSz
    end
    imgLabel.Parent = container
    applyCorner(imgLabel, options.CornerRadius or 2)

    if options.Tooltip then attachTooltip(imgLabel, options.Tooltip, self._window) end

    local obj = { _instance = container }
    function obj:SetImage(id)
        imgLabel.Image = Axiom.ResolveIcon(id) or id
    end
    function obj:SetRect(offset, sz)
        imgLabel.ImageRectOffset = offset
        imgLabel.ImageRectSize   = sz
    end
    function obj:GetImage() return imgLabel.Image end
    function obj:Destroy() container:Destroy() end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddDropdown & AddSearchableDropdown
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddDropdown(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Dropdown"
    local items    = options.Items or {}
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local selected = default or items[1]
    local isOpen   = false
    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("TextButton")
    header.BackgroundColor3 = options.Color or theme.FrameBg
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Text = ""
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local iconW = 0
    if options.Icon and options.Icon ~= "" then
        local id = Axiom.ResolveIcon(options.Icon)
        if id and id ~= "" then
            local icn = Instance.new("ImageLabel")
            icn.BackgroundTransparency = 1
            icn.AnchorPoint = Vector2.new(0, 0.5)
            icn.Position = UDim2.new(0, 6, 0.5, 0)
            icn.Size = UDim2.new(0, 14, 0, 14)
            icn.Image = id
            icn.Parent = header
            iconW = 22
        end
    end

    local headerLabel = Instance.new("TextLabel")
    headerLabel.BackgroundTransparency = 1
    headerLabel.Position = UDim2.new(0, 6 + iconW, 0, 0)
    headerLabel.Size = UDim2.new(1, -(24 + iconW), 1, 0)
    headerLabel.Font = Enum.Font.RobotoMono
    headerLabel.Text = string.format("%s: %s", text, tostring(selected or ""))
    headerLabel.TextColor3 = theme.Text
    headerLabel.TextSize = 13
    headerLabel.TextXAlignment = Enum.TextXAlignment.Left
    headerLabel.Parent = header

    local arrowLbl = Instance.new("TextLabel")
    arrowLbl.BackgroundTransparency = 1
    arrowLbl.Position = UDim2.new(1, -20, 0, 0)
    arrowLbl.Size = UDim2.new(0, 18, 1, 0)
    arrowLbl.Font = Enum.Font.RobotoMono
    arrowLbl.Text = "▼"
    arrowLbl.TextColor3 = theme.SubText
    arrowLbl.TextSize = 10
    arrowLbl.Parent = header

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.BackgroundColor3 = theme.TabNormal
    listFrame.Position = UDim2.new(0, 0, 0, 26)
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.ScrollBarThickness = 3
    listFrame.ScrollBarImageColor3 = theme.Accent
    listFrame.ClipsDescendants = true
    listFrame.Parent = container
    applyBorder(listFrame, theme.Border)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = listFrame

    local optionButtons = {}
    local function rebuildOptions()
        for _, b in ipairs(optionButtons) do b:Destroy() end
        table.clear(optionButtons)
        for i, optItem in ipairs(items) do
            local optBtn = Instance.new("TextButton")
            optBtn.BackgroundTransparency = 1
            optBtn.Size = UDim2.new(1, 0, 0, 22)
            optBtn.Font = Enum.Font.RobotoMono
            optBtn.Text = " " .. tostring(optItem)
            optBtn.TextColor3 = (optItem == selected) and theme.Accent or theme.TabNormalText
            optBtn.TextSize = 12
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.LayoutOrder = i
            optBtn.Parent = listFrame

            optBtn.MouseEnter:Connect(function() optBtn.TextColor3 = theme.Accent end)
            optBtn.MouseLeave:Connect(function() optBtn.TextColor3 = (optItem == selected) and theme.Accent or theme.TabNormalText end)
            optBtn.MouseButton1Click:Connect(function()
                if not currentEnabled then return end
                selected = optItem
                headerLabel.Text = string.format("%s: %s", text, tostring(selected))
                isOpen = false
                arrowLbl.Text = "▼"
                TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 24)}):Play()
                TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                safeCall(currentCallback, selected)
            end)
            table.insert(optionButtons, optBtn)
        end
        listFrame.CanvasSize = UDim2.new(0, 0, 0, #items * 22)
    end
    rebuildOptions()

    header.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        arrowLbl.Text = isOpen and "▲" or "▼"
        local itemH = math.min(#items * 22, 140)
        local targetHeight = isOpen and (26 + itemH) or 24
        listFrame.Size = isOpen and UDim2.new(1, 0, 0, itemH) or UDim2.new(1, 0, 0, 0)
        TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
    end)

    if tooltip then attachTooltip(header, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = { _instance = container }
    function obj:GetValue() return selected end
    function obj:SetValue(val)
        selected = val
        headerLabel.Text = string.format("%s: %s", text, tostring(selected))
        rebuildOptions()
        safeCall(currentCallback, selected)
    end
    function obj:SetItems(newItems)
        items = newItems
        rebuildOptions()
    end
    function obj:Destroy() container:Destroy() end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddCombo (ImGui-Style Header-Filter Combo Box)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddCombo(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Combo"
    local items    = options.Items or {}
    local default  = options.Default or items[1]
    local callback = options.Callback
    local selected = default
    local isOpen   = false
    local currentEnabled = not self:IsDisabled()

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("Frame")
    header.BackgroundColor3 = theme.FrameBg
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local filterBox = Instance.new("TextBox")
    filterBox.BackgroundTransparency = 1
    filterBox.Position = UDim2.new(0, 6, 0, 0)
    filterBox.Size = UDim2.new(1, -30, 1, 0)
    filterBox.Font = Enum.Font.RobotoMono
    filterBox.Text = tostring(selected or "")
    filterBox.PlaceholderText = text .. " (Type to filter...)"
    filterBox.PlaceholderColor3 = theme.SubText
    filterBox.TextColor3 = theme.Text
    filterBox.TextSize = 13
    filterBox.TextXAlignment = Enum.TextXAlignment.Left
    filterBox.ClearTextOnFocus = false
    filterBox.Parent = header

    local dropBtn = Instance.new("TextButton")
    dropBtn.BackgroundTransparency = 1
    dropBtn.Position = UDim2.new(1, -24, 0, 0)
    dropBtn.Size = UDim2.new(0, 24, 1, 0)
    dropBtn.Font = Enum.Font.RobotoMono
    dropBtn.Text = "▼"
    dropBtn.TextColor3 = theme.SubText
    dropBtn.TextSize = 10
    dropBtn.Parent = header

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.BackgroundColor3 = theme.PopupBg or theme.TabNormal
    listFrame.Position = UDim2.new(0, 0, 0, 26)
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.ScrollBarThickness = 3
    listFrame.ScrollBarImageColor3 = theme.Accent
    listFrame.Parent = container
    applyBorder(listFrame, theme.Border)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = listFrame

    local optionButtons = {}
    local function filterList()
        local q = filterBox.Text:lower()
        local visibleCount = 0
        for _, btn in ipairs(optionButtons) do
            local match = (q == "" or btn.Text:lower():find(q, 1, true) ~= nil)
            btn.Visible = match
            if match then visibleCount = visibleCount + 1 end
        end
        local listH = math.min(visibleCount * 22, 132)
        listFrame.CanvasSize = UDim2.new(0, 0, 0, visibleCount * 22)
        listFrame.Size = isOpen and UDim2.new(1, 0, 0, listH) or UDim2.new(1, 0, 0, 0)
        container.Size = isOpen and UDim2.new(1, 0, 0, 26 + listH) or UDim2.new(1, 0, 0, 24)
    end

    local function rebuildOptions()
        for _, b in ipairs(optionButtons) do b:Destroy() end
        table.clear(optionButtons)
        for i, it in ipairs(items) do
            local b = Instance.new("TextButton")
            b.BackgroundTransparency = 1
            b.Size = UDim2.new(1, 0, 0, 22)
            b.Font = Enum.Font.RobotoMono
            b.Text = " " .. tostring(it)
            b.TextColor3 = (it == selected) and theme.Accent or theme.Text
            b.TextSize = 12
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.LayoutOrder = i
            b.Parent = listFrame

            b.MouseEnter:Connect(function() b.TextColor3 = theme.Accent end)
            b.MouseLeave:Connect(function() b.TextColor3 = (it == selected) and theme.Accent or theme.Text end)
            b.MouseButton1Click:Connect(function()
                selected = it
                filterBox.Text = tostring(selected)
                isOpen = false
                dropBtn.Text = "▼"
                filterList()
                safeCall(callback, selected)
            end)
            table.insert(optionButtons, b)
        end
    end
    rebuildOptions()

    filterBox.Focused:Connect(function()
        if not currentEnabled then return end
        isOpen = true
        dropBtn.Text = "▲"
        filterList()
    end)
    filterBox:GetPropertyChangedSignal("Text"):Connect(function()
        if isOpen then filterList() end
    end)

    dropBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        dropBtn.Text = isOpen and "▲" or "▼"
        filterList()
    end)

    local obj = { _instance = container }
    function obj:GetValue() return selected end
    function obj:SetValue(val)
        selected = val
        filterBox.Text = tostring(selected)
        safeCall(callback, selected)
    end
    function obj:Destroy() container:Destroy() end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddColorPicker (SV Square + Hue Bar + Hex Input)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddColorPicker(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Color"
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local color = options.Default or Color3.new(1, 1, 1)
    local h, s, v = color:ToHSV()
    local isOpen = false
    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("TextButton")
    header.BackgroundColor3 = options.Color or theme.FrameBg
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Text = ""
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local headerLabel = Instance.new("TextLabel")
    headerLabel.BackgroundTransparency = 1
    headerLabel.Position = UDim2.new(0, 8, 0, 0)
    headerLabel.Size = UDim2.new(1, -40, 1, 0)
    headerLabel.Font = Enum.Font.RobotoMono
    headerLabel.Text = text
    headerLabel.TextColor3 = theme.Text
    headerLabel.TextSize = 13
    headerLabel.TextXAlignment = Enum.TextXAlignment.Left
    headerLabel.Parent = header

    local preview = Instance.new("Frame")
    preview.AnchorPoint = Vector2.new(1, 0.5)
    preview.Position = UDim2.new(1, -6, 0.5, 0)
    preview.Size = UDim2.new(0, 16, 0, 16)
    preview.BackgroundColor3 = color
    preview.Parent = header
    applyCorner(preview, 2)
    applyBorder(preview, theme.Border)

    local EXPAND_H = 172
    local expandFrame = Instance.new("Frame")
    expandFrame.BackgroundColor3 = theme.TabNormal
    expandFrame.Position = UDim2.new(0, 0, 0, 24)
    expandFrame.Size = UDim2.new(1, 0, 0, EXPAND_H)
    expandFrame.Parent = container
    applyBorder(expandFrame, theme.Border)

    header.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        local targetHeight = isOpen and (24 + EXPAND_H) or 24
        TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
    end)

    local svArea = Instance.new("Frame")
    svArea.Position = UDim2.new(0, 6, 0, 6)
    svArea.Size = UDim2.new(1, -12, 0, 105)
    svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    svArea.ClipsDescendants = true
    svArea.Parent = expandFrame
    applyCorner(svArea, 2)
    applyBorder(svArea, theme.Border)

    local whiteOverlay = Instance.new("Frame")
    whiteOverlay.Size = UDim2.new(1, 0, 1, 0)
    whiteOverlay.BackgroundColor3 = Color3.new(1, 1, 1)
    whiteOverlay.BorderSizePixel = 0
    whiteOverlay.Parent = svArea
    local whiteGrad = Instance.new("UIGradient")
    whiteGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})
    whiteGrad.Parent = whiteOverlay

    local blackOverlay = Instance.new("Frame")
    blackOverlay.Size = UDim2.new(1, 0, 1, 0)
    blackOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
    blackOverlay.BorderSizePixel = 0
    blackOverlay.Parent = svArea
    local blackGrad = Instance.new("UIGradient")
    blackGrad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})
    blackGrad.Rotation = 90
    blackGrad.Parent = blackOverlay

    local svHandle = Instance.new("Frame")
    svHandle.AnchorPoint = Vector2.new(0.5, 0.5)
    svHandle.Position = UDim2.new(s, 0, 1 - v, 0)
    svHandle.Size = UDim2.new(0, 8, 0, 8)
    svHandle.BackgroundColor3 = Color3.new(1, 1, 1)
    svHandle.Parent = svArea
    applyCorner(svHandle, 4)
    applyBorder(svHandle, Color3.new(0, 0, 0), 1.5)

    local hueBar = Instance.new("Frame")
    hueBar.Position = UDim2.new(0, 6, 0, 118)
    hueBar.Size = UDim2.new(1, -12, 0, 14)
    hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
    hueBar.ClipsDescendants = true
    hueBar.Parent = expandFrame
    applyCorner(hueBar, 2)
    applyBorder(hueBar, theme.Border)

    local hueGrad = Instance.new("UIGradient")
    hueGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
    })
    hueGrad.Parent = hueBar

    local hexBox = Instance.new("TextBox")
    hexBox.Position = UDim2.new(0, 6, 0, 138)
    hexBox.Size = UDim2.new(1, -12, 0, 24)
    hexBox.BackgroundColor3 = theme.FrameBg
    hexBox.Font = Enum.Font.RobotoMono
    hexBox.Text = string.format("#%02X%02X%02X", math.floor(color.R*255), math.floor(color.G*255), math.floor(color.B*255))
    hexBox.TextColor3 = theme.Text
    hexBox.TextSize = 12
    hexBox.Parent = expandFrame
    applyCorner(hexBox, 2)
    applyBorder(hexBox, theme.Border)

    local function refreshAll()
        local cur = Color3.fromHSV(h, s, v)
        svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svHandle.Position = UDim2.new(s, 0, 1 - v, 0)
        preview.BackgroundColor3 = cur
        hexBox.Text = string.format("#%02X%02X%02X", math.floor(cur.R*255), math.floor(cur.G*255), math.floor(cur.B*255))
        safeCall(currentCallback, cur)
    end

    local svDragging = false
    svArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if svDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            s = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / svArea.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / svArea.AbsoluteSize.Y, 0, 1)
            refreshAll()
        end
    end)

    local hueDragging = false
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if hueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            h = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
            refreshAll()
        end
    end)

    hexBox.FocusLost:Connect(function()
        local hex = hexBox.Text:gsub("#", "")
        if #hex == 6 then
            local r = tonumber(hex:sub(1, 2), 16) or 255
            local g = tonumber(hex:sub(3, 4), 16) or 255
            local b = tonumber(hex:sub(5, 6), 16) or 255
            local clr = Color3.fromRGB(r, g, b)
            h, s, v = clr:ToHSV()
            refreshAll()
        end
    end)

    local obj = { _instance = container }
    function obj:GetColor() return Color3.fromHSV(h, s, v) end
    function obj:SetColor(clr)
        h, s, v = clr:ToHSV()
        refreshAll()
    end
    function obj:Destroy() container:Destroy() end
    return obj
end

