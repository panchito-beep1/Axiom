            TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.FrameBgHover }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.FrameBg }):Play()
        end)
    end

    subBtn.MouseButton1Click:Connect(function() updateValue(value - step) end)
    addBtn.MouseButton1Click:Connect(function() updateValue(value + step) end)
    numBox.FocusLost:Connect(function()
        local n = tonumber(numBox.Text)
        if n then updateValue(n) else numBox.Text = tostring(value) end
    end)

    return {
        Container = frame,
        GetValue = function(_) return value end,
        SetValue = function(_, v) updateValue(v) end,
        Destroy = function() frame:Destroy() end,
    }
end

