--  Metrics & Debug Window (ImGui::ShowMetricsWindow)
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:ShowMetricsWindow()
    local win = Axiom._Internal.CreateWindowChrome({
        Title = "Dear ImGui Metrics / Debug",
        Size  = UDim2.new(0, 360, 0, 380),
        Theme = self._theme or Axiom.DefaultTheme,
        Icon  = "rbxassetid://6031280882",
    })

    local body = win:GetBody()
    local tab = setmetatable({ _page = body, _window = self, _layoutOrder = 0, _disabledStack = {} }, TabComponent)

    tab:AddSection({ Text = "Application & Engine Metrics" })
    local fpsLbl  = tab:AddLabel({ Text = "FPS: 60.0 (16.6 ms)" })
    local memLbl  = tab:AddLabel({ Text = "Luau Memory: 0.0 MB" })
    local winLbl  = tab:AddLabel({ Text = "Active Windows: " .. tostring(#Axiom._WindowManager.Windows) })
    local mouseLbl= tab:AddLabel({ Text = "Mouse: (0, 0)" })

    tab:AddSection({ Text = "Performance Plot (Frame Time)" })
    local graph = tab:AddPlotHistogram({
        Title       = "Frame Time (ms)",
        MaxPoints   = 40,
        Height      = 60,
        YMin        = 0,
        YMax        = 33,
        BarColor    = Color3.fromRGB(60, 180, 110),
        OverlayText = "Target: 16.6ms",
    })

    local frames = 0
    local lastTime = tick()
    local stepConn

    stepConn = RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        local now = tick()
        if now - lastTime >= 0.5 then
            local fps = frames / (now - lastTime)
            local ms  = dt * 1000
            fpsLbl:SetText(string.format("FPS: %.1f (%.1f ms)", fps, ms))
            frames = 0
            lastTime = now

            local memMB = collectgarbage("count") / 1024
            memLbl:SetText(string.format("Luau Memory: %.2f MB", memMB))
            winLbl:SetText("Active Windows: " .. tostring(#Axiom._WindowManager.Windows))

            local m = UserInputService:GetMouseLocation()
            mouseLbl:SetText(string.format("Mouse: (%d, %d)", m.X, m.Y))

            graph:Push(ms)
        end
    end)

    win:GetFrame().Destroying:Connect(function()
        if stepConn then stepConn:Disconnect() end
    end)

    return win
end

