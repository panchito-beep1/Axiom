-- ── AddButton ─────────────────────────────────────────────────────────────────
function TabComponent:AddButton(text, callback, opts)
    opts = opts or {}
    local theme = self._theme
    local disabled = opts.Enabled == false

    local btn = Instance.new("TextButton")
    btn.Name = "Button_" .. text
    btn.BackgroundColor3 = disabled and darkenColor(theme.Button) or theme.Button
    btn.BorderSizePixel  = 0
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    btn.TextColor3 = disabled and theme.TextDisabled or theme.Text
    btn.Text = ""
    btn.LayoutOrder = self:_nextOrder()
    btn.Parent = self._frame
    applyCorner(btn, 4)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextColor3 = disabled and theme.TextDisabled or theme.Text
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.TextXAlignment = opts.TextAlignment or Enum.TextXAlignment.Center
    lbl.Parent = btn

    if opts.Icon then addLeftIcon(btn, opts.Icon, 8, 14) end
    if opts.Tooltip then attachTooltip(btn, opts.Tooltip, theme, opts.TooltipDelay) end

    local isHovered = false
    local isPressed = false

    local function updateColor()
        if disabled then
            btn.BackgroundColor3 = darkenColor(theme.Button)
        elseif isPressed then
            TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.ButtonActive }):Play()
        elseif isHovered then
            TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.ButtonHover }):Play()
        else
            TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.Button }):Play()
        end
    end

    btn.MouseEnter:Connect(function() isHovered = true; updateColor() end)
    btn.MouseLeave:Connect(function() isHovered = false; isPressed = false; updateColor() end)
    btn.MouseButton1Down:Connect(function() isPressed = true; updateColor() end)
    btn.MouseButton1Up:Connect(function() isPressed = false; updateColor() end)
    btn.MouseButton1Click:Connect(function()
        if disabled or (self._window and self._window:IsDisabled()) then return end
        if callback then callback() end
    end)

    local btnObj = {
        Container = btn,
        SetText = function(_, t)
            text = t; lbl.Text = t
        end,
        SetEnabled = function(_, v)
            disabled = not v
            lbl.TextColor3 = disabled and theme.TextDisabled or theme.Text
            updateColor()
        end,
        SetDragSource = function(_, sourceData, sourceType, ghostText)
            btn.MouseButton1Down:Connect(function()
                Axiom._DragDrop:Begin(sourceData, sourceType, ghostText)
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    Axiom._DragDrop:End()
                end
            end)
        end,
        SetDragTarget = function(_, acceptType, cb)
            Axiom._DragDrop:RegisterTarget(btn, acceptType, cb)
        end,
        Destroy = function() btn:Destroy() end,
    }
    btnObj._onKeyboardActivate = function()
        if not disabled then if callback then callback() end end
    end
    self:_registerFocusable(btnObj)
    return btnObj
