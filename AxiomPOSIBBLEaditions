function Axiom.Validators.GamePass(passId)
    local ms = cloneref(game:GetService("MarketplaceService"))
    local ok, owns = pcall(function()
        return ms:UserOwnsGamePassAsync(LocalPlayer.UserId, passId)
    end)
    return ok and owns
end

function Axiom.Validators.DevProduct(productId, callback)
    local ms = cloneref(game:GetService("MarketplaceService"))
    ms:PromptProductPurchase(LocalPlayer, productId)
    ms.PromptProductPurchaseFinished:Connect(function(uid, pid, purchased)
        if uid == LocalPlayer.UserId and pid == productId and purchased then
            if callback then callback() end
        end
    end)
end

function Axiom.Validators.UserId(id)
    return LocalPlayer.UserId == id
end

function Axiom.Validators.Username(name)
    return LocalPlayer.Name == name
end

function Axiom.Validators.Currency(attr, amount)
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return false end
    local stat = ls:FindFirstChild(attr)
    if not stat then return false end
    return stat.Value >= amount
end

