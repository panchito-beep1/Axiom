-- ---- Toggle (Obsidian-style 32x18 pill switch) ----
function Components.toggle(section, config)
    local theme = section._theme
    local value = config.default == true
    local listeners, enabled = {}, not config.disabled

    local row = Util.create("TextButton", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Parent = section._content,
    })

    local label = Util.create("TextLabel", {
        Text = tostring(config.name or "Toggle"),
        Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextTransparency = theme.textTransparency,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -40, 1, 0),
        Parent = row,
    })

    local switch = Util.create("Frame", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0),
        Size = UDim2.fromOffset(32, 18),
        BackgroundColor3 = value and theme.accent or theme.main,
        BorderSizePixel = 0, Parent = row,
    })
    Util.corner(9).Parent = switch
    Util.stroke(theme.outline, 1).Parent = switch
    Util.padding({ top = 2, bottom = 2, left = 2, right = 2 }).Parent = switch

    local ball = Util.create("Frame", {
        Size = UDim2.fromScale(1, 1),
        SizeConstraint = Enum.SizeConstraint.RelativeYY,
        BackgroundColor3 = theme.text, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(value and 1 or 0, 0),
        Position = UDim2.fromScale(value and 1 or 0, 0),
        Parent = switch,
    })
    Util.corner(7).Parent = ball

    local function render(animate)
        local targetAnchor = Vector2.new(value and 1 or 0, 0)
        local targetPos = UDim2.fromScale(value and 1 or 0, 0)
        if animate then
            Util.tween(switch, { BackgroundColor3 = value and theme.accent or theme.main }, 0.1)
            TweenService:Create(ball, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                AnchorPoint = targetAnchor, Position = targetPos,
            }):Play()
        else
            switch.BackgroundColor3 = value and theme.accent or theme.main
            ball.AnchorPoint = targetAnchor; ball.Position = targetPos
        end
    end

    if enabled then
        row.MouseEnter:Connect(function()
            Util.tween(label, { TextTransparency = 0 }, 0.1)
        end)
        row.MouseLeave:Connect(function()
            Util.tween(label, { TextTransparency = theme.textTransparency }, 0.1)
        end)
    end

    local obj = { _root = row }
    function obj:get() return value end
    function obj:set(v, silent)
        if not enabled or value == v then return end
        value = v; render(true)
        if not silent then
            if config.callback then config.callback(v) end
            for _, cb in ipairs(listeners) do cb(v) end
        end
    end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    local conn = row.MouseButton1Click:Connect(function()
        if enabled then obj:set(not value) end
    end)
    function obj:destroy() conn:Disconnect(); row:Destroy() end
    return obj
end

