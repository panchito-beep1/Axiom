        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = theme.surface, BackgroundTransparency = 1,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        Parent = window._tabList,
    })
    Util.corner(theme.cornerSmall).Parent = self._navBtn

    -- Purple left indicator (visible when selected)
    self._indicator = Util.create("Frame", {
        Size = UDim2.new(0, 2, 0.5, 0),
        Position = UDim2.new(0, 0, 0.25, 0),
        BackgroundColor3 = theme.accent, BorderSizePixel = 0,
        Visible = false, Parent = self._navBtn,
    })
    Util.corner(1).Parent = self._indicator

    self._icon = Util.create("TextLabel", {
        Text = icon(config.icon), Font = theme.font,
        TextSize = 13, TextColor3 = theme.muted, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(22, 28), Position = UDim2.new(0, 8, 0, 0),
        Parent = self._navBtn,
    })
    self._name = Util.create("TextLabel", {
        Text = tostring(config.name or "Tab"), Font = theme.fontMedium,
        TextSize = theme.fontSize, TextColor3 = theme.muted,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Size = UDim2.new(1, -34, 1, 0), Position = UDim2.new(0, 30, 0, 0),
        Parent = self._navBtn,
    })

    self._navBtn.MouseEnter:Connect(function()
        if not self._selected then
            Util.tween(self._navBtn, { BackgroundTransparency = 0.6 }, 0.12)
        end
    end)
    self._navBtn.MouseLeave:Connect(function()
        if not self._selected then
            Util.tween(self._navBtn, { BackgroundTransparency = 1 }, 0.12)
        end
    end)

    self._content = Util.create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Visible = false,
        Parent = window._content,
    })
    Util.padding({ top = 12, bottom = 12, left = 12, right = 12 }).Parent = self._content

    -- Column divider (subtle)
    Util.create("Frame", {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(0.5, 0, 0, 0),
        BackgroundColor3 = theme.border, BackgroundTransparency = 0.4,
        BorderSizePixel = 0, ZIndex = 1, Parent = self._content,
    })

    local function makeColumn(posX, offsetX)
        local col = Util.create("ScrollingFrame", {
            Size = UDim2.new(0.5, -6, 1, 0),
            Position = UDim2.new(posX, offsetX, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = theme.border,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Parent = self._content,
        })
        Util.listLayout({ gap = 10 }).Parent = col
        return col
    end
    self._col1 = makeColumn(0, 0)
    self._col2 = makeColumn(0.5, 6)

    table.insert(self._conns, self._navBtn.MouseButton1Click:Connect(function()
        window:selectTab(self)
    end))
    return self
end

function Tab:_setSelected(selected)
    local theme = self._window._theme
    self._selected = selected
    self._content.Visible = selected
    self._indicator.Visible = selected
    self._navBtn.BackgroundColor3 = selected and theme.accentBg or theme.surface
    Util.tween(self._navBtn, { BackgroundTransparency = selected and 0.4 or 1 }, 0.15)
    self._icon.TextColor3 = selected and theme.accentBright or theme.muted
    self._name.TextColor3 = selected and theme.accentBright or theme.muted
end

function Tab:_applyTheme(theme)
    self._indicator.BackgroundColor3 = theme.accent
    self._col1.ScrollBarImageColor3 = theme.border
    self._col2.ScrollBarImageColor3 = theme.border
end

function Tab:section(config)
    local sec = Section.new(self, config or {})
    table.insert(self._sections, sec)
    return sec
end

function Tab:destroy()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    for _, s in ipairs(self._sections) do s:destroy() end
    if self._navBtn then self._navBtn:Destroy() end
    if self._content then self._content:Destroy() end
end

-- =========================================================
-- Window
-- =========================================================
local Window = {}
Window.__index = Window

function Window.new(config)
    config = config or {}
    local self = setmetatable({}, Window)
    local themeOverride = (type(config.theme) == "table") and config.theme or nil
    self._theme   = Theme.merge(Theme.Default, themeOverride)
    self._tabs    = {}
    self._current = nil
    self._conns   = {}
    self._visible = true
    self:_build(config)
    return self
end

function Window:_build(config)
    local theme = self._theme
    -- narrower, more square: 580x440
    local size  = config.size or UDim2.fromOffset(580, 440)

    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    self._gui = Util.create("ScreenGui", {
        Name = "Axiom", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100, Parent = playerGui,
    })

    self._root = Util.create("Frame", {
        Name = "Window", Size = size,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.background, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = self._gui,
    })
    Util.corner(theme.cornerRadius + 2).Parent = self._root
    Util.stroke(theme.borderLight, 1).Parent = self._root

    -- Title bar (26px)
    self._titleBar = Util.create("Frame", {
        Name = "TitleBar", Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = theme.sidebar, BorderSizePixel = 0, Parent = self._root,
    })
    Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = theme.border, BorderSizePixel = 0, Parent = self._titleBar,
    })
    -- Purple accent dot before title
    local titleDot = Util.create("Frame", {
        Size = UDim2.fromOffset(6, 6),
        Position = UDim2.new(0, 14, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = theme.accent, BorderSizePixel = 0, Parent = self._titleBar,
    })
    Util.corner(3).Parent = titleDot

    Util.create("TextLabel", {
        Text = tostring(config.title or "Application"),
        Font = theme.fontBold, TextSize = 12, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 26, 0, 0),
        Parent = self._titleBar,
    })
    local closeBtn = Util.create("TextButton", {
        Text = Icons.close, Font = theme.fontCode, TextSize = 12,
        TextColor3 = theme.muted, BackgroundTransparency = 1,
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(1, -26, 0, 0), Parent = self._titleBar,
    })
    closeBtn.MouseEnter:Connect(function()
        closeBtn.TextColor3 = theme.error
    end)
    closeBtn.MouseLeave:Connect(function()
        closeBtn.TextColor3 = theme.muted
    end)
    table.insert(self._conns, closeBtn.MouseButton1Click:Connect(function()
        self:setVisible(false)
    end))
    self:_enableDrag()

    -- Body
    local body = Util.create("Frame", {
        Size = UDim2.new(1, 0, 1, -26), Position = UDim2.new(0, 0, 0, 26),
        BackgroundTransparency = 1, Parent = self._root,
    })

    -- Sidebar
    self._sidebar = Util.create("Frame", {
        Size = UDim2.new(0.19, 0, 1, 0),
        BackgroundColor3 = theme.sidebar, BorderSizePixel = 0, Parent = body,
    })
    Util.create("Frame", {
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0),
        BackgroundColor3 = theme.border, BackgroundTransparency = 0.4,
        BorderSizePixel = 0, Parent = self._sidebar,
    })
    self._tabList = Util.create("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Parent = self._sidebar,
    })
    Util.padding({ top = 8, bottom = 8, left = 6, right = 6 }).Parent = self._tabList
    Util.listLayout({ gap = 2 }).Parent = self._tabList

    -- Content
    self._content = Util.create("Frame", {
        Size = UDim2.new(0.81, 0, 1, 0),
        Position = UDim2.new(0.19, 0, 0, 0),
        BackgroundTransparency = 1, Parent = body,
    })
end

function Window:_enableDrag()
    local dragging, dragStart, startPos = false, nil, nil

    table.insert(self._conns, self._titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = self._root.Position
        end
    end))
    table.insert(self._conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            self._root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(self._conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Window:tab(config)
    local tab = Tab.new(self, config or {})
    table.insert(self._tabs, tab)
    if not self._current then self:selectTab(tab) end
    return tab
end

function Window:selectTab(tab)
    for _, t in ipairs(self._tabs) do t:_setSelected(t == tab) end
    self._current = tab
end

function Window:setVisible(visible)
    self._visible = visible
    if self._gui then self._gui.Enabled = visible end
end

function Window:isVisible() return self._visible end

function Window:setTheme(override)
    if type(override) ~= "table" then return end
    self._theme = Theme.merge(self._theme, override)
    local t = self._theme
    self._root.BackgroundColor3     = t.background
    self._titleBar.BackgroundColor3 = t.sidebar
    self._sidebar.BackgroundColor3  = t.sidebar
    for _, tab in ipairs(self._tabs) do tab:_applyTheme(t) end
end

function Window:destroy()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    self._conns = {}
    for _, t in ipairs(self._tabs) do t:destroy() end
    self._tabs = {}
    if self._gui then self._gui:Destroy(); self._gui = nil end
end

-- =========================================================
-- Public entry
-- =========================================================
local Axiom = {}
Axiom.build = AXIOM_BUILD

function Axiom.new(config)
    print(("[Axiom] build %s — new() called"):format(AXIOM_BUILD))
    if type(config) ~= "table" then config = {} end
    if type(config.theme) ~= "table" then config.theme = nil end
    return Window.new(config)
end

function Axiom.notify(config)
    return Notify.show(config or {})
end

return Axiom
