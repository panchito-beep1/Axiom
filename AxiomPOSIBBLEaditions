--  Context Menu (Axiom:ShowContextMenu)
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:ShowContextMenu(options)
    options = options or {}
    local theme = self._theme or Axiom.DefaultTheme
    local items = options.Items or {}
    local pos   = options.Position or UserInputService:GetMouseLocation()

    local screen = Instance.new("ScreenGui")
    screen.Name = "Axiom_ContextMenu"
    screen.ResetOnSpawn = false
    screen.DisplayOrder = 99999
    screen.Parent = CoreGui

    local dismissArea = Instance.new("TextButton")
    dismissArea.BackgroundTransparency = 1
    dismissArea.Size = UDim2.new(1, 0, 1, 0)
    dismissArea.Text = ""
    dismissArea.Parent = screen

    local menu = Instance.new("Frame")
    menu.BackgroundColor3 = theme.PopupBg or theme.WindowBg
    menu.Position = UDim2.new(0, pos.X, 0, pos.Y)
    menu.Size = UDim2.new(0, 160, 0, #items * 24 + 4)
    menu.ClipsDescendants = true
    menu.Parent = screen
    applyCorner(menu, 2)
    applyBorder(menu, theme.Border)
    applyPadding(menu, 2)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = menu

    for _, it in ipairs(items) do
        if it.Separator then
            local sep = Instance.new("Frame")
            sep.BackgroundColor3 = theme.Separator or theme.Border
            sep.Size = UDim2.new(1, 0, 0, 1)
            sep.Parent = menu
        else
            local btn = Instance.new("TextButton")
            btn.BackgroundTransparency = 1
            btn.Size = UDim2.new(1, 0, 0, 22)
            btn.Font = Enum.Font.RobotoMono
            btn.Text = "  " .. tostring(it.Text or "Item")
            btn.TextColor3 = theme.Text
            btn.TextSize = 12
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = menu

            btn.MouseEnter:Connect(function()
                btn.BackgroundTransparency = 0
                btn.BackgroundColor3 = theme.HeaderHover or theme.Accent
            end)
            btn.MouseLeave:Connect(function()
                btn.BackgroundTransparency = 1
            end)
            btn.MouseButton1Click:Connect(function()
                screen:Destroy()
                safeCall(it.Callback)
            end)
        end
    end

    dismissArea.MouseButton1Click:Connect(function() screen:Destroy() end)
end

