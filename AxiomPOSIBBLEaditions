-- ════════════════════════════════════════════════════════════════════════════
--  AddVideo / AddVideoPlayer (Native VideoFrame Player with Scrubbing Controls)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddVideo(options)
    options = options or {}
    local theme = getTheme(self)

    local videoId   = options.Video or ""
    local title     = options.Title or "Video Player"
    local autoPlay  = options.AutoPlay or false
    local looped    = options.Looped ~= false
    local volume    = math.clamp(options.Volume or 1, 0, 1)

    local container = Instance.new("Frame")
    container.BackgroundColor3 = theme.WindowBg
    container.Size = options.Size or UDim2.new(1, 0, 0, 220)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page
    applyCorner(container, 3)
    applyBorder(container, theme.Border)

    local titleBar = Instance.new("Frame")
    titleBar.BackgroundColor3 = theme.TitleBg
    titleBar.Size = UDim2.new(1, 0, 0, 20)
    titleBar.Parent = container

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0, 6, 0, 0)
    titleLbl.Size = UDim2.new(1, -12, 1, 0)
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.Text
    titleLbl.TextSize = 11
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = titleBar

    -- VideoFrame Instance (or Image fallback if executor has limitations)
    local videoFrame
    local ok, vf = pcall(function() return Instance.new("VideoFrame") end)
    if ok and vf then
        videoFrame = vf
        videoFrame.Video = Axiom.ResolveIcon(videoId) or videoId
        videoFrame.Looped = looped
        videoFrame.Volume = volume
    else
        videoFrame = Instance.new("ImageLabel")
        videoFrame.Image = Axiom.ResolveIcon(videoId) or ""
    end
    videoFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    videoFrame.Position = UDim2.new(0, 0, 0, 20)
    videoFrame.Size = UDim2.new(1, 0, 1, -48)
    videoFrame.Parent = container

    local controls = Instance.new("Frame")
    controls.BackgroundColor3 = theme.FrameBg
    controls.Position = UDim2.new(0, 0, 1, -28)
    controls.Size = UDim2.new(1, 0, 0, 28)
    controls.Parent = container

    local playBtn = Instance.new("TextButton")
    playBtn.BackgroundTransparency = 1
    playBtn.Size = UDim2.new(0, 28, 1, 0)
    playBtn.Font = Enum.Font.RobotoMono
    playBtn.Text = autoPlay and "❚❚" or "▶"
    playBtn.TextColor3 = theme.Text
    playBtn.TextSize = 13
    playBtn.Parent = controls

    local timeLbl = Instance.new("TextLabel")
    timeLbl.BackgroundTransparency = 1
    timeLbl.Position = UDim2.new(1, -80, 0, 0)
    timeLbl.Size = UDim2.new(0, 76, 1, 0)
    timeLbl.Font = Enum.Font.RobotoMono
    timeLbl.Text = "00:00 / 00:00"
    timeLbl.TextColor3 = theme.SubText
    timeLbl.TextSize = 11
    timeLbl.Parent = controls

    local scrubTrack = Instance.new("Frame")
    scrubTrack.BackgroundColor3 = theme.SliderTrack
    scrubTrack.Position = UDim2.new(0, 32, 0.5, -3)
    scrubTrack.Size = UDim2.new(1, -120, 0, 6)
    scrubTrack.Parent = controls
    applyCorner(scrubTrack, 2)

    local scrubFill = Instance.new("Frame")
    scrubFill.BackgroundColor3 = theme.SliderFill
    scrubFill.Size = UDim2.new(0, 0, 1, 0)
    scrubFill.Parent = scrubTrack
    applyCorner(scrubFill, 2)

    local isPlaying = autoPlay
    if isPlaying and videoFrame:IsA("VideoFrame") then
        pcall(function() videoFrame:Play() end)
    end

    local function formatSeconds(s)
        s = math.floor(s or 0)
        local m = math.floor(s / 60)
        local sec = s % 60
        return string.format("%02d:%02d", m, sec)
    end

    local updateConn
    if videoFrame:IsA("VideoFrame") then
        updateConn = RunService.Heartbeat:Connect(function()
            if videoFrame.TimeLength and videoFrame.TimeLength > 0 then
                local pct = math.clamp(videoFrame.TimePosition / videoFrame.TimeLength, 0, 1)
                scrubFill.Size = UDim2.new(pct, 0, 1, 0)
                timeLbl.Text = formatSeconds(videoFrame.TimePosition) .. " / " .. formatSeconds(videoFrame.TimeLength)
            end
        end)
    end

    playBtn.MouseButton1Click:Connect(function()
        isPlaying = not isPlaying
        playBtn.Text = isPlaying and "❚❚" or "▶"
        if videoFrame:IsA("VideoFrame") then
            if isPlaying then videoFrame:Play() else videoFrame:Pause() end
        end
    end)

    local scrubbing = false
    scrubTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            scrubbing = true
            local rel = math.clamp((input.Position.X - scrubTrack.AbsolutePosition.X) / scrubTrack.AbsoluteSize.X, 0, 1)
            scrubFill.Size = UDim2.new(rel, 0, 1, 0)
            if videoFrame:IsA("VideoFrame") and videoFrame.TimeLength then
                videoFrame.TimePosition = rel * videoFrame.TimeLength
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then scrubbing = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if scrubbing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((input.Position.X - scrubTrack.AbsolutePosition.X) / scrubTrack.AbsoluteSize.X, 0, 1)
            scrubFill.Size = UDim2.new(rel, 0, 1, 0)
            if videoFrame:IsA("VideoFrame") and videoFrame.TimeLength then
                videoFrame.TimePosition = rel * videoFrame.TimeLength
            end
        end
    end)

    local playerObj = { _instance = container }
    function playerObj:Play()
        isPlaying = true
        playBtn.Text = "❚❚"
        if videoFrame:IsA("VideoFrame") then videoFrame:Play() end
    end
    function playerObj:Pause()
        isPlaying = false
        playBtn.Text = "▶"
        if videoFrame:IsA("VideoFrame") then videoFrame:Pause() end
    end
    function playerObj:SetTime(pos)
        if videoFrame:IsA("VideoFrame") then videoFrame.TimePosition = pos end
    end
    function playerObj:SetVolume(vol)
        volume = math.clamp(vol, 0, 1)
        if videoFrame:IsA("VideoFrame") then videoFrame.Volume = volume end
    end
    function playerObj:SetVideo(id)
        videoId = id
        if videoFrame:IsA("VideoFrame") then
            videoFrame.Video = Axiom.ResolveIcon(id) or id
        else
            videoFrame.Image = Axiom.ResolveIcon(id) or id
        end
    end
    function playerObj:Destroy()
        if updateConn then updateConn:Disconnect() end
        container:Destroy()
    end
    return playerObj
end
TabComponent.AddVideoPlayer = TabComponent.AddVideo

-- ════════════════════════════════════════════════════════════════════════════
--  AddCheckbox (Binary & Tri-State Support)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddCheckbox(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Checkbox"
    local tristate = options.Tristate or false
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    -- States: true (Checked), false (Unchecked), nil/"indeterminate" (Indeterminate)
    local state = default
    if state == nil and not tristate then state = false end

    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()
    if options.Enabled ~= nil then currentEnabled = options.Enabled and not self:IsDisabled() end

    local bgColor = theme.FrameBg
    if options.Color then
        warnCustomColor(self, "Checkbox")
        bgColor = options.Color
    end
    local hoverColor = options.Color and lightenColor(options.Color, 0.12) or theme.FrameBgHover

    local row = Instance.new("TextButton")
    row.BackgroundColor3 = currentEnabled and bgColor or disabledColor(bgColor)
    row.Size = UDim2.new(1, 0, 0, 24)
    row.LayoutOrder = self:_nextOrder()
    row.Text = ""
    row.AutoButtonColor = false
    row.Active = currentEnabled
    row.Parent = self._page
    applyCorner(row, 2)
    applyBorder(row, theme.Border)

    row.MouseEnter:Connect(function()
        if currentEnabled then row.BackgroundColor3 = hoverColor end
    end)
    row.MouseLeave:Connect(function()
        if currentEnabled then row.BackgroundColor3 = bgColor end
    end)

    local check = Instance.new("TextLabel")
    check.Position = UDim2.new(0, 4, 0.5, -8)
    check.Size = UDim2.new(0, 16, 0, 16)
    check.Font = Enum.Font.RobotoMono
    check.TextSize = 12
    check.Parent = row
    applyCorner(check, 2)
    applyBorder(check, theme.Accent)

    local function refreshVisual()
        if state == true then
            check.Text = "✓"
            check.BackgroundColor3 = theme.CheckOn
            check.TextColor3 = theme.Text
        elseif state == false then
            check.Text = ""
            check.BackgroundColor3 = theme.CheckOff
        else
            -- Indeterminate state:
            check.Text = "−"
            check.BackgroundColor3 = theme.CheckIndeterminate or theme.Accent
            check.TextColor3 = theme.Text
        end
    end
    refreshVisual()

    local iconW = 0
    if options.Icon and options.Icon ~= "" then
        local id = Axiom.ResolveIcon(options.Icon)
        if id and id ~= "" then
            local icn = Instance.new("ImageLabel")
            icn.BackgroundTransparency = 1
            icn.AnchorPoint = Vector2.new(0, 0.5)
            icn.Position = UDim2.new(0, 24, 0.5, 0)
            icn.Size = UDim2.new(0, 16, 0, 16)
            icn.Image = id
            icn.Parent = row
            iconW = 20
        end
    end

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 24 + iconW, 0, 0)
    lbl.Size = UDim2.new(1, -(24 + iconW), 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = currentEnabled and theme.Text or disabledColor(theme.Text)
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local function toggleNext()
        if not currentEnabled then return end
        if tristate then
            if state == false then
                state = true
            elseif state == true then
                state = nil
            else
                state = false
            end
        else
            state = not state
        end
        refreshVisual()
        safeCall(currentCallback, state)
    end

    row.MouseButton1Click:Connect(toggleNext)

    if tooltip then attachTooltip(row, tooltip, self._window) end
    if self._window then self._window:_registerSearch(row, text) end

    local obj = { _instance = row, _window = self._window }
    function obj:GetValue() return state end
    function obj:SetValue(v)
        state = v
        refreshVisual()
        safeCall(currentCallback, state)
    end
    function obj:SetTristate(enabled)
        tristate = enabled
    end
    function obj:Toggle() toggleNext() end
    function obj:SetText(t) lbl.Text = tostring(t) end
    function obj:GetText() return lbl.Text end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(enabled)
        currentEnabled = enabled and not self._window:IsDisabled()
        row.Active = currentEnabled
        row.BackgroundColor3 = currentEnabled and bgColor or disabledColor(bgColor)
        lbl.TextColor3 = currentEnabled and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() row:Destroy() end
    function obj:GetInstance() return row end
    function obj:_onKeyboardActivate() toggleNext() end

    self:_registerFocusable(obj)

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return state end, function(v) obj:SetValue(v) end)

    return obj
end
TabComponent.AddTriStateCheckbox = function(self, opts)
    opts = opts or {}
    opts.Tristate = true
    return self:AddCheckbox(opts)
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddCheckboxFlags (Bitmask Multiselect)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddCheckboxFlags(options)
    options = options or {}
    local flagMask = options.FlagValue or options.Flag or 1
    local getFlags = options.GetFlags or function() return 0 end
    local setFlags = options.SetFlags or function() end

    local currentIsSet = (bit32.band(getFlags(), flagMask) == flagMask)

    options.Default = currentIsSet
    options.Callback = function(checked)
        local cur = getFlags()
        if checked then
            cur = bit32.bor(cur, flagMask)
        else
            cur = bit32.band(cur, bit32.bnot(flagMask))
        end
        setFlags(cur)
        if options.OnFlagChanged then safeCall(options.OnFlagChanged, cur, checked) end
    end

    return self:AddCheckbox(options)
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddSlider (with Ctrl+Click Direct Number Input & Active State)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddSlider(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Slider"
    local min      = options.Min  or 0
    local max      = options.Max  or 100
    local default  = options.Default
    local callback = options.Callback
    local isFloat  = options.Float or false
    local decimals = options.Decimals or 1
    local tooltip  = options.Tooltip

    default = math.clamp(default or min, min, max)
    local value = default
    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local track = Instance.new("TextButton")
    track.BackgroundColor3 = options.Color or theme.SliderTrack
    track.Size = UDim2.new(1, 0, 1, 0)
    track.Text = ""
    track.AutoButtonColor = false
    track.Parent = container
    applyCorner(track, 2)
    applyBorder(track, theme.Border)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = theme.SliderFill
    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.Parent = track
    applyCorner(fill, 2)

    local function formatValue(v)
        if isFloat then
            return string.format("%s: %." .. decimals .. "f", text, v)
        else
            return string.format("%s: %d", text, math.floor(v + 0.5))
        end
    end

    local iconW = 0
    if options.Icon and options.Icon ~= "" then
        local id = Axiom.ResolveIcon(options.Icon)
        if id and id ~= "" then
            local icn = Instance.new("ImageLabel")
            icn.BackgroundTransparency = 1
            icn.AnchorPoint = Vector2.new(0, 0.5)
            icn.Position = UDim2.new(0, 4, 0.5, 0)
            icn.Size = UDim2.new(0, 14, 0, 14)
            icn.ZIndex = 3
            icn.Image = id
            icn.Parent = track
            iconW = 20
        end
    end

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, iconW, 0, 0)
    lbl.Size = UDim2.new(1, -iconW, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = formatValue(value)
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 13
    lbl.ZIndex = 2
    lbl.Parent = track

    -- Ctrl+Click inline numeric input (Dear ImGui signature feature):
    local editBox = Instance.new("TextBox")
    editBox.BackgroundColor3 = theme.FrameBgActive or theme.Accent
    editBox.Size = UDim2.new(1, 0, 1, 0)
    editBox.Font = Enum.Font.RobotoMono
    editBox.Text = tostring(value)
    editBox.TextColor3 = theme.Text
    editBox.TextSize = 13
    editBox.ZIndex = 4
    editBox.Visible = false
    editBox.ClearTextOnFocus = false
    editBox.Parent = track
    applyCorner(editBox, 2)
    applyBorder(editBox, theme.NavHighlight or theme.Accent, 1.5)

    local function commitEdit()
        local n = tonumber(editBox.Text)
        if n then
            value = math.clamp(n, min, max)
            if not isFloat then
                value = math.floor(value + 0.5)
            else
                value = math.floor(value * (10 ^ decimals) + 0.5) / (10 ^ decimals)
            end
            local rel = (value - min) / (max - min)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            lbl.Text = formatValue(value)
            safeCall(currentCallback, value)
        end
        editBox.Visible = false
        lbl.Visible = true
    end

    editBox.FocusLost:Connect(commitEdit)

    local function updateFromInput(input)
        if not currentEnabled then return end
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * rel
        if not isFloat then
            value = math.floor(value + 0.5)
        else
            value = math.floor(value * (10 ^ decimals) + 0.5) / (10 ^ decimals)
        end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = formatValue(value)
        safeCall(currentCallback, value)
    end

    local dragging = false
    track.InputBegan:Connect(function(i)
        if not currentEnabled then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            local isCtrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            if isCtrl then
                -- Open direct input box:
                lbl.Visible = false
                editBox.Visible = true
                editBox.Text = isFloat and string.format("%." .. decimals .. "f", value) or tostring(value)
                editBox:CaptureFocus()
                return
            end

            dragging = true
            fill.BackgroundColor3 = theme.SliderFillActive or theme.AccentActive
            Axiom._FocusManager:SetFocus(track)
            updateFromInput(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                fill.BackgroundColor3 = theme.SliderFill
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(i)
        end
    end)

    if tooltip then attachTooltip(track, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = { _instance = track, _window = self._window }
    function obj:GetValue() return value end
    function obj:SetValue(val)
        val = math.clamp(val, min, max)
        value = val
        local rel = (val - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = formatValue(val)
        safeCall(currentCallback, val)
    end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state and not self._window:IsDisabled()
        track.Active = currentEnabled
        track.BackgroundColor3 = currentEnabled and (options.Color or theme.SliderTrack) or disabledColor(options.Color or theme.SliderTrack)
        fill.BackgroundColor3 = currentEnabled and theme.SliderFill or disabledColor(theme.SliderFill)
        lbl.TextColor3 = currentEnabled and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    -- Keyboard arrow navigation:
    function obj:_onKeyboardStep(dir)
        local step = isFloat and (10 ^ -decimals) or 1
        obj:SetValue(value + dir * step)
    end

    self:_registerFocusable(obj)

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return value end, function(v) obj:SetValue(v) end)

    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddNumberInput (Numeric Stepper)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddNumberInput(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Value"
    local min      = options.Min  or 0
    local max      = options.Max  or 100
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local isFloat    = options.Float or false
    local decimals   = options.Decimals or 1
    local step       = options.Step or (isFloat and (10 ^ -decimals) or 1)
    local inputWidth = options.Width or 70
    local currentCallback = callback
    local currentEnabled  = not self:IsDisabled()

    local value = math.clamp(default or min, min, max)
    local function clampValue(v)
        v = math.clamp(v, min, max)
        if isFloat then
            v = math.floor(v * (10 ^ decimals) + 0.5) / (10 ^ decimals)
        else
            v = math.floor(v + 0.5)
        end
        return v
    end
    value = clampValue(value)

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 4, 0, 0)
    label.Size = UDim2.new(1, -inputWidth - 60, 1, 0)
    label.Font = Enum.Font.RobotoMono
    label.Text = text
    label.TextColor3 = theme.Text
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local minusBtn = Instance.new("TextButton")
    minusBtn.BackgroundColor3 = options.Color or theme.FrameBg
    minusBtn.Position = UDim2.new(1, -(inputWidth + 52), 0, 0)
    minusBtn.Size = UDim2.new(0, 24, 1, 0)
    minusBtn.Font = Enum.Font.RobotoMono
    minusBtn.Text = "-"
    minusBtn.TextColor3 = theme.Text
    minusBtn.TextSize = 14
    minusBtn.Parent = container
    applyCorner(minusBtn, 2)
    applyBorder(minusBtn, theme.Border)

    local box = Instance.new("TextBox")
    box.BackgroundColor3 = options.Color or theme.FrameBg
    box.Position = UDim2.new(1, -(inputWidth + 24), 0, 0)
    box.Size = UDim2.new(0, inputWidth, 1, 0)
    box.Font = Enum.Font.RobotoMono
    box.Text = isFloat and string.format("%." .. decimals .. "f", value) or tostring(value)
    box.TextColor3 = theme.Text
    box.TextSize = 13
    box.TextXAlignment = Enum.TextXAlignment.Center
    box.ClearTextOnFocus = false
    box.Parent = container
    applyCorner(box, 2)
    applyBorder(box, theme.Border)

    local plusBtn = Instance.new("TextButton")
    plusBtn.BackgroundColor3 = options.Color or theme.FrameBg
    plusBtn.Position = UDim2.new(1, -24, 0, 0)
    plusBtn.Size = UDim2.new(0, 24, 1, 0)
    plusBtn.Font = Enum.Font.RobotoMono
    plusBtn.Text = "+"
    plusBtn.TextColor3 = theme.Text
    plusBtn.TextSize = 14
    plusBtn.Parent = container
    applyCorner(plusBtn, 2)
    applyBorder(plusBtn, theme.Border)

    local function refreshText()
        if isFloat then
            box.Text = string.format("%." .. decimals .. "f", value)
        else
            box.Text = tostring(value)
        end
    end

    local function setValue(newVal, fire)
        local clamped = clampValue(newVal)
        if clamped == value then refreshText(); return end
        value = clamped
        refreshText()
        if fire ~= false then safeCall(currentCallback, value) end
    end

    minusBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        setValue(value - step)
    end)
    plusBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        setValue(value + step)
    end)

    box.FocusLost:Connect(function()
        if not currentEnabled then return end
        local n = tonumber(box.Text)
        if n then setValue(n) else refreshText() end
    end)

    box.InputChanged:Connect(function(input)
        if not currentEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            setValue(value + step * input.Position.Z)
        end
    end)

    if tooltip then attachTooltip(box, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = { _instance = container }
    function obj:GetValue() return value end
    function obj:SetValue(v) setValue(v) end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state and not self._window:IsDisabled()
        minusBtn.Active = currentEnabled
        plusBtn.Active = currentEnabled
        box.Active = currentEnabled
        local base = currentEnabled and (options.Color or theme.FrameBg) or disabledColor(options.Color or theme.FrameBg)
        minusBtn.BackgroundColor3 = base
        plusBtn.BackgroundColor3  = base
        box.BackgroundColor3      = base
        box.TextColor3            = currentEnabled and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return value end, function(v) obj:SetValue(v) end)

    return obj
end

