--  Toast Notifications System
-- ════════════════════════════════════════════════════════════════════════════
local NOTIFY_COLORS = {
    info    = Color3.fromRGB(56, 101, 165),
    warn    = Color3.fromRGB(215, 145, 45),
    error   = Color3.fromRGB(195, 65, 65),
    success = Color3.fromRGB(60, 160, 75),
}

function Axiom:Notify(options)
    options = options or {}
    local theme = self._theme or Axiom.DefaultTheme
    local title = options.Title or "Notification"
    local desc  = options.Description or options.Message or ""
    local dur   = options.Duration or 4
    local ntype = options.Type or "info"
    local accentColor = options.Color or NOTIFY_COLORS[ntype] or theme.Accent

    if not self._notificationGui or not self._notificationGui.Parent then
        local sg = Instance.new("ScreenGui")
        sg.Name = "Axiom_Notifications"
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 9998
        sg.Parent = CoreGui
        self._notificationGui = sg

        local container = Instance.new("Frame")
        container.Name = "NotificationContainer"
        container.BackgroundTransparency = 1
        container.AnchorPoint = Vector2.new(1, 1)
        container.Position = UDim2.new(1, -16, 1, -16)
        container.Size = UDim2.new(0, 280, 1, -32)
        container.Parent = sg

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 6)
        layout.Parent = container

        self._notificationList = container
    end

    local card = Instance.new("Frame")
    card.BackgroundColor3 = theme.NotifyBg or theme.PopupBg
    card.Size = UDim2.new(1, 0, 0, 0)
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.ClipsDescendants = true
    card.Parent = self._notificationList
    applyCorner(card, 2)
    applyBorder(card, theme.Border)

    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel = 0
    bar.Size = UDim2.new(0, 3, 1, 0)
    bar.Parent = card

    local content = Instance.new("Frame")
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 9, 0, 0)
    content.Size = UDim2.new(1, -9, 0, 0)
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.Parent = card
    applyPadding(content, 6, 6)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Size = UDim2.new(1, 0, 0, 16)
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.NotifyTitle or theme.Text
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.RichText = true
    titleLbl.Parent = content

    if desc ~= "" then
        local descLbl = Instance.new("TextLabel")
        descLbl.BackgroundTransparency = 1
        descLbl.Position = UDim2.new(0, 0, 0, 18)
        descLbl.Size = UDim2.new(1, 0, 0, 0)
        descLbl.AutomaticSize = Enum.AutomaticSize.Y
        descLbl.Font = Enum.Font.RobotoMono
        descLbl.Text = desc
        descLbl.TextColor3 = theme.NotifyMsg or theme.SubText
        descLbl.TextSize = 12
        descLbl.TextWrapped = true
        descLbl.TextXAlignment = Enum.TextXAlignment.Left
        descLbl.RichText = true
        descLbl.Parent = content
    end

    card.BackgroundTransparency = 1
    TweenService:Create(card, TWEEN_FAST, { BackgroundTransparency = 0 }):Play()

    task.delay(dur, function()
        if card and card.Parent then
            local tw = TweenService:Create(card, TWEEN_FAST, { BackgroundTransparency = 1 })
            tw:Play()
            tw.Completed:Connect(function()
                card:Destroy()
            end)
        end
    end)
end

