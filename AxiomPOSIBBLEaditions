-- ── AddCheckbox ───────────────────────────────────────────────────────────────
function TabComponent:AddCheckbox(text, default, callback, opts)
    opts = opts or {}
    local theme = self._theme
    local tristate = opts.tristate or false
    local disabled = opts.Enabled == false
    -- state: true = checked, false = unchecked, nil = indeterminate (tristate only)
    local state = default
    if tristate and default == nil then state = nil end

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 24)
    row.LayoutOrder = self:_nextOrder()
    row.Parent = self._frame

    local box = Instance.new("TextButton")
    box.BackgroundColor3 = state and theme.CheckOn or theme.CheckOff
    box.BorderSizePixel = 0
    box.Size = UDim2.new(0, 16, 0, 16)
    box.AnchorPoint = Vector2.new(0, 0.5)
    box.Position = UDim2.new(0, 0, 0.5, 0)
    box.Text = ""
    box.Parent = row
    applyCorner(box, 3)
    applyBorder(box, theme.Border)

    local checkLbl = Instance.new("TextLabel")
    checkLbl.BackgroundTransparency = 1
    checkLbl.Text = state == nil and "−" or (state and "✓" or "")
    checkLbl.Font = Enum.Font.GothamBold
    checkLbl.TextSize = 12
    checkLbl.TextColor3 = Color3.fromRGB(255,255,255)
    checkLbl.Size = UDim2.new(1,0,1,0)
    checkLbl.Parent = box

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextColor3 = disabled and theme.TextDisabled or theme.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Position = UDim2.new(0, 22, 0, 0)
    lbl.Size = UDim2.new(1, -22, 1, 0)
    lbl.Parent = row
    if opts.Tooltip then attachTooltip(row, opts.Tooltip, theme, opts.TooltipDelay) end

    local function updateVisual()
        if state == nil then
            box.BackgroundColor3 = theme.CheckIndeterminate or Color3.fromRGB(85,125,185)
            checkLbl.Text = "−"
        elseif state then
            box.BackgroundColor3 = theme.CheckOn
            checkLbl.Text = "✓"
        else
            box.BackgroundColor3 = theme.CheckOff
            checkLbl.Text = ""
        end
    end
    updateVisual()

    box.MouseButton1Click:Connect(function()
        if disabled or (self._window and self._window:IsDisabled()) then return end
        if tristate then
            if state == false then state = nil
            elseif state == nil then state = true
            else state = false end
        else
            state = not state
        end
        updateVisual()
        if callback then callback(state) end
    end)

    local obj = {
        Container = row,
        GetState = function(_) return state end,
        SetState = function(_, v) state = v; updateVisual() end,
        SetEnabled = function(_, v)
            disabled = not v
            lbl.TextColor3 = disabled and theme.TextDisabled or theme.Text
        end,
        SetTristate = function(_, v) tristate = v end,
        Destroy = function() row:Destroy() end,
    }
    obj._onKeyboardActivate = function()
        if not disabled then
            if tristate then
                if state == false then state = nil
                elseif state == nil then state = true
                else state = false end
            else state = not state end
            updateVisual()
            if callback then callback(state) end
        end
    end
    self:_registerFocusable(obj)
    return obj
end

