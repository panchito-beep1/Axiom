local Notify = {}
local notifyGui, notifyContainer

local function ensureNotifyGui()
    if notifyGui and notifyGui.Parent then return end
    notifyGui = Util.create("ScreenGui", {
        Name = "AxiomNotify", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 200, Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
    })
    notifyContainer = Util.create("Frame", {
        Size = UDim2.new(0, 280, 1, -40),
        Position = UDim2.new(1, -20, 0, 20),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1, Parent = notifyGui,
    })
    Util.listLayout({ gap = 8 }).Parent = notifyContainer
end

function Notify.show(config)
    config = config or {}
    local theme = (type(config.theme) == "table") and config.theme or Theme.Default
    ensureNotifyGui()

    local toast = Util.create("Frame", {
        Size = UDim2.fromOffset(280, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.card, BorderSizePixel = 0,
        Parent = notifyContainer,
    })
    Util.corner(theme.cornerRadius).Parent = toast
    Util.stroke(theme.accentDim, 1).Parent = toast
    Util.padding({ top = 12, bottom = 12, left = 14, right = 14 }).Parent = toast
    Util.listLayout({ gap = 4 }).Parent = toast

    local accentBar = Util.create("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        Position = UDim2.new(0, -14, 0, 0),
        BackgroundColor3 = config.accent or theme.accent,
        BorderSizePixel = 0, Parent = toast,
    })
    Util.corner(2).Parent = accentBar

    Util.create("TextLabel", {
        Text = tostring(config.title or "Notification"),
        Font = theme.fontBold, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Parent = toast,
    })
    if config.message then
        Util.create("TextLabel", {
            Text = tostring(config.message),
            Font = theme.font, TextSize = theme.fontSizeSm, TextColor3 = theme.muted,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, Parent = toast,
        })
    end
    task.delay(config.duration or 4, function()
        if toast and toast.Parent then toast:Destroy() end
    end)
    return toast
end

