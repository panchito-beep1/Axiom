--  Validators & Key System
-- ════════════════════════════════════════════════════════════════════════════
Axiom.Validators = {}

function Axiom.Validators.GamePass(passId, options)
    options = options or {}
    return {
        Tier = options.Tier or "VIP",
        Validate = function()
            local MPS = game:GetService("MarketplaceService")
            local ok, owns = pcall(MPS.UserOwnsGamePassAsync, MPS, LocalPlayer.UserId, passId)
            return ok and owns
        end,
    }
end

function Axiom.Validators.UserId(ids, options)
    options = options or {}
    local set = {}
    for _, id in ipairs(ids) do set[id] = true end
    return {
        Tier = options.Tier or "Developer",
        Validate = function() return set[LocalPlayer.UserId] == true end,
    }
end

function Axiom:CreateKeySystem(config)
    config = config or {}
    local theme = self._theme or Axiom.DefaultTheme
    local title = config.Title or "Key Verification"
    local callback = config.Callback or function() end

    return self:OpenPopup({
        Title = title,
        Size = UDim2.new(0, 340, 0, 150),
        Content = function(popup, closeFn)
            popup:AddLabel({ Text = config.Description or "Enter your access key to continue:" })
            local keyInput = popup:AddTextBox({ Placeholder = "Enter key here..." })
            popup:AddButton({
                Text = "Submit Key",
                Callback = function()
                    local key = keyInput:GetValue()
                    if key and #key > 0 then
                        closeFn()
                        safeCall(callback, key)
                    end
                end,
            })
        end,
    })
end

