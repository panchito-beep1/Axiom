-- ---------- Keybind ----------
function Components.keybind(section, config)
    local theme   = section._theme
    local value   = config.default
    local listeners, enabled = {}, not config.disabled
    local capturing, captureConn = false, nil

    local row = rowFrame(section._content, theme, config.description and 46 or 32)
    describeRow(row, theme, config, 160)

    local btn = Util.create("TextButton", {
        Text = "", Size = UDim2.new(0, 150, 0, 24),
        Position = UDim2.new(1, 0, 0, 4), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = theme.surface, BorderSizePixel = 0,
        AutoButtonColor = false, Parent = row,
    })
    Util.corner(theme.cornerRadius).Parent = btn
    Util.stroke(theme.border, 1).Parent = btn

    local valLbl = Util.create("TextLabel", {
        Text = (typeof(value) == "EnumItem") and value.Name or "None",
        Font = theme.font, TextSize = 12, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), Parent = btn,
    })

    local function stopCapture()
        capturing = false
        if captureConn then captureConn:Disconnect(); captureConn = nil end
        valLbl.Text = (typeof(value) == "EnumItem") and value.Name or "None"
    end
    local function startCapture()
        capturing = true
        valLbl.Text = "[press key…]"
        captureConn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local key = input.KeyCode
            if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                value = nil
            else
                value = key
            end
            stopCapture()
            if config.callback then config.callback(value) end
            for _, cb in ipairs(listeners) do cb(value) end
        end)
    end

    local obj = { _root = row }
    function obj:get() return value end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    function obj:set(v, silent)
        if not enabled then return end
        value = v
        valLbl.Text = (typeof(v) == "EnumItem") and v.Name or "None"
        if not silent then
            if config.callback then config.callback(v) end
            for _, cb in ipairs(listeners) do cb(v) end
        end
    end
    local conn = btn.MouseButton1Click:Connect(function()
        if not enabled then return end
        if capturing then stopCapture() else startCapture() end
    end)
    local orig = obj.destroy
    function obj:destroy() conn:Disconnect(); stopCapture(); orig() end
    return obj
end

-- ---------- ColorPicker ----------
function Components.colorpicker(section, config)
    local theme = section._theme
    local color = config.default or Color3.fromRGB(255, 255, 255)
    local listeners, enabled = {}, not config.disabled
    local popup, backdrop

    local row = rowFrame(section._content, theme, config.description and 46 or 32)
    describeRow(row, theme, config, 60)

    local swatch = Util.create("TextButton", {
        Text = "", Size = UDim2.fromOffset(48, 22),
        Position = UDim2.new(1, 0, 0, 5), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = color, BorderSizePixel = 0,
        AutoButtonColor = false, Parent = row,
    })
    Util.corner(theme.cornerRadius).Parent = swatch
    Util.stroke(theme.border, 1).Parent = swatch

    local obj = { _root = row }
    function obj:get() return color end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    function obj:set(c, silent)
        if not enabled then return end
        color = c; swatch.BackgroundColor3 = c
        if not silent then
            if config.callback then config.callback(c) end
            for _, cb in ipairs(listeners) do cb(c) end
        end
    end

    local function closePopup()
        if popup then popup:Destroy(); popup = nil end
        if backdrop then backdrop:Destroy(); backdrop = nil end
    end

    local function openPopup()
        if popup then return end
        local win = section._tab._window
        backdrop = Util.create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 998, Parent = win._root,
        })
        backdrop.MouseButton1Click:Connect(closePopup)

        local sAbs, wAbs = swatch.AbsolutePosition, win._root.AbsolutePosition
        popup = Util.create("Frame", {
            Size = UDim2.fromOffset(220, 130),
            Position = UDim2.fromOffset(sAbs.X - wAbs.X - 170, sAbs.Y - wAbs.Y + 28),
            BackgroundColor3 = theme.surface, BorderSizePixel = 0,
            ZIndex = 999, Parent = win._root,
        })
        Util.corner(theme.cornerRadius).Parent = popup
        Util.stroke(theme.border, 1).Parent = popup
        Util.padding({ top = 8, bottom = 8, left = 8, right = 8 }).Parent = popup
        Util.listLayout({ gap = 6 }).Parent = popup

        local values = {
            R = math.floor(color.R * 255 + 0.5),
            G = math.floor(color.G * 255 + 0.5),
            B = math.floor(color.B * 255 + 0.5),
        }
        for _, key in ipairs({ "R", "G", "B" }) do
            local line = Util.create("Frame", {
                Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
                ZIndex = 1000, Parent = popup,
            })
            Util.create("TextLabel", {
                Text = key, Font = theme.font, TextSize = 12, TextColor3 = theme.muted,
                BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 24),
                ZIndex = 1000, Parent = line,
            })
            local track = Util.create("Frame", {
                Size = UDim2.new(1, -50, 0, 4),
                Position = UDim2.new(0, 20, 0.5, 0),
                BackgroundColor3 = theme.background, BorderSizePixel = 0,
                ZIndex = 1000, Parent = line,
            })
            Util.corner(2).Parent = track
            local fill = Util.create("Frame", {
                Size = UDim2.new(values[key] / 255, 0, 1, 0),
                BackgroundColor3 = theme.accent, BorderSizePixel = 0,
                ZIndex = 1000, Parent = track,
            })
            Util.corner(2).Parent = fill
            local box = Util.create("TextBox", {
                Text = tostring(values[key]), Font = theme.font,
                TextSize = 12, TextColor3 = theme.text, BackgroundTransparency = 1,
                BorderSizePixel = 0, Size = UDim2.fromOffset(36, 24),
                Position = UDim2.new(1, -36, 0, 0),
                TextXAlignment = Enum.TextXAlignment.Right,
                ClearTextOnFocus = false, ZIndex = 1000, Parent = line,
            })
            box.FocusLost:Connect(function()
                local n = math.clamp(tonumber(box.Text) or values[key], 0, 255)
                values[key] = n; box.Text = tostring(n)
                fill.Size = UDim2.new(n / 255, 0, 1, 0)
                obj:set(Color3.fromRGB(values.R, values.G, values.B))
            end)
        end
        local hex = Util.create("TextLabel", {
            Text = string.format("#%02X%02X%02X", values.R, values.G, values.B),
            Font = theme.font, TextSize = 12, TextColor3 = theme.text,
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20),
            ZIndex = 1000, Parent = popup,
        })
        obj:onChanged(function(c)
            hex.Text = string.format("#%02X%02X%02X",
                math.floor(c.R * 255 + 0.5),
                math.floor(c.G * 255 + 0.5),
                math.floor(c.B * 255 + 0.5))
        end)
    end

    local conn = swatch.MouseButton1Click:Connect(function()
        if not enabled then return end
        if popup then closePopup() else openPopup() end
    end)
    local orig = obj.destroy
    function obj:destroy() conn:Disconnect(); closePopup(); orig() end
    return obj
end

