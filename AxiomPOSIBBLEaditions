-- ════════════════════════════════════════════════════════════════════════════
--  AddTable (Sortable Columns, Selectable Rows, Hidden Headers, Row Colors)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddTable(options)
    options = options or {}
    local theme = getTheme(self)

    local headers        = options.Headers or {}
    local rows           = options.Rows or {}
    local headerHeight   = options.HideHeaders and 0 or (options.HeaderHeight or 24)
    local rowHeight      = options.RowHeight or 22
    local maxHeight      = options.MaxHeight or 200
    local sortable       = options.Sortable ~= false
    local selectable     = options.Selectable ~= false
    local multiSelect    = options.MultiSelect or false
    local altRowColors   = options.AlternateRowColors ~= false
    local rowColor1      = options.RowColor1 or theme.TableRowBg
    local rowColor2      = options.RowColor2 or theme.TableRowBgAlt
    local selectedColor  = options.SelectedColor or theme.TableSelected or theme.Accent
    local onSelect       = options.OnSelect

    local currentRows = {}
    for i, r in ipairs(rows) do currentRows[i] = r end

    local selectedIndices = {}
    local sortCol = nil
    local sortAsc = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, math.min(#currentRows * rowHeight + headerHeight + 2, maxHeight))
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page
    applyCorner(container, 2)
    applyBorder(container, theme.TableBorderStrong or theme.Border)

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = theme.ScrollbarGrab
    scroll.Parent = container

    local headerFrame
    local headerButtons = {}
    if not options.HideHeaders and #headers > 0 then
        headerFrame = Instance.new("Frame")
        headerFrame.BackgroundColor3 = theme.TableHeaderBg or theme.TitleBg
        headerFrame.Size = UDim2.new(1, 0, 0, headerHeight)
        headerFrame.Parent = scroll
        applyBorder(headerFrame, theme.TableBorderStrong or theme.Border)

        local colW = 1 / #headers
        for i, headerTitle in ipairs(headers) do
            local hBtn = Instance.new("TextButton")
            hBtn.BackgroundTransparency = 1
            hBtn.Position = UDim2.new((i - 1) * colW, 0, 0, 0)
            hBtn.Size = UDim2.new(colW, 0, 1, 0)
            hBtn.Font = Enum.Font.RobotoMono
            hBtn.Text = headerTitle
            hBtn.TextColor3 = theme.Text
            hBtn.TextSize = 12
            hBtn.TextXAlignment = Enum.TextXAlignment.Center
            hBtn.Parent = headerFrame

            if sortable then
                hBtn.MouseButton1Click:Connect(function()
                    if sortCol == i then
                        sortAsc = not sortAsc
                    else
                        sortCol = i
                        sortAsc = true
                    end
                    for idx, b in ipairs(headerButtons) do
                        b.Text = headers[idx] .. ((idx == sortCol) and (sortAsc and " ▲" or " ▼") or "")
                    end
                    table.sort(currentRows, function(a, b)
                        local va, vb = a[sortCol], b[sortCol]
                        if tonumber(va) and tonumber(vb) then
                            return sortAsc and (tonumber(va) < tonumber(vb)) or (tonumber(va) > tonumber(vb))
                        else
                            return sortAsc and (tostring(va):lower() < tostring(vb):lower()) or (tostring(va):lower() > tostring(vb):lower())
                        end
                    end)
                    refreshRows()
                end)
            end
            table.insert(headerButtons, hBtn)
        end
    end

    local rowFrames = {}
    function refreshRows()
        for _, rf in ipairs(rowFrames) do rf:Destroy() end
        table.clear(rowFrames)

        local colW = #headers > 0 and (1 / #headers) or 1
        for r, rowData in ipairs(currentRows) do
            local isSel = selectedIndices[r] == true
            local bg = isSel and selectedColor or (altRowColors and (r % 2 == 0 and rowColor2 or rowColor1) or rowColor1)

            local rowBtn = Instance.new("TextButton")
            rowBtn.BackgroundColor3 = bg
            rowBtn.Position = UDim2.new(0, 0, 0, headerHeight + (r - 1) * rowHeight)
            rowBtn.Size = UDim2.new(1, 0, 0, rowHeight)
            rowBtn.Text = ""
            rowBtn.AutoButtonColor = false
            rowBtn.Parent = scroll
            applyBorder(rowBtn, theme.TableBorderLight or theme.Border)

            for c = 1, math.max(#headers, #rowData) do
                local cell = rowData[c]
                local cellLbl = Instance.new("TextLabel")
                cellLbl.BackgroundTransparency = 1
                cellLbl.Position = UDim2.new((c - 1) * colW, 0, 0, 0)
                cellLbl.Size = UDim2.new(colW, 0, 1, 0)
                cellLbl.Font = Enum.Font.RobotoMono
                cellLbl.Text = tostring(cell or "")
                cellLbl.TextColor3 = isSel and Color3.new(1, 1, 1) or theme.SubText
                cellLbl.TextSize = 12
                cellLbl.TextXAlignment = Enum.TextXAlignment.Center
                cellLbl.TextTruncate = Enum.TextTruncate.AtEnd
                cellLbl.Parent = rowBtn
            end

            if selectable then
                rowBtn.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selectedIndices[r] = not selectedIndices[r]
                    else
                        local wasSel = selectedIndices[r]
                        table.clear(selectedIndices)
                        selectedIndices[r] = not wasSel
                    end
                    refreshRows()
                    local selList = {}
                    for idx, s in pairs(selectedIndices) do
                        if s and currentRows[idx] then table.insert(selList, currentRows[idx]) end
                    end
                    safeCall(onSelect, selList, r)
                end)
            end

            table.insert(rowFrames, rowBtn)
        end

        local totalContentH = headerHeight + #currentRows * rowHeight
        scroll.CanvasSize = UDim2.new(0, 0, 0, totalContentH)
        container.Size = UDim2.new(1, 0, 0, math.min(totalContentH + 2, maxHeight))
    end
    refreshRows()

    local tableObj = { _instance = container }
    function tableObj:SetData(newRows)
        currentRows = {}
        for i, r in ipairs(newRows) do currentRows[i] = r end
        table.clear(selectedIndices)
        refreshRows()
    end
    function tableObj:GetSelected()
        local selList = {}
        for idx, s in pairs(selectedIndices) do
            if s and currentRows[idx] then table.insert(selList, currentRows[idx]) end
        end
        return selList
    end
    function tableObj:ClearSelection()
        table.clear(selectedIndices)
        refreshRows()
    end
    function tableObj:SelectRow(idx)
        selectedIndices[idx] = true
        refreshRows()
    end
    function tableObj:Destroy() container:Destroy() end
    return tableObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddPlotHistogram (Block/Bar Graph with Negative Values & Zero-Line Baseline)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddPlotHistogram(options)
    options = options or {}
    local theme = getTheme(self)

    local title       = options.Title or "Histogram"
    local maxPoints   = options.MaxPoints or 40
    local barColor    = options.BarColor or theme.PlotHistogram
    local negColor    = options.BarNegativeColor or theme.PlotHistogramNeg
    local zeroColor   = options.ZeroLineColor or theme.PlotZeroLine
    local gridColor   = options.GridColor or theme.PlotGrid
    local fixedMin    = options.YMin
    local fixedMax    = options.YMax
    local overlayText = options.OverlayText or ""
    local graphH      = options.Height or 80

    local data = {}
    if options.Values then
        for _, v in ipairs(options.Values) do table.insert(data, tonumber(v) or 0) end
    end

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, graphH + 28)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0, 4, 0, 0)
    titleLbl.Size = UDim2.new(1, -8, 0, 18)
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.Text
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = container

    local graphFrame = Instance.new("Frame")
    graphFrame.BackgroundColor3 = theme.GraphBg
    graphFrame.Position = UDim2.new(0, 0, 0, 20)
    graphFrame.Size = UDim2.new(1, 0, 0, graphH)
    graphFrame.ClipsDescendants = true
    graphFrame.Parent = container
    applyCorner(graphFrame, 2)
    applyBorder(graphFrame, theme.Border)

    -- Grid lines:
    local gridMid = Instance.new("Frame")
    gridMid.BackgroundColor3 = gridColor
    gridMid.Size = UDim2.new(1, 0, 0, 1)
    gridMid.Position = UDim2.new(0, 0, 0.5, 0)
    gridMid.ZIndex = 1
    gridMid.Parent = graphFrame

    -- Emphasized zero baseline:
    local zeroLine = Instance.new("Frame")
    zeroLine.BackgroundColor3 = zeroColor
    zeroLine.Size = UDim2.new(1, 0, 0, 1.5)
    zeroLine.Visible = false
    zeroLine.ZIndex = 3
    zeroLine.Parent = graphFrame

    local overlayLbl = Instance.new("TextLabel")
    overlayLbl.BackgroundTransparency = 1
    overlayLbl.Position = UDim2.new(0, 6, 0, 2)
    overlayLbl.Size = UDim2.new(1, -12, 0, 16)
    overlayLbl.Font = Enum.Font.RobotoMono
    overlayLbl.Text = overlayText
    overlayLbl.TextColor3 = theme.SubText
    overlayLbl.TextSize = 11
    overlayLbl.TextXAlignment = Enum.TextXAlignment.Right
    overlayLbl.ZIndex = 5
    overlayLbl.Parent = graphFrame

    local barHolder = Instance.new("Frame")
    barHolder.BackgroundTransparency = 1
    barHolder.Size = UDim2.new(1, 0, 1, 0)
    barHolder.ZIndex = 2
    barHolder.Parent = graphFrame

    local barsPool = {}
    local function redraw()
        for _, b in ipairs(barsPool) do b:Destroy() end
        table.clear(barsPool)

        local count = #data
        if count == 0 then return end

        local lo = fixedMin or math.huge
        local hi = fixedMax or -math.huge
        if not (fixedMin and fixedMax) then
            for _, v in ipairs(data) do
                if v < lo then lo = v end
                if v > hi then hi = v end
            end
        end
        if lo > 0 then lo = 0 end -- baseline anchor
        if hi < 0 then hi = 0 end
        if hi == lo then hi = lo + 1 end
        local range = hi - lo

        -- Position zero line:
        local zeroYRel = 1 - ((0 - lo) / range)
        if lo < 0 and hi > 0 then
            zeroLine.Position = UDim2.new(0, 0, zeroYRel, 0)
            zeroLine.Visible = true
        else
            zeroLine.Visible = false
        end

        local frameW = graphFrame.AbsoluteSize.X
        local frameH = graphFrame.AbsoluteSize.Y
        if frameW <= 0 or frameH <= 0 then return end

        local barWidth = math.max(2, (frameW / count) - 2)
        local gap = 2

        for i, val in ipairs(data) do
            local bar = Instance.new("TextButton")
            bar.AutoButtonColor = false
            bar.Text = ""
            local x = (i - 1) * (barWidth + gap)

            if val >= 0 then
                local barH = (val / range) * frameH
                bar.BackgroundColor3 = barColor
                bar.Position = UDim2.new(0, x, zeroYRel - (barH / frameH), 0)
                bar.Size = UDim2.new(0, barWidth, 0, math.max(1, barH))
            else
                local barH = (math.abs(val) / range) * frameH
                bar.BackgroundColor3 = negColor
                bar.Position = UDim2.new(0, x, zeroYRel, 0)
                bar.Size = UDim2.new(0, barWidth, 0, math.max(1, barH))
            end
            applyCorner(bar, 1)
            bar.Parent = barHolder

            attachTooltip(bar, string.format("[%d] Value: %.2f", i, val), self._window, 0)
            table.insert(barsPool, bar)
        end
    end

    graphFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(redraw)
    task.defer(redraw)

    local plotObj = { _instance = container }
    function plotObj:Push(val)
        table.insert(data, tonumber(val) or 0)
        if #data > maxPoints then table.remove(data, 1) end
        redraw()
    end
    function plotObj:SetValues(vals)
        data = {}
        for _, v in ipairs(vals) do table.insert(data, tonumber(v) or 0) end
        redraw()
    end
    function plotObj:SetOverlayText(t)
        overlayText = tostring(t)
        overlayLbl.Text = overlayText
    end
    function plotObj:Clear()
        data = {}
        redraw()
    end
    function plotObj:Destroy() container:Destroy() end
    return plotObj
end
TabComponent.AddHistogram = TabComponent.AddPlotHistogram
TabComponent.AddBarGraph   = TabComponent.AddPlotHistogram

-- ════════════════════════════════════════════════════════════════════════════
--  AddLineGraph (Multi-Series Line Plots with Gridlines & Axis Scale Ticks)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddLineGraph(options)
    options = options or {}
    local theme = getTheme(self)

    local title       = options.Title or "Line Plot"
    local maxPoints   = options.MaxPoints or 60
    local fixedMin    = options.YMin
    local fixedMax    = options.YMax
    local graphH      = options.Height or 90
    local showGrid    = options.GridLines ~= false
    local showTicks   = options.AxisLabels ~= false

    -- Multi-series setup:
    local rawSeries = options.Series or { { Name = "Value", Color = options.LineColor or theme.PlotLines } }
    local seriesList = {}
    for i, s in ipairs(rawSeries) do
        table.insert(seriesList, {
            Name    = s.Name or ("Series " .. i),
            Color   = s.Color or theme.PlotLines,
            Data    = {},
            Visible = true,
        })
    end

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, graphH + 42)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0, 4, 0, 0)
    titleLbl.Size = UDim2.new(0.5, 0, 0, 18)
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.Text
    titleLbl.TextSize = 12
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = container

    -- Legend bar:
    local legend = Instance.new("Frame")
    legend.BackgroundTransparency = 1
    legend.Position = UDim2.new(0.5, 0, 0, 0)
    legend.Size = UDim2.new(0.5, -4, 0, 18)
    legend.Parent = container

    local legendLayout = Instance.new("UIListLayout")
    legendLayout.FillDirection = Enum.FillDirection.Horizontal
    legendLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    legendLayout.SortOrder = Enum.SortOrder.LayoutOrder
    legendLayout.Padding = UDim.new(0, 8)
    legendLayout.Parent = legend

    local graphFrame = Instance.new("Frame")
    graphFrame.BackgroundColor3 = theme.GraphBg
    graphFrame.Position = UDim2.new(0, 0, 0, 20)
    graphFrame.Size = UDim2.new(1, 0, 0, graphH)
    graphFrame.ClipsDescendants = true
    graphFrame.Parent = container
    applyCorner(graphFrame, 2)
    applyBorder(graphFrame, theme.Border)

    -- Axis Ticks:
    local tickMax = Instance.new("TextLabel")
    tickMax.BackgroundTransparency = 1
    tickMax.Position = UDim2.new(1, -50, 0, 2)
    tickMax.Size = UDim2.new(0, 46, 0, 12)
    tickMax.Font = Enum.Font.RobotoMono
    tickMax.Text = "+100"
    tickMax.TextColor3 = theme.SubText
    tickMax.TextSize = 10
    tickMax.TextXAlignment = Enum.TextXAlignment.Right
    tickMax.ZIndex = 5
    tickMax.Parent = graphFrame

    local tickMin = Instance.new("TextLabel")
    tickMin.BackgroundTransparency = 1
    tickMin.Position = UDim2.new(1, -50, 1, -14)
    tickMin.Size = UDim2.new(0, 46, 0, 12)
    tickMin.Font = Enum.Font.RobotoMono
    tickMin.Text = "0"
    tickMin.TextColor3 = theme.SubText
    tickMin.TextSize = 10
    tickMin.TextXAlignment = Enum.TextXAlignment.Right
    tickMin.ZIndex = 5
    tickMin.Parent = graphFrame

    -- Grid lines:
    if showGrid then
        for _, pct in ipairs({0.25, 0.5, 0.75}) do
            local g = Instance.new("Frame")
            g.BackgroundColor3 = theme.PlotGrid or theme.Border
            g.Position = UDim2.new(0, 0, pct, 0)
            g.Size = UDim2.new(1, 0, 0, 1)
            g.ZIndex = 1
            g.Parent = graphFrame
        end
    end

    local zeroLine = Instance.new("Frame")
    zeroLine.BackgroundColor3 = theme.PlotZeroLine
    zeroLine.Size = UDim2.new(1, 0, 0, 1.5)
    zeroLine.Visible = false
    zeroLine.ZIndex = 2
    zeroLine.Parent = graphFrame

    local linePool = {}
    local poolIndex = 0

    local function getLine()
        poolIndex = poolIndex + 1
        if linePool[poolIndex] then
            linePool[poolIndex].Visible = true
            return linePool[poolIndex]
        end
        local seg = Instance.new("Frame")
        seg.BorderSizePixel = 0
        seg.ZIndex = 3
        seg.Parent = graphFrame
        linePool[poolIndex] = seg
        return seg
    end

    local function redraw()
        for _, l in ipairs(linePool) do l.Visible = false end
        poolIndex = 0

        local globalMin = fixedMin or math.huge
        local globalMax = fixedMax or -math.huge
        local hasData = false

        for _, s in ipairs(seriesList) do
            if s.Visible and #s.Data > 0 then
                hasData = true
                if not (fixedMin and fixedMax) then
                    for _, v in ipairs(s.Data) do
                        if v < globalMin then globalMin = v end
                        if v > globalMax then globalMax = v end
                    end
                end
            end
        end

        if not hasData then return end
        if globalMax == globalMin then globalMax = globalMin + 1 end
        local range = globalMax - globalMin

        tickMax.Text = string.format("%.1f", globalMax)
        tickMin.Text = string.format("%.1f", globalMin)

        if globalMin < 0 and globalMax > 0 then
            local zPct = 1 - ((0 - globalMin) / range)
            zeroLine.Position = UDim2.new(0, 0, zPct, 0)
            zeroLine.Visible = true
        else
            zeroLine.Visible = false
        end

        local W = graphFrame.AbsoluteSize.X
        local H = graphFrame.AbsoluteSize.Y
        if W <= 0 or H <= 0 then return end

        for _, s in ipairs(seriesList) do
            if s.Visible and #s.Data >= 2 then
                local pts = s.Data
                local stepX = W / (maxPoints - 1)
                for i = 1, #pts - 1 do
                    local x1 = (i - 1) * stepX
                    local y1 = H - (((pts[i] - globalMin) / range) * H)
                    local x2 = i * stepX
                    local y2 = H - (((pts[i + 1] - globalMin) / range) * H)

                    local dx = x2 - x1
                    local dy = y2 - y1
                    local dist = math.sqrt(dx * dx + dy * dy)
                    local angle = math.deg(math.atan2(dy, dx))

                    local line = getLine()
                    line.BackgroundColor3 = s.Color
                    line.Size = UDim2.new(0, dist, 0, 2)
                    line.Position = UDim2.new(0, x1, 0, y1)
                    line.Rotation = angle
                    line.AnchorPoint = Vector2.new(0, 0.5)
                end
            end
        end
    end

    -- Build interactive legend:
    for _, s in ipairs(seriesList) do
        local item = Instance.new("TextButton")
        item.BackgroundTransparency = 1
        item.Size = UDim2.new(0, 60, 1, 0)
        item.Font = Enum.Font.RobotoMono
        item.Text = "■ " .. s.Name
        item.TextColor3 = s.Color
        item.TextSize = 11
        item.Parent = legend

        item.MouseButton1Click:Connect(function()
            s.Visible = not s.Visible
            item.TextColor3 = s.Visible and s.Color or theme.TextDisabled
            redraw()
        end)
    end

    graphFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(redraw)
    task.defer(redraw)

    local graphObj = { _instance = container }
    function graphObj:Push(seriesNameOrVal, maybeVal)
        if maybeVal == nil then
            -- Single series push
            local val = tonumber(seriesNameOrVal) or 0
            local s = seriesList[1]
            table.insert(s.Data, val)
            if #s.Data > maxPoints then table.remove(s.Data, 1) end
        else
            local name = tostring(seriesNameOrVal)
            local val  = tonumber(maybeVal) or 0
            for _, s in ipairs(seriesList) do
                if s.Name == name then
                    table.insert(s.Data, val)
                    if #s.Data > maxPoints then table.remove(s.Data, 1) end
                    break
                end
            end
        end
        redraw()
    end
    function graphObj:Clear()
        for _, s in ipairs(seriesList) do s.Data = {} end
        redraw()
    end
    function graphObj:Destroy() container:Destroy() end
    return graphObj
end
TabComponent.AddGraph = TabComponent.AddLineGraph

-- ════════════════════════════════════════════════════════════════════════════
--  Notifications (Axiom:Notify)
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:Notify(options)
    options = options or {}
    local theme = self._theme or Axiom.DefaultTheme

    local title    = options.Title or "Notification"
    local desc     = options.Description or options.Message or ""
    local duration = options.Duration or 3.5
    local nType    = (options.Type or "info"):lower()

    if not self._notificationGui then
        local sg = Instance.new("ScreenGui")
        sg.Name = "Axiom_Notifications"
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 9999
        sg.Parent = CoreGui

        local holder = Instance.new("Frame")
        holder.BackgroundTransparency = 1
        holder.Position = UDim2.new(1, -280, 1, -20)
        holder.AnchorPoint = Vector2.new(0, 1)
        holder.Size = UDim2.new(0, 260, 1, -40)
        holder.Parent = sg

        local layout = Instance.new("UIListLayout")
        layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 8)
        layout.Parent = holder

        self._notificationGui    = sg
        self._notificationHolder = holder
    end

    local typeColors = {
        info    = theme.Accent,
        success = Color3.fromRGB(60, 190, 100),
        warn    = Color3.fromRGB(240, 175, 45),
        error   = Color3.fromRGB(230, 65, 65),
    }
    local accentColor = typeColors[nType] or theme.Accent

    local card = Instance.new("Frame")
    card.BackgroundColor3 = theme.NotifyBg or theme.WindowBg
    card.Size = UDim2.new(1, 0, 0, 56)
    card.Position = UDim2.new(1, 40, 0, 0)
    card.Parent = self._notificationHolder
    applyCorner(card, 3)
    applyBorder(card, theme.Border)

    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = accentColor
    bar.Size = UDim2.new(0, 4, 1, 0)
    bar.Parent = card
    applyCorner(bar, 2)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0, 12, 0, 6)
    titleLbl.Size = UDim2.new(1, -20, 0, 18)
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.NotifyTitle or theme.Text
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.RichText = true
    titleLbl.Parent = card

    local descLbl = Instance.new("TextLabel")
    descLbl.BackgroundTransparency = 1
    descLbl.Position = UDim2.new(0, 12, 0, 24)
    descLbl.Size = UDim2.new(1, -20, 0, 26)
    descLbl.Font = Enum.Font.RobotoMono
    descLbl.Text = desc
    descLbl.TextColor3 = theme.NotifyMsg or theme.SubText
    descLbl.TextSize = 11
    descLbl.TextXAlignment = Enum.TextXAlignment.Left
    descLbl.TextWrapped = true
    descLbl.RichText = true
    descLbl.Parent = card

    TweenService:Create(card, TWEEN_MID, { Position = UDim2.new(0, 0, 0, 0) }):Play()

    task.delay(duration, function()
        local tw = TweenService:Create(card, TWEEN_MID, { Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1 })
        tw:Play()
        tw.Completed:Connect(function() card:Destroy() end)
    end)
end

-- ════════════════════════════════════════════════════════════════════════════
--  Modal Popup with Dim Backdrop (ImGui::OpenPopup / Modal)
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:OpenPopup(options)
    options = options or {}
    local theme = self._theme or Axiom.DefaultTheme

    local title       = options.Title or "Popup"
    local size        = options.Size or UDim2.new(0, 360, 0, 200)
    local dimBackdrop = options.DimBackdrop ~= false
    local closeOnDim  = options.CloseOnBackdropClick ~= false
    local contentFn   = options.Content

    local screen = Instance.new("ScreenGui")
    screen.Name = "Axiom_ModalPopup"
    screen.ResetOnSpawn = false
    screen.DisplayOrder = Axiom._WindowManager.TopDisplayOrder + 100
    screen.Parent = CoreGui

    local backdrop = Instance.new("TextButton")
    backdrop.BackgroundColor3 = theme.ModalDim or Color3.fromRGB(0, 0, 0)
    backdrop.BackgroundTransparency = 1
    backdrop.Size = UDim2.new(1, 0, 1, 0)
    backdrop.Text = ""
    backdrop.AutoButtonColor = false
    backdrop.Parent = screen

    if dimBackdrop then
        TweenService:Create(backdrop, TWEEN_MID, { BackgroundTransparency = 0.55 }):Play()
    end

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = theme.PopupBg or theme.WindowBg
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.new(0.5, 0, 0.48, 0)
    frame.Size = size
    frame.ClipsDescendants = true
    frame.Parent = backdrop
    applyCorner(frame, 3)
    applyBorder(frame, theme.Border, 1.5)

    TweenService:Create(frame, TWEEN_MID, { Position = UDim2.new(0.5, 0, 0.5, 0) }):Play()

    local titleBar = Instance.new("Frame")
    titleBar.BackgroundColor3 = theme.TitleBgActive or theme.TitleBg
    titleBar.Size = UDim2.new(1, 0, 0, 24)
    titleBar.Parent = frame
    applyCorner(titleBar, 3)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Position = UDim2.new(0, 8, 0, 0)
    titleLbl.Size = UDim2.new(1, -36, 1, 0)
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.Text
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = titleBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.BackgroundTransparency = 1
    closeBtn.Position = UDim2.new(1, -22, 0, 0)
    closeBtn.Size = UDim2.new(0, 22, 1, 0)
    closeBtn.Font = Enum.Font.RobotoMono
    closeBtn.Text = "×"
    closeBtn.TextColor3 = theme.SubText
    closeBtn.TextSize = 16
    closeBtn.Parent = titleBar

    local body = Instance.new("ScrollingFrame")
    body.BackgroundTransparency = 1
    body.Position = UDim2.new(0, 0, 0, 24)
    body.Size = UDim2.new(1, 0, 1, -24)
    body.ScrollBarThickness = 4
    body.ScrollBarImageColor3 = theme.Accent
    body.Parent = frame
    applyPadding(body, 8)

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Padding = UDim.new(0, 6)
    bodyLayout.Parent = body
    bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        body.CanvasSize = UDim2.new(0, 0, 0, bodyLayout.AbsoluteContentSize.Y + 16)
    end)

    local function closePopup()
        local tw = TweenService:Create(backdrop, TWEEN_FAST, { BackgroundTransparency = 1 })
        TweenService:Create(frame, TWEEN_FAST, { Position = UDim2.new(0.5, 0, 0.52, 0) }):Play()
        tw:Play()
        tw.Completed:Connect(function() screen:Destroy() end)
    end

    closeBtn.MouseButton1Click:Connect(closePopup)
    if closeOnDim then
        backdrop.MouseButton1Click:Connect(function() closePopup() end)
        frame.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                -- absorb click
            end
        end)
    end

    makeDraggable(frame, titleBar)

    local popupTab = setmetatable({
        _page          = body,
        _window        = self,
        _layoutOrder   = 0,
        _disabledStack = {},
    }, TabComponent)

    if contentFn then safeCall(contentFn, popupTab, closePopup) end

    local popupObj = { Container = frame, Screen = screen }
    function popupObj:Close() closePopup() end
    return popupObj
end
Axiom.ShowDialog = Axiom.OpenPopup

