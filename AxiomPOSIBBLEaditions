        descLbl.AutomaticSize = Enum.AutomaticSize.Y
        descLbl.Position = UDim2.new(0, 0, 0, 20)
        descLbl.Parent = inner
    end

    -- Fade in
    card.BackgroundTransparency = 1
    TweenService:Create(card, TWEEN_MID, { BackgroundTransparency = 0 }):Play()

    -- Auto dismiss
    task.delay(dur, function()
        if card and card.Parent then
            TweenService:Create(card, TWEEN_SLOW, { BackgroundTransparency = 1 }):Play()
            task.delay(0.4, function()
                if card and card.Parent then card:Destroy() end
            end)
        end
    end)

    return card
end

-- ── Destroy ────────────────────────────────────────────────────────────────────
function Axiom:Destroy()
    Axiom._WindowManager:Unregister(self)
    if self._screen and self._screen.Parent then
        self._screen:Destroy()
    end
    if self._notificationGui and self._notificationGui.Parent then
        self._notificationGui:Destroy()
    end
end

-- ── CreateWindowChrome ─────────────────────────────────────────────────────────
Axiom._Internal = {}

function Axiom._Internal.CreateWindowChrome(opts)
    opts = opts or {}
    local owner  = opts.Owner      -- Axiom instance
    local title  = opts.Title  or "Window"
    local size   = opts.Size   or UDim2.new(0, 500, 0, 400)
    local pos    = opts.Position or UDim2.new(0.5, -250, 0.5, -200)
    local theme  = opts.Theme  or Axiom.DefaultTheme

    -- Screen GUI
    local screen = Instance.new("ScreenGui")
    screen.Name = "AxiomWindow_" .. title
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.DisplayOrder = 10
    screen.IgnoreGuiInset = true
    screen.Parent = CoreGui
    if owner then owner._screen = screen end

    -- Main window frame
    local win = Instance.new("Frame")
    win.Name = "Window"
    win.BackgroundColor3 = theme.WindowBg
    win.BorderSizePixel  = 0
    win.Size     = size
    win.Position = pos
    win.ClipsDescendants = true
    win.Parent = screen
    applyCorner(win, 6)
    applyBorder(win, theme.Border)

    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.BackgroundColor3 = theme.TitleBg
    titleBar.BorderSizePixel  = 0
    titleBar.Size = UDim2.new(1, 0, 0, 28)
    titleBar.Parent = win
    applyCorner(titleBar, 6)
    if owner then owner._titleBar = titleBar end

    -- Make bottom of titlebar square
    local titleSquare = Instance.new("Frame")
    titleSquare.BackgroundColor3 = theme.TitleBg
    titleSquare.BorderSizePixel = 0
    titleSquare.Position = UDim2.new(0, 0, 0.5, 0)
    titleSquare.Size = UDim2.new(1, 0, 0.5, 0)
    titleSquare.Parent = titleBar
    if owner then
        owner:_bindTheme(titleBar,    { BackgroundColor3 = "TitleBg" })
        owner:_bindTheme(titleSquare, { BackgroundColor3 = "TitleBg" })
    end

    -- Title label
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Name = "TitleLabel"
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 13
    titleLbl.TextColor3 = theme.Text
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Position = UDim2.new(0, 10, 0, 0)
    titleLbl.Size = UDim2.new(1, -58, 1, 0)
    titleLbl.Parent = titleBar

    -- Collapse button (–)
    local collapseBtn = Instance.new("TextButton")
    collapseBtn.Name = "CollapseBtn"
    collapseBtn.BackgroundTransparency = 1
    collapseBtn.Text = "–"
    collapseBtn.Font = Enum.Font.GothamBold
    collapseBtn.TextSize = 16
    collapseBtn.TextColor3 = theme.SubText
    collapseBtn.Size = UDim2.new(0, 20, 0, 20)
    collapseBtn.Position = UDim2.new(1, -44, 0, 4)
    collapseBtn.Parent = titleBar

    -- Close button (×)
    local closeBtn = Instance.new("TextButton")
    closeBtn.Name = "CloseBtn"
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "×"
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 18
    closeBtn.TextColor3 = theme.SubText
    closeBtn.Size = UDim2.new(0, 20, 0, 20)
    closeBtn.Position = UDim2.new(1, -20, 0, 4)
    closeBtn.Parent = titleBar

    -- Body frame (below titlebar)
    local body = Instance.new("Frame")
    body.Name = "Body"
    body.BackgroundTransparency = 1
    body.Position = UDim2.new(0, 0, 0, 28)
    body.Size = UDim2.new(1, 0, 1, -28)
    body.Parent = win
    if owner then owner._body = body end

    -- Drag
    makeDraggable(win, titleBar, function(pos)
        -- optional onDragEnd
    end)

    -- Focus on click
    local function bringToFront()
        if owner then Axiom._WindowManager:SetActive(owner) end
    end
    win.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            bringToFront()
        end
    end)

    -- Collapse
    local collapsed = false
    local function toggleCollapse()
        collapsed = not collapsed
        if collapsed then
            TweenService:Create(win, TWEEN_MID, { Size = UDim2.new(size.X.Scale, size.X.Offset, 0, 28) }):Play()
            collapseBtn.Text = "+"
        else
            TweenService:Create(win, TWEEN_MID, { Size = size }):Play()
            collapseBtn.Text = "–"
        end
    end
    collapseBtn.MouseButton1Click:Connect(toggleCollapse)

    -- Close
    closeBtn.MouseButton1Click:Connect(function()
        if owner then owner:Destroy() end
        screen:Destroy()
    end)

    -- Register with window manager
    if owner then
        Axiom._WindowManager:Register(owner)
    end

    return {
        Screen    = screen,
        Window    = win,
        TitleBar  = titleBar,
        Body      = body,
        CloseBtn  = closeBtn,
        CollapseBtn = collapseBtn,
    }
end

-- ── Axiom.new ──────────────────────────────────────────────────────────────────
function Axiom.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Axiom)

    self._theme              = opts.Theme or Axiom.DefaultTheme
    self._themeBindings      = {}
    self._disabledScopeCount = 0
    self._keyboardNavEnabled = opts.KeyboardNav ~= false
    self._focusableWidgets   = {}
    self._notificationCount  = 0
    self._tabs               = {}
    self._activeTab          = nil

    -- Create window chrome
    local chrome = Axiom._Internal.CreateWindowChrome({
        Owner    = self,
        Title    = opts.Title or "Axiom",
        Size     = opts.Size  or UDim2.new(0, 540, 0, 420),
        Position = opts.Position or UDim2.new(0.5, -270, 0.5, -210),
        Theme    = self._theme,
    })

    self._screen  = chrome.Screen
    self._win     = chrome.Window
    self._titleBar = chrome.TitleBar
    self._body    = chrome.Body

    -- Tab bar
    local tabBar = Instance.new("Frame")
    tabBar.Name = "TabBar"
    tabBar.BackgroundColor3 = self._theme.TabBarBg
    tabBar.BorderSizePixel  = 0
    tabBar.Size = UDim2.new(1, 0, 0, 30)
    tabBar.Position = UDim2.new(0, 0, 0, 0)
    tabBar.Parent = self._body
    self:_bindTheme(tabBar, { BackgroundColor3 = "TabBarBg" })

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Padding = UDim.new(0, 2)
    tabLayout.Parent = tabBar
    local tabPad = Instance.new("UIPadding")
    tabPad.PaddingLeft = UDim.new(0, 4)
    tabPad.PaddingTop  = UDim.new(0, 4)
    tabPad.Parent = tabBar

    -- Content area (below tab bar)
    local contentArea = Instance.new("Frame")
    contentArea.Name = "ContentArea"
    contentArea.BackgroundColor3 = self._theme.WindowBg
    contentArea.BorderSizePixel  = 0
    contentArea.Position = UDim2.new(0, 0, 0, 30)
    contentArea.Size = UDim2.new(1, 0, 1, -30)
    contentArea.ClipsDescendants = true
    contentArea.Parent = self._body
    self:_bindTheme(contentArea, { BackgroundColor3 = "WindowBg" })

    self._tabBar     = tabBar
    self._contentArea = contentArea

    -- Search bar support
    self._searchEnabled = false

    -- Enable search box in title bar
    if opts.EnableSearch then
        self:_createSearchBar(opts.EnableSearch)
    end

    return self
end

function Axiom:_createSearchBar(placeholder)
    local theme = self._theme
    local searchFrame = Instance.new("Frame")
    searchFrame.BackgroundColor3 = theme.FrameBg
    searchFrame.BorderSizePixel  = 0
    local width = 160
    searchFrame.Size = UDim2.new(0, width, 0, 18)
    searchFrame.Position = UDim2.new(1, -(44 + 4 + width), 0.5, -9)
    searchFrame.Parent = self._titleBar
    applyCorner(searchFrame, 3)
    self:_bindTheme(searchFrame, { BackgroundColor3 = "FrameBg" })

    local searchBox = Instance.new("TextBox")
    searchBox.BackgroundTransparency = 1
    searchBox.PlaceholderText = placeholder or "Search..."
    searchBox.Text = ""
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextSize = 12
    searchBox.TextColor3 = theme.Text
    searchBox.PlaceholderColor3 = theme.SubText
    searchBox.TextXAlignment = Enum.TextXAlignment.Left
    searchBox.Size = UDim2.new(1, -6, 1, 0)
    searchBox.Position = UDim2.new(0, 6, 0, 0)
    searchBox.ClearTextOnFocus = false
    searchBox.Parent = searchFrame
    self:_bindTheme(searchBox, { TextColor3 = "Text", PlaceholderColor3 = "SubText" })

    self._searchBox   = searchBox
    self._searchFrame = searchFrame
    self._searchEnabled = true
end

-- ── AddTab ─────────────────────────────────────────────────────────────────────
function Axiom:AddTab(tabName, opts)
    opts = opts or {}
    local theme = self._theme

    -- Tab button
    local tabBtn = Instance.new("TextButton")
    tabBtn.Name = "Tab_" .. tabName
    tabBtn.BackgroundColor3 = theme.TabNormal
    tabBtn.BorderSizePixel  = 0
    tabBtn.AutomaticSize = Enum.AutomaticSize.X
    tabBtn.Size = UDim2.new(0, 0, 0, 22)
    tabBtn.Font = Enum.Font.GothamMedium
    tabBtn.TextSize = 12
    tabBtn.TextColor3 = theme.SubText
    tabBtn.LayoutOrder = #self._tabs + 1
    tabBtn.Parent = self._tabBar
    applyCorner(tabBtn, 4)
    applyPadding(tabBtn, 10, 0)
    self:_bindTheme(tabBtn, { BackgroundColor3 = "TabNormal" })

    if opts.Icon then
        addLeftIcon(tabBtn, opts.Icon, 4, 14)
    end

    -- Tab content frame (ScrollingFrame)
    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Name = "TabContent_" .. tabName
    tabFrame.BackgroundTransparency = 1
    tabFrame.BorderSizePixel = 0
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabFrame.ScrollBarThickness = 4
    tabFrame.ScrollBarImageColor3 = theme.ScrollbarGrab
    tabFrame.Visible = false
    tabFrame.Parent = self._contentArea
    self:_bindTheme(tabFrame, { ScrollBarImageColor3 = "ScrollbarGrab" })

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 4)
    layout.Parent = tabFrame
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft   = UDim.new(0, 8)
    pad.PaddingRight  = UDim.new(0, 8)
    pad.PaddingTop    = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.Parent = tabFrame

    -- Build TabComponent
    local tab = setmetatable({}, TabComponent)
    tab._window          = self
    tab._frame           = tabFrame
    tab._btn             = tabBtn
    tab._theme           = theme
    tab._order           = 0
    tab._disabledStack   = {}
    tab._focusableWidgets = {}
    tab._divisionContainer = nil

    table.insert(self._tabs, tab)

    -- Activate first tab automatically
    if #self._tabs == 1 then
        self:_activateTab(tab)
    end

    -- Tab click
    tabBtn.MouseButton1Click:Connect(function()
        self:_activateTab(tab)
    end)
    tabBtn.MouseEnter:Connect(function()
        if self._activeTab ~= tab then
            TweenService:Create(tabBtn, TWEEN_FAST, { BackgroundColor3 = theme.TabHover }):Play()
        end
    end)
    tabBtn.MouseLeave:Connect(function()
        if self._activeTab ~= tab then
            TweenService:Create(tabBtn, TWEEN_FAST, { BackgroundColor3 = theme.TabNormal }):Play()
        end
    end)

    -- Search filtering
    if self._searchEnabled and self._searchBox then
        self._searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            tab:_filterContent(self._searchBox.Text)
        end)
    end

    return tab
end

function Axiom:_activateTab(tab)
    local theme = self._theme
    if self._activeTab then
        self._activeTab._frame.Visible = false
        TweenService:Create(self._activeTab._btn, TWEEN_FAST, {
            BackgroundColor3 = theme.TabNormal,
            TextColor3 = theme.SubText,
        }):Play()
    end
    self._activeTab = tab
    tab._frame.Visible = true
    TweenService:Create(tab._btn, TWEEN_FAST, {
        BackgroundColor3 = theme.TabActive,
        TextColor3 = theme.Text,
    }):Play()
end

function TabComponent:_filterContent(query)
    query = query:lower()
    for _, child in ipairs(self._frame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            local lbl = child:FindFirstChildWhichIsA("TextLabel", true)
            if lbl then
                local vis = query == "" or lbl.Text:lower():find(query, 1, true)
                child.Visible = vis ~= nil
            end
        end
    end
end

-- ── NextOrder helper ───────────────────────────────────────────────────────────
function TabComponent:_nextOrder()
    self._order = self._order + 1
    -- Clear division container if direct call
    self._divisionContainer = nil
    return self._order
end

