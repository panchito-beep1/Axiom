    section.Parent = self._frame
    applyCorner(section, 4)
    applyBorder(section, theme.Border)

    local header = Instance.new("Frame")
    header.Name = "Header"
    header.BackgroundColor3 = theme.Header
    header.BorderSizePixel  = 0
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Parent = section
    applyCorner(header, 4)

    addHeaderIcon(header, opts.Icon)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Text = sectionName
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextColor3 = theme.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Size = UDim2.new(1, -10, 1, 0)
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.Parent = header

    -- Make header square at bottom
    local sq = Instance.new("Frame")
    sq.BackgroundColor3 = theme.Header
    sq.BorderSizePixel = 0
    sq.Position = UDim2.new(0, 0, 0.5, 0)
    sq.Size = UDim2.new(1, 0, 0.5, 0)
    sq.Parent = header

    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "Content"
    contentFrame.BackgroundTransparency = 1
    contentFrame.Position = UDim2.new(0, 0, 0, 24)
    contentFrame.Size = UDim2.new(1, 0, 0, 0)
    contentFrame.AutomaticSize = Enum.AutomaticSize.Y
    contentFrame.Parent = section
    applyPadding(contentFrame, 6, 4)

    local innerLayout = Instance.new("UIListLayout")
    innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    innerLayout.Padding = UDim.new(0, 4)
    innerLayout.Parent = contentFrame

    -- Return a proxy tab that writes into contentFrame
    local sectionTab = setmetatable({}, TabComponent)
    sectionTab._window = self._window
    sectionTab._frame  = contentFrame
    sectionTab._theme  = self._theme
    sectionTab._order  = 0
    sectionTab._disabledStack = {}
    sectionTab._focusableWidgets = {}
    sectionTab._divisionContainer = nil
    function sectionTab:_nextOrder()
        self._order = self._order + 1
        self._divisionContainer = nil
        return self._order
    end
    sectionTab._filterContent = TabComponent._filterContent

    return sectionTab
end

