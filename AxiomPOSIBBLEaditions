-- ── AddCheckboxFlags ──────────────────────────────────────────────────────────
function TabComponent:AddCheckboxFlags(text, flagValue, getFlags, setFlags, opts)
    opts = opts or {}
    local function getCurrentState()
        return bit32.band(getFlags(), flagValue) ~= 0
    end
    return self:AddCheckbox(text, getCurrentState(), function(state)
        local flags = getFlags()
        if state then
            setFlags(bit32.bor(flags, flagValue))
        else
            setFlags(bit32.band(flags, bit32.bnot(flagValue)))
        end
        if opts.OnFlagChanged then opts.OnFlagChanged(getFlags()) end
    end, opts)
end

-- ── AddSlider ─────────────────────────────────────────────────────────────────
function TabComponent:AddSlider(text, min, max, default, callback, opts)
    opts = opts or {}
    local theme = self._theme
    local disabled = opts.Enabled == false
    local step = opts.Step or 1
    local value = math.clamp(default or min, min, max)
    local fmt = opts.Format or "%g"

    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 44)
    frame.LayoutOrder = self:_nextOrder()
    frame.Parent = self._frame

    local topRow = Instance.new("Frame")
    topRow.BackgroundTransparency = 1
    topRow.Size = UDim2.new(1, 0, 0, 20)
    topRow.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.TextColor3 = disabled and theme.TextDisabled or theme.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Parent = topRow

    local valLbl = Instance.new("TextLabel")
    valLbl.BackgroundTransparency = 1
    valLbl.Text = string.format(fmt, value)
    valLbl.Font = Enum.Font.GothamMedium
    valLbl.TextSize = 12
    valLbl.TextColor3 = theme.SubText
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Size = UDim2.new(0.4, 0, 1, 0)
    valLbl.Position = UDim2.new(0.6, 0, 0, 0)
    valLbl.Parent = topRow

    -- Track
    local trackFrame = Instance.new("Frame")
    trackFrame.BackgroundColor3 = theme.SliderTrack
    trackFrame.BorderSizePixel  = 0
    trackFrame.Position = UDim2.new(0, 0, 0, 24)
    trackFrame.Size = UDim2.new(1, 0, 0, 10)
    trackFrame.Parent = frame
    applyCorner(trackFrame, 5)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = theme.SliderFill
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.Parent = trackFrame
    applyCorner(fill, 5)

    -- Ctrl+Click inline edit box
    local editBox = Instance.new("TextBox")
    editBox.BackgroundColor3 = theme.FrameBg
    editBox.BorderSizePixel = 0
    editBox.Text = string.format(fmt, value)
    editBox.Font = Enum.Font.GothamMedium
    editBox.TextSize = 12
    editBox.TextColor3 = theme.Text
    editBox.PlaceholderColor3 = theme.SubText
    editBox.Size = UDim2.new(1, 0, 0, 20)
    editBox.Position = UDim2.new(0, 0, 0, 24)
    editBox.Visible = false
    editBox.Parent = frame
    applyCorner(editBox, 4)
    editBox.FocusLost:Connect(function(enterPressed)
        local n = tonumber(editBox.Text)
        if n then
            value = math.clamp(
                step > 0 and math.round((n - min) / step) * step + min or n,
                min, max
            )
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            valLbl.Text = string.format(fmt, value)
            if callback then callback(value) end
        end
        editBox.Visible = false
        trackFrame.Visible = true
    end)

    -- Dragging
    local dragging = false
    local function updateFromX(absX)
        local relX = math.clamp((absX - trackFrame.AbsolutePosition.X) / trackFrame.AbsoluteSize.X, 0, 1)
        local raw = min + relX * (max - min)
        value = math.clamp(
            step > 0 and math.round((raw - min) / step) * step + min or raw,
            min, max
        )
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valLbl.Text = string.format(fmt, value)
        if callback then callback(value) end
    end

    trackFrame.InputBegan:Connect(function(input)
        if disabled or (self._window and self._window:IsDisabled()) then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromX(input.Position.X)
            fill.BackgroundColor3 = theme.SliderFillActive
        end
        -- Ctrl+Click
        if input.UserInputType == Enum.UserInputType.MouseButton1
           and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            dragging = false
            trackFrame.Visible = false
            editBox.Visible = true
            editBox.Text = string.format(fmt, value)
            editBox:CaptureFocus()
        end
    end)
    trackFrame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            fill.BackgroundColor3 = theme.SliderFill
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromX(input.Position.X)
        end
    end)

    local obj = {
        Container = frame,
        GetValue = function(_) return value end,
        SetValue = function(_, v)
            value = math.clamp(v, min, max)
            fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            valLbl.Text = string.format(fmt, value)
        end,
        SetEnabled = function(_, v)
            disabled = not v
            lbl.TextColor3 = disabled and theme.TextDisabled or theme.Text
        end,
        Destroy = function() frame:Destroy() end,
    }
    obj._onKeyboardStep = function(delta)
        value = math.clamp(value + delta * step, min, max)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valLbl.Text = string.format(fmt, value)
        if callback then callback(value) end
    end
    self:_registerFocusable(obj)
    return obj
end

