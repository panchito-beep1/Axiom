    applyCorner(subTabBar, 4)

    local subLayout = Instance.new("UIListLayout")
    subLayout.FillDirection = Enum.FillDirection.Horizontal
    subLayout.SortOrder = Enum.SortOrder.LayoutOrder
    subLayout.Padding = UDim.new(0, 2)
    subLayout.Parent = subTabBar
    local subPad = Instance.new("UIPadding")
    subPad.PaddingLeft = UDim.new(0, 4)
    subPad.PaddingTop  = UDim.new(0, 3)
    subPad.Parent = subTabBar

    local subContentArea = Instance.new("Frame")
    subContentArea.BackgroundTransparency = 1
    subContentArea.Position = UDim2.new(0, 0, 0, 30)
    subContentArea.Size = UDim2.new(1, 0, 0, 0)
    subContentArea.AutomaticSize = Enum.AutomaticSize.Y
    subContentArea.Parent = container

    local subTabs = {}
    local activeSubTab = nil

    local function activateSub(st)
        if activeSubTab then
            activeSubTab._frame.Visible = false
            TweenService:Create(activeSubTab._btn, TWEEN_FAST, {
                BackgroundColor3 = theme.TabNormal,
                TextColor3 = theme.SubText,
            }):Play()
        end
        activeSubTab = st
        st._frame.Visible = true
        TweenService:Create(st._btn, TWEEN_FAST, {
            BackgroundColor3 = theme.TabActive,
            TextColor3 = theme.Text,
        }):Play()
    end

    for i, name in ipairs(tabNames) do
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = theme.TabNormal
        btn.BorderSizePixel  = 0
        btn.AutomaticSize = Enum.AutomaticSize.X
        btn.Size = UDim2.new(0, 0, 0, 20)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 11
        btn.TextColor3 = theme.SubText
        btn.LayoutOrder = i
        btn.Parent = subTabBar
        applyCorner(btn, 3)
        applyPadding(btn, 8, 0)

        local contentFrame = Instance.new("Frame")
        contentFrame.BackgroundTransparency = 1
        contentFrame.Size = UDim2.new(1, 0, 0, 0)
        contentFrame.AutomaticSize = Enum.AutomaticSize.Y
        contentFrame.Visible = false
        contentFrame.Parent = subContentArea

        local innerLayout = Instance.new("UIListLayout")
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Padding = UDim.new(0, 4)
        innerLayout.Parent = contentFrame

        local st = setmetatable({}, TabComponent)
        st._window = self._window
        st._frame  = contentFrame
        st._btn    = btn
        st._theme  = self._theme
        st._order  = 0
        st._disabledStack = {}
        st._focusableWidgets = {}
        st._divisionContainer = nil
        function st:_nextOrder()
            self._order = self._order + 1
            self._divisionContainer = nil
            return self._order
        end
        st._filterContent = TabComponent._filterContent

        -- Set btn text after creating st
        btn.Text = name

        btn.MouseButton1Click:Connect(function() activateSub(st) end)
        btn.MouseEnter:Connect(function()
            if activeSubTab ~= st then
                TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.TabHover }):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if activeSubTab ~= st then
                TweenService:Create(btn, TWEEN_FAST, { BackgroundColor3 = theme.TabNormal }):Play()
            end
        end)

        table.insert(subTabs, st)
        if i == 1 then activateSub(st) end
    end

    return table.unpack(subTabs)
end

