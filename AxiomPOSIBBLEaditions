        if popup then popup:Destroy(); popup = nil end
        if backdrop then backdrop:Destroy(); backdrop = nil end
    end
    local function select(opt)
        if value == opt then closePopup(); return end
        value = opt; valueLabel.Text = tostring(opt)
        closePopup()
        if config.callback then config.callback(opt) end
        for _, cb in ipairs(listeners) do cb(opt) end
    end

    local function openPopup()
        if popup then return end
        local win = section._tab._window
        backdrop = Util.create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 998, Parent = win._root,
        })
        backdrop.MouseButton1Click:Connect(closePopup)

        local btnAbs, winAbs = display.AbsolutePosition, win._root.AbsolutePosition
        local rowH = math.min(#options * 21 + 8, 200)
        popup = Util.create("ScrollingFrame", {
            Size = UDim2.fromOffset(display.AbsoluteSize.X, rowH),
            Position = UDim2.fromOffset(btnAbs.X - winAbs.X, btnAbs.Y - winAbs.Y + 24),
            BackgroundColor3 = theme.main, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = theme.outline,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 999, Parent = win._root,
        })
        Util.corner(theme.cornerSmall).Parent = popup
        Util.outline(popup, theme.outline, theme.dark)
        Util.padding({ top = 2, bottom = 2 }).Parent = popup
        Util.listLayout({ gap = 0 }).Parent = popup

        for _, opt in ipairs(options) do
            local isSel = (opt == value)
            local item = Util.create("TextButton", {
                Text = tostring(opt),
                Font = theme.font, TextSize = theme.fontSize,
                TextColor3 = isSel and theme.accent or theme.text,
                TextTransparency = isSel and 0 or theme.textTransparency,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundColor3 = theme.main, BackgroundTransparency = 1,
                BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 21),
                AutoButtonColor = false, ZIndex = 1000, Parent = popup,
            })
            Util.padding({ left = 8 }).Parent = item
            item.MouseEnter:Connect(function()
                if not isSel then item.BackgroundTransparency = 0; item.TextTransparency = 0 end
            end)
            item.MouseLeave:Connect(function()
                if not isSel then item.BackgroundTransparency = 1; item.TextTransparency = theme.textTransparency end
            end)
            item.MouseButton1Click:Connect(function() select(opt) end)
        end
    end

    local conn = display.MouseButton1Click:Connect(function()
        if not enabled then return end
        if popup then closePopup() else openPopup() end
    end)

    function obj:destroy() conn:Disconnect(); closePopup(); holder:Destroy() end
    return obj
end

