-- ── Color & Utility Helpers ───────────────────────────────────────────────────
local function applyCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 2)
    c.Parent = parent
    return c
end

local function applyBorder(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(48, 52, 60)
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function applyPadding(parent, px, py)
    local p = Instance.new("UIPadding")
    p.PaddingLeft   = UDim.new(0, px)
    p.PaddingRight  = UDim.new(0, px)
    p.PaddingTop    = UDim.new(0, py or px)
    p.PaddingBottom = UDim.new(0, py or px)
    p.Parent = parent
    return p
end

local function disabledColor(c)
    if typeof(c) ~= "Color3" then return c end
    return Color3.new(c.R * 0.45, c.G * 0.45, c.B * 0.45)
end

local function lightenColor(c, amt)
    if typeof(c) ~= "Color3" then return c end
    amt = amt or 0.15
    return Color3.new(
        math.min(c.R + amt, 1),
        math.min(c.G + amt, 1),
        math.min(c.B + amt, 1)
    )
end

local function darkenColor(c, amt)
    if typeof(c) ~= "Color3" then return c end
    amt = amt or 0.15
    return Color3.new(
        math.max(c.R - amt, 0),
        math.max(c.G - amt, 0),
        math.max(c.B - amt, 0)
    )
end

local function safeCall(fn, ...)
    if not fn then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[Axiom] Callback error: " .. tostring(err))
    end
end

local function makeDraggable(frame, handle, onDragEnd)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if onDragEnd then onDragEnd(frame.Position) end
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- ═══ Icon System ══════════════════════════════════════════════════════════════
Axiom.IconPack = Axiom.IconPack or {}
do
    local SOURCES = {
        "https://github.com/xxpwnxxx420lord/Scripts/blob/main/iconpack.lua?raw=true",
        "https://raw.githubusercontent.com/xxpwnxxx420lord/Scripts/main/iconpack.lua",
    }
    for _, url in ipairs(SOURCES) do
        local ok, tbl = pcall(function() return loadstring(game:HttpGet(url))() end)
        if ok and type(tbl) == "table" then
            local n = 0
            for k, v in pairs(tbl) do
                if type(k) == "string" and type(v) == "string" then
                    Axiom.IconPack[k] = v; n = n + 1
                end
            end
            if n > 0 then break end
        end
    end
end

function Axiom.ResolveIcon(ref)
    if ref == nil then return nil end
    if type(ref) == "number" then return "rbxassetid://" .. tostring(ref) end
    if type(ref) ~= "string" or ref == "" then return ref end
    if ref:match("^rbxasset://") or ref:match("^rbxassetid://")
       or ref:match("^rbxthumb://") or ref:match("^content://")
       or ref:match("^https?://") then return ref end
    if tonumber(ref) then return "rbxassetid://" .. ref end
    return Axiom.IconPack[ref] or ref
end
Axiom.resolveIcon = Axiom.ResolveIcon

local function addLeftIcon(parent, iconRef, xPos, size)
    if not iconRef or iconRef == "" then return nil, 0 end
    local id = Axiom.ResolveIcon(iconRef)
    if not id or id == "" then return nil, 0 end
    size = size or 16
    local icn = Instance.new("ImageLabel")
    icn.BackgroundTransparency = 1
    icn.AnchorPoint = Vector2.new(0, 0.5)
    icn.Position = UDim2.new(0, xPos or 4, 0.5, 0)
    icn.Size = UDim2.new(0, size, 0, size)
    icn.Image = id
    icn.Parent = parent
    return icn, size + 6
end



-- ═══ Window Focus Manager (Focus-Lost TitleBar Color Changes) ═════════════════
Axiom._WindowManager = {
    Windows = {},
    ActiveWindow = nil,
    TopDisplayOrder = 100,
}

function Axiom._WindowManager:Register(win)
    table.insert(self.Windows, win)
    self:SetActive(win)
end

function Axiom._WindowManager:Unregister(win)
    for i, w in ipairs(self.Windows) do
        if w == win then
            table.remove(self.Windows, i)
            break
        end
    end
    if self.ActiveWindow == win then
        self.ActiveWindow = self.Windows[#self.Windows]
        if self.ActiveWindow and self.ActiveWindow._onFocusGained then
            self.ActiveWindow:_onFocusGained()
        end
    end
end

function Axiom._WindowManager:SetActive(win)
    if self.ActiveWindow == win then return end
    local prev = self.ActiveWindow
    self.ActiveWindow = win
    if prev and prev._onFocusLost then prev:_onFocusLost() end
    if win and win._onFocusGained then win:_onFocusGained() end
    self.TopDisplayOrder = self.TopDisplayOrder + 1
    if win and win._screen and win._screen:IsA("ScreenGui") then
        win._screen.DisplayOrder = self.TopDisplayOrder
    end
end

-- Global click/focus listener
UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local clickedWin = nil
        for i = #Axiom._WindowManager.Windows, 1, -1 do
            local w = Axiom._WindowManager.Windows[i]
            local frame = w._mainFrame
            if frame and frame.Visible then
                local ap = frame.AbsolutePosition
                local as = frame.AbsoluteSize
                if mousePos.X >= ap.X and mousePos.X <= ap.X + as.X and
                   mousePos.Y >= ap.Y and mousePos.Y <= ap.Y + as.Y then
                    clickedWin = w
                    break
                end
            end
        end
        if clickedWin then
            Axiom._WindowManager:SetActive(clickedWin)
        else
            if Axiom._WindowManager.ActiveWindow then
                local prev = Axiom._WindowManager.ActiveWindow
                Axiom._WindowManager.ActiveWindow = nil
                if prev and prev._onFocusLost then prev:_onFocusLost() end
            end
        end
    end
end)

