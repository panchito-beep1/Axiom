-- ── AddGraph ──────────────────────────────────────────────────────────────────
function TabComponent:AddGraph(opts)
    opts = opts or {}
    local theme = self._theme
    local data = opts.Data or {}
    local maxPoints = opts.MaxPoints or 50
    local lineColor = opts.LineColor or theme.Accent
    local bgColor = opts.BgColor or theme.FrameBg

    local graphH = opts.Height or 80

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = bgColor
    frame.BorderSizePixel = 0
    frame.Size = UDim2.new(1, 0, 0, graphH)
    frame.LayoutOrder = self:_nextOrder()
    frame.ClipsDescendants = true
    frame.Parent = self._frame
    applyCorner(frame, 4)
    applyBorder(frame, theme.Border)

    if opts.Label then
        local lbl = makeLabel(frame, { Text = opts.Label, Color = theme.SubText, Size = 11,
            AlignX = Enum.TextXAlignment.Right,
            FrameSize = UDim2.new(1, -6, 0, 14),
            Position = UDim2.new(0, 6, 0, 2) })
    end

    local lines = {}

    local function redraw()
        for _, l in ipairs(lines) do l:Destroy() end
        lines = {}
        if #data < 2 then return end

        local minV, maxV = math.huge, -math.huge
        for _, v in ipairs(data) do
            minV = math.min(minV, v)
            maxV = math.max(maxV, v)
        end
        local range = maxV - minV
        if range == 0 then range = 1 end

        local w = frame.AbsoluteSize.X
        local h = frame.AbsoluteSize.Y
        local step = w / (#data - 1)

        for i = 1, #data - 1 do
            local x1 = (i-1) * step
            local x2 = i * step
            local y1 = h - ((data[i] - minV) / range * (h - 10) + 5)
            local y2 = h - ((data[i+1] - minV) / range * (h - 10) + 5)

            local dx = x2 - x1
            local dy = y2 - y1
            local len = math.sqrt(dx*dx + dy*dy)
            local angle = math.atan2(dy, dx)

            local seg = Instance.new("Frame")
            seg.BackgroundColor3 = lineColor
            seg.BorderSizePixel = 0
            seg.AnchorPoint = Vector2.new(0, 0.5)
            seg.Position = UDim2.new(0, x1, 0, y1)
            seg.Size = UDim2.new(0, len, 0, 2)
            seg.Rotation = math.deg(angle)
            seg.Parent = frame
            table.insert(lines, seg)
        end
    end

    -- Redraw when frame size changes
    frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(redraw)
    task.defer(redraw)

    return {
        Container = frame,
        AddPoint = function(_, v)
            table.insert(data, v)
            while #data > maxPoints do table.remove(data, 1) end
            redraw()
        end,
        SetData = function(_, newData) data = newData; redraw() end,
        Clear = function(_) data = {}; redraw() end,
        Destroy = function() frame:Destroy() end,
    }
end

-- ── AddTable ──────────────────────────────────────────────────────────────────
function TabComponent:AddTable(columns, rows, opts)
    opts = opts or {}
    local theme = self._theme
    local sortable = opts.Sortable or false
    local selectable = opts.Selectable or false
    local multiSelect = opts.MultiSelect or false
    local hideHeaders = opts.HideHeaders or false
    local altRows = opts.AlternateRowColors or false
    local rowBg1 = opts.RowColor1 or theme.FrameBg
    local rowBg2 = opts.RowColor2 or theme.ChildBg
    local selectedColor = opts.SelectedColor or theme.HeaderActive
    local onSelect = opts.OnSelect

    local sortCol = nil
    local sortAsc = true
    local selectedIndices = {}
    local currentRows = rows or {}

    local outer = Instance.new("Frame")
    outer.BackgroundTransparency = 1
    outer.Size = UDim2.new(1, 0, 0, 0)
    outer.AutomaticSize = Enum.AutomaticSize.Y
    outer.LayoutOrder = self:_nextOrder()
    outer.Parent = self._frame

    -- Header row
    local headerRow
    if not hideHeaders then
        headerRow = Instance.new("Frame")
        headerRow.BackgroundColor3 = theme.TableHeaderBg or theme.Header
        headerRow.BorderSizePixel = 0
        headerRow.Size = UDim2.new(1, 0, 0, 24)
        headerRow.Parent = outer
        applyCorner(headerRow, 4)

        local colW = 1 / #columns
        for ci, col in ipairs(columns) do
            local hbtn = Instance.new("TextButton")
            hbtn.BackgroundTransparency = 1
            hbtn.Text = tostring(col)
            hbtn.Font = Enum.Font.GothamBold
            hbtn.TextSize = 12
            hbtn.TextColor3 = theme.Text
            hbtn.TextXAlignment = Enum.TextXAlignment.Left
            hbtn.Position = UDim2.new((ci-1)*colW, ci == 1 and 6 or 0, 0, 0)
            hbtn.Size = UDim2.new(colW, 0, 1, 0)
            hbtn.Parent = headerRow
            applyPadding(hbtn, 4, 0)
            if sortable then
                hbtn.MouseButton1Click:Connect(function()
                    if sortCol == ci then sortAsc = not sortAsc
                    else sortCol = ci; sortAsc = true end
                    hbtn.Text = tostring(col) .. (sortAsc and " ▲" or " ▼")
                    -- Resort other headers
                    for _, h in ipairs(headerRow:GetChildren()) do
                        if h ~= hbtn and h:IsA("TextButton") then
                            local idx = table.find(columns, h.Text:match("^(.-)%s*[▲▼]?$") or h.Text)
                            if idx then h.Text = tostring(columns[idx]) end
                        end
                    end
                    refreshRows()
                end)
            end
        end
    end

    local bodyFrame = Instance.new("ScrollingFrame")
    bodyFrame.BackgroundTransparency = 1
    bodyFrame.BorderSizePixel = 0
    bodyFrame.Position = UDim2.new(0, 0, 0, hideHeaders and 0 or 24)
    bodyFrame.Size = UDim2.new(1, 0, 0, opts.MaxHeight or 200)
    bodyFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    bodyFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    bodyFrame.ScrollBarThickness = 4
    bodyFrame.ScrollBarImageColor3 = theme.ScrollbarGrab
    bodyFrame.Parent = outer

    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Parent = bodyFrame

    function refreshRows()
        for _, c in ipairs(bodyFrame:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end

        local displayRows = {}
        for i, row in ipairs(currentRows) do
            table.insert(displayRows, { idx = i, row = row })
        end

        if sortCol then
            table.sort(displayRows, function(a, b)
                local av = a.row[sortCol]
                local bv = b.row[sortCol]
                if type(av) == "number" and type(bv) == "number" then
                    return sortAsc and av < bv or av > bv
                else
                    return sortAsc and tostring(av) < tostring(bv) or tostring(av) > tostring(bv)
                end
            end)
        end

        local colW = 1 / #columns
        for ri, entry in ipairs(displayRows) do
            local origIdx = entry.idx
            local row = entry.row
            local rowFrame = Instance.new("TextButton")
            rowFrame.BackgroundColor3 = selectedIndices[origIdx] and selectedColor
                or (altRows and ri % 2 == 0 and rowBg2 or rowBg1)
            rowFrame.BorderSizePixel = 0
            rowFrame.Size = UDim2.new(1, 0, 0, 22)
            rowFrame.Text = ""
            rowFrame.LayoutOrder = ri
            rowFrame.Parent = bodyFrame

            for ci, val in ipairs(row) do
                local cellLbl = Instance.new("TextLabel")
                cellLbl.BackgroundTransparency = 1
                cellLbl.Text = tostring(val)
                cellLbl.Font = Enum.Font.Gotham
                cellLbl.TextSize = 12
                cellLbl.TextColor3 = theme.Text
                cellLbl.TextXAlignment = Enum.TextXAlignment.Left
                cellLbl.Position = UDim2.new((ci-1)*colW, ci == 1 and 6 or 0, 0, 0)
                cellLbl.Size = UDim2.new(colW, 0, 1, 0)
                cellLbl.Parent = rowFrame
            end

            if selectable then
                rowFrame.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selectedIndices[origIdx] = not selectedIndices[origIdx] or nil
                    else
                        selectedIndices = {}
                        selectedIndices[origIdx] = true
                    end
                    if onSelect then
                        local sel = {}
                        for idx, _ in pairs(selectedIndices) do table.insert(sel, currentRows[idx]) end
                        onSelect(sel, origIdx)
                    end
                    refreshRows()
                end)
            end

            rowFrame.MouseEnter:Connect(function()
                if not selectedIndices[origIdx] then
                    rowFrame.BackgroundColor3 = theme.HeaderHover
                end
            end)
            rowFrame.MouseLeave:Connect(function()
                rowFrame.BackgroundColor3 = selectedIndices[origIdx] and selectedColor
                    or (altRows and ri % 2 == 0 and rowBg2 or rowBg1)
            end)
        end
    end
    refreshRows()

    return {
        Container = outer,
        SetData = function(_, newRows)
            currentRows = newRows
            selectedIndices = {}
            refreshRows()
        end,
        GetSelected = function(_)
            local sel = {}
            for idx, _ in pairs(selectedIndices) do table.insert(sel, currentRows[idx]) end
            return sel
        end,
        ClearSelection = function(_)
            selectedIndices = {}
            refreshRows()
        end,
        Destroy = function() outer:Destroy() end,
    }
end

