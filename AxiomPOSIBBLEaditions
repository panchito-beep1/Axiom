                ZIndex = 1000, Parent = popup,
            })
            Util.create("TextLabel", {
                Text = key, Font = theme.font, TextSize = theme.fontSize,
                TextColor3 = theme.text, TextTransparency = theme.textTransparency,
                BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 22),
                ZIndex = 1000, Parent = line,
            })
            local track = Util.create("Frame", {
                Size = UDim2.new(1, -52, 0, 4), Position = UDim2.new(0, 20, 0.5, 0),
                BackgroundColor3 = theme.background, BorderSizePixel = 0,
                ZIndex = 1000, Parent = line,
            })
            Util.corner(2).Parent = track
            local fill = Util.create("Frame", {
                Size = UDim2.new(values[key] / 255, 0, 1, 0),
                BackgroundColor3 = theme.accent, BorderSizePixel = 0,
                ZIndex = 1000, Parent = track,
            })
            Util.corner(2).Parent = fill
            local box = Util.create("TextBox", {
                Text = tostring(values[key]), Font = theme.font, TextSize = theme.fontSize,
                TextColor3 = theme.text, BackgroundTransparency = 1, BorderSizePixel = 0,
                Size = UDim2.fromOffset(36, 22), Position = UDim2.new(1, -36, 0, 0),
                TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = false,
                ZIndex = 1000, Parent = line,
            })
            box.FocusLost:Connect(function()
                local n = math.clamp(tonumber(box.Text) or values[key], 0, 255)
                values[key] = n; box.Text = tostring(n)
                fill.Size = UDim2.new(n / 255, 0, 1, 0)
                obj:set(Color3.fromRGB(values.R, values.G, values.B))
            end)
        end
    end

    local conn = swatch.MouseButton1Click:Connect(function()
        if not enabled then return end
        if popup then closePopup() else openPopup() end
    end)
    function obj:destroy() conn:Disconnect(); closePopup(); row:Destroy() end
    return obj
