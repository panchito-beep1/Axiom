--  AddColorButton (Standalone Color Swatch Button)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddColorButton(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or ""
    local color    = options.Color or Color3.fromRGB(255, 255, 255)
    local size     = options.Size or UDim2.new(0, 36, 0, 24)
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = (text ~= "") and UDim2.new(1, 0, 0, 24) or size
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    if text ~= "" then
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Position = UDim2.new(0, 4, 0, 0)
        lbl.Size = UDim2.new(1, -size.X.Offset - 8, 1, 0)
        lbl.Font = Enum.Font.RobotoMono
        lbl.Text = text
        lbl.TextColor3 = theme.Text
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = container
    end

    local swatchBtn = Instance.new("TextButton")
    swatchBtn.BackgroundColor3 = color
    swatchBtn.Position = (text ~= "") and UDim2.new(1, -size.X.Offset, 0, 0) or UDim2.new(0, 0, 0, 0)
    swatchBtn.Size = size
    swatchBtn.Text = ""
    swatchBtn.AutoButtonColor = false
    swatchBtn.Parent = container
    applyCorner(swatchBtn, 2)
    local stroke = applyBorder(swatchBtn, theme.Border, 1.5)

    swatchBtn.MouseEnter:Connect(function() stroke.Color = theme.Accent end)
    swatchBtn.MouseLeave:Connect(function() stroke.Color = theme.Border end)
    swatchBtn.MouseButton1Click:Connect(function()
        safeCall(callback, color)
    end)

    if tooltip then attachTooltip(swatchBtn, tooltip, self._window) end

    local obj = { _instance = swatchBtn }
    function obj:GetColor() return color end
    function obj:SetColor(newColor)
        color = newColor
        swatchBtn.BackgroundColor3 = newColor
        safeCall(callback, color)
    end
    function obj:Destroy() container:Destroy() end
    return obj
end

