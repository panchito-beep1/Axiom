local Components = {}

local function rowFrame(parent, theme, height)
    return Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, height or 28),
        BackgroundTransparency = 1, BorderSizePixel = 0, Parent = parent,
    })
end

local function describeRow(parent, theme, config, controlWidth)
    local labelColor = config.disabled and theme.dim or theme.text
    Util.create("TextLabel", {
        Text = tostring(config.name or ""),
        Font = theme.fontMedium, TextSize = theme.fontSize, TextColor3 = labelColor,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Size = UDim2.new(1, -(controlWidth or 80), 0, 16), Parent = parent,
    })
    if config.description then
        Util.create("TextLabel", {
            Text = tostring(config.description),
            Font = theme.font, TextSize = theme.fontSizeSm, TextColor3 = theme.dim,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -(controlWidth or 80), 0, 12),
            Position = UDim2.new(0, 0, 0, 18), Parent = parent,
        })
    end
end

-- ---------- Toggle (pill switch, animated) ----------
function Components.toggle(section, config)
    local theme = section._theme
    local value = config.default == true
    local listeners, enabled = {}, not config.disabled
    local row = rowFrame(section._content, theme, config.description and 44 or 28)
    describeRow(row, theme, config, 50)

    local track = Util.create("Frame", {
        Size = UDim2.fromOffset(34, 18),
        Position = UDim2.new(1, 0, 0, 5), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = value and theme.accent or theme.surface,
        BorderSizePixel = 0, Parent = row,
    })
    Util.corner(9).Parent = track
    local trackStroke = Util.stroke(value and theme.accent or theme.border, 1)
    trackStroke.Parent = track

    local knob = Util.create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = value and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = value and Color3.new(1, 1, 1) or theme.dim,
        BorderSizePixel = 0, Parent = track,
    })
    Util.corner(7).Parent = knob

    local clicker = Util.create("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1), Parent = row,
    })

    local function render(animate)
        local targetPos = value and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)
        if animate then
            Util.tween(knob, { Position = targetPos }, 0.15)
            Util.tween(track, { BackgroundColor3 = value and theme.accent or theme.surface }, 0.15)
            Util.tween(knob, { BackgroundColor3 = value and Color3.new(1, 1, 1) or theme.dim }, 0.15)
        else
            knob.Position = targetPos
            track.BackgroundColor3 = value and theme.accent or theme.surface
            knob.BackgroundColor3  = value and Color3.new(1, 1, 1) or theme.dim
        end
        trackStroke.Color = value and theme.accent or theme.border
    end

    if enabled then
        clicker.MouseEnter:Connect(function()
            if not value then
                Util.tween(track, { BackgroundColor3 = theme.surfaceHover }, 0.1)
            end
        end)
        clicker.MouseLeave:Connect(function()
            if not value then
                Util.tween(track, { BackgroundColor3 = theme.surface }, 0.1)
            end
        end)
    end

    local obj = { _root = row }
    function obj:get() return value end
    function obj:set(v, silent)
        if not enabled or value == v then return end
        value = v; render(true)
        if not silent then
            if config.callback then config.callback(v) end
            for _, cb in ipairs(listeners) do cb(v) end
        end
    end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    local conn = clicker.MouseButton1Click:Connect(function()
        if enabled then obj:set(not value) end
    end)
    function obj:destroy() conn:Disconnect(); row:Destroy() end
    return obj
end

-- ---------- Button (hover-lift) ----------
function Components.button(section, config)
    local theme = section._theme
    local enabled, listeners = not config.disabled, {}

    local btn = Util.create("TextButton", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = theme.surface, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Parent = section._content,
    })
    Util.corner(theme.cornerSmall).Parent = btn
    local stroke = Util.stroke(theme.border, 1); stroke.Parent = btn

    Util.create("TextLabel", {
        Text = tostring(config.name or "Button"),
        Font = theme.fontMedium, TextSize = theme.fontSize,
        TextColor3 = config.disabled and theme.dim or theme.text,
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = btn,
    })

    if enabled then
        btn.MouseEnter:Connect(function()
            Util.tween(btn, { BackgroundColor3 = theme.surfaceHover }, 0.12)
            stroke.Color = theme.accentDim
        end)
        btn.MouseLeave:Connect(function()
            Util.tween(btn, { BackgroundColor3 = theme.surface }, 0.12)
            stroke.Color = theme.border
        end)
    end

    local obj = { _root = btn }
    function obj:fire()
        if not enabled then return end
        if config.callback then config.callback() end
        for _, cb in ipairs(listeners) do cb() end
    end
    function obj:onPressed(cb) table.insert(listeners, cb); return obj end
    function obj:destroy() btn:Destroy() end
    btn.MouseButton1Click:Connect(function() obj:fire() end)
    return obj
end

-- ---------- Slider (circular knob, gradient fill) ----------
function Components.slider(section, config)
    local theme = section._theme
    local min, max = config.min or 0, config.max or 100
    local step     = config.step or 1
    local value    = config.default or min
    local showVal  = config.showValue ~= false
    local listeners, enabled = {}, not config.disabled
    local descH    = config.description and 50 or 38
    local trackY   = config.description and 36 or 24

    local row = rowFrame(section._content, theme, descH)
    describeRow(row, theme, config, 80)

    local valueLabel
    if showVal then
        valueLabel = Util.create("TextLabel", {
            Text = tostring(value),
            Font = theme.fontCode, TextSize = theme.fontSizeCode, TextColor3 = theme.muted,
            TextXAlignment = Enum.TextXAlignment.Right, BackgroundTransparency = 1,
            Size = UDim2.new(0, 60, 0, 16),
            Position = UDim2.new(1, 0, 0, 0), Parent = row,
        })
    end

    local track = Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0, trackY),
        BackgroundColor3 = theme.surface, BorderSizePixel = 0, Parent = row,
    })
    Util.corner(2).Parent = track

    local fill = Util.create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = theme.accent, BorderSizePixel = 0, Parent = track,
    })
    Util.corner(2).Parent = fill

    local knob = Util.create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track,
    })
    Util.corner(7).Parent = knob
    Util.stroke(theme.accent, 1).Parent = knob

    local hitbox = Util.create("TextButton", {
        Text = "", BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, trackY - 8), Parent = row,
    })

    local function snap(v)
        v = math.clamp(v, min, max)
        if step > 0 then v = math.floor((v - min) / step + 0.5) * step + min end
        return v
    end
    local function fmt(v)
        if step >= 1 then return tostring(math.floor(v + 0.5)) end
        return string.format("%.2f", v)
    end
    local function render()
        local a = (value - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        if valueLabel then valueLabel.Text = fmt(value) end
    end

    local obj = { _root = row }
    function obj:get() return value end
    function obj:set(v, silent)
        if not enabled then return end
        v = snap(v)
        if value == v then return end
        value = v; render()
        if not silent then
            if config.callback then config.callback(v) end
            for _, cb in ipairs(listeners) do cb(v) end
        end
    end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end

    local dragConns = {}
    local function stopDrag()
        for _, c in ipairs(dragConns) do c:Disconnect() end
        dragConns = {}
    end
    local function updateFromX(x)
        local ax, aw = track.AbsolutePosition.X, track.AbsoluteSize.X
        local rel = math.clamp((x - ax) / aw, 0, 1)
        obj:set(min + rel * (max - min))
    end
    hitbox.InputBegan:Connect(function(input)
        if not enabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        updateFromX(input.Position.X)
        table.insert(dragConns, UserInputService.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch then
                updateFromX(i.Position.X)
            end
        end))
        table.insert(dragConns, UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then stopDrag() end
        end))
    end)
    function obj:destroy() stopDrag(); row:Destroy() end
    render()
    return obj
end

-- ---------- Dropdown ----------
function Components.dropdown(section, config)
    local theme = section._theme
    local options = config.options or {}
    local value   = config.default or options[1]
    local listeners, enabled = {}, not config.disabled
    local popup, backdrop

    local row = rowFrame(section._content, theme, config.description and 44 or 28)
    describeRow(row, theme, config, 150)

    local btn = Util.create("TextButton", {
        Text = "", Size = UDim2.new(0, 140, 0, 24),
        Position = UDim2.new(1, 0, 0, 3), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = theme.surface, BorderSizePixel = 0,
        AutoButtonColor = false, Parent = row,
    })
    Util.corner(theme.cornerSmall).Parent = btn
    local btnStroke = Util.stroke(theme.border, 1); btnStroke.Parent = btn

    local valueLbl = Util.create("TextLabel", {
        Text = tostring(value or ""),
        Font = theme.font, TextSize = theme.fontSize, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Size = UDim2.new(1, -22, 1, 0), Position = UDim2.new(0, 8, 0, 0), Parent = btn,
    })
    Util.create("TextLabel", {
        Text = "▾", Font = theme.fontCode, TextSize = 10, TextColor3 = theme.muted,
        BackgroundTransparency = 1, Size = UDim2.fromOffset(14, 24),
        Position = UDim2.new(1, -18, 0, 0), Parent = btn,
    })

    if enabled then
        btn.MouseEnter:Connect(function()
            Util.tween(btn, { BackgroundColor3 = theme.surfaceHover }, 0.12)
        end)
        btn.MouseLeave:Connect(function()
            Util.tween(btn, { BackgroundColor3 = theme.surface }, 0.12)
        end)
    end

    local obj = { _root = row }
    function obj:get() return value end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    function obj:set(v, silent)
        if not enabled then return end
        value = v; valueLbl.Text = tostring(v)
        if not silent then
            if config.callback then config.callback(v) end
            for _, cb in ipairs(listeners) do cb(v) end
        end
    end

    local function closePopup()
        if popup then popup:Destroy(); popup = nil end
        if backdrop then backdrop:Destroy(); backdrop = nil end
    end
    local function select(opt)
        if value == opt then closePopup(); return end
        value = opt; valueLbl.Text = tostring(opt)
        closePopup()
        if config.callback then config.callback(opt) end
        for _, cb in ipairs(listeners) do cb(opt) end
    end

    local function openPopup()
        if popup then return end
        local win = section._tab._window
        backdrop = Util.create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 998, Parent = win._root,
        })
        backdrop.MouseButton1Click:Connect(closePopup)

        local btnAbs, winAbs = btn.AbsolutePosition, win._root.AbsolutePosition
        local rowH = math.min(#options * 26 + 8, 200)
        popup = Util.create("ScrollingFrame", {
            Size = UDim2.fromOffset(140, rowH),
            Position = UDim2.fromOffset(btnAbs.X - winAbs.X, btnAbs.Y - winAbs.Y + 28),
            BackgroundColor3 = theme.card, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = theme.border,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 999, Parent = win._root,
        })
        Util.corner(theme.cornerRadius).Parent = popup
        Util.stroke(theme.accentDim, 1).Parent = popup
        Util.padding({ top = 4, bottom = 4 }).Parent = popup
        Util.listLayout({ gap = 1 }).Parent = popup

        for _, opt in ipairs(options) do
            local isSel = (opt == value)
            local item = Util.create("TextButton", {
                Text = tostring(opt),
                Font = theme.font, TextSize = theme.fontSize,
                TextColor3 = isSel and theme.accentBright or theme.text,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundColor3 = isSel and theme.accentBg or theme.card,
                BackgroundTransparency = isSel and 0 or 1,
                BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 24),
                AutoButtonColor = false, ZIndex = 1000, Parent = popup,
            })
            Util.create("UIPadding", { PaddingLeft = UDim.new(0, 10), Parent = item })
            if isSel then
                Util.create("Frame", {
                    Size = UDim2.new(0, 2, 0.6, 0), Position = UDim2.new(0, 0, 0.2, 0),
                    BackgroundColor3 = theme.accent, BorderSizePixel = 0,
                    ZIndex = 1001, Parent = item,
                })
            end
            item.MouseEnter:Connect(function()
                if not isSel then item.BackgroundTransparency = 0;
                    item.BackgroundColor3 = theme.surfaceHover end
            end)
            item.MouseLeave:Connect(function()
                if not isSel then item.BackgroundTransparency = 1 end
            end)
            item.MouseButton1Click:Connect(function() select(opt) end)
        end
    end

    local conn = btn.MouseButton1Click:Connect(function()
        if not enabled then return end
        if popup then closePopup() else openPopup() end
    end)
    function obj:destroy() conn:Disconnect(); closePopup(); row:Destroy() end
    return obj
end

-- ---------- MultiDropdown ----------
function Components.multidropdown(section, config)
    local theme = section._theme
    local options = config.options or {}
    local selected = {}
    for _, v in ipairs(config.default or {}) do selected[v] = true end
    local listeners, enabled = {}, not config.disabled
    local popup, backdrop

    local row = rowFrame(section._content, theme, config.description and 44 or 28)
    describeRow(row, theme, config, 150)

    local btn = Util.create("TextButton", {
        Text = "", Size = UDim2.new(0, 140, 0, 24),
        Position = UDim2.new(1, 0, 0, 3), AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = theme.surface, BorderSizePixel = 0,
        AutoButtonColor = false, Parent = row,
    })
    Util.corner(theme.cornerSmall).Parent = btn
    Util.stroke(theme.border, 1).Parent = btn

    local valueLbl = Util.create("TextLabel", {
        Text = "", Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, -22, 1, 0),
        Position = UDim2.new(0, 8, 0, 0), Parent = btn,
    })
    Util.create("TextLabel", {
        Text = "▾", Font = theme.fontCode, TextSize = 10, TextColor3 = theme.muted,
        BackgroundTransparency = 1, Size = UDim2.fromOffset(14, 24),
        Position = UDim2.new(1, -18, 0, 0), Parent = btn,
    })

    local function list()
        local out = {}
        for _, v in ipairs(options) do if selected[v] then table.insert(out, v) end end
        return out
    end
    local function renderLabel()
        local s = list()
        valueLbl.Text = (#s == 0) and "" or table.concat(s, ", ")
    end
    renderLabel()

    local obj = { _root = row }
    function obj:get() return list() end
    function obj:onChanged(cb) table.insert(listeners, cb); return obj end
    function obj:set(values, silent)
        if not enabled then return end
        selected = {}
        for _, v in ipairs(values) do selected[v] = true end
        renderLabel()
        local s = list()
        if not silent then
            if config.callback then config.callback(s) end
            for _, cb in ipairs(listeners) do cb(s) end
        end
    end

    local function closePopup()
        if popup then popup:Destroy(); popup = nil end
        if backdrop then backdrop:Destroy(); backdrop = nil end
    end
    local function toggleOption(opt)
        selected[opt] = (not selected[opt]) or nil
        renderLabel()
        local s = list()
        if config.callback then config.callback(s) end
        for _, cb in ipairs(listeners) do cb(s) end
    end

    local function openPopup()
        if popup then return end
        local win = section._tab._window
        backdrop = Util.create("TextButton", {
            Text = "", BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1), ZIndex = 998, Parent = win._root,
        })
        backdrop.MouseButton1Click:Connect(closePopup)

        local btnAbs, winAbs = btn.AbsolutePosition, win._root.AbsolutePosition
        local rowH = math.min(#options * 26 + 8, 200)
        popup = Util.create("ScrollingFrame", {
            Size = UDim2.fromOffset(140, rowH),
            Position = UDim2.fromOffset(btnAbs.X - winAbs.X, btnAbs.Y - winAbs.Y + 28),
            BackgroundColor3 = theme.card, BorderSizePixel = 0,
            ScrollBarThickness = 2, ScrollBarImageColor3 = theme.border,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 999, Parent = win._root,
        })
        Util.corner(theme.cornerRadius).Parent = popup
        Util.stroke(theme.accentDim, 1).Parent = popup
        Util.padding({ top = 4, bottom = 4 }).Parent = popup
        Util.listLayout({ gap = 1 }).Parent = popup

        for _, opt in ipairs(options) do
            local isSel = selected[opt]
            local item = Util.create("TextButton", {
                Text = tostring(opt),
                Font = theme.font, TextSize = theme.fontSize,
                TextColor3 = isSel and theme.accentBright or theme.text,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundColor3 = isSel and theme.accentBg or theme.card,
                BackgroundTransparency = isSel and 0 or 1,
                BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 24),
                AutoButtonColor = false, ZIndex = 1000, Parent = popup,
            })
            Util.create("UIPadding", { PaddingLeft = UDim.new(0, 24), Parent = item })
            if isSel then
                Util.create("TextLabel", {
                    Text = "✓", Font = theme.fontBold, TextSize = 11,
                    TextColor3 = theme.accent, BackgroundTransparency = 1,
                    Size = UDim2.fromOffset(16, 24), Position = UDim2.new(0, 6, 0, 0),
                    ZIndex = 1001, Parent = item,
                })
            end
            item.MouseButton1Click:Connect(function()
                toggleOption(opt); closePopup(); openPopup()
            end)
        end
    end

    local conn = btn.MouseButton1Click:Connect(function()
        if not enabled then return end
        if popup then closePopup() else openPopup() end
    end)
    function obj:destroy() conn:Disconnect(); closePopup(); row:Destroy() end
    return obj
end

