        BackgroundColor3 = color, BackgroundTransparency = 0.85,
        BorderSizePixel = 0, Parent = holder,
    })
    Util.corner(8).Parent = pill
    Util.stroke(color, 1).Parent = pill
    Util.create("TextLabel", {
        Text = tostring(config.name or "Badge"),
        Font = theme.fontBold, TextSize = 10, TextColor3 = color,
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = pill,
    })
    local obj = { _root = holder }
    function obj:destroy() holder:Destroy() end
    return obj
end

-- =========================================================
-- Section (Obsidian Groupbox style)
-- =========================================================
local Section = {}
Section.__index = Section

function Section.new(tab, config)
    config = config or {}
    local self = setmetatable({}, Section)
    self._tab = tab
    self._config = config
    self._theme = tab._window._theme
    self._components = {}

    local theme = self._theme
    local parent = (config.column == 2) and tab._col2 or tab._col1

    -- Card container (background + double outline)
    self._root = Util.create("Frame", {
        Name = tostring(config.title or "Section"),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = theme.background,
        BorderSizePixel = 0,
        Parent = parent,
    })
    Util.corner(theme.cornerRadius).Parent = self._root
    Util.outline(self._root, theme.outline, theme.dark)
    Util.listLayout({ gap = 0 }).Parent = self._root

    -- Header (6px padding, 15px title, optional 14px description at 0.5)
    local header = Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = 1, Parent = self._root,
    })
    Util.padding({ top = 6, bottom = 6, left = 6, right = 6 }).Parent = header
    Util.listLayout({ gap = 2 }).Parent = header

    Util.create("TextLabel", {
        Text = tostring(config.title or "Section"),
        Font = theme.font, TextSize = theme.sectionSize,
        TextColor3 = theme.text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
        LayoutOrder = 1, Parent = header,
    })

    if config.description then
        Util.create("TextLabel", {
            Text = tostring(config.description),
            Font = theme.font, TextSize = theme.fontSize,
            TextColor3 = theme.text, TextTransparency = 0.5,
            TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = header,
        })
    end

    -- Divider line under header
    Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = theme.outline, BorderSizePixel = 0,
        LayoutOrder = 2, Parent = self._root,
    })

    -- Content (7px padding, 8px gap)
    self._content = Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = 3, Parent = self._root,
    })
    Util.padding({ top = 7, bottom = 7, left = 7, right = 7 }).Parent = self._content
    Util.listLayout({ gap = theme.sectionGap }).Parent = self._content

    return self
end

local function delegate(self, factory, config)
    local c = factory(self, config or {})
    table.insert(self._components, c)
    return c
end

function Section:toggle(config)        return delegate(self, Components.toggle, config)        end
function Section:button(config)        return delegate(self, Components.button, config)        end
function Section:slider(config)        return delegate(self, Components.slider, config)        end
function Section:dropdown(config)      return delegate(self, Components.dropdown, config)      end
function Section:multidropdown(config) return delegate(self, Components.multidropdown, config) end
function Section:input(config)         return delegate(self, Components.input, config)         end
function Section:numberinput(config)   return delegate(self, Components.numberinput, config)   end
function Section:keybind(config)       return delegate(self, Components.keybind, config)       end
function Section:colorpicker(config)   return delegate(self, Components.colorpicker, config)   end
function Section:label(config)         return delegate(self, Components.label, config)         end
function Section:paragraph(config)     return delegate(self, Components.paragraph, config)     end
function Section:divider(config)       return delegate(self, Components.divider, config)       end
function Section:checkbox(config)      return delegate(self, Components.checkbox, config)      end
function Section:progress(config)      return delegate(self, Components.progress, config)      end
function Section:badge(config)         return delegate(self, Components.badge, config)         end

function Section:destroy()
    for _, c in ipairs(self._components) do
        if c.destroy then c:destroy() end
    end
    if self._root then self._root:Destroy() end
end

-- =========================================================
-- Tab
-- =========================================================
local Tab = {}
Tab.__index = Tab

function Tab.new(window, config)
    config = config or {}
    local self = setmetatable({}, Tab)
    self._window = window
    self._config = config
    self._sections = {}
    self._conns = {}
    local theme = window._theme

    -- Sidebar tab button (40px, transparent, code font)
    self._navBtn = Util.create("TextButton", {
        Name = tostring(config.name or "Tab"),
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = theme.main,
        BackgroundTransparency = 1,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        Parent = window._tabList,
    })

    self._icon = Util.create("TextLabel", {
        Text = icon(config.icon),
        Font = theme.font, TextSize = 18,
        TextColor3 = theme.accent, TextTransparency = 0.5,
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
        BackgroundTransparency = 1, Size = UDim2.fromOffset(22, 22),
        Parent = self._navBtn,
    })

    self._name = Util.create("TextLabel", {
        Text = tostring(config.name or "Tab"),
        Font = theme.font, TextSize = 16,
        TextColor3 = theme.text, TextTransparency = 0.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -44, 1, 0), Position = UDim2.new(0, 40, 0, 0),
        Parent = self._navBtn,
    })

    self._navBtn.MouseEnter:Connect(function()
        if not self._selected then
            Util.tween(self._icon, { TextTransparency = 0.3 }, 0.1)
            Util.tween(self._name, { TextTransparency = 0.3 }, 0.1)
        end
    end)
    self._navBtn.MouseLeave:Connect(function()
        if not self._selected then
            Util.tween(self._icon, { TextTransparency = 0.5 }, 0.1)
            Util.tween(self._name, { TextTransparency = 0.5 }, 0.1)
        end
    end)

    -- Content container
    self._content = Util.create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, Visible = false,
        Parent = window._content,
    })

    -- Two columns (2px padding each, 2px outer gap)
    local function makeColumn(posX, offsetX)
        local col = Util.create("ScrollingFrame", {
            Size = UDim2.new(0.5, -3, 1, 0),
            Position = UDim2.new(posX, offsetX, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = theme.outline,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            Parent = self._content,
        })
        Util.padding({ top = 2, bottom = 2, left = 2, right = 2 }).Parent = col
        Util.listLayout({ gap = theme.sectionOuterGap }).Parent = col
        return col
    end
    self._col1 = makeColumn(0, 0)
    self._col2 = makeColumn(0.5, 3)

    table.insert(self._conns, self._navBtn.MouseButton1Click:Connect(function()
        window:selectTab(self)
    end))
    return self
end

function Tab:_setSelected(selected)
    local theme = self._window._theme
    self._selected = selected
    self._content.Visible = selected
    self._navBtn.BackgroundTransparency = selected and 0 or 1
    self._navBtn.BackgroundColor3 = theme.main
    self._icon.TextColor3 = theme.accent
    self._icon.TextTransparency = selected and 0 or 0.5
    self._name.TextColor3 = theme.text
    self._name.TextTransparency = selected and 0 or 0.5
end

function Tab:_applyTheme(theme)
    self._navBtn.BackgroundColor3 = theme.main
    self._icon.TextColor3 = theme.accent
    self._col1.ScrollBarImageColor3 = theme.outline
    self._col2.ScrollBarImageColor3 = theme.outline
end

function Tab:section(config)
    local sec = Section.new(self, config or {})
    table.insert(self._sections, sec)
    return sec
end

function Tab:destroy()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    for _, s in ipairs(self._sections) do s:destroy() end
    if self._navBtn then self._navBtn:Destroy() end
    if self._content then self._content:Destroy() end
end

-- =========================================================
-- Window (Obsidian layout)
-- =========================================================
local Window = {}
Window.__index = Window

function Window.new(config)
    config = config or {}
    local self = setmetatable({}, Window)
    local themeOverride = (type(config.theme) == "table") and config.theme or nil
    self._theme = Theme.merge(Theme.Default, themeOverride)
    self._tabs = {}
    self._current = nil
    self._conns = {}
    self._visible = true
    self:_build(config)
    return self
end

function Window:_build(config)
    local theme = self._theme
    local size = config.size or UDim2.fromOffset(720, 560)

    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    self._gui = Util.create("ScreenGui", {
        Name = "Axiom", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100, Parent = playerGui,
    })

    -- Main window
    self._root = Util.create("Frame", {
        Name = "Window", Size = size,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.background, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = self._gui,
    })
    Util.corner(theme.cornerRadius).Parent = self._root
    Util.outline(self._root, theme.outline, theme.dark)

    -- Title bar (48px)
    self._titleBar = Util.create("Frame", {
        Name = "TitleBar", Size = UDim2.new(1, 0, 0, 48),
        BackgroundTransparency = 1, BorderSizePixel = 0, Parent = self._root,
    })

    -- Title holder (30% width, centered vertically)
    local titleHolder = Util.create("Frame", {
        Size = UDim2.new(0.3, 0, 1, 0),
        BackgroundTransparency = 1, Parent = self._titleBar,
    })
    Util.listLayout({
        direction = Enum.FillDirection.Horizontal,
        halign = Enum.HorizontalAlignment.Center,
        valign = Enum.VerticalAlignment.Center,
        gap = 6,
    }).Parent = titleHolder

    Util.create("TextLabel", {
        Text = tostring(config.title or "Application"),
        Font = theme.fontBold, TextSize = theme.titleSize,
        TextColor3 = theme.text, BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 24),
        Parent = titleHolder,
    })

    -- Search box (right side)
    local searchFrame = Util.create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0.7, -12, 0, 28),
        BackgroundTransparency = 1, Parent = self._titleBar,
    })
    local searchBox = Util.create("TextBox", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = theme.main,
        BorderSizePixel = 0, PlaceholderText = "Search",
        PlaceholderColor3 = theme.muted, Font = theme.font,
        TextSize = theme.fontSize, TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left, TextScaled = true,
        ClearTextOnFocus = false, Parent = searchFrame,
    })
    Util.corner(theme.cornerSmall).Parent = searchBox
    Util.stroke(theme.outline, 1).Parent = searchBox
    Util.padding({ left = 8, right = 8, top = 4, bottom = 4 }).Parent = searchBox

    -- Horizontal line under title bar
    Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, 48),
        BackgroundColor3 = theme.outline, BorderSizePixel = 0, Parent = self._root,
    })

    -- Vertical divider between sidebar and content
    Util.create("Frame", {
        Size = UDim2.new(0, 1, 1, -70),
        Position = UDim2.fromOffset(math.floor(size.X.Offset * 0.3), 49),
        BackgroundColor3 = theme.outline, BorderSizePixel = 0, Parent = self._root,
    })

    -- Sidebar (30% width, 49 to bottom-21)
    self._sidebar = Util.create("ScrollingFrame", {
        Size = UDim2.new(0.3, 0, 1, -70),
        Position = UDim2.fromOffset(0, 49),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = theme.outline,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = self._root,
    })
    Util.listLayout({ gap = 0 }).Parent = self._sidebar
    self._tabList = self._sidebar

    -- Content (70%, right of divider)
    self._content = Util.create("Frame", {
        Size = UDim2.new(0.7, -1, 1, -70),
        Position = UDim2.new(0.3, 1, 0, 49),
        BackgroundTransparency = 1, Parent = self._root,
    })
    Util.padding({ left = 6, right = 6 }).Parent = self._content

    -- Bottom bar (20px tall, line above)
    self._bottomBar = Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 1, -20),
        BackgroundColor3 = theme.background, BorderSizePixel = 0, Parent = self._root,
    })
    Util.create("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, 0),
        BackgroundColor3 = theme.outline, BorderSizePixel = 0, Parent = self._bottomBar,
    })
    Util.create("TextLabel", {
        Text = tostring(config.footer or ""),
        Font = theme.font, TextSize = theme.fontSize,
        TextColor3 = theme.text, TextTransparency = 0.5,
        BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
        Parent = self._bottomBar,
    })

    self:_enableDrag(searchBox)
end

function Window:_enableDrag(searchBox)
    local dragging, dragStart, startPos = false, nil, nil

    table.insert(self._conns, self._titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            -- Skip drag if click is on search box
            local pos = input.Position
            local sAbs, sSize = searchBox.AbsolutePosition, searchBox.AbsoluteSize
            if pos.X >= sAbs.X and pos.X <= sAbs.X + sSize.X
            and pos.Y >= sAbs.Y and pos.Y <= sAbs.Y + sSize.Y then
                return
            end
            dragging = true
            dragStart = input.Position
            startPos = self._root.Position
        end
    end))
    table.insert(self._conns, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            self._root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(self._conns, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

function Window:tab(config)
    local tab = Tab.new(self, config or {})
    table.insert(self._tabs, tab)
    if not self._current then self:selectTab(tab) end
    return tab
end

function Window:selectTab(tab)
    for _, t in ipairs(self._tabs) do t:_setSelected(t == tab) end
    self._current = tab
end

function Window:setVisible(visible)
    self._visible = visible
    if self._gui then self._gui.Enabled = visible end
end

function Window:isVisible() return self._visible end

function Window:setTheme(override)
    if type(override) ~= "table" then return end
    self._theme = Theme.merge(self._theme, override)
    local t = self._theme
    self._root.BackgroundColor3 = t.background
    for _, tab in ipairs(self._tabs) do tab:_applyTheme(t) end
end

function Window:destroy()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    self._conns = {}
    for _, t in ipairs(self._tabs) do t:destroy() end
    self._tabs = {}
    if self._gui then self._gui:Destroy(); self._gui = nil end
end

