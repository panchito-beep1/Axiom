function TabComponent:AddVideoPlayer(opts)
    opts = opts or {}
    local theme = self._theme
    local playing = opts.AutoPlay or false
    local videoId = opts.Video or ""

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    frame.BorderSizePixel = 0
    frame.Size = opts.Size or UDim2.new(1, 0, 0, 180)
    frame.LayoutOrder = self:_nextOrder()
    frame.ClipsDescendants = true
    frame.Parent = self._frame
    applyCorner(frame, 6)

    if opts.Title then
        local titleBar = Instance.new("Frame")
        titleBar.BackgroundColor3 = theme.Header
        titleBar.BorderSizePixel = 0
        titleBar.Size = UDim2.new(1, 0, 0, 22)
        titleBar.Parent = frame
        makeLabel(titleBar, { Text = opts.Title, Color = theme.Text, Size = 12,
            FrameSize = UDim2.new(1, -8, 1, 0),
            Position = UDim2.new(0, 8, 0, 0) })
    end

    local yOff = opts.Title and 22 or 0

    -- Try VideoFrame, fall back to ImageLabel
    local videoFrame
    local ok = pcall(function()
        videoFrame = Instance.new("VideoFrame")
        videoFrame.Video = videoId
        videoFrame.Volume = opts.Volume or 0.5
        videoFrame.Looped = opts.Looped or false
        videoFrame.Playing = playing
    end)
    if not ok then
        videoFrame = Instance.new("ImageLabel")
        videoFrame.Image = ""
        videoFrame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    end
    videoFrame.BorderSizePixel = 0
    videoFrame.Position = UDim2.new(0, 0, 0, yOff)
    videoFrame.Size = UDim2.new(1, 0, 1, -(yOff + 32))
    videoFrame.Parent = frame

    -- Controls bar
    local controlsBar = Instance.new("Frame")
    controlsBar.BackgroundColor3 = theme.Header
    controlsBar.BorderSizePixel = 0
    controlsBar.AnchorPoint = Vector2.new(0, 1)
    controlsBar.Position = UDim2.new(0, 0, 1, 0)
    controlsBar.Size = UDim2.new(1, 0, 0, 30)
    controlsBar.Parent = frame

    local playBtn = Instance.new("TextButton")
    playBtn.BackgroundTransparency = 1
    playBtn.Text = playing and "⏸" or "▶"
    playBtn.Font = Enum.Font.GothamBold
    playBtn.TextSize = 14
    playBtn.TextColor3 = theme.Text
    playBtn.Size = UDim2.new(0, 28, 1, 0)
    playBtn.Parent = controlsBar

    local scrubTrack = Instance.new("Frame")
    scrubTrack.BackgroundColor3 = theme.SliderTrack
    scrubTrack.BorderSizePixel = 0
    scrubTrack.Position = UDim2.new(0, 32, 0.5, -3)
    scrubTrack.Size = UDim2.new(1, -88, 0, 6)
    scrubTrack.Parent = controlsBar
    applyCorner(scrubTrack, 3)

    local scrubFill = Instance.new("Frame")
    scrubFill.BackgroundColor3 = theme.SliderFill
    scrubFill.BorderSizePixel = 0
    scrubFill.Size = UDim2.new(0, 0, 1, 0)
    scrubFill.Parent = scrubTrack
    applyCorner(scrubFill, 3)

    local timeLbl = makeLabel(controlsBar, {
        Text = "0:00",
        Color = theme.SubText, Size = 11,
        AlignX = Enum.TextXAlignment.Right,
        FrameSize = UDim2.new(0, 50, 1, 0),
        Position = UDim2.new(1, -54, 0, 0)
    })

    playBtn.MouseButton1Click:Connect(function()
        playing = not playing
        playBtn.Text = playing and "⏸" or "▶"
        if videoFrame:IsA("VideoFrame") then
            videoFrame.Playing = playing
        end
    end)

    -- Scrub update
    local conn
    if videoFrame:IsA("VideoFrame") then
        conn = RunService.Heartbeat:Connect(function()
            local dur = videoFrame.TimeLength
            local t   = videoFrame.TimePosition
            if dur > 0 then
                scrubFill.Size = UDim2.new(t / dur, 0, 1, 0)
                local m = math.floor(t / 60)
                local s = math.floor(t % 60)
                timeLbl.Text = string.format("%d:%02d", m, s)
            end
        end)
    end

    return {
        Container = frame,
        SetPlay = function(_)
            playing = true; playBtn.Text = "⏸"
            if videoFrame:IsA("VideoFrame") then videoFrame.Playing = true end
        end,
        Pause = function(_)
            playing = false; playBtn.Text = "▶"
            if videoFrame:IsA("VideoFrame") then videoFrame.Playing = false end
        end,
        SetTime = function(_, t)
            if videoFrame:IsA("VideoFrame") then videoFrame.TimePosition = t end
        end,
        SetVolume = function(_, v)
            if videoFrame:IsA("VideoFrame") then videoFrame.Volume = v end
        end,
        SetVideo = function(_, id)
            videoId = id
            if videoFrame:IsA("VideoFrame") then videoFrame.Video = id end
        end,
        Destroy = function()
            if conn then conn:Disconnect() end
            frame:Destroy()
        end,
    }
end

-- ── AddKeybindPicker ──────────────────────────────────────────────────────────
function TabComponent:AddKeybindPicker(text, default, callback, opts)
    opts = opts or {}
    local theme = self._theme
    local currentBind = default or {}
    -- currentBind: { keys = {KeyCode...}, modifiers = {bool LeftCtrl, bool LeftShift, bool LeftAlt}, mouseButton = Enum? }
    if type(currentBind) ~= "table" then currentBind = { keys = {currentBind} } end
    currentBind.keys = currentBind.keys or {}
    currentBind.modifiers = currentBind.modifiers or {}

    local listening = false

    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 28)
    frame.LayoutOrder = self:_nextOrder()
    frame.Parent = self._frame

    makeLabel(frame, { Text = text, Color = theme.Text, Size = 13,
        FrameSize = UDim2.new(0.5, 0, 1, 0) })

    local bindBtn = Instance.new("TextButton")
    bindBtn.BackgroundColor3 = theme.FrameBg
    bindBtn.BorderSizePixel = 0
    bindBtn.AnchorPoint = Vector2.new(1, 0.5)
    bindBtn.Position = UDim2.new(1, 0, 0.5, 0)
    bindBtn.Size = UDim2.new(0.5, 0, 0, 22)
    bindBtn.Font = Enum.Font.GothamMedium
    bindBtn.TextSize = 12
    bindBtn.TextColor3 = theme.SubText
    bindBtn.Parent = frame
    applyCorner(bindBtn, 4)
    applyBorder(bindBtn, theme.Border)

    local function getBindText()
        local parts = {}
        if currentBind.modifiers.ctrl  then table.insert(parts, "Ctrl") end
        if currentBind.modifiers.shift then table.insert(parts, "Shift") end
        if currentBind.modifiers.alt   then table.insert(parts, "Alt") end
        if currentBind.mouseButton then
            table.insert(parts, currentBind.mouseButton.Name)
        end
        for _, k in ipairs(currentBind.keys) do
            table.insert(parts, k.Name)
        end
        return #parts > 0 and table.concat(parts, " + ") or "None"
    end
    bindBtn.Text = getBindText()

    bindBtn.MouseButton1Click:Connect(function()
        listening = true
        bindBtn.Text = "Press key..."
        bindBtn.TextColor3 = theme.Accent
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not listening then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            listening = false
            currentBind = { keys = {}, modifiers = {} }
            bindBtn.Text = "None"
            bindBtn.TextColor3 = theme.SubText
            if callback then callback(currentBind) end
            return
        end
        local modKeys = {
            Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl,
            Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift,
            Enum.KeyCode.LeftAlt, Enum.KeyCode.RightAlt,
        }
        local isMod = false
        for _, mk in ipairs(modKeys) do if input.KeyCode == mk then isMod = true break end end

        if not isMod and input.UserInputType == Enum.UserInputType.Keyboard then
            listening = false
            currentBind = {
                keys = {input.KeyCode},
                modifiers = {
                    ctrl  = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
                    shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)   or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
                    alt   = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)     or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
                }
            }
            bindBtn.Text = getBindText()
            bindBtn.TextColor3 = theme.SubText
            if callback then callback(currentBind) end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2 then
            listening = false
            currentBind = {
                keys = {},
                modifiers = {},
                mouseButton = input.UserInputType,
            }
            bindBtn.Text = getBindText()
            bindBtn.TextColor3 = theme.SubText
            if callback then callback(currentBind) end
        end
    end)

    return {
        Container = frame,
        GetBind = function(_) return currentBind end,
        SetBind = function(_, b) currentBind = b; bindBtn.Text = getBindText() end,
        Clear = function(_)
            currentBind = { keys = {}, modifiers = {} }
            bindBtn.Text = "None"
        end,
        Destroy = function() frame:Destroy() end,
    }
end

-- ── AddViewport ───────────────────────────────────────────────────────────────
function TabComponent:AddViewport(opts)
    opts = opts or {}
    local theme = self._theme
    local vpH = opts.Height or 160

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(0,0,0)
    frame.BorderSizePixel = 0
    frame.Size = UDim2.new(1, 0, 0, vpH)
    frame.LayoutOrder = self:_nextOrder()
    frame.ClipsDescendants = true
    frame.Parent = self._frame
    applyCorner(frame, 4)
    applyBorder(frame, theme.Border)

    local vp = Instance.new("ViewportFrame")
    vp.BackgroundTransparency = 1
    vp.Size = UDim2.new(1, 0, 1, 0)
    vp.Parent = frame

    local camera = Instance.new("Camera")
    camera.Parent = vp
    vp.CurrentCamera = camera

    local camAngleX = opts.AngleX or 20
    local camAngleY = opts.AngleY or 45
    local camDist   = opts.Distance or 10

    local function updateCamera()
        local radX = math.rad(camAngleX)
        local radY = math.rad(camAngleY)
        camera.CFrame = CFrame.new(
            Vector3.new(
                math.sin(radY) * math.cos(radX) * camDist,
                math.sin(radX) * camDist,
                math.cos(radY) * math.cos(radX) * camDist
            ),
            Vector3.new(0, 0, 0)
        )
    end
    updateCamera()

    -- Drag to rotate
    local dragging = false
    local lastPos
    if opts.DragEnabled ~= false then
        frame.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; lastPos = inp.Position
            end
        end)
        frame.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(inp)
            if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = inp.Position - lastPos
                lastPos = inp.Position
                camAngleY = camAngleY + delta.X * (opts.Speed or 0.5)
                camAngleX = math.clamp(camAngleX - delta.Y * (opts.Speed or 0.5), -80, 80)
                updateCamera()
            end
        end)
    end

    -- Rotation presets
    local presets = { Front = {0,0}, Back = {0,180}, Left = {0,90}, Right = {0,-90}, Top = {90,0}, Bottom = {-90,0} }

    return {
        Container = frame,
        Viewport = vp,
        Camera = camera,
        SetModel = function(_, model)
            for _, c in ipairs(vp:GetChildren()) do
                if c:IsA("Model") or c:IsA("BasePart") then c:Destroy() end
            end
            if model then model.Parent = vp end
        end,
        SetRotation = function(_, ax, ay)
            camAngleX = ax; camAngleY = ay; updateCamera()
        end,
        GetRotation = function(_) return camAngleX, camAngleY end,
        SetPreset = function(_, name)
            local p = presets[name]
            if p then camAngleX = p[1]; camAngleY = p[2]; updateCamera() end
        end,
        SetDistance = function(_, d) camDist = d; updateCamera() end,
        Destroy = function() frame:Destroy() end,
    }
end

-- ── CreateWatermark ───────────────────────────────────────────────────────────
function Axiom.CreateWatermark(opts)
    opts = opts or {}
    local theme = opts.Theme or Axiom.DefaultTheme

    local sg = Instance.new("ScreenGui")
    sg.Name = "AxiomWatermark"
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder = 5
    sg.IgnoreGuiInset = true
    sg.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = theme.WindowBg
    frame.BackgroundTransparency = opts.Transparency or 0.3
    frame.BorderSizePixel = 0
    frame.AutomaticSize = Enum.AutomaticSize.X
    frame.Size = UDim2.new(0, 0, 0, 24)
    frame.Position = opts.Position or UDim2.new(0, 8, 0, 8)
    frame.Parent = sg
    applyCorner(frame, 6)
    applyBorder(frame, theme.Border)
    applyPadding(frame, 8, 0)

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, 6)
    layout.Parent = frame

    if opts.Icon then
        addLeftIcon(frame, opts.Icon, 0, 16)
    end

    local mainLbl = Instance.new("TextLabel")
    mainLbl.BackgroundTransparency = 1
    mainLbl.Text = opts.Text or "Axiom"
    mainLbl.Font = Enum.Font.GothamBold
    mainLbl.TextSize = opts.TextSize or 13
    mainLbl.TextColor3 = theme.Text
    mainLbl.AutomaticSize = Enum.AutomaticSize.X
    mainLbl.Size = UDim2.new(0, 0, 1, 0)
    mainLbl.LayoutOrder = 1
    mainLbl.Parent = frame

    local subLbl
    if opts.Subtitle then
        subLbl = Instance.new("TextLabel")
        subLbl.BackgroundTransparency = 1
        subLbl.Text = opts.Subtitle
        subLbl.Font = Enum.Font.Gotham
        subLbl.TextSize = 11
        subLbl.TextColor3 = theme.SubText
        subLbl.AutomaticSize = Enum.AutomaticSize.X
        subLbl.Size = UDim2.new(0, 0, 1, 0)
        subLbl.LayoutOrder = 2
        subLbl.Parent = frame
    end

    return {
        Gui = sg,
        Frame = frame,
        SetText = function(_, t) mainLbl.Text = t end,
        SetSubtitle = function(_, t)
            if subLbl then subLbl.Text = t end
        end,
        SetVisible = function(_, v) sg.Enabled = v end,
        Destroy = function() sg:Destroy() end,
    }
end

return Axiom
