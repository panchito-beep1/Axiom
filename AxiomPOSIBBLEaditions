-- ── Utility Functions ──────────────────────────────────────────────────────────
local function darkenColor(c, factor)
    factor = factor or 0.7
    return Color3.new(c.R * factor, c.G * factor, c.B * factor)
end

local function applyCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 4)
    c.Parent = parent
    return c
end

local function applyBorder(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(48, 52, 60)
    s.Thickness = thickness or 1
    s.Parent = parent
    return s
end

local function applyPadding(parent, px, py)
    local p = Instance.new("UIPadding")
    local xPad = UDim.new(0, px or 6)
    local yPad = UDim.new(0, py or px or 6)
    p.PaddingLeft   = xPad
    p.PaddingRight  = xPad
    p.PaddingTop    = yPad
    p.PaddingBottom = yPad
    p.Parent = parent
    return p
end

local function makeLabel(parent, props)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = props.Color or Color3.fromRGB(255,255,255)
    lbl.Text       = props.Text or ""
    lbl.Font       = props.Font or Enum.Font.GothamMedium
    lbl.TextSize   = props.Size or 13
    lbl.TextXAlignment = props.AlignX or Enum.TextXAlignment.Left
    lbl.TextYAlignment = props.AlignY or Enum.TextYAlignment.Center
    lbl.Size       = props.FrameSize or UDim2.new(1,0,0,20)
    lbl.Position   = props.Position or UDim2.new(0,0,0,0)
    lbl.TextTruncate = props.Truncate or Enum.TextTruncate.AtEnd
    lbl.Parent     = parent
    return lbl
end

local function attachTooltip(gui, text, theme, delaySeconds)
    if not text or text == "" then return end
    delaySeconds = delaySeconds or 0.4
    local tip; local showThread
    gui.MouseEnter:Connect(function()
        showThread = task.delay(delaySeconds, function()
            if tip then tip:Destroy() end
            local sg = Instance.new("ScreenGui")
            sg.Name = "AxiomTooltip"
            sg.ResetOnSpawn = false
            sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            sg.DisplayOrder = 999
            sg.Parent = CoreGui
            tip = sg

            local frame = Instance.new("Frame")
            frame.BackgroundColor3 = theme and theme.PopupBg or Color3.fromRGB(25,27,32)
            frame.AutomaticSize = Enum.AutomaticSize.XY
            frame.BorderSizePixel = 0
            frame.Parent = sg
            applyCorner(frame, 4)
            applyBorder(frame, theme and theme.Border or Color3.fromRGB(48,52,60))
            applyPadding(frame, 6, 4)

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = theme and theme.Text or Color3.fromRGB(255,255,255)
            lbl.AutomaticSize = Enum.AutomaticSize.XY
            lbl.Parent = frame

            local conn
            conn = RunService.Heartbeat:Connect(function()
                local mp = UserInputService:GetMouseLocation()
                frame.Position = UDim2.new(0, mp.X + 14, 0, mp.Y + 6)
            end)
            sg.Destroying:Connect(function() conn:Disconnect() end)
        end)
    end)
    gui.MouseLeave:Connect(function()
        if showThread then task.cancel(showThread) showThread = nil end
        if tip then tip:Destroy() tip = nil end
    end)
end

local function makeDraggable(frame, handle, onDragEnd)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            if dragging and onDragEnd then
                onDragEnd(frame.Position)
            end
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or
                         input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

-- ── Window Focus Manager ───────────────────────────────────────────────────────
Axiom._WindowManager = {
    _windows    = {},
    _baseOrder  = 10,
    _activeWin  = nil,
}
do
    local wm = Axiom._WindowManager
    function wm:Register(winObj)
        table.insert(self._windows, winObj)
        self:SetActive(winObj)
    end
    function wm:Unregister(winObj)
        for i, w in ipairs(self._windows) do
            if w == winObj then table.remove(self._windows, i) break end
        end
    end
    function wm:SetActive(winObj)
        if self._activeWin == winObj then return end
        -- Dim previous active window's titlebar
        if self._activeWin and self._activeWin._titleBar then
            local theme = self._activeWin._theme or Axiom.DefaultTheme
            TweenService:Create(self._activeWin._titleBar,
                TWEEN_MID, { BackgroundColor3 = theme.TitleBg or theme.TitleBgActive }
            ):Play()
        end
        self._activeWin = winObj
        -- Raise display order
        for i, w in ipairs(self._windows) do
            if w._screen then
                w._screen.DisplayOrder = self._baseOrder + i
            end
        end
        if winObj._screen then
            winObj._screen.DisplayOrder = self._baseOrder + #self._windows + 1
        end
        -- Brighten active titlebar
        if winObj._titleBar then
            local theme = winObj._theme or Axiom.DefaultTheme
            TweenService:Create(winObj._titleBar,
                TWEEN_MID, { BackgroundColor3 = theme.TitleBgActive or theme.TitleBg }
            ):Play()
        end
    end
end

-- ── Global Drag & Drop Manager ─────────────────────────────────────────────────
Axiom._DragDrop = {
    _active      = false,
    _sourceData  = nil,
    _sourceType  = nil,
    _ghost       = nil,
    _targets     = {},
}
do
    local dd = Axiom._DragDrop
    local ghostGui
    function dd:EnsureGhost()
        if ghostGui then return end
        ghostGui = Instance.new("ScreenGui")
        ghostGui.Name = "AxiomDragGhost"
        ghostGui.ResetOnSpawn = false
        ghostGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        ghostGui.DisplayOrder = 998
        ghostGui.IgnoreGuiInset = true
        ghostGui.Parent = CoreGui
        self._ghost = Instance.new("Frame")
        self._ghost.Size = UDim2.new(0,100,0,24)
        self._ghost.BackgroundColor3 = Color3.fromRGB(56,101,165)
        self._ghost.BackgroundTransparency = 0.5
        self._ghost.BorderSizePixel = 0
        self._ghost.Visible = false
        self._ghost.Parent = ghostGui
        applyCorner(self._ghost, 4)
        RunService.Heartbeat:Connect(function()
            if self._active and self._ghost then
                local mp = UserInputService:GetMouseLocation()
                self._ghost.Position = UDim2.new(0, mp.X - 50, 0, mp.Y - 12)
            end
        end)
    end
    function dd:Begin(sourceData, sourceType, ghostText)
        self:EnsureGhost()
        self._active = true
        self._sourceData = sourceData
        self._sourceType = sourceType
        if self._ghost then
            self._ghost.Visible = true
            local lbl = self._ghost:FindFirstChild("GhostLabel")
            if not lbl then
                lbl = Instance.new("TextLabel")
                lbl.Name = "GhostLabel"
                lbl.BackgroundTransparency = 1
                lbl.Size = UDim2.new(1,0,1,0)
                lbl.TextColor3 = Color3.fromRGB(255,255,255)
                lbl.Font = Enum.Font.GothamMedium
                lbl.TextSize = 12
                lbl.Parent = self._ghost
            end
            lbl.Text = ghostText or tostring(sourceData)
        end
    end
    function dd:End()
        self._active = false
        if self._ghost then self._ghost.Visible = false end
        self._sourceData = nil
        self._sourceType = nil
    end
    function dd:RegisterTarget(frame, acceptType, callback)
        frame.MouseButton1Up:Connect(function()
            if self._active and (acceptType == nil or self._sourceType == acceptType) then
                callback(self._sourceData)
                self:End()
            end
        end)
    end
end

-- ── Keyboard Focus Manager ─────────────────────────────────────────────────────
Axiom._FocusManager = {
    _focused    = nil,
    _focusRing  = nil,
}
do
    local fm = Axiom._FocusManager
    function fm:SetFocus(widget)
        if self._focused == widget then return end
        if self._focused and self._focused._onFocusLost then
            self._focused:_onFocusLost()
        end
        self._focused = widget
        if widget and widget._onFocusGained then
            widget:_onFocusGained()
        end
    end
    function fm:Clear()
        self:SetFocus(nil)
    end
    -- Global Tab cycling
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.Tab then
            -- Tab cycling handled per-window via _focusableWidgets
        end
    end)
end

-- ── Theme Binding System ───────────────────────────────────────────────────────
function Axiom:_bindTheme(instance, propMap)
    -- propMap: { InstanceProperty = "ThemeKey", ... }
    self._themeBindings = self._themeBindings or {}
    table.insert(self._themeBindings, { instance = instance, propMap = propMap })
    -- Apply immediately
    local theme = self._theme or Axiom.DefaultTheme
    for prop, key in pairs(propMap) do
        local val = theme[key]
        if val ~= nil then
            instance[prop] = val
        end
    end
end

function Axiom:SetTheme(newTheme)
    self._theme = newTheme
    if not self._themeBindings then return end
    for _, binding in ipairs(self._themeBindings) do
        for prop, key in pairs(binding.propMap) do
            local val = newTheme[key]
            if val ~= nil then
                binding.instance[prop] = val
            end
        end
    end
end

function Axiom:GetTheme()
    return self._theme or Axiom.DefaultTheme
end

-- ── Window-level Disabled Scopes ───────────────────────────────────────────────
function Axiom:BeginDisabled(cond)
    if cond == nil or cond == true then
        self._disabledScopeCount = (self._disabledScopeCount or 0) + 1
    end
end

function Axiom:EndDisabled()
    if (self._disabledScopeCount or 0) > 0 then
        self._disabledScopeCount -= 1
    end
end

function Axiom:IsDisabled()
    return (self._disabledScopeCount or 0) > 0
end

-- ── Tab-level Disabled Scopes ──────────────────────────────────────────────────
function TabComponent:BeginDisabled(cond)
    if cond == nil or cond == true then
        self._disabledStack = self._disabledStack or {}
        table.insert(self._disabledStack, true)
    end
end

function TabComponent:EndDisabled()
    if self._disabledStack and #self._disabledStack > 0 then
        table.remove(self._disabledStack)
    end
end

function TabComponent:IsDisabled()
    if self._window and self._window:IsDisabled() then return true end
    return self._disabledStack and #self._disabledStack > 0
end

function TabComponent:_registerFocusable(widget)
    if not self._focusableWidgets then self._focusableWidgets = {} end
    table.insert(self._focusableWidgets, widget)
end

