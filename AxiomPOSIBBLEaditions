-- ── AddColorPicker ────────────────────────────────────────────────────────────
function TabComponent:AddColorPicker(text, default, callback, opts)
    opts = opts or {}
    local theme = self._theme
    local currentColor = default or Color3.fromRGB(255, 100, 100)
    local open = false

    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 0, 28)
    frame.LayoutOrder = self:_nextOrder()
    frame.Parent = self._frame

    local lbl = makeLabel(frame, { Text = text, Color = theme.Text, Size = 13,
