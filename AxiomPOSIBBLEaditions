-- Public entry
-- =========================================================
local Axiom = {}
Axiom.build = AXIOM_BUILD

function Axiom.new(config)
    print(("[Axiom] build %s — new() called"):format(AXIOM_BUILD))
    if type(config) ~= "table" then config = {} end
    if type(config.theme) ~= "table" then config.theme = nil end
    return Window.new(config)
end

function Axiom.notify(config)
    return Notify.show(config or {})
end

return Axiom
