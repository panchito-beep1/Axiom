    local preview = Instance.new("TextButton")
    preview.BackgroundColor3 = currentColor
    preview.BorderSizePixel = 0
    preview.AnchorPoint = Vector2.new(1, 0.5)
    preview.Position = UDim2.new(1, 0, 0.5, 0)
    preview.Size = UDim2.new(0.4, -4, 0, 20)
    preview.Text = ""
    preview.Parent = frame
    applyCorner(preview, 4)
    applyBorder(preview, theme.Border)

    -- Picker popup
    local pickerSG = Instance.new("ScreenGui")
    pickerSG.Name = "AxiomColorPicker"
    pickerSG.ResetOnSpawn = false
    pickerSG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pickerSG.DisplayOrder = 600
    pickerSG.Parent = CoreGui

    local pickerFrame = Instance.new("Frame")
    pickerFrame.BackgroundColor3 = theme.PopupBg or theme.FrameBg
    pickerFrame.BorderSizePixel = 0
    pickerFrame.Size = UDim2.new(0, 220, 0, 240)
    pickerFrame.Visible = false
    pickerFrame.Parent = pickerSG
    applyCorner(pickerFrame, 6)
    applyBorder(pickerFrame, theme.Border)
    applyPadding(pickerFrame, 8, 8)

    local pickerLayout = Instance.new("UIListLayout")
    pickerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pickerLayout.Padding = UDim.new(0, 6)
    pickerLayout.Parent = pickerFrame

    -- HSV canvas (gradient)
    local SV_SIZE = 160
    local svCanvas = Instance.new("ImageLabel")
    svCanvas.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    svCanvas.BorderSizePixel = 0
    svCanvas.Size = UDim2.new(0, SV_SIZE, 0, SV_SIZE)
    svCanvas.Image = "rbxassetid://6523286724" -- SV gradient overlay
    svCanvas.ImageColor3 = Color3.fromRGB(255,255,255)
    svCanvas.LayoutOrder = 1
    svCanvas.Parent = pickerFrame
    applyCorner(svCanvas, 4)

    -- Hue bar
    local HUE_H = 14
    local hueBar = Instance.new("ImageLabel")
    hueBar.BorderSizePixel = 0
    hueBar.Size = UDim2.new(0, SV_SIZE, 0, HUE_H)
    hueBar.Image = "rbxassetid://6523291969" -- Hue gradient
    hueBar.LayoutOrder = 2
    hueBar.Parent = pickerFrame
    applyCorner(hueBar, 4)

    -- Hue handle
    local hueHandle = Instance.new("Frame")
    hueHandle.BackgroundColor3 = Color3.fromRGB(255,255,255)
    hueHandle.BorderSizePixel = 0
    hueHandle.AnchorPoint = Vector2.new(0.5, 0)
    hueHandle.Position = UDim2.new(0, 0, 0, 0)
    hueHandle.Size = UDim2.new(0, 4, 1, 0)
    hueHandle.Parent = hueBar
    applyCorner(hueHandle, 2)

    -- Hex input
    local hexRow = Instance.new("Frame")
    hexRow.BackgroundTransparency = 1
    hexRow.Size = UDim2.new(0, SV_SIZE, 0, 22)
    hexRow.LayoutOrder = 3
    hexRow.Parent = pickerFrame

    makeLabel(hexRow, { Text = "#", Color = theme.SubText, Size = 12,
        FrameSize = UDim2.new(0, 14, 1, 0) })

    local hexBox = Instance.new("TextBox")
    hexBox.BackgroundColor3 = theme.FrameBg
    hexBox.BorderSizePixel = 0
    hexBox.PlaceholderText = "FFFFFF"
    hexBox.Text = string.format("%02X%02X%02X",
        math.floor(currentColor.R*255), math.floor(currentColor.G*255), math.floor(currentColor.B*255))
    hexBox.Font = Enum.Font.GothamMedium
    hexBox.TextSize = 12
    hexBox.TextColor3 = theme.Text
    hexBox.Position = UDim2.new(0, 16, 0, 0)
    hexBox.Size = UDim2.new(1, -16, 1, 0)
    hexBox.Parent = hexRow
    applyCorner(hexBox, 3)

    local hue, sat, val_ = 0, 1, 1
    hue, sat, val_ = Color3.toHSV(currentColor)

    local function updateColor()
        currentColor = Color3.fromHSV(hue, sat, val_)
        svCanvas.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        preview.BackgroundColor3 = currentColor
        hexBox.Text = string.format("%02X%02X%02X",
            math.floor(currentColor.R*255), math.floor(currentColor.G*255), math.floor(currentColor.B*255))
        hueHandle.Position = UDim2.new(hue, 0, 0, 0)
        if callback then callback(currentColor) end
    end

    -- SV canvas drag
    local svDrag = false
    svCanvas.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = true end
    end)
    svCanvas.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if svDrag and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local ap = svCanvas.AbsolutePosition
            local as = svCanvas.AbsoluteSize
            sat   = math.clamp((inp.Position.X - ap.X) / as.X, 0, 1)
            val_  = 1 - math.clamp((inp.Position.Y - ap.Y) / as.Y, 0, 1)
            updateColor()
        end
    end)

    -- Hue bar drag
    local hueDrag = false
    hueBar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = true end
    end)
    hueBar.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if hueDrag and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local ap = hueBar.AbsolutePosition
            local as = hueBar.AbsoluteSize
            hue = math.clamp((inp.Position.X - ap.X) / as.X, 0, 1)
            updateColor()
        end
    end)

    -- Hex box
    hexBox.FocusLost:Connect(function()
        local hex = hexBox.Text:gsub("#", "")
        if #hex == 6 then
            local r = tonumber(hex:sub(1,2), 16)
            local g = tonumber(hex:sub(3,4), 16)
            local b = tonumber(hex:sub(5,6), 16)
            if r and g and b then
                currentColor = Color3.fromRGB(r, g, b)
                hue, sat, val_ = Color3.toHSV(currentColor)
                updateColor()
            end
        end
    end)

    preview.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local absPos = preview.AbsolutePosition
            local absSize = preview.AbsoluteSize
            pickerFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
            pickerFrame.Visible = true
        else
            pickerFrame.Visible = false
        end
    end)
    UserInputService.InputBegan:Connect(function(input)
        if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
            task.wait()
            local mp = UserInputService:GetMouseLocation()
            local lp = pickerFrame.AbsolutePosition
            local ls = pickerFrame.AbsoluteSize
            if mp.X < lp.X or mp.X > lp.X + ls.X or mp.Y < lp.Y or mp.Y > lp.Y + ls.Y then
                open = false; pickerFrame.Visible = false
            end
        end
    end)

    return {
        Container = frame,
        GetColor = function(_) return currentColor end,
        SetColor = function(_, c)
            currentColor = c
            hue, sat, val_ = Color3.toHSV(c)
            updateColor()
        end,
        Destroy = function() frame:Destroy(); pickerSG:Destroy() end,
    }
end

