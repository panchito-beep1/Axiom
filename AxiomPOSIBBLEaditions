    arrowLbl.TextColor3 = theme.SubText
    arrowLbl.AnchorPoint = Vector2.new(1, 0.5)
    arrowLbl.Position = UDim2.new(1, -6, 0.5, 0)
    arrowLbl.Size = UDim2.new(0, 14, 0, 14)
    arrowLbl.Parent = header

    -- Dropdown list
    local listSG = Instance.new("ScreenGui")
    listSG.Name = "AxiomDropdown"
    listSG.ResetOnSpawn = false
    listSG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    listSG.DisplayOrder = 500
    listSG.Parent = CoreGui

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.BackgroundColor3 = theme.PopupBg or theme.FrameBg
    listFrame.BorderSizePixel = 0
    listFrame.Size = UDim2.new(0, 0, 0, 0)
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    listFrame.ScrollBarThickness = 3
    listFrame.ScrollBarImageColor3 = theme.ScrollbarGrab
    listFrame.Visible = false
    listFrame.Parent = listSG
    applyCorner(listFrame, 4)
    applyBorder(listFrame, theme.Border)

    local listLayout = Instance.new("UIListLayout")
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 1)
    listLayout.Parent = listFrame

    local function populateList()
        for _, c in ipairs(listFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for i, item in ipairs(items) do
            local opt = Instance.new("TextButton")
            opt.BackgroundColor3 = item == selected and theme.HeaderActive or theme.FrameBg
            opt.BorderSizePixel = 0
            opt.Size = UDim2.new(1, 0, 0, 24)
            opt.Text = tostring(item)
            opt.Font = Enum.Font.Gotham
            opt.TextSize = 12
            opt.TextColor3 = theme.Text
            opt.TextXAlignment = Enum.TextXAlignment.Left
            opt.LayoutOrder = i
            opt.Parent = listFrame
            applyPadding(opt, 6, 0)
            opt.MouseEnter:Connect(function()
                opt.BackgroundColor3 = theme.HeaderHover
            end)
            opt.MouseLeave:Connect(function()
                opt.BackgroundColor3 = item == selected and theme.HeaderActive or theme.FrameBg
            end)
            opt.MouseButton1Click:Connect(function()
                selected = item
                selLbl.Text = tostring(item)
                open = false
                arrowLbl.Text = "▼"
                listFrame.Visible = false
                if callback then callback(item) end
            end)
        end
    end
    populateList()

    local function openDropdown()
        local absPos = header.AbsolutePosition
        local absSize = header.AbsoluteSize
        local contentH = math.min(#items * 25 + 4, MAX_H)
        listFrame.Size = UDim2.new(0, absSize.X, 0, contentH)
        listFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
        listFrame.Visible = true
    end

    header.MouseButton1Click:Connect(function()
        open = not open
        if open then
            arrowLbl.Text = "▲"
            openDropdown()
        else
            arrowLbl.Text = "▼"
            listFrame.Visible = false
        end
    end)

    -- Close on outside click
    UserInputService.InputBegan:Connect(function(input)
        if open and input.UserInputType == Enum.UserInputType.MouseButton1 then
            task.wait()
            if not listFrame:IsDescendantOf(CoreGui) then return end
            local mp = UserInputService:GetMouseLocation()
            local lp = listFrame.AbsolutePosition
            local ls = listFrame.AbsoluteSize
            if mp.X < lp.X or mp.X > lp.X + ls.X or mp.Y < lp.Y or mp.Y > lp.Y + ls.Y then
                open = false
                arrowLbl.Text = "▼"
                listFrame.Visible = false
            end
        end
    end)

    local ddObj = {
        Container = frame,
        GetValue = function(_) return selected end,
        SetValue = function(_, v) selected = v; selLbl.Text = tostring(v); populateList() end,
        AddItem = function(_, item)
            table.insert(items, item)
            populateList()
        end,
        SetItems = function(_, newItems)
            items = newItems
            selected = newItems[1]
            selLbl.Text = tostring(selected or "Select...")
            populateList()
        end,
        Clear = function(_)
            items = {}
            selected = nil
            selLbl.Text = "Select..."
            populateList()
        end,
        Destroy = function()
            frame:Destroy()
            listSG:Destroy()
        end,
    }
    return ddObj
end

