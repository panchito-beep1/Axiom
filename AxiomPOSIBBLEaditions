--  AddVideoButton (Media Thumbnail Button with Play/Pause Badge)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddVideoButton(options)
    options = options or {}
    local theme = getTheme(self)

    local title    = options.Title or "Video"
    local duration = options.Duration or "00:00"
    local thumbId  = Axiom.ResolveIcon(options.Thumbnail or options.Video) or ""
