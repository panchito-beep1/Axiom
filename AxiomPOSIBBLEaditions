-- ── AddSplitter ───────────────────────────────────────────────────────────────
function TabComponent:AddSplitter(opts)
    opts = opts or {}
    local theme = self._theme
    local direction = opts.Direction or "Horizontal"
    local ratio = opts.Ratio or 0.5
    local minR = opts.MinRatio or 0.1
    local maxR = opts.MaxRatio or 0.9

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = opts.Size or UDim2.new(1, 0, 0, 200)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._frame

    local paneA = Instance.new("Frame")
    paneA.BackgroundColor3 = theme.ChildBg or theme.WindowBg
    paneA.BorderSizePixel = 0
    paneA.Parent = container
    applyCorner(paneA, 4)

    local divider = Instance.new("Frame")
    divider.BackgroundColor3 = theme.Separator
    divider.BorderSizePixel = 0
    divider.Parent = container

    local paneB = Instance.new("Frame")
    paneB.BackgroundColor3 = theme.ChildBg or theme.WindowBg
    paneB.BorderSizePixel = 0
    paneB.Parent = container
    applyCorner(paneB, 4)

    local DIV_SIZE = 6

    local function updateLayout()
        if direction == "Horizontal" then
            paneA.Position  = UDim2.new(0, 0, 0, 0)
            paneA.Size      = UDim2.new(ratio, -DIV_SIZE/2, 1, 0)
            divider.Position = UDim2.new(ratio, -DIV_SIZE/2, 0, 0)
            divider.Size    = UDim2.new(0, DIV_SIZE, 1, 0)
            paneB.Position  = UDim2.new(ratio, DIV_SIZE/2, 0, 0)
            paneB.Size      = UDim2.new(1 - ratio, -DIV_SIZE/2, 1, 0)
        else
            paneA.Position  = UDim2.new(0, 0, 0, 0)
            paneA.Size      = UDim2.new(1, 0, ratio, -DIV_SIZE/2)
            divider.Position = UDim2.new(0, 0, ratio, -DIV_SIZE/2)
            divider.Size    = UDim2.new(1, 0, 0, DIV_SIZE)
            paneB.Position  = UDim2.new(0, 0, ratio, DIV_SIZE/2)
            paneB.Size      = UDim2.new(1, 0, 1 - ratio, -DIV_SIZE/2)
        end
    end
    updateLayout()

    -- Dragging
    local dragging = false
    divider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            divider.BackgroundColor3 = theme.SeparatorActive
        end
    end)
    divider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            divider.BackgroundColor3 = theme.Separator
        end
    end)
    divider.MouseEnter:Connect(function()
        if not dragging then divider.BackgroundColor3 = theme.SeparatorHover end
    end)
    divider.MouseLeave:Connect(function()
        if not dragging then divider.BackgroundColor3 = theme.Separator end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local ap = container.AbsolutePosition
            local as = container.AbsoluteSize
            if direction == "Horizontal" then
                ratio = math.clamp((input.Position.X - ap.X) / as.X, minR, maxR)
            else
                ratio = math.clamp((input.Position.Y - ap.Y) / as.Y, minR, maxR)
            end
            updateLayout()
        end
    end)

    local layoutA = Instance.new("UIListLayout")
    layoutA.SortOrder = Enum.SortOrder.LayoutOrder
    layoutA.Padding = UDim.new(0, 4)
    layoutA.Parent = paneA
    applyPadding(paneA, 4, 4)

    local layoutB = Instance.new("UIListLayout")
    layoutB.SortOrder = Enum.SortOrder.LayoutOrder
    layoutB.Padding = UDim.new(0, 4)
    layoutB.Parent = paneB
    applyPadding(paneB, 4, 4)

    local function makePane(paneFrame)
        local pt = setmetatable({}, TabComponent)
        pt._window = self._window
        pt._frame  = paneFrame
        pt._theme  = self._theme
        pt._order  = 0
        pt._disabledStack = {}
        pt._focusableWidgets = {}
        pt._divisionContainer = nil
        function pt:_nextOrder()
            self._order = self._order + 1
            self._divisionContainer = nil
            return self._order
        end
        pt._filterContent = TabComponent._filterContent
        return pt
    end

    return {
        Container = container,
        LeftPane  = makePane(paneA),
        RightPane = makePane(paneB),
        TopPane   = makePane(paneA),
        BottomPane = makePane(paneB),
        SetRatio = function(r) ratio = math.clamp(r, minR, maxR); updateLayout() end,
        GetRatio = function() return ratio end,
        Destroy = function() container:Destroy() end,
    }
end

