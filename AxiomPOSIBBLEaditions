-- ════════════════════════════════════════════════════════════════════════════
--  AddTable (Sortable Columns, Selectable Rows, Hidden Headers, Row Colors)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddTable(options)
    options = options or {}
    local theme = getTheme(self)

    local headers        = options.Headers or {}
    local rows           = options.Rows or {}
    local headerHeight   = options.HideHeaders and 0 or (options.HeaderHeight or 24)
    local rowHeight      = options.RowHeight or 22
    local maxHeight      = options.MaxHeight or 200
    local sortable       = options.Sortable ~= false
    local selectable     = options.Selectable ~= false
    local multiSelect    = options.MultiSelect or false
    local altRowColors   = options.AlternateRowColors ~= false
    local rowColor1      = options.RowColor1 or theme.TableRowBg
    local rowColor2      = options.RowColor2 or theme.TableRowBgAlt
    local selectedColor  = options.SelectedColor or theme.TableSelected or theme.Accent
    local onSelect       = options.OnSelect

    local currentRows = {}
    for i, r in ipairs(rows) do currentRows[i] = r end

    local selectedIndices = {}
    local sortCol = nil
    local sortAsc = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, math.min(#currentRows * rowHeight + headerHeight + 2, maxHeight))
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page
    applyCorner(container, 2)
    applyBorder(container, theme.TableBorderStrong or theme.Border)

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = theme.ScrollbarGrab
    scroll.Parent = container

    local headerFrame
    local headerButtons = {}
    if not options.HideHeaders and #headers > 0 then
        headerFrame = Instance.new("Frame")
        headerFrame.BackgroundColor3 = theme.TableHeaderBg or theme.TitleBg
        headerFrame.Size = UDim2.new(1, 0, 0, headerHeight)
        headerFrame.Parent = scroll
        applyBorder(headerFrame, theme.TableBorderStrong or theme.Border)

        local colW = 1 / #headers
        for i, headerTitle in ipairs(headers) do
            local hBtn = Instance.new("TextButton")
            hBtn.BackgroundTransparency = 1
            hBtn.Position = UDim2.new((i - 1) * colW, 0, 0, 0)
            hBtn.Size = UDim2.new(colW, 0, 1, 0)
            hBtn.Font = Enum.Font.RobotoMono
            hBtn.Text = headerTitle
            hBtn.TextColor3 = theme.Text
            hBtn.TextSize = 12
            hBtn.TextXAlignment = Enum.TextXAlignment.Center
            hBtn.Parent = headerFrame

            if sortable then
                hBtn.MouseButton1Click:Connect(function()
                    if sortCol == i then
                        sortAsc = not sortAsc
                    else
                        sortCol = i
                        sortAsc = true
                    end
                    for idx, b in ipairs(headerButtons) do
                        b.Text = headers[idx] .. ((idx == sortCol) and (sortAsc and " ▲" or " ▼") or "")
                    end
                    table.sort(currentRows, function(a, b)
                        local va, vb = a[sortCol], b[sortCol]
                        if tonumber(va) and tonumber(vb) then
                            return sortAsc and (tonumber(va) < tonumber(vb)) or (tonumber(va) > tonumber(vb))
                        else
                            return sortAsc and (tostring(va):lower() < tostring(vb):lower()) or (tostring(va):lower() > tostring(vb):lower())
                        end
                    end)
                    refreshRows()
                end)
            end
            table.insert(headerButtons, hBtn)
        end
    end

    local rowFrames = {}
    function refreshRows()
        for _, rf in ipairs(rowFrames) do rf:Destroy() end
        table.clear(rowFrames)

        local colW = #headers > 0 and (1 / #headers) or 1
        for r, rowData in ipairs(currentRows) do
            local isSel = selectedIndices[r] == true
            local bg = isSel and selectedColor or (altRowColors and (r % 2 == 0 and rowColor2 or rowColor1) or rowColor1)

            local rowBtn = Instance.new("TextButton")
            rowBtn.BackgroundColor3 = bg
            rowBtn.Position = UDim2.new(0, 0, 0, headerHeight + (r - 1) * rowHeight)
            rowBtn.Size = UDim2.new(1, 0, 0, rowHeight)
            rowBtn.Text = ""
            rowBtn.AutoButtonColor = false
            rowBtn.Parent = scroll
            applyBorder(rowBtn, theme.TableBorderLight or theme.Border)

            for c, cell in ipairs(rowData) do
                local cellLabel = Instance.new("TextLabel")
                cellLabel.BackgroundTransparency = 1
                cellLabel.Position = UDim2.new((c - 1) * colW, 0, 0, 0)
                cellLabel.Size = UDim2.new(colW, 0, 1, 0)
                cellLabel.Font = Enum.Font.RobotoMono
                cellLabel.Text = tostring(cell)
                cellLabel.TextColor3 = isSel and Color3.fromRGB(255, 255, 255) or theme.Text
                cellLabel.TextSize = 12
                cellLabel.TextXAlignment = Enum.TextXAlignment.Center
                cellLabel.TextWrapped = true
                cellLabel.RichText = true
                cellLabel.Parent = rowBtn
            end

            if selectable then
                rowBtn.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selectedIndices[r] = not selectedIndices[r]
                    else
                        local was = selectedIndices[r]
                        table.clear(selectedIndices)
                        selectedIndices[r] = not was
                    end
                    refreshRows()
                    if onSelect then
                        safeCall(onSelect, r, rowData, selectedIndices[r])
                    end
                end)
            end
            table.insert(rowFrames, rowBtn)
        end

        local totalContentH = headerHeight + #currentRows * rowHeight
        scroll.CanvasSize = UDim2.new(0, 0, 0, totalContentH)
        container.Size = UDim2.new(1, 0, 0, math.min(totalContentH + 2, maxHeight))
    end
    refreshRows()

    local obj = { _instance = container }
    function obj:SetData(newRows)
        currentRows = {}
        for i, r in ipairs(newRows) do currentRows[i] = r end
        table.clear(selectedIndices)
        refreshRows()
    end
    function obj:GetSelected()
        local sel = {}
        for idx in pairs(selectedIndices) do
            table.insert(sel, { Index = idx, Data = currentRows[idx] })
        end
        return sel
    end
    function obj:ClearSelection()
        table.clear(selectedIndices)
        refreshRows()
    end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddGraph (Smooth Bezier / Catmull-Rom Graph from Script 2)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddGraph(options)
    options = options or {}
    local theme      = getTheme(self)

    local title       = options.Title or "Graph"
    local maxPoints   = options.MaxPoints or 100
    local lineColor   = options.LineColor or theme.GraphLine
    local yMin        = options.YMin
    local yMax        = options.YMax
    local smoothAlpha = options.SmoothAlpha or 0.2
    local maxLines    = options.MaxLines or 120

    local buf     = table.create(maxPoints, 0)
    local bufHead = 1
    local bufSize = 0
    local smoothed = nil
    local dirty    = false

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size        = UDim2.new(1, 0, 0, 108)
    container.LayoutOrder = self:_nextOrder()
    container.Parent      = self._page

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size       = UDim2.new(1, 0, 0, 18)
    titleLabel.Font       = Enum.Font.RobotoMono
    titleLabel.Text       = title
    titleLabel.TextColor3 = theme.Text
    titleLabel.TextSize   = 12
    titleLabel.Parent     = container

    local graphFrame = Instance.new("Frame")
    graphFrame.BackgroundColor3 = theme.GraphBg
    graphFrame.BorderSizePixel  = 0
    graphFrame.Position         = UDim2.new(0, 0, 0, 20)
    graphFrame.Size             = UDim2.new(1, 0, 0, 80)
    graphFrame.ClipsDescendants = true
    graphFrame.Parent           = container
    applyCorner(graphFrame, 2)
    applyBorder(graphFrame, theme.Border)

    local linesHolder = Instance.new("Frame")
    linesHolder.BackgroundTransparency = 1
    linesHolder.Size   = UDim2.new(1, 0, 1, 0)
    linesHolder.Parent = graphFrame

    local pool = table.create(maxLines)
    for i = 1, maxLines do
        local f = Instance.new("Frame")
        f.BackgroundColor3 = lineColor
        f.BorderSizePixel  = 0
        f.Size             = UDim2.new(0, 0, 0, 2)
        f.Visible          = false
        f.Parent           = linesHolder
        pool[i]            = f
    end

    local function cr(p0, p1, p2, p3, t)
        local t2 = t * t
        local t3 = t2 * t
        return 0.5 * ((2*p1) + (-p0 + p2)*t + (2*p0 - 5*p1 + 4*p2 - p3)*t2 + (-p0 + 3*p1 - 3*p2 + p3)*t3)
    end

    local function redraw()
        local W, H = graphFrame.AbsoluteSize.X, graphFrame.AbsoluteSize.Y
        if W <= 0 or H <= 0 or bufSize < 2 then
            for i = 1, maxLines do pool[i].Visible = false end
            return
        end
        local lo, hi
        if yMin and yMax then lo, hi = yMin, yMax
        else
            lo, hi = math.huge, -math.huge
            for i = 1, bufSize do
                local v = buf[((bufHead - 1 + i - 1) % maxPoints) + 1]
                if v < lo then lo = v end
                if v > hi then hi = v end
            end
            if lo == hi then hi = lo + 1 end
        end
        local range = hi - lo
        local PAD = 3
        local drawH = H - PAD * 2
        local px, py = table.create(bufSize), table.create(bufSize)
        for i = 1, bufSize do
            local v = buf[((bufHead - 1 + i - 1) % maxPoints) + 1]
            px[i] = (i - 1) / (bufSize - 1) * W
            py[i] = PAD + drawH - ((v - lo) / range) * drawH
        end
        local intervals  = bufSize - 1
        local stepsEach  = math.max(1, math.floor(maxLines / intervals))
        local used = 0
        for i = 1, intervals do
            local i0 = math.max(1, i - 1)
            local i2 = math.min(bufSize, i + 1)
            local i3 = math.min(bufSize, i + 2)
            local lx, ly = px[i], py[i]
            for s = 1, stepsEach do
                local t  = s / stepsEach
                local nx = cr(px[i0], px[i], px[i2], px[i3], t)
                local ny = cr(py[i0], py[i], py[i2], py[i3], t)
                local dx = nx - lx
                local dy = ny - ly
                local len = math.sqrt(dx * dx + dy * dy)
                if len > 0.5 and used < maxLines then
                    used = used + 1
                    local f = pool[used]
                    f.Size     = UDim2.new(0, len + 1, 0, 2)
                    f.Position = UDim2.new(0, lx, 0, ly - 1)
                    f.Rotation = math.deg(math.atan2(dy, dx))
                    f.Visible  = true
                end
                lx, ly = nx, ny
            end
        end
        for i = used + 1, maxLines do pool[i].Visible = false end
    end

    local hbConn = RunService.Heartbeat:Connect(function() if dirty then dirty = false; redraw() end end)
    graphFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() dirty = true end)

    if self._window then self._window:_registerSearch(container, title) end

    local graphObj = {}
    function graphObj:Push(rawValue)
        if smoothed == nil then smoothed = rawValue
        else smoothed = smoothed + (rawValue - smoothed) * smoothAlpha end
        local tail = ((bufHead - 1 + bufSize) % maxPoints) + 1
        buf[tail] = smoothed
        if bufSize < maxPoints then bufSize = bufSize + 1
        else bufHead = (bufHead % maxPoints) + 1 end
        dirty = true
    end
    function graphObj:SetColor(color)
        lineColor = color
        for i = 1, maxLines do pool[i].BackgroundColor3 = color end
    end
    function graphObj:Clear() bufSize = 0; bufHead = 1; smoothed = nil; dirty = true end
    function graphObj:Destroy() hbConn:Disconnect(); container:Destroy() end
    return graphObj
end

return Axiom
