-- ═══ Keyboard Navigation & Focus Ring Manager ═════════════════════════════════
Axiom._FocusManager = {
    FocusedWidget = nil,
    RingStroke = nil,
}

function Axiom._FocusManager:SetFocus(widget)
    if self.FocusedWidget == widget then return end
    if self.FocusedWidget and self.FocusedWidget._onFocusLost then
        self.FocusedWidget:_onFocusLost()
    end
    if self.RingStroke then
        self.RingStroke:Destroy()
        self.RingStroke = nil
    end
    self.FocusedWidget = widget
    if widget and widget._instance then
        local stroke = Instance.new("UIStroke")
        stroke.Name = "ImGuiFocusRing"
        local theme = (widget._window and widget._window._theme) or Axiom.DefaultTheme
        stroke.Color = theme.NavHighlight or Color3.fromRGB(80, 140, 235)
        stroke.Thickness = 1.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = widget._instance
        self.RingStroke = stroke
        if widget._onFocusGained then widget:_onFocusGained() end
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local activeWin = Axiom._WindowManager.ActiveWindow
    if not activeWin or not activeWin._keyboardNavEnabled then return end

    if input.KeyCode == Enum.KeyCode.Tab then
        local widgets = activeWin._focusableWidgets or {}
        if #widgets == 0 then return end
        local isShift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
        local curIdx = 0
        for i, w in ipairs(widgets) do
            if w == Axiom._FocusManager.FocusedWidget then curIdx = i; break end
        end
        local nextIdx = curIdx + (isShift and -1 or 1)
        if nextIdx > #widgets then nextIdx = 1 elseif nextIdx < 1 then nextIdx = #widgets end
        Axiom._FocusManager:SetFocus(widgets[nextIdx])
    elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return then
        local w = Axiom._FocusManager.FocusedWidget
        if w and w._onKeyboardActivate then w:_onKeyboardActivate() end
    elseif input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.Right then
        local w = Axiom._FocusManager.FocusedWidget
        if w and w._onKeyboardStep then
            w:_onKeyboardStep(input.KeyCode == Enum.KeyCode.Right and 1 or -1)
        end
    end
end)

-- ── Tooltip Infrastructure ────────────────────────────────────────────────────
local tooltipGui, tooltipLabel, tooltipTimer

local function ensureTooltipGui(theme)
    if tooltipGui then
        tooltipLabel.BackgroundColor3 = theme.PopupBg or theme.WindowBg
        tooltipLabel.TextColor3 = theme.Text
        local stroke = tooltipLabel:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Color = theme.Border end
        return
    end
    tooltipGui = Instance.new("ScreenGui")
    tooltipGui.Name = "Axiom_Tooltip"
    tooltipGui.ResetOnSpawn = false
    tooltipGui.DisplayOrder = 9999
    tooltipGui.Parent = CoreGui

    tooltipLabel = Instance.new("TextLabel")
    tooltipLabel.BackgroundColor3 = theme.PopupBg or theme.WindowBg
    tooltipLabel.BorderSizePixel = 0
    tooltipLabel.Font = Enum.Font.RobotoMono
    tooltipLabel.TextColor3 = theme.Text
    tooltipLabel.TextSize = 12
    tooltipLabel.TextWrapped = true
    tooltipLabel.AutomaticSize = Enum.AutomaticSize.XY
    tooltipLabel.Visible = false
    tooltipLabel.ZIndex = 1000
    tooltipLabel.Parent = tooltipGui
    applyCorner(tooltipLabel, 2)
    applyBorder(tooltipLabel, theme.Border)
    applyPadding(tooltipLabel, 6, 4)
end

local function hideTooltip()
    if tooltipTimer then task.cancel(tooltipTimer); tooltipTimer = nil end
    if tooltipLabel then tooltipLabel.Visible = false end
end

local function attachTooltip(anchor, text, win, delaySeconds)
    if not text or not anchor then return end
    local delay = delaySeconds or 0.4
    anchor.MouseEnter:Connect(function()
        hideTooltip()
        if delay <= 0 then
            local theme = (win and win._theme) or Axiom.DefaultTheme
            ensureTooltipGui(theme)
            tooltipLabel.Text = text
            local absPos  = anchor.AbsolutePosition
            local absSize = anchor.AbsoluteSize
            tooltipLabel.Position = UDim2.new(0, absPos.X + 8, 0, absPos.Y + absSize.Y + 4)
            tooltipLabel.Visible = true
        else
            tooltipTimer = task.delay(delay, function()
                local theme = (win and win._theme) or Axiom.DefaultTheme
                ensureTooltipGui(theme)
                tooltipLabel.Text = text
                local absPos  = anchor.AbsolutePosition
                local absSize = anchor.AbsoluteSize
                tooltipLabel.Position = UDim2.new(0, absPos.X + 8, 0, absPos.Y + absSize.Y + 4)
                tooltipLabel.Visible = true
            end)
        end
    end)
    anchor.MouseLeave:Connect(hideTooltip)
end

local function warnCustomColor(tab, componentName)
    if tab._window and tab._window.Notify then
        tab._window:Notify({
            Title       = "Theme Warning",
            Description = "Custom colour used on " .. componentName .. " – this may break theme consistency!",
            Duration    = 4,
            Type        = "warn",
        })
    end
end

