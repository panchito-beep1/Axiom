-- =========================================================
-- Util
-- =========================================================
local Util = {}

function Util.create(className, props)
    local inst = Instance.new(className)
    if type(props) ~= "table" then
        if props then inst.Parent = props end
        return inst
    end
    local parent = props.Parent
    for k, v in pairs(props) do
        if k ~= "Parent" then inst[k] = v end
    end
    if parent then inst.Parent = parent end
    return inst
end

function Util.corner(radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 4)
    return c
end

function Util.stroke(color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(40, 40, 40)
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

-- Obsidian-style double outline (1px outline + 1.5px dark shadow)
function Util.outline(frame, outlineColor, darkColor)
    local outline = Instance.new("UIStroke")
    outline.Color = outlineColor
    outline.Thickness = 1
    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outline.Parent = frame

    local shadow = Instance.new("UIStroke")
    shadow.Color = darkColor
    shadow.Thickness = 1.5
    shadow.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    shadow.Parent = frame

    return outline, shadow
end

-- Text stroke for readability (Obsidian contextual stroke)
function Util.textStroke(textLabel, color)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    s.Color = color or Color3.new(0, 0, 0)
    s.LineJoinMode = Enum.LineJoinMode.Miter
    s.Parent = textLabel
    return s
end

function Util.padding(props)
    local p = Instance.new("UIPadding")
    props = props or {}
    p.PaddingTop = UDim.new(0, props.top or 0)
    p.PaddingBottom = UDim.new(0, props.bottom or 0)
    p.PaddingLeft = UDim.new(0, props.left or 0)
    p.PaddingRight = UDim.new(0, props.right or 0)
    return p
end

function Util.listLayout(props)
    local l = Instance.new("UIListLayout")
    props = props or {}
    l.FillDirection = props.direction or Enum.FillDirection.Vertical
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, props.gap or 4)
    if props.valign then l.VerticalAlignment = props.valign end
    if props.halign then l.HorizontalAlignment = props.halign end
    return l
end

function Util.tween(inst, props, time, style, dir)
    TweenService:Create(
        inst,
        TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props
    ):Play()
end

