--  Axiom:AddTab
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:AddTab(options)
    options = options or {}
    local name   = options.Name or "Tab"
    local iconId = options.Icon
    local theme  = self._theme

    if #self._tabs == 0 then
        if options.Layout and options.Layout ~= self._tabLayoutMode then
            self:_applyTabLayout(options.Layout)
        end
    elseif options.Layout and options.Layout ~= self._tabLayoutMode then
        warn("[Axiom] Tab layout already set to '" .. tostring(self._tabLayoutMode) ..
             "'; ignoring Layout='" .. tostring(options.Layout) ..
             "' on new tab. Use win:SetTabLayout() to change it.")
    end

    local tabBtn = Instance.new("TextButton")
    tabBtn.BackgroundColor3 = theme.TabNormal
    tabBtn.Size             = UDim2.new(0, 0, 1, 0)
    tabBtn.Font             = Enum.Font.RobotoMono
    tabBtn.Text             = ""
    tabBtn.TextColor3       = theme.TabNormalText
    tabBtn.TextSize         = 13
    tabBtn.LayoutOrder      = #self._tabs + 1
    tabBtn.Parent           = self._tabContainer
    applyBorder(tabBtn, theme.Border)

    local tabText = Instance.new("TextLabel")
    tabText.BackgroundTransparency = 1
    tabText.Font         = Enum.Font.RobotoMono
    tabText.Text         = name
    tabText.TextColor3   = theme.TabNormalText
    tabText.TextSize     = 13
    tabText.TextTruncate = Enum.TextTruncate.AtEnd
    tabText.TextXAlignment = Enum.TextXAlignment.Center
    tabText.Parent       = tabBtn

    local icon
    if iconId then
        icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Size     = UDim2.new(0, 18, 0, 18)
        icon.Position = UDim2.new(0, 4, 0.5, -9)
        icon.Image    = iconId
        icon.Parent   = tabBtn
    end

    local page = Instance.new("ScrollingFrame")
    page.BackgroundTransparency = 1
    page.Size                   = UDim2.new(1, 0, 1, 0)
    page.ScrollBarThickness     = 4
    page.ScrollBarImageColor3   = theme.Accent
    page.Visible                = false
    page.Parent                 = self._pageContainer
    applyPadding(page, 8)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding   = UDim.new(0, 6)
    layout.Parent    = page

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)

    local tabRecord = {Button = tabBtn, Page = page, TextLabel = tabText, Icon = icon}
    table.insert(self._tabs, tabRecord)
    self:_sizeTab(tabRecord)

    tabBtn.MouseButton1Click:Connect(function()
        for i, t in ipairs(self._tabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = theme.TabNormal
            t.TextLabel.TextColor3 = theme.TabNormalText
            if t.Button == tabBtn then self._activeTabIndex = i end
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = theme.TabActive
        tabText.TextColor3 = theme.TabActiveText
    end)

    if #self._tabs == 1 then
        page.Visible = true
        tabBtn.BackgroundColor3 = theme.TabActive
        tabText.TextColor3 = theme.TabActiveText
        self._activeTabIndex = 1
    end

    local tabObj = setmetatable({}, TabComponent)
    tabObj._page        = page
    tabObj._layoutOrder = 0
    tabObj._window      = self
    return tabObj
end

