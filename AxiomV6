    subBtn.Size = UDim2.new(0, 0, 1, 0)
    subBtn.Font = Enum.Font.RobotoMono
    subBtn.Text = ""
    subBtn.TextSize = 12
    subBtn.LayoutOrder = #self._subTabs + 1
    subBtn.Parent = bar
    applyBorder(subBtn, theme.Border)

    local subText = Instance.new("TextLabel")
    subText.BackgroundTransparency = 1
    subText.Font = Enum.Font.RobotoMono
    subText.Text = name
    subText.TextColor3 = theme.TabNormalText
    subText.TextSize = 12
    subText.TextXAlignment = Enum.TextXAlignment.Center
    subText.TextTruncate   = Enum.TextTruncate.AtEnd
    subText.Position       = UDim2.new(0, 0, 0, 0)
    subText.Size           = UDim2.new(1, 0, 1, 0)
