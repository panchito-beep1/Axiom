--  Axiom._Internal — shared helpers for TargetWindow + Viewport + future
-- ════════════════════════════════════════════════════════════════════════════
Axiom._Internal = Axiom._Internal or {}

function Axiom._Internal.PrepareModel(originalModel)
    if typeof(originalModel) ~= "Instance" then return nil end
    local wasArchivable = originalModel.Archivable
    originalModel.Archivable = true
    local ok, clone = pcall(function() return originalModel:Clone() end)
    originalModel.Archivable = wasArchivable
    if not ok or not clone then return nil end

    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then hum:Destroy() end
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
        end
    end
    if clone:IsA("BasePart") then
        clone.Anchored = true
        clone.CFrame = CFrame.new()
    elseif clone:IsA("Model") then
        pcall(function() clone:PivotTo(CFrame.new()) end)
    end
    return clone
end

function Axiom._Internal.FitCamera(camera, model, fov, padding, angle)
    if not camera or not model then return end
    local center, size
    if model:IsA("Model") then
        local ok, cf, sz = pcall(function()
            local c, s = model:GetBoundingBox()
            return c, s
        end)
        if ok and cf then center, size = cf.Position, sz end
    elseif model:IsA("BasePart") then
        center, size = model.Position, model.Size
    end
    center = center or Vector3.zero
    size = size or Vector3.new(2, 2, 2)
    if size.Magnitude < 0.01 then size = Vector3.new(2, 2, 2) end

    local radius = size.Magnitude * 0.5 * (padding or 1.3)
    local dist = radius / math.tan(math.rad(fov or 30) * 0.5)
    local rotCF = CFrame.Angles(0, angle or 0, 0)
    local offset = rotCF * Vector3.new(0, radius * 0.25, dist)
    camera.FieldOfView = fov or 30
    camera.CFrame = CFrame.lookAt(center + offset, center)
    return center, radius
end

