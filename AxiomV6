Axiom.Config = {}
function Axiom.Config.new(folder, filename)
    folder = folder or "Axiom"
    filename = filename or "config.json"
    local fullPath = folder .. "/" .. filename

    local self = {}
    self._data = {}

    if isfolder and makefolder and not isfolder(folder) then pcall(makefolder, folder) end

    local function saveToStorage(tbl)
        if not writefile then return end
        local ok, json = pcall(function() return HttpService:JSONEncode(tbl) end)
        if ok then pcall(writefile, fullPath, json) end
    end

    local function loadFromStorage()
        if not (isfile and readfile and isfile(fullPath)) then return {} end
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(fullPath))
        end)
        if ok and type(decoded) == "table" then return decoded end
        return {}
    end

    function self:Set(key, value) self._data[key] = value end
    function self:Get(key) return self._data[key] end
    function self:Save() saveToStorage(self._data) end
    function self:Load() self._data = loadFromStorage(); return self._data end
    function self:BindCheckbox(tab, key, text, default)
        local saved = self:Get(key)
        local initial = saved ~= nil and saved or default
        return tab:AddCheckbox({
            Text     = text,
            Default  = initial,
            Callback = function(value) self:Set(key, value) end,
        })
    end
    return self
end

function Axiom:Destroy()
    if self._watermark then pcall(function() self._watermark:Destroy() end) end
    if self._notificationGui then pcall(function() self._notificationGui:Destroy() end) end
    if self._keySystemGui then pcall(function() self._keySystemGui:Destroy() end) end
    if tooltipGui then pcall(function() tooltipGui:Destroy() end); tooltipGui = nil end
  if self._targetWindows then
      for _, tw in ipairs(self._targetWindows) do
          pcall(function() tw:Destroy() end)
      end
      self._targetWindows = nil
  end
    if self._screen then pcall(function() self._screen:Destroy() end) end
end

-- ═══════════════════════════════════════════════════════════════════════════
--  Vanilla tab-layout support
-- ═══════════════════════════════════════════════════════════════════════════
do
    local VALID = { top = true, bottom = true, left = true, right = true }

    local function hasIcon(tabBtn)
        return tabBtn:FindFirstChildWhichIsA("ImageLabel", true) ~= nil
    end

    local function applyLayout(self, layout)
        layout = layout or "top"
        if not VALID[layout] then
            warn("[Axiom] invalid layout '" .. tostring(layout) .. "', using 'top'")
            layout = "top"
        end
        self._tabLayoutMode = layout

        local tb = self._tabContainer
        local pc = self._pageContainer
        if not (tb and pc) then return end

        local tl = self._tabListLayout
        if not tl then
            tl = Instance.new("UIListLayout")
            tl.SortOrder = Enum.SortOrder.LayoutOrder
            tl.Parent = tb
            self._tabListLayout = tl
        end

        local w = self._tabBarWidth or 120
        local resizer = self._resizer

        if layout == "top" then
            tb.Position = UDim2.new(0, 0, 0, 0);   tb.Size = UDim2.new(1, 0, 0, 26)
            pc.Position = UDim2.new(0, 0, 0, 26);  pc.Size = UDim2.new(1, 0, 1, -26)
            tl.FillDirection     = Enum.FillDirection.Horizontal
            tl.VerticalAlignment = Enum.VerticalAlignment.Center
            if resizer then resizer.Position = UDim2.new(1, -12, 1, -12) end
        elseif layout == "bottom" then
            tb.Position = UDim2.new(0, 0, 1, -26); tb.Size = UDim2.new(1, 0, 0, 26)
            pc.Position = UDim2.new(0, 0, 0, 0);   pc.Size = UDim2.new(1, 0, 1, -26)
            tl.FillDirection     = Enum.FillDirection.Horizontal
            tl.VerticalAlignment = Enum.VerticalAlignment.Center
            if resizer then resizer.Position = UDim2.new(1, -12, 1, -38) end
        elseif layout == "left" then
            tb.Position = UDim2.new(0, 0, 0, 0);   tb.Size = UDim2.new(0, w, 1, 0)
            pc.Position = UDim2.new(0, w, 0, 0);   pc.Size = UDim2.new(1, -w, 1, 0)
            tl.FillDirection     = Enum.FillDirection.Vertical
            tl.VerticalAlignment = Enum.VerticalAlignment.Top
            if resizer then resizer.Position = UDim2.new(1, -12, 1, -12) end
        elseif layout == "right" then
            tb.Position = UDim2.new(1, -w, 0, 0);  tb.Size = UDim2.new(0, w, 1, 0)
            pc.Position = UDim2.new(0, 0, 0, 0);   pc.Size = UDim2.new(1, -w, 1, 0)
            tl.FillDirection     = Enum.FillDirection.Vertical
            tl.VerticalAlignment = Enum.VerticalAlignment.Top
            if resizer then resizer.Position = UDim2.new(1, -(w + 12), 1, -12) end
        end

        for _, t in ipairs(self._tabs or {}) do
            local icon = hasIcon(t.Button)
            t.TextLabel.TextXAlignment = Enum.TextXAlignment.Center
            t.TextLabel.TextTruncate   = Enum.TextTruncate.AtEnd
            t.TextLabel.Position       = UDim2.new(0, 0, 0, 0)
            t.TextLabel.Size           = UDim2.new(1, 0, 1, 0)

            if layout == "left" or layout == "right" then
                t.Button.Size = UDim2.new(1, 0, 0, 28)
            else
                local ts = game:GetService("TextService"):GetTextSize(
                    t.TextLabel.Text, 13, Enum.Font.RobotoMono, Vector2.new(999, 26))
                local extra = icon and 56 or 24
                t.Button.Size = UDim2.new(0, ts.X + extra, 1, 0)
            end
        end
    end

    function Axiom:SetTabLayout(layout) applyLayout(self, layout) end
    function Axiom:_applyTabLayout(layout) applyLayout(self, layout) end

    local origNew = Axiom.new
    function Axiom.new(options)
        options = options or {}
        local win = origNew(options)
        win._tabBarWidth   = options.TabBarWidth or 120
        win._tabLayoutMode = options.Layout or "top"
        if options.Layout and options.Layout ~= "top" then
            applyLayout(win, options.Layout)
        end
        return win
    end

    local origAddTab = Axiom.AddTab
    function Axiom:AddTab(options)
        options = options or {}
        if #(self._tabs or {}) == 0 and options.Layout and VALID[options.Layout]
           and options.Layout ~= self._tabLayoutMode then
            self._pendingLayout = options.Layout
        end
        local result = origAddTab(self, options)
        if self._pendingLayout then
            applyLayout(self, self._pendingLayout)
            self._pendingLayout = nil
        end
        return result
    end
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddRadioButton  (grouped mutual exclusion)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddRadioButton(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Radio"
    local group    = options.Group or "__default_radio"
    local default  = options.Default or false
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local win = self._window
    if not win._radioGroups then win._radioGroups = {} end
    if not win._radioGroups[group] then win._radioGroups[group] = {} end
    local groupList = win._radioGroups[group]

    local currentCallback = callback
    local currentEnabled = true
    local selected = default

    local row = Instance.new("TextButton")
    row.BackgroundColor3 = options.Color or theme.FrameBg
    if options.Color then warnCustomColor(self, "RadioButton") end
    row.Size = UDim2.new(1, 0, 0, 24)
    row.LayoutOrder = self:_nextOrder()
    row.Text = ""
    row.Parent = self._page
    applyCorner(row, 2)
    applyBorder(row, theme.Border)

    local circle = Instance.new("Frame")
    circle.BackgroundColor3 = selected and theme.CheckOn or theme.CheckOff
    circle.Position = UDim2.new(0, 4, 0.5, -8)
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Parent = row
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(1, 0); cc.Parent = circle
    applyBorder(circle, theme.Accent)

    local dotInner = Instance.new("Frame")
    dotInner.AnchorPoint = Vector2.new(0.5, 0.5)
    dotInner.Position = UDim2.new(0.5, 0, 0.5, 0)
    dotInner.Size = selected and UDim2.new(0, 6, 0, 6) or UDim2.new(0, 0, 0, 0)
    dotInner.BackgroundColor3 = theme.Text
    dotInner.BorderSizePixel = 0
    dotInner.Parent = circle
    local dic = Instance.new("UICorner"); dic.CornerRadius = UDim.new(1, 0); dic.Parent = dotInner

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 24, 0, 0)
    lbl.Size = UDim2.new(1, -24, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local obj = {}
    local function selectThis(fireCb)
        selected = true
        dotInner.Size = UDim2.new(0, 6, 0, 6)
        circle.BackgroundColor3 = theme.CheckOn
        if fireCb then safeCall(currentCallback, true) end
    end
    local function deselectThis()
        selected = false
        dotInner.Size = UDim2.new(0, 0, 0, 0)
        circle.BackgroundColor3 = theme.CheckOff
    end

    row.MouseEnter:Connect(function()
        if currentEnabled then row.BackgroundColor3 = options.Color and lightenColor(options.Color) or theme.FrameBgHover end
    end)
    row.MouseLeave:Connect(function() row.BackgroundColor3 = options.Color or theme.FrameBg end)

    row.MouseButton1Click:Connect(function()
        if not currentEnabled or selected then return end
        for _, other in ipairs(groupList) do
            if other ~= obj then other:_deselect() end
        end
        selectThis(true)
    end)

    obj._deselect = deselectThis
    obj._select   = selectThis

    function obj:GetValue() return selected end
    function obj:SetValue(v)
        if v and not selected then
            for _, other in ipairs(groupList) do
                if other ~= obj then other:_deselect() end
            end
            selectThis(true)
        elseif not v then deselectThis() end
    end
    function obj:SetText(t) lbl.Text = t end
    function obj:GetText() return lbl.Text end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        row.Active = state
        if state then
            row.BackgroundColor3 = options.Color or theme.FrameBg
            lbl.TextColor3 = theme.Text
        else
            row.BackgroundColor3 = disabledColor(options.Color or theme.FrameBg)
            lbl.TextColor3 = disabledColor(theme.Text)
        end
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy()
        for i, other in ipairs(groupList) do
            if other == obj then table.remove(groupList, i); break end
        end
        row:Destroy()
    end
    function obj:GetInstance() return row end

    if tooltip then attachTooltip(row, tooltip, self._window) end
    if self._window then self._window:_registerSearch(row, text) end

    table.insert(groupList, obj)
    if default then selectThis(false) end

    local key = options.StateKey or self._window:_autoStateKey("radio", group .. "::" .. text)
    self._window:_registerState(key,
        function() return selected end,
        function(v) obj:SetValue(v) end
    )

    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddSelectable  (full-width row, stays highlighted when selected)
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddSelectable(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Item"
    local group    = options.Group   -- optional: mutual exclusion group
    local default  = options.Default or false
    local callback = options.Callback
    local onRight  = options.OnRightClick
    local height   = options.Height or 22
    local tooltip  = options.Tooltip

    local win = self._window
    if group then
        if not win._selectableGroups then win._selectableGroups = {} end
        if not win._selectableGroups[group] then win._selectableGroups[group] = {} end
    end
    local groupList = group and win._selectableGroups[group] or nil

    local currentCallback = callback
    local currentEnabled = true
    local selected = default

    local row = Instance.new("TextButton")
    row.BackgroundColor3 = options.Color or theme.FrameBg
    if options.Color then warnCustomColor(self, "Selectable") end
    row.Size = UDim2.new(1, 0, 0, height)
    row.LayoutOrder = self:_nextOrder()
    row.Font = Enum.Font.RobotoMono
    row.Text = ""
    row.Parent = self._page
    applyCorner(row, 2)
    applyBorder(row, theme.Border)

    if selected then row.BackgroundColor3 = theme.TabActive end

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 6, 0, 0)
    lbl.Size = UDim2.new(1, -12, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = selected and theme.TabActiveText or theme.Text
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Parent = row

    local obj = {}
    local function setSelected(v, fire)
        selected = v
        row.BackgroundColor3 = v and theme.TabActive or (options.Color or theme.FrameBg)
        lbl.TextColor3 = v and theme.TabActiveText or theme.Text
        if fire then safeCall(currentCallback, v, obj) end
    end

    row.MouseEnter:Connect(function()
        if currentEnabled and not selected then
            row.BackgroundColor3 = options.Color and lightenColor(options.Color) or theme.FrameBgHover
        end
    end)
    row.MouseLeave:Connect(function()
        row.BackgroundColor3 = selected and theme.TabActive or (options.Color or theme.FrameBg)
    end)

    row.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        if groupList then
            for _, other in ipairs(groupList) do
                if other ~= obj then other:_set(false, true) end
            end
        end
        setSelected(true, true)
    end)

    if onRight then
        row.MouseButton2Click:Connect(function()
            if currentEnabled then safeCall(onRight, obj) end
        end)
    end

    obj._set = setSelected

    function obj:GetValue() return selected end
    function obj:SetValue(v)
        if groupList and v then
            for _, other in ipairs(groupList) do
                if other ~= obj then other:_set(false, false) end
            end
        end
        setSelected(v, true)
    end
    function obj:SetText(t) lbl.Text = t end
    function obj:GetText() return lbl.Text end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        row.Active = state
        if not state then row.BackgroundColor3 = disabledColor(options.Color or theme.FrameBg) end
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy()
        if groupList then
            for i, other in ipairs(groupList) do
                if other == obj then table.remove(groupList, i); break end
            end
        end
        row:Destroy()
    end
    function obj:GetInstance() return row end

    if tooltip then attachTooltip(row, tooltip, self._window) end
    if self._window then self._window:_registerSearch(row, text) end
    if groupList then table.insert(groupList, obj) end

    return obj
end

