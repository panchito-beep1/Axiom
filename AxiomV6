--  AddColorPicker
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddColorPicker(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Color"
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local color = options.Default or Color3.new(1, 1, 1)
    local h, s, v = color:ToHSV()
    local isOpen = false
    local currentCallback = callback
    local currentEnabled = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("TextButton")
    header.BackgroundColor3 = options.Color or theme.FrameBg
    if options.Color then warnCustomColor(self, "ColorPicker") end
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Font = Enum.Font.RobotoMono
    header.Text = " " .. text
    header.TextColor3 = theme.Text
    header.TextSize = 13
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local preview = Instance.new("Frame")
    preview.AnchorPoint = Vector2.new(1, 0.5)
    preview.Position = UDim2.new(1, -4, 0.5, 0)
    preview.Size = UDim2.new(0, 16, 0, 16)
    preview.BackgroundColor3 = color
    preview.Parent = header
    applyCorner(preview, 2)
    applyBorder(preview, theme.Border)

    local EXPAND_H = 172

    local expandFrame = Instance.new("Frame")
    expandFrame.BackgroundColor3 = theme.TabNormal
    expandFrame.Position = UDim2.new(0, 0, 0, 24)
    expandFrame.Size = UDim2.new(1, 0, 0, EXPAND_H)
    expandFrame.Parent = container
    applyBorder(expandFrame, theme.Border)

    header.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        local targetHeight = isOpen and (24 + EXPAND_H) or 24
        TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
    end)

    -- ── Saturation / Value square ─────────────────────────────────────────
    local svArea = Instance.new("Frame")
    svArea.Position = UDim2.new(0, 6, 0, 6)
    svArea.Size = UDim2.new(1, -12, 0, 110)
    svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    svArea.Parent = expandFrame
    applyCorner(svArea, 2)
    applyBorder(svArea, theme.Border)
    svArea.ClipsDescendants = true

    -- White gradient (left = white -> right = transparent) : saturation
    local whiteOverlay = Instance.new("Frame")
    whiteOverlay.Size = UDim2.new(1, 0, 1, 0)
    whiteOverlay.BackgroundColor3 = Color3.new(1, 1, 1)
    whiteOverlay.BorderSizePixel = 0
    whiteOverlay.Parent = svArea

    local whiteGrad = Instance.new("UIGradient")
    whiteGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    whiteGrad.Rotation = 0
    whiteGrad.Parent = whiteOverlay

    -- Black gradient (top = transparent -> bottom = black) : value
    local blackOverlay = Instance.new("Frame")
    blackOverlay.Size = UDim2.new(1, 0, 1, 0)
    blackOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
    blackOverlay.BorderSizePixel = 0
    blackOverlay.Parent = svArea

    local blackGrad = Instance.new("UIGradient")
    blackGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    blackGrad.Rotation = 90
    blackGrad.Parent = blackOverlay

    -- SV handle (circle)
    local svHandle = Instance.new("Frame")
    svHandle.AnchorPoint = Vector2.new(0.5, 0.5)
    svHandle.Position = UDim2.new(s, 0, 1 - v, 0)
    svHandle.Size = UDim2.new(0, 10, 0, 10)
    svHandle.BackgroundColor3 = Color3.new(1, 1, 1)
    svHandle.BackgroundTransparency = 0.4
    svHandle.BorderSizePixel = 0
    svHandle.ZIndex = 5
    svHandle.Parent = svArea
    local svCorner = Instance.new("UICorner")
    svCorner.CornerRadius = UDim.new(1, 0)
    svCorner.Parent = svHandle
    local svStroke = Instance.new("UIStroke")
    svStroke.Thickness = 1.5
    svStroke.Color = Color3.new(0, 0, 0)
    svStroke.Parent = svHandle

    -- ── Hue strip ─────────────────────────────────────────────────────────
    local hueBar = Instance.new("Frame")
    hueBar.Position = UDim2.new(0, 6, 0, 122)
    hueBar.Size = UDim2.new(1, -12, 0, 12)
    hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
    hueBar.Parent = expandFrame
    applyCorner(hueBar, 2)
    applyBorder(hueBar, theme.Border)
    hueBar.ClipsDescendants = true

    local hueGrad = Instance.new("UIGradient")
    hueGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
    })
    hueGrad.Parent = hueBar

    local hueHandle = Instance.new("Frame")
    hueHandle.AnchorPoint = Vector2.new(0.5, 0.5)
    hueHandle.Position = UDim2.new(h, 0, 0.5, 0)
    hueHandle.Size = UDim2.new(0, 4, 1, 0)
    hueHandle.BackgroundColor3 = Color3.new(1, 1, 1)
    hueHandle.BorderSizePixel = 0
    hueHandle.ZIndex = 5
    hueHandle.Parent = hueBar
    local hueStroke = Instance.new("UIStroke")
    hueStroke.Thickness = 1.5
    hueStroke.Color = Color3.new(0, 0, 0)
    hueStroke.Parent = hueHandle
    applyCorner(hueHandle, 2)

    -- ── Preview swatch + hex input ────────────────────────────────────────
    local previewBox = Instance.new("Frame")
    previewBox.Position = UDim2.new(0, 6, 0, 140)
    previewBox.Size = UDim2.new(0, 26, 0, 26)
    previewBox.BackgroundColor3 = color
    previewBox.Parent = expandFrame
    applyCorner(previewBox, 2)
    applyBorder(previewBox, theme.Border)

    local hexBox = Instance.new("TextBox")
    hexBox.Position = UDim2.new(0, 38, 0, 140)
    hexBox.Size = UDim2.new(1, -44, 0, 26)
    hexBox.BackgroundColor3 = theme.FrameBg
    hexBox.Font = Enum.Font.RobotoMono
    hexBox.Text = ""
    hexBox.PlaceholderText = "#RRGGBB"
    hexBox.TextColor3 = theme.Text
    hexBox.TextSize = 12
    hexBox.ClearTextOnFocus = false
    hexBox.Parent = expandFrame
    applyCorner(hexBox, 2)
    applyBorder(hexBox, theme.Border)

    -- ── Helpers / refresh ─────────────────────────────────────────────────
    local function currentColor()
        return Color3.fromHSV(h, s, v)
    end

    local function toHex(c)
        return string.format("#%02X%02X%02X",
            math.floor(c.R * 255 + 0.5),
            math.floor(c.G * 255 + 0.5),
            math.floor(c.B * 255 + 0.5))
    end

    local function refreshAll()
        local c = currentColor()
        svArea.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svHandle.Position = UDim2.new(s, 0, 1 - v, 0)
        hueHandle.Position = UDim2.new(h, 0, 0.5, 0)
        previewBox.BackgroundColor3 = c
        preview.BackgroundColor3 = c
        hexBox.Text = toHex(c)
    end

    local function fireCallback()
        safeCall(currentCallback, currentColor())
    end

    -- ── SV drag ───────────────────────────────────────────────────────────
    local svDragging = false
    local function svUpdate(input)
        local relX = math.clamp((input.Position.X - svArea.AbsolutePosition.X) / svArea.AbsoluteSize.X, 0, 1)
        local relY = math.clamp((input.Position.Y - svArea.AbsolutePosition.Y) / svArea.AbsoluteSize.Y, 0, 1)
        s = relX
        v = 1 - relY
        refreshAll()
        fireCallback()
    end

    svArea.InputBegan:Connect(function(i)
        if not currentEnabled then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            svDragging = true
            svUpdate(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if svDragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            svUpdate(i)
        end
    end)

    -- ── Hue drag ──────────────────────────────────────────────────────────
    local hueDragging = false
    local function hueUpdate(input)
        local relX = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
        h = relX
        refreshAll()
        fireCallback()
    end

    hueBar.InputBegan:Connect(function(i)
        if not currentEnabled then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            hueDragging = true
            hueUpdate(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if hueDragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            hueUpdate(i)
        end
    end)

    -- ── Hex input ─────────────────────────────────────────────────────────
    hexBox.FocusLost:Connect(function()
        local txt = hexBox.Text:gsub("#", ""):gsub("%s", "")
        if #txt == 6 and txt:match("^%x+$") then
            local r = tonumber(txt:sub(1, 2), 16) / 255
            local g = tonumber(txt:sub(3, 4), 16) / 255
            local b = tonumber(txt:sub(5, 6), 16) / 255
            h, s, v = Color3.new(r, g, b):ToHSV()
            refreshAll()
            fireCallback()
        else
            refreshAll()
        end
    end)

    refreshAll()

    if tooltip then attachTooltip(header, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetColor() return currentColor() end
    function obj:SetColor(clr)
        h, s, v = clr:ToHSV()
        refreshAll()
        safeCall(currentCallback, clr)
    end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        header.Active = state
        header.BackgroundColor3 = state and (options.Color or theme.FrameBg)
                                        or disabledColor(options.Color or theme.FrameBg)
        header.TextColor3 = state and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(
        key,
        function()
            local c = currentColor()
            return { r = c.R, g = c.G, b = c.B }
        end,
        function(st) obj:SetColor(Color3.new(st.r, st.g, st.b)) end
    )

    return obj
end
