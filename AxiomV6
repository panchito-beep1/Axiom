--  AddSlider
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddSlider(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Slider"
    local min      = options.Min  or 0
    local max      = options.Max  or 100
    local default  = options.Default
    local callback = options.Callback
    local isFloat  = options.Float or false
    local decimals = options.Decimals or 1
    local tooltip  = options.Tooltip

    default = math.clamp(default or min, min, max)
    local value = default
    local currentCallback = callback
    local currentEnabled = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local track = Instance.new("TextButton")
    track.BackgroundColor3 = options.Color or theme.SliderTrack
    if options.Color then warnCustomColor(self, "Slider") end
    track.Size = UDim2.new(1, 0, 1, 0)
    track.Text = ""
    track.Parent = container
    applyCorner(track, 2)
    applyBorder(track, theme.Border)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = theme.SliderFill
    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.Parent = track
    applyCorner(fill, 2)

    local function formatValue(v)
        if isFloat then
            return string.format("%s: %." .. decimals .. "f", text, v)
        else
            return string.format("%s: %d", text, math.floor(v + 0.5))
        end
    end

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = formatValue(value)
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 13
    lbl.ZIndex = 2
    lbl.Parent = track

    track.MouseEnter:Connect(function()
        if currentEnabled then track.BackgroundColor3 = theme.FrameBgHover end
    end)
    track.MouseLeave:Connect(function()
        track.BackgroundColor3 = options.Color or theme.SliderTrack
    end)

    local function updateFromInput(input)
        if not currentEnabled then return end
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * rel
        if not isFloat then
            value = math.floor(value + 0.5)
        else
            value = math.floor(value * (10 ^ decimals) + 0.5) / (10 ^ decimals)
        end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = formatValue(value)
        safeCall(currentCallback, value)
    end

    local dragging = false
    track.InputBegan:Connect(function(i)
        if not currentEnabled then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromInput(i)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            updateFromInput(i)
        end
    end)

    if tooltip then attachTooltip(track, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetValue() return value end
    function obj:SetValue(val)
        val = math.clamp(val, min, max)
        value = val
        local rel = (val - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = formatValue(val)
        safeCall(currentCallback, val)
    end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        track.Active = state
        if state then
            track.BackgroundColor3 = options.Color or theme.SliderTrack
            fill.BackgroundColor3 = theme.SliderFill
            lbl.TextColor3 = theme.Text
        else
            track.BackgroundColor3 = disabledColor(options.Color or theme.SliderTrack)
            fill.BackgroundColor3 = disabledColor(theme.SliderFill)
            lbl.TextColor3 = disabledColor(theme.Text)
        end
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return value end, function(v) obj:SetValue(v) end)

    return obj
end

