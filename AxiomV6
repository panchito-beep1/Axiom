-- ── Internal Helpers ──────────────────────────────────────────────────────────
local function applyCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 2)
    c.Parent = parent
    return c
end

local function applyBorder(parent, color)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function applyPadding(parent, px)
    local p = Instance.new("UIPadding")
    p.PaddingLeft   = UDim.new(0, px)
    p.PaddingRight  = UDim.new(0, px)
    p.PaddingTop    = UDim.new(0, px)
    p.PaddingBottom = UDim.new(0, px)
    p.Parent = parent
    return p
end

local function makeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, dragStart, startPos = true, input.Position, frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

local function safeCall(fn, ...)
    if not fn then return end
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[Axiom] Callback error: " .. tostring(err))
    end
end

local function disabledColor(c)
    if typeof(c) ~= "Color3" then return c end
    return Color3.new(c.R * 0.4, c.G * 0.4, c.B * 0.4)
end

local function lightenColor(c, amt)
    if typeof(c) ~= "Color3" then return c end
    amt = amt or 0.15
    return Color3.new(
        math.min(c.R + amt, 1),
        math.min(c.G + amt, 1),
        math.min(c.B + amt, 1)
    )
end

-- ── Tooltip infrastructure ────────────────────────────────────────────────────
local tooltipGui, tooltipLabel, tooltipTimer

local function ensureTooltipGui(theme)
    if tooltipGui then
        tooltipLabel.BackgroundColor3 = theme.WindowBg
        tooltipLabel.TextColor3 = theme.Text
        local stroke = tooltipLabel:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Color = theme.Border end
        return
    end
    tooltipGui = Instance.new("ScreenGui")
    tooltipGui.Name = "Axiom_Tooltip"
    tooltipGui.ResetOnSpawn = false
    tooltipGui.DisplayOrder = 999
    tooltipGui.Parent = CoreGui

    tooltipLabel = Instance.new("TextLabel")
    tooltipLabel.BackgroundColor3 = theme.WindowBg
    tooltipLabel.BorderSizePixel = 0
    tooltipLabel.Font = Enum.Font.RobotoMono
    tooltipLabel.TextColor3 = theme.Text
    tooltipLabel.TextSize = 12
    tooltipLabel.TextWrapped = true
    tooltipLabel.AutomaticSize = Enum.AutomaticSize.XY
    tooltipLabel.Visible = false
    tooltipLabel.ZIndex = 1000
    tooltipLabel.Parent = tooltipGui
    applyCorner(tooltipLabel, 2)
    applyBorder(tooltipLabel, theme.Border)
    applyPadding(tooltipLabel, 6)
end

local function hideTooltip()
    if tooltipTimer then task.cancel(tooltipTimer); tooltipTimer = nil end
    if tooltipLabel then tooltipLabel.Visible = false end
end

local function attachTooltip(anchor, text, win)
    if not text or not anchor then return end
    anchor.MouseEnter:Connect(function()
        hideTooltip()
        tooltipTimer = task.delay(0.4, function()
            local theme = (win and win._theme) or Axiom.DefaultTheme
            ensureTooltipGui(theme)
            tooltipLabel.Text = text
            local absPos  = anchor.AbsolutePosition
            local absSize = anchor.AbsoluteSize
            tooltipLabel.Position = UDim2.new(0, absPos.X + 8, 0, absPos.Y + absSize.Y + 4)
            tooltipLabel.Visible = true
        end)
    end)
    anchor.MouseLeave:Connect(hideTooltip)
end

local function warnCustomColor(tab, componentName)
    if tab._window then
        tab._window:Notify({
            Title       = "Theme Warning",
            Description = "Custom colour used on " .. componentName .. " – this may break theme consistency!",
            Duration    = 4,
            Type        = "error",
        })
    end
end

