--  Axiom._Internal.CreateWindowChrome — shared chrome for secondary windows
-- ════════════════════════════════════════════════════════════════════════════
function Axiom._Internal.CreateWindowChrome(opts)
    local theme    = opts.Theme
    local parent   = opts.Parent        or CoreGui
    local title    = opts.Title         or "Window"
    local position = opts.Position      or UDim2.new(0.5, -210, 0.3, 0)
    local size     = opts.Size          or UDim2.new(0, 420, 0, 320)
    local icon     = opts.Icon
    local draggable = opts.Draggable    ~= false
    local resizable = opts.Resizable    ~= false
    local onClose   = opts.OnClose
    local onResize  = opts.OnResize
    local onDragEnd = opts.OnDragEnd

    local screen = Instance.new("ScreenGui")
    screen.Name = "AxiomWin_" .. title .. "_" .. tostring(math.random(1, 99999))
    screen.ResetOnSpawn = false
    screen.Parent = parent

    local frame = Instance.new("Frame")
    frame.BackgroundTransparency = 1
    frame.Position = position
    frame.Size = size
    frame.Parent = screen

    local titleBar = Instance.new("Frame")
    titleBar.BackgroundColor3 = theme.TitleBg
    titleBar.Size = UDim2.new(1, 0, 0, 24)
    titleBar.Parent = frame
    applyCorner(titleBar, 2)
    applyBorder(titleBar, theme.Border)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.BackgroundTransparency = 1
    titleLbl.Font = Enum.Font.RobotoMono
    titleLbl.Text = title
    titleLbl.TextColor3 = theme.Text
    titleLbl.TextSize = 13
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.RichText = true
    if icon then
        local iconLbl = Instance.new("ImageLabel")
        iconLbl.BackgroundTransparency = 1
        iconLbl.Size = UDim2.new(0, 18, 0, 18)
        iconLbl.Position = UDim2.new(0, 4, 0.5, -9)
        iconLbl.Image = icon
        iconLbl.Parent = titleBar
        titleLbl.Position = UDim2.new(0, 26, 0, 0)
        titleLbl.Size = UDim2.new(1, -74, 1, 0)
    else
        titleLbl.Position = UDim2.new(0, 8, 0, 0)
        titleLbl.Size = UDim2.new(1, -56, 1, 0)
    end
    titleLbl.Parent = titleBar

    local collapseBtn = Instance.new("TextButton")
    collapseBtn.BackgroundTransparency = 1
    collapseBtn.Position = UDim2.new(1, -44, 0, 0)
    collapseBtn.Size = UDim2.new(0, 20, 1, 0)
    collapseBtn.Font = Enum.Font.RobotoMono
    collapseBtn.Text = "-"
    collapseBtn.TextColor3 = theme.SubText
    collapseBtn.TextSize = 14
    collapseBtn.Parent = titleBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.BackgroundTransparency = 1
    closeBtn.Position = UDim2.new(1, -20, 0, 0)
    closeBtn.Size = UDim2.new(0, 20, 1, 0)
    closeBtn.Font = Enum.Font.RobotoMono
    closeBtn.Text = "×"
    closeBtn.TextColor3 = theme.SubText
    closeBtn.TextSize = 16
    closeBtn.Parent = titleBar

    local body = Instance.new("Frame")
    body.BackgroundColor3 = theme.WindowBg
    body.Position = UDim2.new(0, 0, 0, 23)
    body.Size = UDim2.new(1, 0, 1, -23)
    body.ClipsDescendants = true
    body.Parent = frame
    applyCorner(body, 2)
    applyBorder(body, theme.Border)

    local resizer
    if resizable then
        resizer = Instance.new("TextButton")
        resizer.BackgroundTransparency = 1
        resizer.Size = UDim2.new(0, 12, 0, 12)
        resizer.Position = UDim2.new(1, -12, 1, -12)
        resizer.Text = "◢"
        resizer.TextColor3 = theme.SubText
        resizer.TextSize = 10
        resizer.ZIndex = 10
        resizer.Parent = body

        local resizing, resizeStart, startSize = false, nil, nil
        resizer.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                resizing, resizeStart, startSize = true, i.Position, frame.Size
            end
        end)
        local endConn = UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                resizing = false
                if onResize then onResize(frame.Size) end
            end
        end)
        local changeConn = UserInputService.InputChanged:Connect(function(i)
            if not resizing then return end
            if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
            local d = i.Position - resizeStart
            frame.Size = UDim2.new(0, math.max(200, startSize.X.Offset + d.X), 0, math.max(100, startSize.Y.Offset + d.Y))
        end)
        frame.Destroying:Connect(function() endConn:Disconnect(); changeConn:Disconnect() end)
    end

    local collapsed = false
    collapseBtn.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        body.Visible = not collapsed
        collapseBtn.Text = collapsed and "+" or "-"
    end)

    local destroyed = false
    closeBtn.MouseButton1Click:Connect(function()
        if destroyed then return end
        if onClose then pcall(onClose) end
    end)

    if draggable then
        local dragging, dragInput, dragStart, startPos
        titleBar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging, dragStart, startPos = true, i.Position, frame.Position
                i.Changed:Connect(function()
                    if i.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        if onDragEnd then onDragEnd(frame.Position) end
                    end
                end)
            end
        end)
        titleBar.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                dragInput = i
            end
        end)
        local dragConn = UserInputService.InputChanged:Connect(function(i)
            if i == dragInput and dragging then
                local d = i.Position - dragStart
                frame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
        frame.Destroying:Connect(function() dragConn:Disconnect() end)
    end

    local api = {}
    function api:GetFrame() return frame end
    function api:GetBody() return body end
    function api:GetTitleBar() return titleBar end
    function api:GetTitleLabel() return titleLbl end
    function api:GetScreen() return screen end
    function api:SetTitle(t) titleLbl.Text = tostring(t) end
    function api:SetVisible(v) frame.Visible = v end
    function api:IsVisible() return frame.Visible end
    function api:SetPosition(p) frame.Position = p end
    function api:GetPosition() return frame.Position end
    function api:SetSize(s) frame.Size = s end
    function api:GetSize() return frame.Size end
    function api:Destroy()
        if destroyed then return end
        destroyed = true
        screen:Destroy()
    end

    return api
end



