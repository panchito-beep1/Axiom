--  Tab bar layout
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:_applyTabLayout(layout)
    layout = layout or "top"
    if not VALID_TAB_LAYOUTS[layout] then
        warn("[Axiom] Unknown tab Layout '" .. tostring(layout) .. "', falling back to 'top'.")
        layout = "top"
    end
    self._tabLayoutMode = layout

    local tabContainer  = self._tabContainer
    local pageContainer = self._pageContainer
    local tabLayout     = self._tabListLayout
    local tabBarWidth   = self._tabBarWidth or 120

    if layout == "top" then
        tabContainer.Position  = UDim2.new(0, 0, 0, 0)
        tabContainer.Size      = UDim2.new(1, 0, 0, 26)
        pageContainer.Position = UDim2.new(0, 0, 0, 26)
        pageContainer.Size     = UDim2.new(1, 0, 1, -26)
        tabLayout.FillDirection     = Enum.FillDirection.Horizontal
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        if self._resizer then self._resizer.Position = UDim2.new(1, -12, 1, -12) end
    elseif layout == "bottom" then
        tabContainer.Position  = UDim2.new(0, 0, 1, -26)
        tabContainer.Size      = UDim2.new(1, 0, 0, 26)
        pageContainer.Position = UDim2.new(0, 0, 0, 0)
        pageContainer.Size     = UDim2.new(1, 0, 1, -26)
        tabLayout.FillDirection     = Enum.FillDirection.Horizontal
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
        if self._resizer then self._resizer.Position = UDim2.new(1, -12, 1, -38) end
    elseif layout == "left" then
        tabContainer.Position  = UDim2.new(0, 0, 0, 0)
        tabContainer.Size      = UDim2.new(0, tabBarWidth, 1, 0)
        pageContainer.Position = UDim2.new(0, tabBarWidth, 0, 0)
        pageContainer.Size     = UDim2.new(1, -tabBarWidth, 1, 0)
        tabLayout.FillDirection     = Enum.FillDirection.Vertical
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Top
        if self._resizer then self._resizer.Position = UDim2.new(1, -12, 1, -12) end
    elseif layout == "right" then
        tabContainer.Position  = UDim2.new(1, -tabBarWidth, 0, 0)
        tabContainer.Size      = UDim2.new(0, tabBarWidth, 1, 0)
        pageContainer.Position = UDim2.new(0, 0, 0, 0)
        pageContainer.Size     = UDim2.new(1, -tabBarWidth, 1, 0)
        tabLayout.FillDirection     = Enum.FillDirection.Vertical
        tabLayout.VerticalAlignment = Enum.VerticalAlignment.Top
        if self._resizer then self._resizer.Position = UDim2.new(1, -(tabBarWidth + 12), 1, -12) end
    end

    for _, t in ipairs(self._tabs) do
        self:_sizeTab(t)
    end
end

function Axiom:_sizeTab(tab)
    local mode = self._tabLayoutMode or "top"

    tab.TextLabel.TextXAlignment = Enum.TextXAlignment.Center
    tab.TextLabel.TextTruncate   = Enum.TextTruncate.AtEnd
    tab.TextLabel.Position       = UDim2.new(0, 0, 0, 0)
    tab.TextLabel.Size           = UDim2.new(1, 0, 1, 0)

    if mode == "top" or mode == "bottom" then
        local txtSize = TextService:GetTextSize(
            tab.TextLabel.Text, 13, Enum.Font.RobotoMono, Vector2.new(999, 26)
        )
        local extra = tab.Icon and 56 or 24
        tab.Button.Size = UDim2.new(0, txtSize.X + extra, 1, 0)
    else
        tab.Button.Size = UDim2.new(1, 0, 0, 28)
    end
end

function Axiom:SetTabLayout(layout)
    self:_applyTabLayout(layout)
end

-- ════════════════════════════════════════════════════════════════════════════
--  Global search
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:_registerSearch(frame, text)
    if not frame or not text then return end
    table.insert(self._searchRegistry, { Frame = frame, Text = tostring(text):lower() })
end

function Axiom:_applySearch(query)
    self._searchQuery = (query or ""):lower()
    local q = self._searchQuery
    for _, entry in ipairs(self._searchRegistry) do
        if entry.Frame and entry.Frame.Parent then
            if q == "" then
                entry.Frame.Visible = true
            else
                entry.Frame.Visible = entry.Text:find(q, 1, true) ~= nil
            end
        end
    end
end

function Axiom:EnableSearch(options)
    options = options or {}
    if self._searchBox then return self._searchBox end
    local theme = self._theme
    local titleBar = self._mainFrame:FindFirstChild("TitleBar")
    if not titleBar then return end
    local width = options.Width or 120

    local searchBox = Instance.new("TextBox")
    searchBox.Name               = "GlobalSearch"
    searchBox.BackgroundColor3   = theme.FrameBg
    searchBox.BorderSizePixel    = 0
    searchBox.Size               = UDim2.new(0, width, 0, 18)
    searchBox.Position           = UDim2.new(1, -(44 + 4 + width), 0.5, -9)
    searchBox.Font               = Enum.Font.RobotoMono
    searchBox.PlaceholderText    = options.Placeholder or "Search..."
    searchBox.PlaceholderColor3  = theme.SubText
    searchBox.Text               = ""
    searchBox.TextColor3         = theme.Text
    searchBox.TextSize           = 12
    searchBox.TextXAlignment     = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus   = false
    searchBox.Parent             = titleBar
    applyCorner(searchBox, 2)
    applyBorder(searchBox, theme.Border)

    if self._titleLbl then
        local reserve = width + 4 + 44 + 8
        self._titleLbl.Size = UDim2.new(1, -reserve, 1, 0)
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        self:_applySearch(searchBox.Text)
    end)

    self._searchBox = searchBox
    return searchBox
end

function Axiom:DisableSearch()
    if self._searchBox then
        self._searchBox:Destroy()
        self._searchBox = nil
    end
    self:_applySearch("")
end

-- ════════════════════════════════════════════════════════════════════════════
--  State saving
-- ════════════════════════════════════════════════════════════════════════════
function Axiom:_registerState(key, getFn, setFn)
    if not key then return end
    self._stateRegistry[key] = { get = getFn, set = setFn }
end

function Axiom:_autoStateKey(tabLabel, componentLabel)
    self._stateAutoCounter = self._stateAutoCounter + 1
    return string.format("%s::%s::%d", tostring(tabLabel), tostring(componentLabel), self._stateAutoCounter)
end

function Axiom:EnableStateSaving(options)
    options = options or {}
    if not writefile or not readfile then
        warn("[Axiom] EnableStateSaving: executor missing file I/O functions")
        return
    end
    local folder   = options.Folder   or "Axiom"
    local filename = options.Filename or "state.json"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    self._stateFilePath = folder .. "/" .. filename
end

function Axiom:SaveState()
    if not self._stateFilePath then
        warn("[Axiom] SaveState: call win:EnableStateSaving({ Folder = ..., Filename = ... }) first")
        return
    end
    if not writefile then return end
    local snapshot = {
        Position = {
            self._mainFrame.Position.X.Scale, self._mainFrame.Position.X.Offset,
            self._mainFrame.Position.Y.Scale, self._mainFrame.Position.Y.Offset,
        },
        Size = {
            self._mainFrame.Size.X.Scale, self._mainFrame.Size.X.Offset,
            self._mainFrame.Size.Y.Scale, self._mainFrame.Size.Y.Offset,
        },
        ActiveTab  = self._activeTabIndex,
        Components = {},
    }
    for key, entry in pairs(self._stateRegistry) do
        local ok, value = pcall(entry.get)
        if ok then snapshot.Components[key] = value end
    end
    local ok, json = pcall(function() return HttpService:JSONEncode(snapshot) end)
    if ok then pcall(writefile, self._stateFilePath, json) end
end

function Axiom:LoadState()
    if not self._stateFilePath then return end
    if not readfile or not isfile then return end
    local exists = false
    pcall(function() exists = isfile(self._stateFilePath) end)
    if not exists then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(self._stateFilePath))
    end)
    if not ok or type(data) ~= "table" then return end

    if data.Position then self._mainFrame.Position = UDim2.new(unpack(data.Position)) end
    if data.Size     then self._mainFrame.Size     = UDim2.new(unpack(data.Size))     end

    for key, value in pairs(data.Components or {}) do
        local entry = self._stateRegistry[key]
        if entry then pcall(entry.set, value) end
    end

    if data.ActiveTab and self._tabs[data.ActiveTab] then
        self._tabs[data.ActiveTab].Button.MouseButton1Click:Fire()
    end
end

