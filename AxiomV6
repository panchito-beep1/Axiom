--  Notifications
-- ════════════════════════════════════════════════════════════════════════════
local _NOTIFY_PRESETS = {
    success = {headerColor = Color3.fromRGB(38,  175, 75),  icon = "✔"},
    error   = {headerColor = Color3.fromRGB(200, 48,  48),  icon = "✖"},
    warn    = {headerColor = Color3.fromRGB(215, 155, 0),   icon = "⚠"},
    info    = {headerColor = Color3.fromRGB(55,  135, 220), icon = "ℹ"},
}

function Axiom:Notify(options)
    options = options or {}
    local theme    = self._theme
    local title    = options.Title       or "Notification"
    local message  = options.Description or ""
    local duration = options.Duration    or 3

    local preset   = options.Type and _NOTIFY_PRESETS[options.Type]
    local position = options.Position  or self._notifyPosition  or "BottomRight"
    local maxStack = options.MaxStack  or self._notifyMaxStack  or 5

    if not self._notificationGui or not self._notificationGui.Parent then
        local gui = Instance.new("ScreenGui")
        gui.Name         = "Axiom_Notifications"
        gui.ResetOnSpawn = false
        gui.Parent       = CoreGui
        self._notificationGui = gui
        self._notifyStack     = {}
    end
    self._notifyStack = self._notifyStack or {}

    while #self._notifyStack >= maxStack do
        local oldest = table.remove(self._notifyStack, 1)
        if oldest and oldest.Parent then oldest:Destroy() end
    end

    local width, height, headerH, margin = 250, 76, 22, 10

    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = options.BackgroundColor or theme.NotifyBg
    frame.BorderSizePixel  = 0
    frame.Size             = UDim2.new(0, width, 0, height)
    frame.ClipsDescendants = true
    frame.Parent           = self._notificationGui
    applyCorner(frame, 3)
    applyBorder(frame, theme.Border)

    table.insert(self._notifyStack, frame)

    local isRight  = position:find("Right")  ~= nil
    local isBottom = position:find("Bottom") ~= nil
    local anchorX  = isRight  and 1 or 0
    local anchorY  = isBottom and 1 or 0
    local baseX    = isRight  and -(width + margin) or margin
    local baseY    = isBottom and -(height + margin) or margin
    local stepDir  = isBottom and -1 or 1

    local stepH = height + 8
    for i = #self._notifyStack - 1, 1, -1 do
        local child = self._notifyStack[i]
        if child and child.Parent then
            TweenService:Create(child, TWEEN_FAST, {
                Position = child.Position + UDim2.new(0, 0, 0, stepDir * stepH)
            }):Play()
        end
    end

    local slideStartX = isRight and (width + margin) or -(width + margin)
    frame.Position = UDim2.new(anchorX, slideStartX, anchorY, baseY)

    TweenService:Create(frame,
        TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Position = UDim2.new(anchorX, baseX, anchorY, baseY)}
    ):Play()

    local headerColor = options.Color or (preset and preset.headerColor) or theme.TitleBg
    local titleBar    = Instance.new("Frame")
    titleBar.BackgroundColor3 = headerColor
    titleBar.BorderSizePixel  = 0
    titleBar.Size             = UDim2.new(1, 0, 0, headerH)
    titleBar.Parent           = frame

    local iconText = options.Icon or (preset and preset.icon) or ""
    local titleOffsetX = 8
    if iconText ~= "" then
        local iconLbl = Instance.new("TextLabel")
        iconLbl.BackgroundTransparency = 1
        iconLbl.Font       = Enum.Font.RobotoMono
        iconLbl.Text       = iconText
        iconLbl.TextColor3 = Color3.new(1, 1, 1)
        iconLbl.TextSize   = 13
        iconLbl.Position   = UDim2.new(0, 6, 0, 0)
        iconLbl.Size       = UDim2.new(0, 16, 1, 0)
        iconLbl.Parent     = titleBar
        titleOffsetX       = 26
    end

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font           = Enum.Font.RobotoMono
    titleLabel.Text           = title
    titleLabel.TextColor3     = options.TitleColor or theme.NotifyTitle
    titleLabel.TextSize       = 13
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Position       = UDim2.new(0, titleOffsetX, 0, 0)
    titleLabel.Size           = UDim2.new(1, -(titleOffsetX + headerH), 1, 0)
    titleLabel.Parent         = titleBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.BackgroundTransparency = 1
    closeBtn.Position   = UDim2.new(1, -headerH, 0, 0)
    closeBtn.Size       = UDim2.new(0, headerH, 0, headerH)
    closeBtn.Font       = Enum.Font.RobotoMono
    closeBtn.Text       = "×"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.TextSize   = 16
    closeBtn.Parent     = titleBar
    closeBtn.MouseButton1Click:Connect(function()
        for i, f in ipairs(self._notifyStack) do
            if f == frame then table.remove(self._notifyStack, i) break end
        end
        frame:Destroy()
    end)

    local msgLabel = Instance.new("TextLabel")
    msgLabel.BackgroundTransparency = 1
    msgLabel.Font           = Enum.Font.RobotoMono
    msgLabel.Text           = message
    msgLabel.TextColor3     = options.MessageColor or theme.NotifyMsg
    msgLabel.TextSize       = 12
    msgLabel.TextWrapped    = true
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextYAlignment = Enum.TextYAlignment.Top
    msgLabel.Position       = UDim2.new(0, 8, 0, headerH + 5)
    msgLabel.Size           = UDim2.new(1, -16, 1, -(headerH + 10))
    msgLabel.Parent         = frame

    local timerBg = Instance.new("Frame")
    timerBg.BackgroundColor3 = theme.Border
    timerBg.BorderSizePixel  = 0
    timerBg.Size             = UDim2.new(1, 0, 0, 2)
    timerBg.Position         = UDim2.new(0, 0, 1, -2)
    timerBg.Parent           = frame

    local timerBar = Instance.new("Frame")
    timerBar.BackgroundColor3 = headerColor
    timerBar.BorderSizePixel  = 0
    timerBar.Size             = UDim2.new(1, 0, 1, 0)
    timerBar.Parent           = timerBg

    TweenService:Create(timerBar,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        {Size = UDim2.new(0, 0, 1, 0)}
    ):Play()

    task.delay(duration, function()
        if not (frame and frame.Parent) then return end
        local slideOutX = isRight and (width + margin) or -(width + margin)
        TweenService:Create(frame,
            TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {Position = frame.Position + UDim2.new(0, slideOutX, 0, 0)}
        ):Play()
        task.delay(0.16, function()
            if frame and frame.Parent then
                for i, f in ipairs(self._notifyStack) do
                    if f == frame then table.remove(self._notifyStack, i) break end
                end
                frame:Destroy()
            end
        end)
    end)

    return frame
end

function Axiom:DismissAllNotifications()
    if not self._notifyStack then return end
    for _, frame in ipairs(self._notifyStack) do
        if frame and frame.Parent then frame:Destroy() end
    end
    self._notifyStack = {}
end

function Axiom:SetNotifyPosition(pos) self._notifyPosition = pos end
function Axiom:SetNotifyMaxStack(n) self._notifyMaxStack = n end

