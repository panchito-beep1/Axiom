--  AddNumberInput
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddNumberInput(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Value"
    local min      = options.Min  or 0
    local max      = options.Max  or 100
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local isFloat = options.Float or false
    local decimals = options.Decimals or 1
    local step = options.Step or (isFloat and (10 ^ -decimals) or 1)
    local inputWidth = options.Width or 70
    local currentCallback = callback
    local currentEnabled = true

    local value = math.clamp(default or min, min, max)

    local function clampValue(v)
        v = math.clamp(v, min, max)
        if isFloat then
            v = math.floor(v * (10 ^ decimals) + 0.5) / (10 ^ decimals)
        else
            v = math.floor(v + 0.5)
        end
        return v
    end
    value = clampValue(value)

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 4, 0, 0)
    label.Size = UDim2.new(1, -inputWidth - 60, 1, 0)
    label.Font = Enum.Font.RobotoMono
    label.Text = text
    label.TextColor3 = theme.Text
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local minusBtn = Instance.new("TextButton")
    minusBtn.BackgroundColor3 = options.Color or theme.FrameBg
    minusBtn.Position = UDim2.new(1, -(inputWidth + 52), 0, 0)
    minusBtn.Size = UDim2.new(0, 24, 1, 0)
    minusBtn.Font = Enum.Font.RobotoMono
    minusBtn.Text = "-"
    minusBtn.TextColor3 = theme.Text
    minusBtn.TextSize = 14
    minusBtn.Parent = container
    applyCorner(minusBtn, 2)
    applyBorder(minusBtn, theme.Border)

    local box = Instance.new("TextBox")
    box.BackgroundColor3 = options.Color or theme.FrameBg
    box.Position = UDim2.new(1, -(inputWidth + 24), 0, 0)
    box.Size = UDim2.new(0, inputWidth, 1, 0)
    box.Font = Enum.Font.RobotoMono
    box.Text = isFloat and string.format("%." .. decimals .. "f", value) or tostring(value)
    box.TextColor3 = theme.Text
    box.TextSize = 13
    box.TextXAlignment = Enum.TextXAlignment.Center
    box.ClearTextOnFocus = false
    box.Parent = container
    applyCorner(box, 2)
    applyBorder(box, theme.Border)

    local plusBtn = Instance.new("TextButton")
    plusBtn.BackgroundColor3 = options.Color or theme.FrameBg
    plusBtn.Position = UDim2.new(1, -24, 0, 0)
    plusBtn.Size = UDim2.new(0, 24, 1, 0)
    plusBtn.Font = Enum.Font.RobotoMono
    plusBtn.Text = "+"
    plusBtn.TextColor3 = theme.Text
    plusBtn.TextSize = 14
    plusBtn.Parent = container
    applyCorner(plusBtn, 2)
    applyBorder(plusBtn, theme.Border)

    local function refreshText()
        if isFloat then
            box.Text = string.format("%." .. decimals .. "f", value)
        else
            box.Text = tostring(value)
        end
    end

    local function setValue(newVal, fire)
        local clamped = clampValue(newVal)
        if clamped == value then refreshText(); return end
        value = clamped
        refreshText()
        if fire ~= false then safeCall(currentCallback, value) end
    end

    minusBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        setValue(value - step)
    end)
    plusBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        setValue(value + step)
    end)

    local function addHover(btn)
        btn.MouseEnter:Connect(function()
            if currentEnabled then btn.BackgroundColor3 = options.Color and lightenColor(options.Color) or theme.FrameBgHover end
        end)
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = options.Color or theme.FrameBg
        end)
    end
    addHover(minusBtn)
    addHover(plusBtn)

    box.FocusLost:Connect(function()
        if not currentEnabled then return end
        local n = tonumber(box.Text)
        if n then setValue(n) else refreshText() end
    end)

    box.InputChanged:Connect(function(input)
        if not currentEnabled then return end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            setValue(value + step * input.Position.Z)
        end
    end)

    if tooltip then attachTooltip(box, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetValue() return value end
    function obj:SetValue(v) setValue(v) end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        minusBtn.Active = state
        plusBtn.Active = state
        box.Active = state
        local base = state and (options.Color or theme.FrameBg) or disabledColor(options.Color or theme.FrameBg)
        minusBtn.BackgroundColor3 = base
        plusBtn.BackgroundColor3 = base
        box.BackgroundColor3 = base
        box.TextColor3 = state and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return value end, function(v) obj:SetValue(v) end)

    return obj
end

