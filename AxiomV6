--  DIVISIONS 
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:_createDivisionContainer()
    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 0)
    container.LayoutOrder = self:_nextOrder(true)
    container.Parent = self._page

    local leftCol = Instance.new("Frame")
    leftCol.Name = "LeftColumn"
    leftCol.BackgroundTransparency = 1
    leftCol.Position = UDim2.new(0, 0, 0, 0)
    leftCol.Size = UDim2.new(0.5, -3, 0, 0)
    leftCol.Parent = container

    local leftLayout = Instance.new("UIListLayout")
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Padding = UDim.new(0, 6)
    leftLayout.Parent = leftCol

    local rightCol = Instance.new("Frame")
    rightCol.Name = "RightColumn"
    rightCol.BackgroundTransparency = 1
    rightCol.Position = UDim2.new(0.5, 3, 0, 0)
    rightCol.Size = UDim2.new(0.5, -3, 0, 0)
    rightCol.Parent = container

    local rightLayout = Instance.new("UIListLayout")
    rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightLayout.Padding = UDim.new(0, 6)
    rightLayout.Parent = rightCol

    local state = {
        Container     = container,
        LeftCol       = leftCol,
        RightCol      = rightCol,
        LeftLayout    = leftLayout,
        RightLayout   = rightLayout,
        Divisions     = {},
        Relayouting   = false,
        NeedsRelayout = false,
        HeartbeatConn = nil,
    }

    local function refresh()
        if state.Relayouting then return end
        local lh = leftLayout.AbsoluteContentSize.Y
        local rh = rightLayout.AbsoluteContentSize.Y
        leftCol.Size  = UDim2.new(0.5, -3, 0, lh)
        rightCol.Size = UDim2.new(0.5, -3, 0, rh)
        container.Size = UDim2.new(1, 0, 0, math.max(lh, rh))
    end
    state.Refresh = refresh

    leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refresh)
    rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refresh)

    return state
end

function TabComponent:_doRelayout(state)
    if not state or not state.Container or not state.Container.Parent then return end
    if state.Relayouting then return end
    state.Relayouting = true

    local GAP = 6
    local leftH, rightH = 0, 0

    for i, r in ipairs(state.Divisions) do
        if r.Frame and r.Frame.Parent ~= nil then
            local h = r.Frame.Size.Y.Offset
            if h <= 0 then h = r.Height or 32 end

            local target
            if leftH <= rightH then
                target = state.LeftCol
                leftH = leftH + h + GAP
            else
                target = state.RightCol
                rightH = rightH + h + GAP
            end

            if r.Frame.Parent ~= target then
                r.Frame.Parent = target
            end
            r.Frame.LayoutOrder = i
        end
    end

    state.Relayouting = false
    state.Refresh()
end

function TabComponent:AddDivision(options)
    options = options or {}
    local theme     = getTheme(self)
    local title     = options.Title or "Division"
    local parentTab = self

    local state = self._activeDivisionState
    if not state then
        state = self:_createDivisionContainer()
        self._activeDivisionState = state

        state.HeartbeatConn = RunService.Heartbeat:Connect(function()
            if not (state.Container and state.Container.Parent) then
                if state.HeartbeatConn then
                    pcall(function() state.HeartbeatConn:Disconnect() end)
                    state.HeartbeatConn = nil
                end
                return
            end
            if state.NeedsRelayout then
                state.NeedsRelayout = false
                parentTab:_doRelayout(state)
            end
        end)
    end

    local divisionFrame = Instance.new("Frame")
    divisionFrame.BackgroundColor3 = theme.FrameBg
    divisionFrame.Size = UDim2.new(1, 0, 0, 24)
    divisionFrame.ClipsDescendants = true
    applyCorner(divisionFrame, 2)
    applyBorder(divisionFrame, theme.Border)

    local titleBar = Instance.new("Frame")
    titleBar.BackgroundColor3 = theme.TitleBg
    titleBar.Size = UDim2.new(1, 0, 0, 22)
    titleBar.Parent = divisionFrame
    applyCorner(titleBar, 2)

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Position = UDim2.new(0, 6, 0, 0)
    titleLabel.Size = UDim2.new(1, -12, 1, 0)
    titleLabel.Font = Enum.Font.RobotoMono
    titleLabel.Text = title
    titleLabel.TextColor3 = theme.Text
    titleLabel.TextSize = 12
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.RichText = true
    titleLabel.Parent = titleBar

    local content = Instance.new("ScrollingFrame")
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 0, 0, 22)
    content.Size = UDim2.new(1, 0, 0, 0)
    content.ScrollBarThickness = 4
    content.ScrollBarImageColor3 = theme.Accent
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.Parent = divisionFrame
    applyPadding(content, 4)

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.Parent = content

    local record = {Frame = divisionFrame, Content = content, Height = 24}
    table.insert(state.Divisions, record)

    local function updateHeight()
        local contentH = contentLayout.AbsoluteContentSize.Y + 8
        content.CanvasSize = UDim2.new(0, 0, 0, contentH)
        content.Size = UDim2.new(1, 0, 0, contentH)
        local newH = 22 + contentH + 2
        divisionFrame.Size = UDim2.new(1, 0, 0, newH)
        record.Height = newH
        state.NeedsRelayout = true
    end
    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateHeight)
    task.defer(updateHeight)

    divisionFrame.Parent = state.LeftCol

    local dummyTab = {_page = content, _window = self._window, _layoutOrder = 0}
    setmetatable(dummyTab, TabComponent)

    local division = {Frame = divisionFrame, Content = content, Record = record}
    setmetatable(division, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) == "function" then
                return function(_, ...)
                    local result = method(dummyTab, ...)
                    updateHeight()
                    return result
                end
            end
            return method
        end
    })

    function division:GetContainer() return divisionFrame end
    function division:GetContent() return content end
    function division:GetTitle() return titleLabel.Text end
    function division:SetTitle(t) titleLabel.Text = tostring(t) end
    function division:SetVisible(v) divisionFrame.Visible = v end
    function division:IsVisible() return divisionFrame.Visible end
    function division:Relayout() parentTab:_doRelayout(state) end
    function division:Destroy()
        for i, r in ipairs(state.Divisions) do
            if r == record then table.remove(state.Divisions, i); break end
        end
        divisionFrame:Destroy()
        state.NeedsRelayout = true

        if #state.Divisions == 0 then
            if parentTab._activeDivisionState == state then
                parentTab._activeDivisionState = nil
            end
            if state.HeartbeatConn then
                pcall(function() state.HeartbeatConn:Disconnect() end)
                state.HeartbeatConn = nil
            end
            state.Container:Destroy()
        end
    end

    task.defer(function()
        if state.Container and state.Container.Parent then
            parentTab:_doRelayout(state)
        end
    end)

    if self._window then self._window:_registerSearch(divisionFrame, title) end
    return division
end
