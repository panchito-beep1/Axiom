    table.insert(self._subTabs, {
        Button = subBtn, Page = page, TextLabel = subText, UpdateSize = updateSizes,
    })

    subBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(self._subTabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = theme.TabNormal
            t.TextLabel.TextColor3 = theme.TabNormalText
        end
        page.Visible = true
        subBtn.BackgroundColor3 = theme.TabActive
        subText.TextColor3 = theme.TabActiveText
        updateSizes()
    end)

    if #self._subTabs == 1 then
        page.Visible = true
        subBtn.BackgroundColor3 = theme.TabActive
        subText.TextColor3 = theme.TabActiveText
        task.defer(updateSizes)
    end

    local subTabObj = setmetatable({}, TabComponent)
    subTabObj._page = page
    subTabObj._layoutOrder = 0
    subTabObj._window = self._window
    return subTabObj
end

