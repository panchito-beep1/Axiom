--  AddGraph
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddGraph(options)
    options = options or {}
    local theme      = getTheme(self)

    local title       = options.Title or "Graph"
    local maxPoints   = options.MaxPoints or 100
    local lineColor   = options.LineColor   or theme.GraphLine
    local yMin        = options.YMin
    local yMax        = options.YMax
    local smoothAlpha = options.SmoothAlpha or 0.2
    local maxLines    = options.MaxLines    or 120

    local buf     = table.create(maxPoints, 0)
    local bufHead = 1
    local bufSize = 0
    local smoothed = nil
    local dirty    = false

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size        = UDim2.new(1, 0, 0, 108)
    container.LayoutOrder = self:_nextOrder()
    container.Parent      = self._page

    local titleLabel = Instance.new("TextLabel")
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size       = UDim2.new(1, 0, 0, 18)
    titleLabel.Font       = Enum.Font.RobotoMono
    titleLabel.Text       = title
    titleLabel.TextColor3 = theme.Text
    titleLabel.TextSize   = 12
    titleLabel.Parent     = container

    local graphFrame = Instance.new("Frame")
    graphFrame.BackgroundColor3 = theme.GraphBg
    graphFrame.BorderSizePixel  = 0
    graphFrame.Position         = UDim2.new(0, 0, 0, 20)
    graphFrame.Size             = UDim2.new(1, 0, 0, 80)
    graphFrame.ClipsDescendants = true
    graphFrame.Parent           = container
    applyCorner(graphFrame, 2)
    applyBorder(graphFrame, theme.Border)

    local linesHolder = Instance.new("Frame")
    linesHolder.BackgroundTransparency = 1
    linesHolder.Size   = UDim2.new(1, 0, 1, 0)
    linesHolder.Parent = graphFrame

    local pool = table.create(maxLines)
    for i = 1, maxLines do
        local f = Instance.new("Frame")
        f.BackgroundColor3 = lineColor
        f.BorderSizePixel  = 0
        f.Size             = UDim2.new(0, 0, 0, 2)
        f.Visible          = false
        f.Parent           = linesHolder
        pool[i]            = f
    end

    local function cr(p0, p1, p2, p3, t)
        local t2 = t * t
        local t3 = t2 * t
        return 0.5 * ((2*p1) + (-p0 + p2)*t + (2*p0 - 5*p1 + 4*p2 - p3)*t2 + (-p0 + 3*p1 - 3*p2 + p3)*t3)
    end

    local function redraw()
        local W, H = graphFrame.AbsoluteSize.X, graphFrame.AbsoluteSize.Y
        if W <= 0 or H <= 0 or bufSize < 2 then
            for i = 1, maxLines do pool[i].Visible = false end
            return
        end
        local lo, hi
        if yMin and yMax then lo, hi = yMin, yMax
        else
            lo, hi = math.huge, -math.huge
            for i = 1, bufSize do
                local v = buf[((bufHead - 1 + i - 1) % maxPoints) + 1]
                if v < lo then lo = v end
                if v > hi then hi = v end
            end
            if lo == hi then hi = lo + 1 end
        end
        local range = hi - lo
        local PAD = 3
        local drawH = H - PAD * 2
        local px, py = table.create(bufSize), table.create(bufSize)
        for i = 1, bufSize do
            local v = buf[((bufHead - 1 + i - 1) % maxPoints) + 1]
            px[i] = (i - 1) / (bufSize - 1) * W
            py[i] = PAD + drawH - ((v - lo) / range) * drawH
        end
        local intervals  = bufSize - 1
        local stepsEach  = math.max(1, math.floor(maxLines / intervals))
        local used = 0
        for i = 1, intervals do
            local i0 = math.max(1, i - 1)
            local i2 = math.min(bufSize, i + 1)
            local i3 = math.min(bufSize, i + 2)
            local lx, ly = px[i], py[i]
            for s = 1, stepsEach do
                local t  = s / stepsEach
                local nx = cr(px[i0], px[i], px[i2], px[i3], t)
                local ny = cr(py[i0], py[i], py[i2], py[i3], t)
                local dx = nx - lx
                local dy = ny - ly
                local len = math.sqrt(dx * dx + dy * dy)
                if len > 0.5 and used < maxLines then
                    used = used + 1
                    local f = pool[used]
                    f.Size     = UDim2.new(0, len + 1, 0, 2)
                    f.Position = UDim2.new(0, lx, 0, ly - 1)
                    f.Rotation = math.deg(math.atan2(dy, dx))
                    f.Visible  = true
                end
                lx, ly = nx, ny
            end
        end
        for i = used + 1, maxLines do pool[i].Visible = false end
    end

    local hbConn = RunService.Heartbeat:Connect(function() if dirty then dirty = false; redraw() end end)
    graphFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() dirty = true end)

    if self._window then self._window:_registerSearch(container, title) end

    local graphObj = {}
    function graphObj:Push(rawValue)
        if smoothed == nil then smoothed = rawValue
        else smoothed = smoothed + (rawValue - smoothed) * smoothAlpha end
        local tail = ((bufHead - 1 + bufSize) % maxPoints) + 1
        buf[tail] = smoothed
        if bufSize < maxPoints then bufSize = bufSize + 1
        else bufHead = (bufHead % maxPoints) + 1 end
        dirty = true
    end
    function graphObj:SetColor(color)
        lineColor = color
        for i = 1, maxLines do pool[i].BackgroundColor3 = color end
    end
    function graphObj:Clear() bufSize = 0; bufHead = 1; smoothed = nil; dirty = true end
    function graphObj:Destroy() hbConn:Disconnect(); container:Destroy() end
    return graphObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddKeybindPicker
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddKeybindPicker(options)
    options = options or {}
    local theme = getTheme(self)

    local text          = options.Text or "Keybind"
    local defaultKey    = options.Default
    local callback      = options.Callback
    local toggleMode    = options.Toggle or false
    local allowCombos   = options.AllowCombos ~= false
    local currentState  = options.DefaultState or false
    local tooltip       = options.Tooltip

    local currentCallback = callback
    local currentEnabled  = true

    local modifierShort = {
        LeftShift = "Shift", RightShift = "Shift",
        LeftControl = "Ctrl", RightControl = "Ctrl",
        LeftAlt = "Alt", RightAlt = "Alt",
    }
    local function isModifier(name) return modifierShort[name] ~= nil end

    local function parseKeySpec(spec)
        if not spec then return {"Unbound"} end
        if typeof(spec) == "EnumItem" then return { spec.Name } end
        if type(spec) == "table" then
            local t = {}
            for _, v in ipairs(spec) do
                if typeof(v) == "EnumItem" then t[#t+1] = v.Name else t[#t+1] = tostring(v) end
            end
            return #t > 0 and t or {"Unbound"}
        end
        if type(spec) == "string" then
            local t = {}
            for part in spec:gmatch("[^+]+") do
                t[#t+1] = (part:gsub("^%s+", ""):gsub("%s+$", ""))
            end
            return #t > 0 and t or {"Unbound"}
        end
        return {"Unbound"}
    end

    local function currentModifiers()
        local mods = {}
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)  or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)  then mods[#mods+1] = "Shift" end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then mods[#mods+1] = "Ctrl"  end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt)     or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)     then mods[#mods+1] = "Alt"   end
        return mods
    end

    local function comboToString(combo)
        if not combo or #combo == 0 then return "Unbound" end
        return table.concat(combo, "+")
    end

    local currentCombo = parseKeySpec(defaultKey or "Unbound")
    local isWaiting    = false
    local pressConnection
    local bindConnection        -- FIX: track the "listening for new key" connection

    -- theme safety helper (FIX: prevents nil Color3 assignment crash)
    local accentColor    = theme.Accent
    local bindActiveColor = theme.CheckOn or theme.Accent
    local hoverColor     = theme.AccentHover or theme.Accent

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(0, TextService:GetTextSize(text, 13, Enum.Font.RobotoMono, Vector2.new(999, 24)).X + 4, 1, 0)
    label.Font = Enum.Font.RobotoMono
    label.Text = text
    label.TextColor3 = theme.Text
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local keyDisplay = Instance.new("TextLabel")
    keyDisplay.BackgroundColor3 = theme.FrameBg
    keyDisplay.Position = UDim2.new(0, label.Size.X.Offset + 8, 0, 0)
    keyDisplay.Size = UDim2.new(1, -(label.Size.X.Offset + 8 + 48), 1, 0)
    keyDisplay.Font = Enum.Font.RobotoMono
    keyDisplay.TextSize = 13
    keyDisplay.TextXAlignment = Enum.TextXAlignment.Center
    keyDisplay.Parent = container
    applyCorner(keyDisplay, 2)
    applyBorder(keyDisplay, theme.Border)

    local bindBtn = Instance.new("TextButton")
    bindBtn.BackgroundColor3 = accentColor
    bindBtn.Position = UDim2.new(1, -44, 0, 0)
    bindBtn.Size = UDim2.new(0, 44, 1, 0)
    bindBtn.Font = Enum.Font.RobotoMono
    bindBtn.Text = "Bind"
    bindBtn.TextColor3 = theme.Text
    bindBtn.TextSize = 12
    bindBtn.Parent = container
    applyCorner(bindBtn, 2)
    applyBorder(bindBtn, theme.Border)

    local function updateDisplay()
        local display = comboToString(currentCombo)
        if display == "Unbound" then
            keyDisplay.Text = "Unbound"
            keyDisplay.TextColor3 = theme.SubText
        else
            if toggleMode then
                keyDisplay.Text = string.format("%s [%s]", display, currentState and "ON" or "OFF")
                keyDisplay.TextColor3 = currentState and accentColor or theme.Text
            else
                keyDisplay.Text = display
                keyDisplay.TextColor3 = theme.Text
            end
        end
    end
    updateDisplay()

    local function comboMatches(input)
        local combo = currentCombo
        if #combo == 0 or combo[1] == "Unbound" then return false end
        local mainKey    = combo[#combo]
        local modsNeeded = {}
        for i = 1, #combo - 1 do modsNeeded[combo[i]] = true end

        if mainKey:sub(1, 5) == "Mouse" then
            local expectedType
            if     mainKey == "Mouse1" then expectedType = Enum.UserInputType.MouseButton1
            elseif mainKey == "Mouse2" then expectedType = Enum.UserInputType.MouseButton2
            elseif mainKey == "Mouse3" then expectedType = Enum.UserInputType.MouseButton3
            elseif mainKey == "Mouse4" then expectedType = Enum.UserInputType.MouseButton4
            elseif mainKey == "Mouse5" then expectedType = Enum.UserInputType.MouseButton5 end
            if input.UserInputType ~= expectedType then return false end
        else
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return false end
            if input.KeyCode.Name ~= mainKey then
                if not (modifierShort[input.KeyCode.Name] and modifierShort[input.KeyCode.Name] == mainKey) then
                    return false
                end
            end
        end
        for modName in pairs(modsNeeded) do
            local down = false
            if modName == "Shift" then
                down = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
            elseif modName == "Ctrl" then
                down = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
            elseif modName == "Alt" then
                down = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)
            end
            if not down then return false end
        end
        return true
    end

    local function reconnectPressListener()
        if pressConnection then pressConnection:Disconnect(); pressConnection = nil end
        if currentCombo[1] == "Unbound" then return end
        pressConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if not currentEnabled then return end
            if not comboMatches(input) then return end
            if toggleMode then
                currentState = not currentState
                updateDisplay()
                safeCall(currentCallback, comboToString(currentCombo), currentState)
            else
                safeCall(currentCallback, comboToString(currentCombo))
            end
        end)
    end

    bindBtn.MouseEnter:Connect(function()
        if not isWaiting and currentEnabled then bindBtn.BackgroundColor3 = hoverColor end
    end)
    bindBtn.MouseLeave:Connect(function()
        if not isWaiting then bindBtn.BackgroundColor3 = accentColor end
    end)

    local function finalizeCombo(combo)
        if bindConnection then bindConnection:Disconnect(); bindConnection = nil end
        currentCombo = combo
        bindBtn.Text = "Bind"
        bindBtn.BackgroundColor3 = accentColor
        isWaiting = false
        updateDisplay()
        reconnectPressListener()
        if not toggleMode then safeCall(currentCallback, comboToString(currentCombo)) end
    end

    local function cancelBind()
        if bindConnection then bindConnection:Disconnect(); bindConnection = nil end
        isWaiting = false
        bindBtn.Text = "Bind"
        bindBtn.BackgroundColor3 = accentColor
        updateDisplay()
    end

    bindBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end

        -- FIX: clicking Bind again while waiting cancels instead of doing nothing
        if isWaiting then
            cancelBind()
            return
        end

        isWaiting = true
        bindBtn.Text = "..."
        bindBtn.BackgroundColor3 = bindActiveColor          -- FIX: safe theme color
        keyDisplay.Text = allowCombos and "Press key(s)..." or "Press a key..."
        keyDisplay.TextColor3 = accentColor

        bindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not isWaiting then return end

            -- Allow Escape to cancel even when Roblox marks it as gameProcessed
            if input.UserInputType == Enum.UserInputType.Keyboard
               and input.KeyCode == Enum.KeyCode.Escape then
                cancelBind()
                return
            end

            if gameProcessed then return end

            local mouseMap = {
                [Enum.UserInputType.MouseButton1] = "Mouse1",
                [Enum.UserInputType.MouseButton2] = "Mouse2",
                [Enum.UserInputType.MouseButton3] = "Mouse3",
                [Enum.UserInputType.MouseButton4] = "Mouse4",
                [Enum.UserInputType.MouseButton5] = "Mouse5",
            }

            if mouseMap[input.UserInputType] then
                local mods = allowCombos and currentModifiers() or {}
                mods[#mods+1] = mouseMap[input.UserInputType]
                finalizeCombo(mods)
                return
            end

            -- Treat touch as Mouse1 for bind purposes (mobile parity)
            if input.UserInputType == Enum.UserInputType.Touch then
                local mods = allowCombos and currentModifiers() or {}
                mods[#mods+1] = "Mouse1"
                finalizeCombo(mods)
                return
            end

            if input.UserInputType == Enum.UserInputType.Keyboard then
                local pressed = input.KeyCode.Name
                if isModifier(pressed) then
                    local shortName = modifierShort[pressed]
                    local held = currentModifiers()
                    local hasMod = false
                    for _, m in ipairs(held) do
                        if m == shortName then hasMod = true; break end
                    end
                    if not hasMod then held[#held+1] = shortName end
                    keyDisplay.Text = table.concat(held, "+") .. " + ..."
                    return
                end

                local mods = allowCombos and currentModifiers() or {}
                mods[#mods+1] = pressed
                finalizeCombo(mods)
            end
        end)
    end)

    reconnectPressListener()

    if tooltip then attachTooltip(bindBtn, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local pickerObj = {}
    function pickerObj:GetKey() return comboToString(currentCombo) end
    function pickerObj:GetCombo()
        local copy = {}
        for i, v in ipairs(currentCombo) do copy[i] = v end
        return copy
    end
    function pickerObj:SetKey(spec) currentCombo = parseKeySpec(spec); updateDisplay(); reconnectPressListener() end
    function pickerObj:SetCombo(tbl) pickerObj:SetKey(tbl) end
    function pickerObj:GetState() return currentState end
    function pickerObj:SetState(state)
        if toggleMode then currentState = state; updateDisplay() end
    end
    function pickerObj:SetCallback(fn) currentCallback = fn end
    function pickerObj:SetEnabled(state)
        currentEnabled = state
        bindBtn.Active = state
        bindBtn.BackgroundColor3 = state and accentColor or disabledColor(accentColor)
        label.TextColor3 = state and theme.Text or disabledColor(theme.Text)
        updateDisplay()
    end
    function pickerObj:IsEnabled() return currentEnabled end
    function pickerObj:Destroy()
        container:Destroy()
        if pressConnection then pressConnection:Disconnect() end
        if bindConnection then bindConnection:Disconnect() end
    end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(
        key,
        function() return { key = comboToString(currentCombo), state = currentState } end,
        function(v)
            pickerObj:SetKey(v.key)
            if toggleMode then pickerObj:SetState(v.state) end
        end
    )

    return pickerObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddViewport
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddViewport(options)
    options = options or {}
    local theme = getTheme(self)

    local title = options.Title

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = options.Size or UDim2.new(1, 0, 0, 200)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local hasTitle = type(title) == "string" and title ~= ""
    if hasTitle then
        local titleLabel = Instance.new("TextLabel")
        titleLabel.BackgroundTransparency = 1
        titleLabel.Size = UDim2.new(1, 0, 0, 18)
        titleLabel.Font = Enum.Font.RobotoMono
        titleLabel.Text = title
        titleLabel.TextColor3 = theme.Text
        titleLabel.TextSize = 12
        titleLabel.Parent = container
    end

    local viewportFrame = Instance.new("ViewportFrame")
    viewportFrame.BackgroundColor3 = theme.WindowBg
    viewportFrame.BorderSizePixel = 0
    viewportFrame.Position = UDim2.new(0, 0, 0, hasTitle and 20 or 0)
    viewportFrame.Size = UDim2.new(1, 0, 1, hasTitle and -20 or 0)
    viewportFrame.ImageColor3 = Color3.new(1, 1, 1)
    viewportFrame.Active = true
    viewportFrame.Parent = container
    applyCorner(viewportFrame, 2)
    applyBorder(viewportFrame, theme.Border)

    local camera = Instance.new("Camera")
    camera.CameraType = Enum.CameraType.Scriptable
    camera.FieldOfView = options.FOV or 30
    camera.Parent = viewportFrame
    viewportFrame.CurrentCamera = camera

    local modelClone = nil
    local modelCenter = Vector3.zero
    local modelRadius = 5

    local rotationPresets = {
        Front  = 0, Back   = math.rad(180),
        Left   = math.rad(90), Right  = math.rad(-90),
    }
    local currentAngle = rotationPresets[options.StartingRotation or "Front"] or 0

    local function updateCamera()
        if not modelClone then return end
        local maxExtent = modelRadius * 1.2
        local rotCF = CFrame.Angles(0, currentAngle, 0)
        local offset = rotCF * Vector3.new(0, maxExtent * 0.4, maxExtent * 2.5)
        camera.CFrame = CFrame.lookAt(modelCenter + offset, modelCenter)
    end

    local autoRotate = options.AutoRotate or false
    local rotationSpeed = math.rad(options.RotationSpeed ~= nil and options.RotationSpeed or 30)
    local heartbeatConn

    local function startAutoRotate()
        if heartbeatConn then heartbeatConn:Disconnect() end
        if autoRotate and modelClone then
            heartbeatConn = RunService.Heartbeat:Connect(function(dt)
                currentAngle = (currentAngle + rotationSpeed * dt) % (2 * math.pi)
                updateCamera()
            end)
        end
    end

    local dragEnabled = options.DragEnabled or false
    local dragging = false
    local lastMousePos = Vector2.zero
    local inputBeganConn, inputEndedConn, inputChangedConn

    inputBeganConn = viewportFrame.InputBegan:Connect(function(input)
        if dragEnabled and (input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging = true
            lastMousePos = input.Position
        end
    end)

    inputEndedConn = UserInputService.InputEnded:Connect(function(input)
        if dragEnabled and (input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging = false
        end
    end)

    inputChangedConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - lastMousePos
            lastMousePos = input.Position
            currentAngle = currentAngle + math.rad(delta.X * 0.5)
            updateCamera()
        end
    end)

    local function loadModel(originalModel)
        if modelClone then modelClone:Destroy(); modelClone = nil end
        if typeof(originalModel) ~= "Instance" then return end
        local wasArchivable = originalModel.Archivable
        originalModel.Archivable = true
        local clone = originalModel:Clone()
        originalModel.Archivable = wasArchivable
        if not clone then return end
        local hum = clone:FindFirstChildOfClass("Humanoid")
        if hum then hum:Destroy() end
        for _, part in ipairs(clone:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored = true end
        end
        if clone:IsA("BasePart") then clone.Anchored = true end
        if clone:IsA("Model") then clone:PivotTo(CFrame.new())
        elseif clone:IsA("BasePart") then clone.CFrame = CFrame.new() end
        local bboxCenter, bboxSize
        if clone:IsA("Model") then bboxCenter, bboxSize = clone:GetBoundingBox()
        elseif clone:IsA("BasePart") then bboxCenter = clone.CFrame; bboxSize = clone.Size
        else bboxCenter = CFrame.new(); bboxSize = Vector3.new(2,2,2) end
        if bboxSize.Magnitude < 0.01 then bboxSize = Vector3.new(2,2,2) end
        modelRadius = math.max(bboxSize.X, bboxSize.Y, bboxSize.Z) * 1.5
        modelCenter = bboxCenter.Position
        clone.Parent = viewportFrame
        modelClone = clone
        updateCamera()
        startAutoRotate()
    end

    if options.Model then loadModel(options.Model) end

    if options.Tooltip then attachTooltip(viewportFrame, options.Tooltip, self._window) end
    if self._window and hasTitle then self._window:_registerSearch(container, title) end

    local obj = {}
    function obj:SetModel(newModel) loadModel(newModel) end
    function obj:SetRotation(rotationKey)
        if rotationPresets[rotationKey] then currentAngle = rotationPresets[rotationKey]; updateCamera() end
    end
    function obj:SetAutoRotate(enabled)
        autoRotate = enabled
        if enabled then startAutoRotate() elseif heartbeatConn then heartbeatConn:Disconnect(); heartbeatConn = nil end
    end
    function obj:SetSpeed(speed) rotationSpeed = math.rad(speed) end
    function obj:GetModel() return modelClone end
    function obj:Destroy()
        if heartbeatConn then heartbeatConn:Disconnect() end
        if inputBeganConn then inputBeganConn:Disconnect() end
        if inputEndedConn then inputEndedConn:Disconnect() end
        if inputChangedConn then inputChangedConn:Disconnect() end
        if modelClone then modelClone:Destroy() end
        container:Destroy()
    end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddTextToggle
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddTextToggle(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Toggle"
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local isOn = default or false
    local onColor  = options.OnColor  or theme.TitleBg
    local offColor = options.OffColor or theme.SubText
    local currentCallback = callback
    local currentEnabled = true

    local lbl = Instance.new("TextButton")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, 0)
    lbl.LayoutOrder = self:_nextOrder()
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = isOn and onColor or offColor
    lbl.TextSize = options.TextSize or 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.RichText = true
    lbl.Parent = self._page

    lbl:GetPropertyChangedSignal("TextBounds"):Connect(function()
        lbl.Size = UDim2.new(1, 0, 0, lbl.TextBounds.Y + 2)
    end)

    lbl.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOn = not isOn
        lbl.TextColor3 = isOn and onColor or offColor
        safeCall(currentCallback, isOn)
    end)

    if tooltip then attachTooltip(lbl, tooltip, self._window) end
    if self._window then self._window:_registerSearch(lbl, text) end

    local obj = {}
    function obj:GetValue() return isOn end
    function obj:SetValue(state)
        isOn = state
        lbl.TextColor3 = isOn and onColor or offColor
        safeCall(currentCallback, isOn)
    end
    function obj:Toggle() obj:SetValue(not isOn) end
    function obj:SetText(t) lbl.Text = t end
    function obj:GetText() return lbl.Text end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        lbl.Active = state
        if state then lbl.TextColor3 = isOn and onColor or offColor
        else lbl.TextColor3 = disabledColor(isOn and onColor or offColor) end
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() lbl:Destroy() end
    function obj:GetInstance() return lbl end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return isOn end, function(v) obj:SetValue(v) end)

    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddProgressBar
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddProgressBar(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or ""
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local min       = options.Min       or 0
    local max       = options.Max       or 100
    local decimals  = options.Decimals  or 2
    local barHeight = options.Height    or 20
    local fillColor = options.FillColor or theme.SliderFill
    local bgColor   = options.BackgroundColor or theme.SliderTrack
    local txtColor  = options.TextColor or theme.Text
    local currentCallback = callback
    local currentEnabled = true

    local value = math.clamp(default or min, min, max)

    local container = Instance.new("Frame")
    container.BackgroundColor3 = bgColor
    container.BorderSizePixel = 0
    container.Size = UDim2.new(1, 0, 0, barHeight)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page
    applyCorner(container, 2)
    applyBorder(container, theme.Border)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = fillColor
    fill.BorderSizePixel = 0
    fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
    fill.Parent = container
    applyCorner(fill, 2)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.TextColor3 = txtColor
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Center
    lbl.TextYAlignment = Enum.TextYAlignment.Center
    lbl.RichText = true
    lbl.ZIndex = 2
    lbl.Parent = container

    local function formatText()
        local pct = (value - min) / (max - min) * 100
        local label = (text ~= "") and (text .. " ") or ""
        return string.format("%s%.2f%%", label, pct)
    end
    local function refresh()
        local rel = (value - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = formatText()
    end
    refresh()

    if tooltip then attachTooltip(container, tooltip, self._window) end
    if self._window and text ~= "" then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetValue() return value end
    function obj:SetValue(val)
        val = math.clamp(val, min, max)
        value = val
        refresh()
        safeCall(currentCallback, value)
    end
    function obj:AddValue(delta) obj:SetValue(value + delta) end
    function obj:SetPercent(pct) obj:SetValue(min + (max - min) * (pct / 100)) end
    function obj:GetPercent() return (value - min) / (max - min) * 100 end
    function obj:Reset() obj:SetValue(min) end
    function obj:SetText(t) text = t; refresh() end
    function obj:GetText() return text end
    function obj:SetFillColor(color) fillColor = color; fill.BackgroundColor3 = color end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        container.BackgroundColor3 = state and bgColor or disabledColor(bgColor)
        fill.BackgroundColor3 = state and fillColor or disabledColor(fillColor)
        lbl.TextColor3 = state and txtColor or disabledColor(txtColor)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    local key = options.StateKey or self._window:_autoStateKey("tab", text ~= "" and text or "progress")
    self._window:_registerState(key, function() return value end, function(v) obj:SetValue(v) end)

    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddImage
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddImage(options)
    options = options or {}
    local theme = getTheme(self)

    local imageId = options.Image
    if type(imageId) == "number" then
        imageId = "rbxassetid://" .. tostring(imageId)
    elseif type(imageId) == "string" and tonumber(imageId) then
        imageId = "rbxassetid://" .. imageId
    end
    imageId = imageId or ""

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = options.Size or UDim2.new(0, 100, 0, 100)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page
    applyCorner(container, options.CornerRadius or 2)
    if options.Border and options.Border ~= false then applyBorder(container, theme.Border) end

    local imgLabel = Instance.new("ImageLabel")
    imgLabel.BackgroundTransparency = options.BackgroundTransparency or 1
    imgLabel.Size = UDim2.new(1, 0, 1, 0)
    imgLabel.Image = imageId
    imgLabel.ScaleType = options.ScaleType or Enum.ScaleType.Fit
    imgLabel.Parent = container
    applyCorner(imgLabel, options.CornerRadius or 2)

    if options.Tooltip then attachTooltip(imgLabel, options.Tooltip, self._window) end

    local obj = {}
    function obj:SetImage(id)
        if type(id) == "number" then id = "rbxassetid://" .. tostring(id) end
        imgLabel.Image = id
    end
    function obj:GetImage() return imgLabel.Image end
    function obj:Update(opts)
        opts = opts or {}
        if opts.Size then container.Size = opts.Size end
        if opts.ScaleType then imgLabel.ScaleType = opts.ScaleType end
        if opts.BackgroundTransparency ~= nil then imgLabel.BackgroundTransparency = opts.BackgroundTransparency end
        if opts.CornerRadius then
            applyCorner(container, opts.CornerRadius)
            applyCorner(imgLabel, opts.CornerRadius)
        end
    end
    function obj:Destroy() container:Destroy() end
    return obj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddLayout
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddLayout(options)
    options = options or {}
    local theme = getTheme(self)

    local style   = options.Style or "Vertical"
    local padding = options.Padding or 4

    local container = Instance.new("Frame")
    container.Name = "Layout_" .. style
    container.BackgroundColor3 = options.BackgroundColor or theme.FrameBg
    container.BackgroundTransparency = options.BackgroundTransparency or 1
    container.BorderSizePixel = 0
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = false
    container.Parent = self._page

    if style == "Horizontal" then
        container.Size = options.Size or UDim2.new(1, 0, 0, 26)
    elseif style == "Grid" then
        container.Size = options.Size or UDim2.new(1, 0, 0, 100)
    elseif style == "Absolute" then
        container.Size = options.Size or UDim2.new(1, 0, 0, 200)
    else
        container.Size = options.Size or UDim2.new(1, 0, 0, 0)
    end
    container.Position = options.Position or UDim2.new(0, 0, 0, 0)

    applyCorner(container, 2)
    applyBorder(container, theme.Border)

    local layout
    if style == "Vertical" then
        layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, padding)
        layout.Parent = container
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, 0, layout.AbsoluteContentSize.Y + padding * 2)
        end)
    elseif style == "Horizontal" then
        layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
        layout.VerticalAlignment = Enum.VerticalAlignment.Center
        layout.Padding = UDim.new(0, padding)
        layout.Parent = container
    elseif style == "Grid" then
        layout = Instance.new("UIGridLayout")
        layout.CellSize = options.CellSize or UDim2.new(0, 100, 0, 30)
        layout.CellPadding = options.CellPadding or UDim2.new(0, 5, 0, 5)
        layout.FillDirectionMaxCells = options.Columns or 2
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = container
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            container.Size = UDim2.new(container.Size.X.Scale, container.Size.X.Offset, 0, layout.AbsoluteContentSize.Y + padding * 2)
        end)
    end

    local dummyTab = {
        _page = container,
        _window = self._window,
        _layoutOrder = 0,
    }
    setmetatable(dummyTab, TabComponent)

    local layoutObj = {}
    setmetatable(layoutObj, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) ~= "function" then return method end

            return function(_, ...)
                local args = { ... }

                if style == "Horizontal" then
                    local opts = args[#args]
                    if type(opts) ~= "table" then
                        opts = {}
                        args[#args + 1] = opts
                    end
                    local size     = opts.Size or UDim2.new(0, 100, 1, 0)
                    local position = opts.Position
                    local anchor   = opts.AnchorPoint
                    opts.Size, opts.Position, opts.AnchorPoint = nil, nil, nil

                    local wrapper = Instance.new("Frame")
                    wrapper.BackgroundTransparency = 1
                    wrapper.Size = size
                    wrapper.Position = position or UDim2.new(0, 0, 0, 0)
                    wrapper.AnchorPoint = anchor or Vector2.new(0, 0)
                    wrapper.Parent = container

                    local originalPage = dummyTab._page
                    dummyTab._page = wrapper
                    local comp = method(dummyTab, table.unpack(args))
                    dummyTab._page = originalPage

                    local inst = comp:GetInstance()
                    inst.AnchorPoint = Vector2.new(0, 0)
                    inst.Position = UDim2.new(0, 0, 0, 0)
                    inst.Size = UDim2.new(1, 0, 1, 0)

                    wrapper.LayoutOrder = dummyTab._layoutOrder
                    dummyTab._layoutOrder = dummyTab._layoutOrder + 1
                    return comp
                end

                if style == "Absolute" then
                    local opts = args[#args]
                    if type(opts) == "table" and (opts.Position or opts.Size or opts.AnchorPoint) then
                        local wrapper = Instance.new("Frame")
                        wrapper.BackgroundTransparency = 1
                        wrapper.Position = opts.Position or UDim2.new(0, 0, 0, 0)
                        wrapper.Size     = opts.Size     or UDim2.new(0, 100, 0, 24)
                        wrapper.AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0)
                        wrapper.Parent = container

                        opts.Position, opts.Size, opts.AnchorPoint = nil, nil, nil

                        local originalPage = dummyTab._page
                        dummyTab._page = wrapper
                        local comp = method(dummyTab, table.unpack(args))
                        dummyTab._page = originalPage

                        local inst = comp:GetInstance()
                        inst.AnchorPoint = Vector2.new(0, 0)
                        inst.Position = UDim2.new(0, 0, 0, 0)
                        inst.Size = UDim2.new(1, 0, 1, 0)
                        return comp
                    end
                end

                return method(dummyTab, table.unpack(args))
            end
        end
    })

    function layoutObj:GetContainer() return container end
    function layoutObj:SetSize(size) container.Size = size end
    function layoutObj:SetPosition(pos) container.Position = pos end
    function layoutObj:Destroy() container:Destroy() end

    return layoutObj
end

-- ════════════════════════════════════════════════════════════════════════════
--  AddTable
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddTable(options)
    options = options or {}
    local theme = getTheme(self)

    local headers    = options.Headers or {}
    local rows       = options.Rows or {}
    local headerHeight = options.HeaderHeight or 24
    local rowHeight    = options.RowHeight    or 22
    local maxHeight    = options.MaxHeight    or 200

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, math.min(#rows * rowHeight + headerHeight, maxHeight))
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.CanvasSize = UDim2.new(0, 0, 0, #rows * rowHeight + headerHeight)
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = theme.Accent
    scroll.Parent = container

    local headerFrame = Instance.new("Frame")
    headerFrame.BackgroundColor3 = theme.TitleBg
    headerFrame.Size = UDim2.new(1, 0, 0, headerHeight)
    headerFrame.Parent = scroll
    applyBorder(headerFrame, theme.Border)

    local headerLayout = Instance.new("UIListLayout")
    headerLayout.FillDirection = Enum.FillDirection.Horizontal
    headerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    headerLayout.Padding = UDim.new(0, 0)
    headerLayout.Parent = headerFrame

    for i, header in ipairs(headers) do
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1 / #headers, 0, 1, 0)
        lbl.Font = Enum.Font.RobotoMono
        lbl.Text = header
        lbl.TextColor3 = theme.Text
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Center
        lbl.Parent = headerFrame
        lbl.LayoutOrder = i
        lbl.TextWrapped = true
    end

    local rowFrames = {}
    local function buildRow(r, rowData)
        local rowFrame = Instance.new("Frame")
        rowFrame.BackgroundColor3 = r % 2 == 0 and theme.FrameBg or theme.WindowBg
        rowFrame.Size = UDim2.new(1, 0, 0, rowHeight)
        rowFrame.Position = UDim2.new(0, 0, 0, headerHeight + (r-1) * rowHeight)
        rowFrame.Parent = scroll
        applyBorder(rowFrame, theme.Border)

        local rowLayout = Instance.new("UIListLayout")
        rowLayout.FillDirection = Enum.FillDirection.Horizontal
        rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
        rowLayout.Padding = UDim.new(0, 0)
        rowLayout.Parent = rowFrame

        for c, cell in ipairs(rowData) do
            local cellLabel = Instance.new("TextLabel")
            cellLabel.BackgroundTransparency = 1
            cellLabel.Size = UDim2.new(1 / #headers, 0, 1, 0)
            cellLabel.Font = Enum.Font.RobotoMono
            cellLabel.Text = tostring(cell)
            cellLabel.TextColor3 = theme.SubText
            cellLabel.TextSize = 12
            cellLabel.TextXAlignment = Enum.TextXAlignment.Center
            cellLabel.Parent = rowFrame
            cellLabel.LayoutOrder = c
            cellLabel.TextWrapped = true
            cellLabel.RichText = true
        end
        table.insert(rowFrames, rowFrame)
    end

    for r, rowData in ipairs(rows) do buildRow(r, rowData) end

    local obj = {}
    function obj:SetData(newRows)
        for _, frame in ipairs(rowFrames) do frame:Destroy() end
        table.clear(rowFrames)
        for r, rowData in ipairs(newRows) do buildRow(r, rowData) end
        scroll.CanvasSize = UDim2.new(0, 0, 0, #newRows * rowHeight + headerHeight)
        container.Size = UDim2.new(1, 0, 0, math.min(#newRows * rowHeight + headerHeight, maxHeight))
    end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end
    return obj
end

