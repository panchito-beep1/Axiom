--  Global search
-- ════════════════════════════════════════════════════════════════════════════
function RGui:_registerSearch(frame, text)
    if not frame or not text then return end
    table.insert(self._searchRegistry, { Frame = frame, Text = tostring(text):lower() })
end

function RGui:_applySearch(query)
    self._searchQuery = (query or ""):lower()
    local q = self._searchQuery
    for _, entry in ipairs(self._searchRegistry) do
        if entry.Frame and entry.Frame.Parent then
            if q == "" then
                entry.Frame.Visible = true
            else
                entry.Frame.Visible = entry.Text:find(q, 1, true) ~= nil
            end
        end
    end
end

function RGui:EnableSearch(options)
    options = options or {}
    if self._searchBox then return self._searchBox end
    local theme = self._theme
    local titleBar = self._mainFrame:FindFirstChild("TitleBar")
    if not titleBar then return end
    local width = options.Width or 120

    local searchBox = Instance.new("TextBox")
    searchBox.Name               = "GlobalSearch"
    searchBox.BackgroundColor3   = theme.FrameBg
    searchBox.BorderSizePixel    = 0
    searchBox.Size               = UDim2.new(0, width, 0, 18)
    searchBox.Position           = UDim2.new(1, -(44 + 4 + width), 0.5, -9)
    searchBox.Font               = Enum.Font.RobotoMono
    searchBox.PlaceholderText    = options.Placeholder or "Search..."
    searchBox.PlaceholderColor3  = theme.SubText
    searchBox.Text               = ""
    searchBox.TextColor3         = theme.Text
    searchBox.TextSize           = 12
    searchBox.TextXAlignment     = Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus   = false
    searchBox.Parent             = titleBar
    applyCorner(searchBox, 2)
    applyBorder(searchBox, theme.Border)

    if self._titleLbl then
        local reserve = width + 4 + 44 + 8
        self._titleLbl.Size = UDim2.new(1, -reserve, 1, 0)
    end

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        self:_applySearch(searchBox.Text)
    end)

    self._searchBox = searchBox
    return searchBox
end

function RGui:DisableSearch()
    if self._searchBox then
        self._searchBox:Destroy()
        self._searchBox = nil
    end
    self:_applySearch("")
end

-- ════════════════════════════════════════════════════════════════════════════
--  Save / load state
-- ════════════════════════════════════════════════════════════════════════════
function RGui:_registerState(key, getFn, setFn)
    if not key then return end
    self._stateRegistry[key] = { get = getFn, set = setFn }
end

function RGui:_autoStateKey(tabLabel, componentLabel)
    self._stateAutoCounter = self._stateAutoCounter + 1
    return string.format("%s::%s::%d", tostring(tabLabel), tostring(componentLabel), self._stateAutoCounter)
end

function RGui:EnableStateSaving(options)
    options = options or {}
    local folder   = options.Folder   or "RGui"
    local filename = options.Filename or "state.json"
    if isfolder and not isfolder(folder) then makefolder(folder) end
    self._stateFilePath = folder .. "/" .. filename
end

function RGui:SaveState()
    if not self._stateFilePath then
        warn("[RGui] SaveState: call win:EnableStateSaving({ Folder = ..., Filename = ... }) first")
        return
    end
    local snapshot = {
        Position = {
            self._mainFrame.Position.X.Scale, self._mainFrame.Position.X.Offset,
            self._mainFrame.Position.Y.Scale, self._mainFrame.Position.Y.Offset,
        },
        Size = {
            self._mainFrame.Size.X.Scale, self._mainFrame.Size.X.Offset,
            self._mainFrame.Size.Y.Scale, self._mainFrame.Size.Y.Offset,
        },
        ActiveTab  = self._activeTabIndex,
        Components = {},
    }
    for key, entry in pairs(self._stateRegistry) do
        local ok, value = pcall(entry.get)
        if ok then snapshot.Components[key] = value end
    end
    local json = HttpService:JSONEncode(snapshot)
    writefile(self._stateFilePath, json)
end

function RGui:LoadState()
    if not self._stateFilePath then
        warn("[RGui] LoadState: call win:EnableStateSaving({ Folder = ..., Filename = ... }) first")
        return
    end
    if not isfile(self._stateFilePath) then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(self._stateFilePath))
    end)
    if not ok or type(data) ~= "table" then return end

    if data.Position then self._mainFrame.Position = UDim2.new(unpack(data.Position)) end
    if data.Size     then self._mainFrame.Size     = UDim2.new(unpack(data.Size))     end

    for key, value in pairs(data.Components or {}) do
        local entry = self._stateRegistry[key]
        if entry then pcall(entry.set, value) end
    end

    if data.ActiveTab and self._tabs[data.ActiveTab] then
        self._tabs[data.ActiveTab].Button.MouseButton1Click:Fire()
    end
end

-- ════════════════════════════════════════════════════════════════════════════
--  RGui:AddTab({ Name, Icon })
-- ════════════════════════════════════════════════════════════════════════════
function RGui:AddTab(options)
    options = options or {}
    local name = options.Name or "Tab"
    local iconId = options.Icon

    local theme = self._theme

    local tabBtn = Instance.new("TextButton")
    tabBtn.BackgroundColor3 = theme.TabNormal
    tabBtn.Size = UDim2.new(0, 0, 1, 0)
    tabBtn.Font = Enum.Font.RobotoMono
    tabBtn.Text = ""
    tabBtn.TextColor3 = theme.TabNormalText
    tabBtn.TextSize = 13
    tabBtn.Parent = self._tabContainer
    applyBorder(tabBtn, theme.Border)

    local tabText = Instance.new("TextLabel")
    tabText.BackgroundTransparency = 1
    tabText.Font = Enum.Font.RobotoMono
    tabText.Text = name
    tabText.TextColor3 = theme.TabNormalText
    tabText.TextSize = 13
    tabText.Parent = tabBtn

    local icon
    if iconId then
        icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Size = UDim2.new(0, 18, 0, 18)
        icon.Position = UDim2.new(0, 4, 0.5, -9)
        icon.Image = iconId
        icon.Parent = tabBtn
    end

    local txtSize = TextService:GetTextSize(name, 13, Enum.Font.RobotoMono, Vector2.new(999, 26))
    local totalWidth = txtSize.X + 16 + (icon and 24 or 0)
    tabBtn.Size = UDim2.new(0, totalWidth, 1, 0)

    if icon then
        tabText.Position = UDim2.new(0, 26, 0, 0)
        tabText.Size = UDim2.new(1, -26, 1, 0)
    else
        tabText.Position = UDim2.new(0, 8, 0, 0)
        tabText.Size = UDim2.new(1, -16, 1, 0)
    end

    local page = Instance.new("ScrollingFrame")
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = theme.Accent
    page.Visible = false
    page.Parent = self._pageContainer
    applyPadding(page, 8)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = page

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 16)
    end)

    table.insert(self._tabs, {Button = tabBtn, Page = page, TextLabel = tabText})

    tabBtn.MouseButton1Click:Connect(function()
        for i, t in ipairs(self._tabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = theme.TabNormal
            t.TextLabel.TextColor3 = theme.TabNormalText
            if t.Button == tabBtn then self._activeTabIndex = i end
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = theme.TabActive
        tabText.TextColor3 = theme.TabActiveText
    end)

    if #self._tabs == 1 then
        page.Visible = true
        tabBtn.BackgroundColor3 = theme.TabActive
        tabText.TextColor3 = theme.TabActiveText
        self._activeTabIndex = 1
    end

    local tabObj = setmetatable({}, TabComponent)
    tabObj._page = page
    tabObj._layoutOrder = 0
    tabObj._window = self
    return tabObj
end

-- ── Tab helper ────────────────────────────────────────────────────────────────
function TabComponent:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

local function getTheme(tab)
    return tab._window._theme
end

