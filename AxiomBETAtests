-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddButton(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text     or "Button"
    local callback = options.Callback
    local iconId   = options.Icon
    local tooltip  = options.Tooltip

    local bgColor = theme.FrameBg
    if options.Color then
        warnCustomColor(self, "Button")
        bgColor = options.Color
    end

    local currentCallback = callback
    local currentEnabled = true

    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = bgColor
    btn.Size = UDim2.new(1, 0, 0, 24)
    btn.LayoutOrder = self:_nextOrder()
    btn.Font = Enum.Font.RobotoMono
    btn.Text = ""
    btn.TextColor3 = theme.Text
    btn.TextSize = 13
    btn.Parent = self._page
    applyCorner(btn, 2)
    applyBorder(btn, theme.Border)

    local icon
    if iconId then
        icon = Instance.new("ImageLabel")
        icon.BackgroundTransparency = 1
        icon.Size = UDim2.new(0, 18, 0, 18)
        icon.Position = UDim2.new(0, 4, 0.5, -9)
        icon.Image = iconId
        icon.Parent = btn
    end

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = icon and UDim2.new(0, 26, 0, 0) or UDim2.new(0, 4, 0, 0)
    lbl.Size = UDim2.new(1, (icon and -30 or -8), 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn

    btn.MouseEnter:Connect(function()
        if currentEnabled then btn.BackgroundColor3 = options.Color or theme.FrameBgHover end
    end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = bgColor end)

    btn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = theme.Accent}):Play()
        task.delay(0.1, function()
            TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = options.Color or theme.FrameBgHover}):Play()
        end)
        safeCall(currentCallback)
    end)

    if tooltip then attachTooltip(btn, tooltip, self._window) end
    if self._window then self._window:_registerSearch(btn, text) end

    local obj = {}
    function obj:SetText(t) lbl.Text = t end
    function obj:GetText() return lbl.Text end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetIcon(id)
        if not icon then
            icon = Instance.new("ImageLabel")
            icon.BackgroundTransparency = 1
            icon.Size = UDim2.new(0, 18, 0, 18)
            icon.Position = UDim2.new(0, 4, 0.5, -9)
            icon.Parent = btn
            lbl.Position = UDim2.new(0, 26, 0, 0)
            lbl.Size = UDim2.new(1, -30, 1, 0)
        end
        icon.Image = id
    end
    function obj:SetEnabled(state)
        currentEnabled = state
        btn.Active = state
        if state then
            btn.BackgroundColor3 = options.Color or theme.FrameBg
            lbl.TextColor3 = theme.Text
        else
            btn.BackgroundColor3 = disabledColor(options.Color or theme.FrameBg)
            lbl.TextColor3 = disabledColor(theme.Text)
        end
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() btn:Destroy() end
    function obj:GetInstance() return btn end
    return obj
end

