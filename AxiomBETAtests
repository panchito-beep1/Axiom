--  TabComponent:AddCollapsible({ Title })
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddCollapsible(options)
    options = options or {}
    local theme = getTheme(self)

    local title = options.Title or "Section"

    local isOpen = true
    local currentEnabled = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 26)
    container.LayoutOrder = self:_nextOrder()
    container.Parent = self._page

    local headerBtn = Instance.new("TextButton")
    headerBtn.BackgroundColor3 = theme.FrameBg
    headerBtn.Size = UDim2.new(1, 0, 0, 24)
    headerBtn.Font = Enum.Font.RobotoMono
    headerBtn.Text = " ▼ " .. title
    headerBtn.TextColor3 = theme.Text
    headerBtn.TextSize = 13
    headerBtn.TextXAlignment = Enum.TextXAlignment.Left
    headerBtn.Parent = container
    applyCorner(headerBtn, 2)
    applyBorder(headerBtn, theme.Border)

    local hoverTweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    headerBtn.MouseEnter:Connect(function()
        if currentEnabled then TweenService:Create(headerBtn, hoverTweenInfo, {BackgroundColor3 = theme.FrameBgHover}):Play() end
    end)
    headerBtn.MouseLeave:Connect(function()
        TweenService:Create(headerBtn, hoverTweenInfo, {BackgroundColor3 = theme.FrameBg}):Play()
    end)

    local content = Instance.new("Frame")
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 0, 0, 26)
    content.Size = UDim2.new(1, 0, 0, 0)
    content.ClipsDescendants = true
    content.Parent = container
    applyPadding(content, 4)

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.Parent = content

    local sizeTweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    local function updateSize(instant)
        local contentHeight = contentLayout.AbsoluteContentSize.Y + 8
        local targetContainerSize = isOpen and UDim2.new(1, 0, 0, 26 + contentHeight) or UDim2.new(1, 0, 0, 26)
        local targetContentSize = isOpen and UDim2.new(1, 0, 0, contentHeight) or UDim2.new(1, 0, 0, 0)
        if instant then
            container.Size = targetContainerSize
            content.Size = targetContentSize
        else
            TweenService:Create(container, sizeTweenInfo, {Size = targetContainerSize}):Play()
            TweenService:Create(content, sizeTweenInfo, {Size = targetContentSize}):Play()
        end
    end

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() updateSize(false) end)
    updateSize(true)

    headerBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        headerBtn.Text = (isOpen and " ▼ " or " ▶ ") .. title
        updateSize(false)
    end)

    local dummyTab = {
        _page = content,
        _window = self._window,
        _layoutOrder = 0,
    }
    setmetatable(dummyTab, TabComponent)

    local collapsible = {}
    setmetatable(collapsible, {
        __index = function(_, methodName)
            local method = dummyTab[methodName]
            if type(method) == "function" then
                return function(_, ...) return method(dummyTab, ...) end
            end
            return method
        end
    })

    function collapsible:Expand()
        if not isOpen and currentEnabled then headerBtn.MouseButton1Click:Fire() end
    end
    function collapsible:Collapse()
        if isOpen and currentEnabled then headerBtn.MouseButton1Click:Fire() end
    end
    function collapsible:Toggle()
        if currentEnabled then headerBtn.MouseButton1Click:Fire() end
    end
    function collapsible:SetEnabled(state)
        currentEnabled = state
        headerBtn.Active = state
        headerBtn.BackgroundColor3 = state and theme.FrameBg or disabledColor(theme.FrameBg)
        headerBtn.TextColor3 = state and theme.Text or disabledColor(theme.Text)
    end
    function collapsible:IsEnabled() return currentEnabled end
    function collapsible:Destroy() container:Destroy() end

    if self._window then self._window:_registerSearch(headerBtn, title) end

    return collapsible
end

