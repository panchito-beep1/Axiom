        box.Size = UDim2.new(1, -8, 0, math.max(textSize.Y + 8, 80))
        scroll.CanvasSize = UDim2.new(0, 0, 0, math.max(textSize.Y + 16, 200))
        if currentEnabled then
            currentText = box.Text
            safeCall(currentCallback, currentText)
        end
    end)

    if self._window then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetText() return box.Text end
