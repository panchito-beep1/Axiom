--  TabComponent:AddSubTab({ Name, Icon })
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddSubTab(options)
    options = options or {}
    local name = options.Name or "SubTab"
    local iconId = options.Icon

    local theme = getTheme(self)

    if not self._subTabContainer then
        local container = Instance.new("Frame")
        container.BackgroundTransparency = 1
        container.Size = UDim2.new(1, 0, 0, 26)
        container.LayoutOrder = self:_nextOrder()
        container.Parent = self._page
        self._subTabContainer = container

        local bar = Instance.new("Frame")
        bar.BackgroundColor3 = theme.TabBarBg
        bar.Size = UDim2.new(1, 0, 0, 24)
        bar.Parent = container
        applyBorder(bar, theme.Border)

        local barLayout = Instance.new("UIListLayout")
        barLayout.FillDirection = Enum.FillDirection.Horizontal
        barLayout.SortOrder = Enum.SortOrder.LayoutOrder
        barLayout.Parent = bar

        self._subTabBar       = bar
        self._subTabBarLayout = barLayout
        self._subTabs         = {}
    end

    local container = self._subTabContainer
    local bar       = self._subTabBar

    local subBtn = Instance.new("TextButton")
    subBtn.BackgroundColor3 = theme.TabNormal
    subBtn.Size = UDim2.new(0, 0, 1, 0)
    subBtn.Font = Enum.Font.RobotoMono
    subBtn.Text = ""
    subBtn.TextSize = 12
    subBtn.LayoutOrder = #self._subTabs + 1
    subBtn.Parent = bar
    applyBorder(subBtn, theme.Border)

    local subText = Instance.new("TextLabel")
    subText.BackgroundTransparency = 1
    subText.Font = Enum.Font.RobotoMono
    subText.Text = name
    subText.TextColor3 = theme.TabNormalText
    subText.TextSize = 12
    subText.Parent = subBtn

    local subIcon
    if iconId then
        subIcon = Instance.new("ImageLabel")
        subIcon.BackgroundTransparency = 1
        subIcon.Size = UDim2.new(0, 16, 0, 16)
        subIcon.Position = UDim2.new(0, 4, 0.5, -8)
        subIcon.Image = iconId
        subIcon.Parent = subBtn
    end

    local txtSize = TextService:GetTextSize(name, 12, Enum.Font.RobotoMono, Vector2.new(999, 24))
    local totalWidth = txtSize.X + 16 + (subIcon and 22 or 0)
    subBtn.Size = UDim2.new(0, totalWidth, 1, 0)

    if subIcon then
        subText.Position = UDim2.new(0, 24, 0, 0)
        subText.Size = UDim2.new(1, -24, 1, 0)
    else
        subText.Position = UDim2.new(0, 8, 0, 0)
        subText.Size = UDim2.new(1, -16, 1, 0)
    end

    local page = Instance.new("Frame")
    page.BackgroundTransparency = 1
    page.Position = UDim2.new(0, 0, 0, 26)
    page.Size = UDim2.new(1, 0, 0, 0)
    page.Visible = false
    page.Parent = container
    applyPadding(page, 6)

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout.Parent = page

    local function updateSizes()
        local h = pageLayout.AbsoluteContentSize.Y + 12
        page.Size = UDim2.new(1, 0, 0, h)
        if page.Visible then
            container.Size = UDim2.new(1, 0, 0, 26 + h)
        end
    end
    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSizes)

    table.insert(self._subTabs, {
        Button = subBtn, Page = page, TextLabel = subText, UpdateSize = updateSizes,
    })

    subBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(self._subTabs) do
            t.Page.Visible = false
            t.Button.BackgroundColor3 = theme.TabNormal
            t.TextLabel.TextColor3 = theme.TabNormalText
        end
        page.Visible = true
        subBtn.BackgroundColor3 = theme.TabActive
        subText.TextColor3 = theme.TabActiveText
        updateSizes()
    end)

    if #self._subTabs == 1 then
        page.Visible = true
        subBtn.BackgroundColor3 = theme.TabActive
        subText.TextColor3 = theme.TabActiveText
        task.defer(updateSizes)
    end

    local subTabObj = setmetatable({}, TabComponent)
    subTabObj._page = page
    subTabObj._layoutOrder = 0
    subTabObj._window = self._window
    return subTabObj
end

