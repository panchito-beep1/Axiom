--  TabComponent:AddMultiSelectDropdown({ Text, Items, Defaults, Callback,
--                                        Color, Tooltip, StateKey })
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddMultiSelectDropdown(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Dropdown"
    local items    = options.Items or {}
    local defaults = options.Defaults
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local selected = {}
    if defaults then for _, v in ipairs(defaults) do selected[v] = true end end
    local isOpen = false
    local currentCallback = callback
    local currentEnabled = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("TextButton")
    header.BackgroundColor3 = options.Color or theme.FrameBg
    if options.Color then warnCustomColor(self, "MultiSelectDropdown") end
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Font = Enum.Font.RobotoMono
    header.TextColor3 = theme.Text
    header.TextSize = 13
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local function updateHeader()
        local count = 0
        for _ in pairs(selected) do count = count + 1 end
        if count == 0 then header.Text = string.format(" %s: None", text)
        elseif count == #items then header.Text = string.format(" %s: All", text)
        else header.Text = string.format(" %s: %d selected", text, count) end
    end
    updateHeader()

    local listFrame = Instance.new("Frame")
    listFrame.BackgroundColor3 = theme.TabNormal
    listFrame.Position = UDim2.new(0, 0, 0, 26)
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.ClipsDescendants = true
    listFrame.Parent = container
    applyBorder(listFrame, theme.Border)

    local scroll = Instance.new("ScrollingFrame")
    scroll.BackgroundTransparency = 1
    scroll.Size = UDim2.new(1, 0, 1, 0)
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ScrollBarThickness = 4
    scroll.ScrollBarImageColor3 = theme.Accent
    scroll.Parent = listFrame

    local optionLayout = Instance.new("UIListLayout")
    optionLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optionLayout.Parent = scroll

    local selectAllBtn = Instance.new("TextButton")
    selectAllBtn.BackgroundColor3 = theme.FrameBg
    selectAllBtn.Size = UDim2.new(1, -8, 0, 20)
    selectAllBtn.Position = UDim2.new(0, 4, 0, 2)
    selectAllBtn.Font = Enum.Font.RobotoMono
    selectAllBtn.Text = "Select All"
    selectAllBtn.TextColor3 = theme.Accent
    selectAllBtn.TextSize = 12
    selectAllBtn.Parent = listFrame
    applyCorner(selectAllBtn, 2)
    applyBorder(selectAllBtn, theme.Border)

    local deselectAllBtn = Instance.new("TextButton")
    deselectAllBtn.BackgroundColor3 = theme.FrameBg
    deselectAllBtn.Size = UDim2.new(1, -8, 0, 20)
    deselectAllBtn.Position = UDim2.new(0, 4, 0, 24)
    deselectAllBtn.Font = Enum.Font.RobotoMono
    deselectAllBtn.Text = "Deselect All"
    deselectAllBtn.TextColor3 = theme.Accent
    deselectAllBtn.TextSize = 12
    deselectAllBtn.Parent = listFrame
    applyCorner(deselectAllBtn, 2)
    applyBorder(deselectAllBtn, theme.Border)

    local optionStartY = 48
    local optionHeight = 22
    local optionButtons = {}
    local function rebuildOptions()
        for _, data in pairs(optionButtons) do data.btn:Destroy() end
        table.clear(optionButtons)
        for i, optItem in ipairs(items) do
            local btn = Instance.new("TextButton")
            btn.BackgroundTransparency = 1
            btn.Size = UDim2.new(1, -8, 0, optionHeight)
            btn.Position = UDim2.new(0, 4, 0, optionStartY + (i-1)*optionHeight)
            btn.Font = Enum.Font.RobotoMono
            btn.Text = " " .. tostring(optItem)
            btn.TextColor3 = theme.TabNormalText
            btn.TextSize = 12
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = scroll

            local checkIndicator = Instance.new("TextLabel")
            checkIndicator.BackgroundTransparency = 1
            checkIndicator.AnchorPoint = Vector2.new(1, 0)
            checkIndicator.Position = UDim2.new(1, -6, 0, 3)
            checkIndicator.Size = UDim2.new(0, 16, 0, 16)
            checkIndicator.Font = Enum.Font.RobotoMono
            checkIndicator.Text = selected[optItem] and "✓" or ""
            checkIndicator.TextColor3 = theme.Accent
            checkIndicator.TextSize = 12
            checkIndicator.Parent = btn

            btn.MouseEnter:Connect(function() btn.TextColor3 = theme.Accent end)
            btn.MouseLeave:Connect(function() btn.TextColor3 = theme.TabNormalText end)
            btn.MouseButton1Click:Connect(function()
                if not currentEnabled then return end
                if selected[optItem] then selected[optItem] = nil else selected[optItem] = true end
                checkIndicator.Text = selected[optItem] and "✓" or ""
                updateHeader()
                local t = {}
                for k in pairs(selected) do table.insert(t, k) end
                safeCall(currentCallback, t)
            end)
            optionButtons[optItem] = {btn = btn, check = checkIndicator}
        end
        scroll.CanvasSize = UDim2.new(0, 0, 0, #items * optionHeight)
        local totalHeight = 48 + #items * optionHeight
        if isOpen then
            local displayedHeight = math.min(totalHeight, 180)
            scroll.Size = UDim2.new(1, 0, 0, displayedHeight)
            TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 26 + 2 + displayedHeight)}):Play()
            TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 2 + displayedHeight)}):Play()
        end
    end
    rebuildOptions()

    local function openClose()
        if not currentEnabled then return end
        isOpen = not isOpen
        if isOpen then
            local totalHeight = 48 + #items * optionHeight
            local displayedHeight = math.min(totalHeight, 180)
            scroll.Size = UDim2.new(1, 0, 0, displayedHeight)
            TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 26 + 2 + displayedHeight)}):Play()
            TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 2 + displayedHeight)}):Play()
        else
            TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 24)}):Play()
            TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 0)}):Play()
        end
    end

    header.MouseButton1Click:Connect(openClose)
    selectAllBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        for _, optItem in ipairs(items) do
            selected[optItem] = true
            if optionButtons[optItem] then optionButtons[optItem].check.Text = "✓" end
        end
        updateHeader()
        safeCall(currentCallback, items)
    end)
    deselectAllBtn.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        for k in pairs(selected) do selected[k] = nil end
        for _, optItem in ipairs(items) do
            if optionButtons[optItem] then optionButtons[optItem].check.Text = "" end
        end
        updateHeader()
        safeCall(currentCallback, {})
    end)

    if tooltip then attachTooltip(header, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetValue()
        local t = {}
        for k in pairs(selected) do table.insert(t, k) end
        return t
    end
    function obj:SetValue(tbl)
        selected = {}
        if tbl then for _, v in ipairs(tbl) do selected[v] = true end end
        for k, data in pairs(optionButtons) do
            data.check.Text = selected[k] and "✓" or ""
        end
        updateHeader()
        safeCall(currentCallback, obj:GetValue())
    end
    function obj:AddItem(item) table.insert(items, item); rebuildOptions() end
    function obj:SetItems(newItems)
        items = newItems
        selected = {}
        rebuildOptions(); updateHeader()
        safeCall(currentCallback, {})
    end
    function obj:Clear()
        items = {}
        selected = {}
        rebuildOptions(); updateHeader()
        safeCall(currentCallback, {})
    end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        header.Active = state
        header.BackgroundColor3 = state and (options.Color or theme.FrameBg)
                                        or disabledColor(options.Color or theme.FrameBg)
        header.TextColor3 = state and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return obj:GetValue() end, function(v) obj:SetValue(v) end)

    return obj
end

