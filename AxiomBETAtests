--  RGui.Validators (unchanged)
-- ════════════════════════════════════════════════════════════════════════════
RGui.Validators = {}

function RGui.Validators.GamePass(passId, options)
    options = options or {}
    return {
        Tier            = options.Tier            or "VIP",
        Premium         = options.Premium         ~= false,
        IsAsync         = true,
        PromptIfMissing = options.PromptIfMissing or false,
        Validate = function(_key)
            local MPS    = game:GetService("MarketplaceService")
            local player = game:GetService("Players").LocalPlayer
            local ok, owns = pcall(MPS.UserOwnsGamePassAsync, MPS, player.UserId, passId)
            if ok and owns then return true end
            if options.PromptIfMissing then
                pcall(MPS.PromptGamePassPurchase, MPS, player, passId)
            end
            return false
        end,
    }
end

function RGui.Validators.DevProduct(productId, options)
    options = options or {}
    return {
        Tier    = options.Tier    or "VIP",
        Premium = options.Premium ~= false,
        IsAsync = false,
        Validate = function(_key)
            local MPS    = game:GetService("MarketplaceService")
            local player = game:GetService("Players").LocalPlayer
            pcall(MPS.PromptProductPurchase, MPS, player, productId)
            if options.OnPrompt then pcall(options.OnPrompt) end
            return false
        end,
    }
end

function RGui.Validators.UserId(ids, options)
    options = options or {}
    local set = {}
    for _, id in ipairs(ids) do set[id] = true end
    return {
        Tier    = options.Tier    or "Developer",
        Premium = options.Premium or false,
        IsAsync = false,
        Validate = function(_key)
            return set[game:GetService("Players").LocalPlayer.UserId] == true
        end,
    }
end

function RGui.Validators.Username(names, options)
    options = options or {}
    local set = {}
    for _, n in ipairs(names) do set[n:lower()] = true end
    return {
        Tier    = options.Tier    or "Developer",
        Premium = options.Premium or false,
        IsAsync = false,
        Validate = function(_key)
            return set[game:GetService("Players").LocalPlayer.Name:lower()] == true
        end,
    }
end

function RGui.Validators.Currency(attr, amount, options)
    options = options or {}
    return {
        Tier    = options.Tier    or "VIP",
        Premium = options.Premium ~= false,
        IsAsync = false,
        Validate = function(_key)
            local player = game:GetService("Players").LocalPlayer
            local ls     = player:FindFirstChild("leaderstats")
            if not ls then return false end
            local stat = ls:FindFirstChild(attr)
            return stat ~= nil and stat.Value >= amount
        end,
    }
end

