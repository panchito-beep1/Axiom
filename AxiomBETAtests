function RGui:SetTheme(newTheme)
    local oldTheme = self._theme
    local merged = {}
    for k, v in pairs(RGui.DefaultTheme) do merged[k] = v end
    if newTheme then for k, v in pairs(newTheme) do merged[k] = v end end
    self._theme = merged

    local oldMap = {}
    for key, col in pairs(oldTheme) do
        if typeof(col) == "Color3" then oldMap[col] = key end
    end

    local function scan(instance)
        if instance:IsA("GuiObject") then
            local key = oldMap[instance.BackgroundColor3]
            if key and merged[key] then instance.BackgroundColor3 = merged[key] end

            if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
                local txtKey = oldMap[instance.TextColor3]
                if txtKey and merged[txtKey] then instance.TextColor3 = merged[txtKey] end
            end

            if instance:IsA("TextBox") then
                local phKey = oldMap[instance.PlaceholderColor3]
                if phKey and merged[phKey] then instance.PlaceholderColor3 = merged[phKey] end
            end

            local stroke = instance:FindFirstChildOfClass("UIStroke")
            if stroke then
                local strokeKey = oldMap[stroke.Color]
                if strokeKey and merged[strokeKey] then stroke.Color = merged[strokeKey] end
            end
        end
        for _, child in ipairs(instance:GetChildren()) do scan(child) end
    end

    if self._mainFrame then scan(self._mainFrame) end
end

RGui.Lucide = nil
function RGui:LoadLucide()
    if not RGui.Lucide then
        RGui.Lucide = loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/xxpwnxxx420lord/Lucide.Lua/refs/heads/main/lucide.lua"
        ))()
    end
    return RGui.Lucide
end

function RGui:GetLucideIcon(name, options)
    local lucide = self:LoadLucide()
    return lucide:geticon(name, options or {})
end

RGui.Config = {}
function RGui.Config.new(folder, filename)
    folder = folder or "Axiom"
    filename = filename or "config.json"
    local fullPath = folder .. "/" .. filename

    local self = {}
    self._data = {}

    if isfolder and not isfolder(folder) then makefolder(folder) end

    local function saveToStorage(tbl)
        local json = HttpService:JSONEncode(tbl)
        writefile(fullPath, json)
    end

    local function loadFromStorage()
        if not isfile(fullPath) then return {} end
        local json = readfile(fullPath)
        local success, decoded = pcall(function() return HttpService:JSONDecode(json) end)
        if success and type(decoded) == "table" then return decoded end
        return {}
    end

    function self:Set(key, value) self._data[key] = value end
    function self:Get(key) return self._data[key] end
    function self:Save() saveToStorage(self._data) end
    function self:Load() self._data = loadFromStorage(); return self._data end
    function self:BindCheckbox(tab, key, text, default)
        local saved = self:Get(key)
        local initial = saved ~= nil and saved or default
        return tab:AddCheckbox({
            Text     = text,
            Default  = initial,
            Callback = function(value) self:Set(key, value) end,
        })
    end
    return self
end

function RGui:Destroy()
    if self._watermark then self._watermark:Destroy() end
    if self._notificationGui then self._notificationGui:Destroy() end
    if tooltipGui then tooltipGui:Destroy(); tooltipGui = nil end
    self._screen:Destroy()
end

return RGui
