--  TabComponent:AddDropdown({ Text, Items, Default, Callback,
--                             Color, Tooltip, StateKey })
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddDropdown(options)
    options = options or {}
    local theme = getTheme(self)

    local text     = options.Text or "Dropdown"
    local items    = options.Items or {}
    local default  = options.Default
    local callback = options.Callback
    local tooltip  = options.Tooltip

    local selected = default or items[1]
    local isOpen = false
    local currentCallback = callback
    local currentEnabled = true

    local container = Instance.new("Frame")
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 0, 24)
    container.LayoutOrder = self:_nextOrder()
    container.ClipsDescendants = true
    container.Parent = self._page

    local header = Instance.new("TextButton")
    header.BackgroundColor3 = options.Color or theme.FrameBg
    if options.Color then warnCustomColor(self, "Dropdown") end
    header.Size = UDim2.new(1, 0, 0, 24)
    header.Font = Enum.Font.RobotoMono
    header.Text = string.format(" %s: %s", text, tostring(selected))
    header.TextColor3 = theme.Text
    header.TextSize = 13
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Parent = container
    applyCorner(header, 2)
    applyBorder(header, theme.Border)

    local listFrame = Instance.new("Frame")
    listFrame.BackgroundColor3 = theme.TabNormal
    listFrame.Position = UDim2.new(0, 0, 0, 26)
    listFrame.Size = UDim2.new(1, 0, 0, 0)
    listFrame.ClipsDescendants = true
    listFrame.Parent = container
    applyBorder(listFrame, theme.Border)

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = listFrame

    local optionButtons = {}
    local function rebuildOptions()
        for _, btn in ipairs(optionButtons) do btn:Destroy() end
        table.clear(optionButtons)
        for i, optItem in ipairs(items) do
            local optBtn = Instance.new("TextButton")
            optBtn.BackgroundTransparency = 1
            optBtn.Size = UDim2.new(1, 0, 0, 22)
            optBtn.Font = Enum.Font.RobotoMono
            optBtn.Text = " " .. tostring(optItem)
            optBtn.TextColor3 = theme.TabNormalText
            optBtn.TextSize = 12
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.LayoutOrder = i
            optBtn.Parent = listFrame

            optBtn.MouseEnter:Connect(function() optBtn.TextColor3 = theme.Accent end)
            optBtn.MouseLeave:Connect(function() optBtn.TextColor3 = theme.TabNormalText end)
            optBtn.MouseButton1Click:Connect(function()
                if not currentEnabled then return end
                selected = optItem
                header.Text = string.format(" %s: %s", text, tostring(selected))
                isOpen = false
                TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 24)}):Play()
                TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                safeCall(currentCallback, selected)
            end)
            table.insert(optionButtons, optBtn)
        end
        local totalHeight = #items * 22
        listFrame.Size = isOpen and UDim2.new(1, 0, 0, totalHeight) or UDim2.new(1, 0, 0, 0)
        if isOpen then
            TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 26 + totalHeight)}):Play()
        end
    end
    rebuildOptions()

    header.MouseButton1Click:Connect(function()
        if not currentEnabled then return end
        isOpen = not isOpen
        local targetHeight = isOpen and (26 + (#items * 22)) or 24
        TweenService:Create(container, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
        TweenService:Create(listFrame, TWEEN_FAST, {Size = UDim2.new(1, 0, 0, isOpen and #items * 22 or 0)}):Play()
    end)

    if tooltip then attachTooltip(header, tooltip, self._window) end
    if self._window then self._window:_registerSearch(container, text) end

    local obj = {}
    function obj:GetValue() return selected end
    function obj:SetValue(val)
        if table.find(items, val) then
            selected = val
            header.Text = string.format(" %s: %s", text, tostring(selected))
            safeCall(currentCallback, selected)
        end
    end
    function obj:AddItem(item) table.insert(items, item); rebuildOptions() end
    function obj:SetItems(newItems)
        items = newItems
        if not table.find(items, selected) then
            selected = items[1]
            header.Text = string.format(" %s: %s", text, tostring(selected))
            safeCall(currentCallback, selected)
        end
        rebuildOptions()
    end
    function obj:Clear()
        items = {}
        selected = nil
        header.Text = string.format(" %s: ", text)
        rebuildOptions()
        safeCall(currentCallback, nil)
    end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        header.Active = state
        if state then
            header.BackgroundColor3 = options.Color or theme.FrameBg
            header.TextColor3 = theme.Text
        else
            header.BackgroundColor3 = disabledColor(options.Color or theme.FrameBg)
            header.TextColor3 = disabledColor(theme.Text)
        end
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() container:Destroy() end
    function obj:GetInstance() return container end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return selected end, function(v) obj:SetValue(v) end)

    return obj
end

