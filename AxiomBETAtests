--  TabComponent:AddTextBox({ Text, Placeholder, Default, Callback,
--                            Color, Tooltip, StateKey })
-- ════════════════════════════════════════════════════════════════════════════
function TabComponent:AddTextBox(options)
    options = options or {}
    local theme = getTheme(self)

    local text        = options.Text or ""
    local placeholder = options.Placeholder
    local default     = options.Default
    local callback    = options.Callback
    local tooltip     = options.Tooltip

    local currentText = default or ""
    local currentCallback = callback
    local currentEnabled = true

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 24)
    row.LayoutOrder = self:_nextOrder()
    row.Parent = self._page

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    local lblWidth = text and (TextService:GetTextSize(text .. ":", 13, Enum.Font.RobotoMono, Vector2.new(999, 24)).X + 4) or 0
    lbl.Size = UDim2.new(0, lblWidth, 1, 0)
    lbl.Font = Enum.Font.RobotoMono
    lbl.Text = text .. ":"
    lbl.TextColor3 = theme.Text
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local box = Instance.new("TextBox")
    box.BackgroundColor3 = options.Color or theme.FrameBg
    if options.Color then warnCustomColor(self, "TextBox") end
    box.Position = UDim2.new(0, lblWidth + 4, 0, 0)
    box.Size = UDim2.new(1, -(lblWidth + 4), 1, 0)
    box.Font = Enum.Font.RobotoMono
    box.PlaceholderText = placeholder or ""
    box.PlaceholderColor3 = theme.SubText
    box.Text = currentText
    box.TextColor3 = theme.Text
    box.TextSize = 13
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.Parent = row
    applyCorner(box, 2)
    applyBorder(box, theme.Border)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if not currentEnabled then return end
        currentText = box.Text
        safeCall(currentCallback, currentText)
    end)

    if tooltip then attachTooltip(box, tooltip, self._window) end
    if self._window then self._window:_registerSearch(row, text) end

    local obj = {}
    function obj:GetValue() return box.Text end
    function obj:SetValue(txt)
        box.Text = txt
        currentText = txt
        safeCall(currentCallback, txt)
    end
    function obj:Clear() obj:SetValue("") end
    function obj:SetCallback(cb) currentCallback = cb end
    function obj:SetEnabled(state)
        currentEnabled = state
        box.Active = state
        box.BackgroundColor3 = state and (options.Color or theme.FrameBg)
                                     or disabledColor(options.Color or theme.FrameBg)
        box.TextColor3 = state and theme.Text or disabledColor(theme.Text)
    end
    function obj:IsEnabled() return currentEnabled end
    function obj:Destroy() row:Destroy() end
    function obj:GetInstance() return row end

    local key = options.StateKey or self._window:_autoStateKey("tab", text)
    self._window:_registerState(key, function() return box.Text end, function(v) obj:SetValue(v) end)

    return obj
end

